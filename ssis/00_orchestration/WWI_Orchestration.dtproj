<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="www.microsoft.com/SqlServer/SSIS" ToolsVersion="13.0">
  <DeploymentModel>Project</DeploymentModel>
  <ProductVersion>13.0.4001.0</ProductVersion>
  <SchemaVersion>9.0.1.0</SchemaVersion>
  <Database>
    <Name>WWI_Orchestration.ispac</Name>
  </Database>
  <DeploymentInfoXml>
    <ProjectProtectionLevel>DontSaveSensitive</ProjectProtectionLevel>
  </DeploymentInfoXml>
  <Packages>
    <Package>
      <Name>Master_Daily_ETL.dtsx</Name>
      <EntryPoint>true</EntryPoint>
    </Package>
    <Package>
      <Name>Master_Hourly_Incremental.dtsx</Name>
      <EntryPoint>true</EntryPoint>
    </Package>
    <Package>
      <Name>Master_Finance_Close.dtsx</Name>
      <EntryPoint>true</EntryPoint>
    </Package>
    <Package>
      <Name>Master_Weekly_Reference_Load.dtsx</Name>
      <EntryPoint>true</EntryPoint>
    </Package>
    <Package>
      <Name>Master_Month_End.dtsx</Name>
      <EntryPoint>true</EntryPoint>
    </Package>
    <Package>
      <Name>Master_Weekly_Maintenance.dtsx</Name>
      <EntryPoint>true</EntryPoint>
    </Package>
    <Package>
      <Name>Master_Customer_Sync.dtsx</Name>
      <EntryPoint>true</EntryPoint>
    </Package>
    <Package>
      <Name>Master_Intraday_Inventory.dtsx</Name>
      <EntryPoint>true</EntryPoint>
    </Package>
    <Package>
      <Name>Master_File_Ingestion.dtsx</Name>
      <EntryPoint>true</EntryPoint>
    </Package>
  </Packages>
  <ConnectionManagers>
    <ConnectionManager>
      <Name>WWI_Oracle_ERP.conmgr</Name>
    </ConnectionManager>
    <ConnectionManager>
      <Name>WWI_Source_DB.conmgr</Name>
    </ConnectionManager>
    <ConnectionManager>
      <Name>WWI_Staging_DB.conmgr</Name>
    </ConnectionManager>
    <ConnectionManager>
      <Name>WWI_DW_Destination_DB.conmgr</Name>
    </ConnectionManager>
    <ConnectionManager>
      <Name>WWI_Inbound_Files.conmgr</Name>
    </ConnectionManager>
    <ConnectionManager>
      <Name>WWI_Archive_Files.conmgr</Name>
    </ConnectionManager>
    <ConnectionManager>
      <Name>WWI_Reject_Files.conmgr</Name>
    </ConnectionManager>
  </ConnectionManagers>
  <Configurations>
    <Configuration>
      <Name>Development</Name>
    </Configuration>
    <Configuration>
      <Name>Test</Name>
    </Configuration>
    <Configuration>
      <Name>Production</Name>
    </Configuration>
  </Configurations>
</Project>
