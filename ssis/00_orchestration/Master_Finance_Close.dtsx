    <DTS:Executable
      DTS:refId="Package\Read Subledger Variance"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1E6A946D-1D3E-211F-628F-68B0CB014086}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Read Subledger Variance"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT ISNULL(SUM(ABS(ra.SourceRowCount - ra.TargetRowCount)), 0) AS Variance FROM etl.RowCountAudit AS ra INNER JOIN etl.PackageExecution AS pe ON pe.PackageExecutionId = ra.PackageExecutionId WHERE pe.BatchId = ? AND ra.ObjectName IN (N'Fact.Payment', N'Fact.GL Posting');"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::SubledgerVariance" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
