        <DTS:Executable
          DTS:refId="Package.EventHandlers[OnError]\Fail Open Batch Step"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C9D44964-CDF8-C8DF-8C3A-E413C0AAA195}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Fail Open Batch Step"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="UPDATE etl.BatchStep SET Status = N'Failed', CompletedAtUtc = SYSUTCDATETIME() WHERE BatchId = ? AND Status = N'Running';"
