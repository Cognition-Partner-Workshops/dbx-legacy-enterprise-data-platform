      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT TOP (1) ConfigurationValue AS PeriodStatus FROM etl.Configuration WHERE ConfigurationKey = N'Finance.PeriodStatus' AND EnvironmentCode IN (?, N'ALL') ORDER BY EnvironmentCode DESC;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
