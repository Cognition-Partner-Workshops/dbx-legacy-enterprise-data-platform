      DTS:CreationName=""
      DTS:DTSID="{3E9E830A-DA85-9299-811C-DE7CC8FB0EE5}"
      DTS:From="Package\General Ledger"
      DTS:LogicalAnd="True"
      DTS:ObjectName="Constraint 5"
      DTS:To="Package\Subledger Tie Out" />
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Constraint 6]"
      DTS:CreationName=""
      DTS:DTSID="{58F3CD31-28FB-C976-F52A-57F58EEC490F}"
      DTS:From="Package\Subledger Tie Out"
      DTS:LogicalAnd="True"
      DTS:ObjectName="Constraint 6"
      DTS:Value="2"
      DTS:To="Package\Read Subledger Variance" />
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Constraint 7]"
      DTS:CreationName=""
      DTS:DTSID="{C63F95BF-8C6D-EC28-5C0F-41525AC4E203}"
      DTS:From="Package\Read Subledger Variance"
      DTS:LogicalAnd="True"
      DTS:ObjectName="Constraint 7"
      DTS:EvalOp="2"
      DTS:Expression="@[User::SubledgerVariance] == 0 || @[$Package::AllowCloseWithVariance]"
      DTS:To="Package\Close Aggregates" />
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Constraint 8]"
      DTS:CreationName=""
      DTS:DTSID="{71A76C5F-1A20-5771-2776-7EF96FD96B90}"
      DTS:From="Package\Read Subledger Variance"
      DTS:LogicalAnd="True"
      DTS:ObjectName="Constraint 8"
      DTS:EvalOp="2"
      DTS:Expression="@[User::SubledgerVariance] != 0 &amp;&amp; !@[$Package::AllowCloseWithVariance]"
      DTS:To="Package\Close Escalation" />
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Constraint 9]"
      DTS:CreationName=""
      DTS:DTSID="{11D92538-705E-DF70-FE3B-5738B6CA45B1}"
