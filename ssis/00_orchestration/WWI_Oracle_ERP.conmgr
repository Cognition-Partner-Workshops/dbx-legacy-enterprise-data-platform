<?xml version="1.0"?>
<DTS:ConnectionManager xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:ObjectName="WWI_Oracle_ERP"
  DTS:DTSID="{219914C8-6320-598D-C999-94A3821DDB9A}"
  DTS:CreationName="OLEDB"
  DTS:Description="Oracle ERP source (customer/supplier/product master, procurement, finance).">
  <DTS:PropertyExpression DTS:Name="ConnectionString">"Data Source=" + @[$Project::OracleHost] + ":" + (DT_WSTR, 12) @[$Project::OraclePort] + "/" + @[$Project::OracleService] + ";User ID=" + @[$Project::OracleUser] + ";Provider=" + @[$Project::OracleProvider] + ";"</DTS:PropertyExpression>
  <DTS:ObjectData>
    <DTS:ConnectionManager
      DTS:ConnectionString="Data Source=oracle-erp.internal.example:1521/WWIGERP;User ID=WWI_EXTRACT;Provider=OraOLEDB.Oracle.1;" />
  </DTS:ObjectData>
</DTS:ConnectionManager>
