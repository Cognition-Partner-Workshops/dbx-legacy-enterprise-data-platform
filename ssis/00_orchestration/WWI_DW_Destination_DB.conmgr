<?xml version="1.0"?>
<DTS:ConnectionManager xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:ObjectName="WWI_DW_Destination_DB"
  DTS:DTSID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
  DTS:CreationName="OLEDB"
  DTS:Description="WideWorldImportersDW warehouse destination.">
  <DTS:PropertyExpression DTS:Name="ServerName">@[$Project::SqlServerHost] + "," + (DT_WSTR, 12) @[$Project::SqlServerPort]</DTS:PropertyExpression>
  <DTS:PropertyExpression DTS:Name="InitialCatalog">@[$Project::SqlServerDwDb]</DTS:PropertyExpression>
  <DTS:PropertyExpression DTS:Name="UserName">@[$Project::SqlServerUser]</DTS:PropertyExpression>
  <DTS:ObjectData>
    <DTS:ConnectionManager
      DTS:ConnectionString="Data Source=sqlserver.internal.example,1433;Initial Catalog=WideWorldImportersDW;Provider=MSOLEDBSQL19.1;Auto Translate=False;Trust Server Certificate=True;" />
