  DTS:DTSID="{7159D508-B9A5-F3EC-7E8B-4F8B19FC4583}"
  DTS:Description="Moves unparsable inbound files out of the landing share into quarantine so the next ingestion run does not trip over them again. A file is quarantined when it failed a structural check, when it is zero length, or when its name does not match any known feed pattern. Every move is registered so the file can be replayed once the supplier sends a corrected copy."
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="13.0.4001.0"
  DTS:LocaleID="1033"
  DTS:ObjectName="ERR_Quarantine_BadFiles"
  DTS:PackageType="5"
  DTS:ProtectionLevel="0"
  DTS:VersionBuild="1"
  DTS:VersionGUID="{7CAE82A5-9413-05DA-7807-B00E78230B83}">
  <DTS:Property DTS:Name="PackageFormatVersion">8</DTS:Property>
