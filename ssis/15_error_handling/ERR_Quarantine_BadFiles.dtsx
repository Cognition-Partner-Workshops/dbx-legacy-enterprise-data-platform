<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationDate="6/14/2011 9:02:41 AM"
  DTS:CreationName="Microsoft.Package"
  DTS:CreatorComputerName="WWIBUILD01"
