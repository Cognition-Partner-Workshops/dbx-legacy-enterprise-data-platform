        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="UPDATE etl.BatchStep SET AttemptNumber = ? WHERE BatchId = ? AND StepStatus IN (N'Failed', N'Pending') AND ISNULL(IsRetryable, 0) = 1;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
