        SQLTask:SqlStatementSource="UPDATE etl.BatchStep SET    StepStatus = N'Failed', IsRetryable = 0,        ErrorMessage = CONCAT(ISNULL(ErrorMessage, N''), N' | retry limit reached') WHERE  BatchId = ? AND ISNULL(AttemptNumber, 1) &gt;= ? AND    StepStatus IN (N'Failed', N'Pending');"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
