            <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::MaxRetryAttempts" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
            <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RetryableStepCount" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
