  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Log Package Start"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{96FC3B55-0E93-CA83-AF5B-5378451DDAB5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Package Start"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogPackageStart @BatchId = ?, @PackageName = ?, @PackageExecutionId = ? OUTPUT;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="True"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="System::PackageName" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::PackageExecutionId" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Find Retryable Steps"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{776769EF-486C-507D-5375-96BE3C22EA42}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Find Retryable Steps"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS RetryableSteps FROM etl.BatchStep WHERE BatchId = ? AND StepStatus = N'Failed' AND ISNULL(IsRetryable, 0) = 1 AND ISNULL(AttemptNumber, 1) &lt; ?;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::MaxRetryAttempts" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RetryableStepCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Initialise Attempt Counter"
      DTS:CreationName="Microsoft.ExpressionTask"
      DTS:Description="Expression Task"
      DTS:DTSID="{60DAFDEF-227B-E135-9703-BF54E072F0FF}"
      DTS:ExecutableType="Microsoft.ExpressionTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Initialise Attempt Counter"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <ExpressionTask Expression="@[User::AttemptNumber] = 1" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Retry Sweep"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Retry sweep: backs off, resets the retryable failed steps and requests their rerun through the control framework."
      DTS:DTSID="{3DC77E92-9B77-BABA-5D69-46B1A9E074E0}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Retry Sweep">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Retry Sweep\Compute Backoff (Retry Sweep)"
          DTS:CreationName="Microsoft.ExpressionTask"
          DTS:Description="Expression Task"
          DTS:DTSID="{B02E9764-D6C9-2CC5-D7AD-B4818564828E}"
          DTS:ExecutableType="Microsoft.ExpressionTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Compute Backoff (Retry Sweep)"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <ExpressionTask Expression="@[User::BackoffSeconds] = @[$Package::BackoffBaseSeconds] * (@[User::AttemptNumber] + 1)" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Retry Sweep\Wait Backoff (Retry Sweep)"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{81691667-C585-5CEC-B8E3-399312478382}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Wait Backoff (Retry Sweep)"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="DECLARE @Delay char(8) = CONVERT(char(8), DATEADD(SECOND, ?, CAST('00:00:00' AS time)), 108); WAITFOR DELAY @Delay;"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BackoffSeconds" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Retry Sweep\Reset Steps For Retry (Retry Sweep)"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{4793279A-5A8B-AA9C-4FE8-E49EFA8C930E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Reset Steps For Retry (Retry Sweep)"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="UPDATE etl.BatchStep SET    StepStatus = N'Pending', AttemptNumber = ISNULL(AttemptNumber, 1) + 1,        EndedAtUtc = NULL WHERE  BatchId = ? AND StepStatus = N'Failed' AND ISNULL(IsRetryable, 0) = 1 AND    ISNULL(AttemptNumber, 1) &lt; ?;"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
            <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::MaxRetryAttempts" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Retry Sweep\Request Step Rerun (Retry Sweep)"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{DA254F10-EB96-7DE1-14DC-AE98A95DCABA}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Request Step Rerun (Retry Sweep)"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="INSERT INTO etl.BatchStepRerunRequest     (BatchId, BatchStepId, PackageName, AttemptNumber, RequestedAtUtc, RequestStatus) SELECT BatchId, BatchStepId, PackageName, AttemptNumber, SYSUTCDATETIME(),        N'Requested' FROM   etl.BatchStep WHERE  BatchId = ? AND StepStatus = N'Pending' AND ISNULL(IsRetryable, 0) = 1;"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Retry Sweep\Recheck Retryable Steps (Retry Sweep)"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{108FE85F-2071-9A1E-D4D7-B81E1487020D}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Recheck Retryable Steps (Retry Sweep)"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="SELECT COUNT(*) AS RetryableSteps FROM etl.BatchStep WHERE BatchId = ? AND StepStatus IN (N'Failed', N'Pending') AND ISNULL(IsRetryable, 0) = 1 AND ISNULL(AttemptNumber, 1) &lt; ?;"
            SQLTask:ResultType="ResultSetType_SingleRow"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
            <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::MaxRetryAttempts" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
            <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RetryableStepCount" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Retry Sweep.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{E92D51BF-62CE-CC71-24AE-25720D474718}"
          DTS:From="Package\Retry Sweep\Compute Backoff (Retry Sweep)"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package\Retry Sweep\Wait Backoff (Retry Sweep)" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Retry Sweep.PrecedenceConstraints[Constraint 1]"
          DTS:CreationName=""
          DTS:DTSID="{334AAA00-8CBF-AA51-AE83-9F405A686900}"
          DTS:From="Package\Retry Sweep\Wait Backoff (Retry Sweep)"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 1"
          DTS:To="Package\Retry Sweep\Reset Steps For Retry (Retry Sweep)" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Retry Sweep.PrecedenceConstraints[Constraint 2]"
          DTS:CreationName=""
          DTS:DTSID="{04100002-A9EB-5D34-BCE7-00892958D3C6}"
          DTS:From="Package\Retry Sweep\Reset Steps For Retry (Retry Sweep)"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 2"
          DTS:To="Package\Retry Sweep\Request Step Rerun (Retry Sweep)" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Retry Sweep.PrecedenceConstraints[Constraint 3]"
          DTS:CreationName=""
          DTS:DTSID="{29EFEC0B-0B29-1D31-36AA-6D1A7FE79EDD}"
          DTS:From="Package\Retry Sweep\Request Step Rerun (Retry Sweep)"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 3"
          DTS:Value="2"
          DTS:To="Package\Retry Sweep\Recheck Retryable Steps (Retry Sweep)" />
      </DTS:PrecedenceConstraints>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Retry Sweep Final"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Retry sweep: backs off, resets the retryable failed steps and requests their rerun through the control framework."
      DTS:DTSID="{3634C590-0DB6-AA09-A80B-C82D5775C2C5}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Retry Sweep Final">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Retry Sweep Final\Compute Backoff (Retry Sweep Final)"
          DTS:CreationName="Microsoft.ExpressionTask"
          DTS:Description="Expression Task"
          DTS:DTSID="{8B974D89-A350-CA99-2199-0E57FF692466}"
          DTS:ExecutableType="Microsoft.ExpressionTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Compute Backoff (Retry Sweep Final)"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <ExpressionTask Expression="@[User::BackoffSeconds] = @[$Package::BackoffBaseSeconds] * (@[User::AttemptNumber] + 1)" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Retry Sweep Final\Wait Backoff (Retry Sweep Final)"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{EAF550AC-8493-B976-8D09-DB6ED785193A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Wait Backoff (Retry Sweep Final)"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="DECLARE @Delay char(8) = CONVERT(char(8), DATEADD(SECOND, ?, CAST('00:00:00' AS time)), 108); WAITFOR DELAY @Delay;"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::BackoffSeconds" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Retry Sweep Final\Reset Steps For Retry (Retry Sweep Final)"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{535AD56A-830E-CFB5-C5D7-4AC809F99C8A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Reset Steps For Retry (Retry Sweep Final)"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="UPDATE etl.BatchStep SET    StepStatus = N'Pending', AttemptNumber = ISNULL(AttemptNumber, 1) + 1,        EndedAtUtc = NULL WHERE  BatchId = ? AND StepStatus = N'Failed' AND ISNULL(IsRetryable, 0) = 1 AND    ISNULL(AttemptNumber, 1) &lt; ?;"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
            <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::MaxRetryAttempts" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Retry Sweep Final\Request Step Rerun (Retry Sweep Final)"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B705BD8B-C844-4B61-7F75-D4DBD9376329}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Request Step Rerun (Retry Sweep Final)"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="INSERT INTO etl.BatchStepRerunRequest     (BatchId, BatchStepId, PackageName, AttemptNumber, RequestedAtUtc, RequestStatus) SELECT BatchId, BatchStepId, PackageName, AttemptNumber, SYSUTCDATETIME(),        N'Requested' FROM   etl.BatchStep WHERE  BatchId = ? AND StepStatus = N'Pending' AND ISNULL(IsRetryable, 0) = 1;"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Retry Sweep Final\Recheck Retryable Steps (Retry Sweep Final)"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B43060E0-37BC-C2F1-7F15-6F5C2D01C32A}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Recheck Retryable Steps (Retry Sweep Final)"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="SELECT COUNT(*) AS RetryableSteps FROM etl.BatchStep WHERE BatchId = ? AND StepStatus IN (N'Failed', N'Pending') AND ISNULL(IsRetryable, 0) = 1 AND ISNULL(AttemptNumber, 1) &lt; ?;"
            SQLTask:ResultType="ResultSetType_SingleRow"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
