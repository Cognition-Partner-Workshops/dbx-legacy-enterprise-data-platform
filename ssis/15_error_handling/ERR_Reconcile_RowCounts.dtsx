                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">StagingRowCount - RejectedRowCount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">StagingRowCount - RejectedRowCount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Evaluate Reconciliation\Derive Differences.Outputs[Derived Column Output].Columns[DifferenceRowCount]" dataType="i4" lineageId="Package\Evaluate Reconciliation\Derive Differences.Outputs[Derived Column Output].Columns[DifferenceRowCount]" name="DifferenceRowCount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TargetRowCount - (StagingRowCount - RejectedRowCount)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TargetRowCount - (StagingRowCount - RejectedRowCount)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Evaluate Reconciliation\Derive Differences.Outputs[Derived Column Output].Columns[DifferencePercent]" dataType="numeric" precision="18" scale="2" lineageId="Package\Evaluate Reconciliation\Derive Differences.Outputs[Derived Column Output].Columns[DifferencePercent]" name="DifferencePercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">StagingRowCount == 0 ? (DT_NUMERIC,18,2)0 : ABS(TargetRowCount - (StagingRowCount - RejectedRowCount)) * 100 / StagingRowCount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">StagingRowCount == 0 ? (DT_NUMERIC,18,2)0 : ABS(TargetRowCount - (StagingRowCount - RejectedRowCount)) * 100 / StagingRowCount</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
          <component refId="Package\Evaluate Reconciliation\Evaluate Tolerance" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Evaluate Tolerance" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\Evaluate Reconciliation\Evaluate Tolerance.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Evaluate Reconciliation\Evaluate Tolerance.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Evaluate Reconciliation\Evaluate Tolerance.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Evaluate Reconciliation\Evaluate Tolerance.Outputs[Derived Column Output].Columns[ReconciliationStatus]" dataType="wstr" length="12" lineageId="Package\Evaluate Reconciliation\Evaluate Tolerance.Outputs[Derived Column Output].Columns[ReconciliationStatus]" name="ReconciliationStatus">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ABS(TargetRowCount - (StagingRowCount - RejectedRowCount)) == 0 ? (DT_WSTR,12)"MATCHED" : (!ISNULL(ExplanationCode) ? (DT_WSTR,12)"EXPLAINED" : ((StagingRowCount == 0 ? (DT_NUMERIC,18,2)0 : ABS(TargetRowCount - (StagingRowCount - RejectedRowCount)) * 100 / StagingRowCount) &lt;= TolerancePercent ? (DT_WSTR,12)"TOLERATED" : (DT_WSTR,12)"FAILED"))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ABS(TargetRowCount - (StagingRowCount - RejectedRowCount)) == 0 ? (DT_WSTR,12)"MATCHED" : (!ISNULL(ExplanationCode) ? (DT_WSTR,12)"EXPLAINED" : ((StagingRowCount == 0 ? (DT_NUMERIC,18,2)0 : ABS(TargetRowCount - (StagingRowCount - RejectedRowCount)) * 100 / StagingRowCount) &lt;= TolerancePercent ? (DT_WSTR,12)"TOLERATED" : (DT_WSTR,12)"FAILED"))</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
