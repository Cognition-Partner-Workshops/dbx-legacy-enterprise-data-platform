    <DTS:Executable
      DTS:refId="Package\Build Reconciliation Set"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9AECDDB5-5DAE-FBE6-5617-0164CED21AD9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Reconciliation Set"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.RowCountReconciliation&#10;    (BatchId, ObjectName, SourceRowCount, StagingRowCount, TargetRowCount,&#10;     RejectedRowCount, TolerancePercent, ExplanationCode)&#10;SELECT  a.BatchId&#10;,       a.ObjectName&#10;,       MAX(CASE WHEN a.CountStage = N'Source'  THEN a.RowCount_ ELSE 0 END)&#10;,       MAX(CASE WHEN a.CountStage = N'Staging' THEN a.RowCount_ ELSE 0 END)&#10;,       MAX(CASE WHEN a.CountStage = N'Target'  THEN a.RowCount_ ELSE 0 END)&#10;,       ISNULL((SELECT COUNT(*) FROM etl.RejectedRecord AS r&#10;                WHERE r.BatchId = a.BatchId AND r.ObjectName = a.ObjectName), 0)&#10;,       ISNULL(t.TolerancePercent, ?)&#10;,       t.ExplanationCode&#10;FROM    etl.RowCountAudit AS a&#10;LEFT OUTER JOIN etl.RowCountTolerance AS t ON t.ObjectName = a.ObjectName&#10;WHERE   a.BatchId = ?&#10;GROUP BY a.BatchId, a.ObjectName, t.TolerancePercent, t.ExplanationCode;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::DefaultTolerancePercent" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
