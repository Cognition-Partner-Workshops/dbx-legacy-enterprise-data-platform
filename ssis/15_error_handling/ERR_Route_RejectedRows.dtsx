    <DTS:Executable
      DTS:refId="Package\Gather Unrouted Rejects"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{64708495-CCAA-F8E0-553D-3958527688F8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Gather Unrouted Rejects"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.RejectRoutingSet&#10;    (RejectedRecordId, BatchId, ObjectName, RejectStage, RejectReasonCode,&#10;     RejectReasonDescription, SourceKey, RejectedAtUtc, AgeDays)&#10;SELECT  r.RejectedRecordId&#10;,       r.BatchId&#10;,       r.ObjectName&#10;,       r.RejectStage&#10;,       r.RejectReasonCode&#10;,       r.RejectReason&#10;,       r.BusinessKey&#10;,       r.LoggedAtUtc&#10;,       DATEDIFF(DAY, r.LoggedAtUtc, SYSUTCDATETIME())&#10;FROM    etl.RejectedRecord AS r&#10;WHERE   r.IsReprocessed = 0&#10;AND     (? = N'ALL' OR r.ObjectName = ?)&#10;AND     NOT EXISTS (SELECT 1 FROM work.RejectRoutingHistory AS h&#10;                    WHERE h.RejectedRecordId = r.RejectedRecordId);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::ObjectScope" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::ObjectScope" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Build Reject File Name"
      DTS:CreationName="Microsoft.ExpressionTask"
      DTS:Description="Expression Task"
      DTS:DTSID="{332FD18A-38FD-90B6-AB20-086C70A18BE2}"
      DTS:ExecutableType="Microsoft.ExpressionTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Reject File Name"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <ExpressionTask Expression='@[User::RejectFileName] = "rejects_" + (DT_WSTR,20)@[$Package::BatchId] + "_" + (DT_WSTR,4)YEAR(GETDATE()) + RIGHT("0" + (DT_WSTR,2)MONTH(GETDATE()), 2) + RIGHT("0" + (DT_WSTR,2)DAY(GETDATE()), 2) + ".csv"' />
      </DTS:ObjectData>
    </DTS:Executable>
