              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT vc.ContractBusinessKey, vc.SupplierBusinessKey, vc.ContractTypeCode, vc.ContractCurrency, vc.CommittedSpendAmount, vc.RebatePercent, vc.ContractStartDate, vc.ContractEndDate, vc.GoverningLawCode, vc.RegionCode, vc.SourceRowHash FROM stg.VendorContract AS vc WHERE vc.ContractEndDate &gt;= DATEADD(YEAR, -3, GETDATE());</property>
