                <outputColumns>
                  <outputColumn refId="Package\Load Vendor Contract Versions\Derive Contract Window Attributes.Outputs[Derived Column Output].Columns[ContractStatusCode]" dataType="wstr" length="10" lineageId="Package\Load Vendor Contract Versions\Derive Contract Window Attributes.Outputs[Derived Column Output].Columns[ContractStatusCode]" name="ContractStatusCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ContractEndDate &lt; GETDATE() ? "EXPIRED" : DATEDIFF("Day", GETDATE(), ContractEndDate) &lt;= @[$Package::RenewalNoticeDays] ? "RENEWAL" : ContractStartDate &gt; GETDATE() ? "PENDING" : "ACTIVE"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ContractEndDate &lt; GETDATE() ? "EXPIRED" : DATEDIFF("Day", GETDATE(), ContractEndDate) &lt;= @[$Package::RenewalNoticeDays] ? "RENEWAL" : ContractStartDate &gt; GETDATE() ? "PENDING" : "ACTIVE"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Vendor Contract Versions\Derive Contract Window Attributes.Outputs[Derived Column Output].Columns[CommittedSpendReporting]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Vendor Contract Versions\Derive Contract Window Attributes.Outputs[Derived Column Output].Columns[CommittedSpendReporting]" name="CommittedSpendReporting">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ContractCurrency == "USD" ? CommittedSpendAmount : (DT_NUMERIC,18,2)NULL(DT_NUMERIC,18,2)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ContractCurrency == "USD" ? CommittedSpendAmount : (DT_NUMERIC,18,2)NULL(DT_NUMERIC,18,2)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Vendor Contract Versions\Derive Contract Window Attributes.Outputs[Derived Column Output].Columns[RebateTierCode]" dataType="wstr" length="2" lineageId="Package\Load Vendor Contract Versions\Derive Contract Window Attributes.Outputs[Derived Column Output].Columns[RebateTierCode]" name="RebateTierCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RebatePercent &gt;= 7.5 ? "R4" : RebatePercent &gt;= 5 ? "R3" : RebatePercent &gt;= 2.5 ? "R2" : "R1"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RebatePercent &gt;= 7.5 ? "R4" : RebatePercent &gt;= 5 ? "R3" : RebatePercent &gt;= 2.5 ? "R2" : "R1"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Vendor Contract Versions\Derive Contract Window Attributes.Outputs[Derived Column Output].Columns[GoverningLawRegion]" dataType="wstr" length="6" lineageId="Package\Load Vendor Contract Versions\Derive Contract Window Attributes.Outputs[Derived Column Output].Columns[GoverningLawRegion]" name="GoverningLawRegion">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">GoverningLawCode == "NY" || GoverningLawCode == "DE" ? "NA" : GoverningLawCode == "ENG" || GoverningLawCode == "NL" ? "EU" : "APAC"</property>
