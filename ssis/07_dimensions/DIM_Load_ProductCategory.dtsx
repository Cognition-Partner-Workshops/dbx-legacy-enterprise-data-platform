                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(ParentCategoryCode) || LEN(TRIM(ParentCategoryCode)) == 0 ? UPPER(TRIM(ProductCategoryCode)) : UPPER(TRIM(ParentCategoryCode)) + "&gt;" + UPPER(TRIM(ProductCategoryCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(ParentCategoryCode) || LEN(TRIM(ParentCategoryCode)) == 0 ? UPPER(TRIM(ProductCategoryCode)) : UPPER(TRIM(ParentCategoryCode)) + "&gt;" + UPPER(TRIM(ProductCategoryCode))</property>
