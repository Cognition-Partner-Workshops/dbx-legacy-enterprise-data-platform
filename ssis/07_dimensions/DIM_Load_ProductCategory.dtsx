    <DTS:Executable
      DTS:refId="Package\Maintain Stock Item Category Bridge"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{72199BB9-C531-08D6-0B54-D90ED218AF52}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Maintain Stock Item Category Bridge"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE b FROM [Dimension].[Stock Item Category Bridge] AS b WHERE NOT EXISTS (SELECT 1 FROM [Dimension].[Product Category] AS c                   WHERE c.[Product Category Key] = b.[Product Category Key]); INSERT INTO [Dimension].[Stock Item Category Bridge]     ([Stock Item Key], [Product Category Key], [Weighting Factor], [Lineage Key]) SELECT si.[Stock Item Key], c.[Product Category Key], 1.0, ? FROM [Dimension].[Stock Item] AS si INNER JOIN [Dimension].[Product Category] AS c     ON c.[WWI Product Category ID] = si.[Product Category Code] WHERE si.[Is Current Row] = 1   AND NOT EXISTS (SELECT 1 FROM [Dimension].[Stock Item Category Bridge] AS x                   WHERE x.[Stock Item Key] = si.[Stock Item Key]                     AND x.[Product Category Key] = c.[Product Category Key]);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
