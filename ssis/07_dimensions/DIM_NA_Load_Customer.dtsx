          <component refId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Apply NA Tax And Address Rules" usesDispositions="true">
            <inputs>
              <input refId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output].Columns[TaxNexusCode]" dataType="wstr" length="12" lineageId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output].Columns[TaxNexusCode]" name="TaxNexusCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">LEN(TRIM(BillingStateProvince)) == 0 ? @[$Package::DefaultTaxNexus] : "US-" + UPPER(SUBSTRING(TRIM(BillingStateProvince),1,2))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">LEN(TRIM(BillingStateProvince)) == 0 ? @[$Package::DefaultTaxNexus] : "US-" + UPPER(SUBSTRING(TRIM(BillingStateProvince),1,2))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output].Columns[PostalCodePlusFour]" dataType="wstr" length="10" lineageId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output].Columns[PostalCodePlusFour]" name="PostalCodePlusFour">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">FINDSTRING(BillingPostalCode,"-",1) &gt; 0 ? BillingPostalCode : LEN(TRIM(BillingPostalCode)) == 9 ? SUBSTRING(BillingPostalCode,1,5) + "-" + SUBSTRING(BillingPostalCode,6,4) : BillingPostalCode</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">FINDSTRING(BillingPostalCode,"-",1) &gt; 0 ? BillingPostalCode : LEN(TRIM(BillingPostalCode)) == 9 ? SUBSTRING(BillingPostalCode,1,5) + "-" + SUBSTRING(BillingPostalCode,6,4) : BillingPostalCode</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output].Columns[PostalCodeIsValid]" dataType="bool" lineageId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output].Columns[PostalCodeIsValid]" name="PostalCodeIsValid">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">LEN(REPLACE(TRIM(BillingPostalCode),"-","")) == 5 || LEN(REPLACE(TRIM(BillingPostalCode),"-","")) == 9</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">LEN(REPLACE(TRIM(BillingPostalCode),"-","")) == 5 || LEN(REPLACE(TRIM(BillingPostalCode),"-","")) == 9</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output].Columns[ConsentOptOut]" dataType="bool" lineageId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output].Columns[ConsentOptOut]" name="ConsentOptOut">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ConsentStatusCode == "CCPA-OUT" || ConsentStatusCode == "DNS"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ConsentStatusCode == "CCPA-OUT" || ConsentStatusCode == "DNS"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output].Columns[CreditLimitUsd]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output].Columns[CreditLimitUsd]" name="CreditLimitUsd">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">IsOnCreditHold ? (DT_NUMERIC,18,2)0 : CreditLimitAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">IsOnCreditHold ? (DT_NUMERIC,18,2)0 : CreditLimitAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output].Columns[ValidFrom]" dataType="dbTimeStamp" lineageId="Package\Load Customer NA Versions\Apply NA Tax And Address Rules.Outputs[Derived Column Output].Columns[ValidFrom]" name="ValidFrom">
