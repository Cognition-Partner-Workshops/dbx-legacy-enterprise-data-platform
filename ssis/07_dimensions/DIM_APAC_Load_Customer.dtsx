                <outputColumns>
                  <outputColumn refId="Package\Load Customer APAC Versions\Apply APAC GST And Script Rules.Outputs[Derived Column Output].Columns[GstRegistrationClean]" dataType="wstr" length="20" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\Load Customer APAC Versions\Apply APAC GST And Script Rules.Outputs[Derived Column Output].Columns[GstRegistrationClean]" name="GstRegistrationClean" truncationRowDisposition="FailComponent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">REPLACE(REPLACE(TRIM(GstRegistrationNumber)," ",""),"-","")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">REPLACE(REPLACE(TRIM(GstRegistrationNumber)," ",""),"-","")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer APAC Versions\Apply APAC GST And Script Rules.Outputs[Derived Column Output].Columns[GstRegistrationIsValid]" dataType="bool" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\Load Customer APAC Versions\Apply APAC GST And Script Rules.Outputs[Derived Column Output].Columns[GstRegistrationIsValid]" name="GstRegistrationIsValid" truncationRowDisposition="FailComponent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">CountryIsoCode == "AU" ? LEN(REPLACE(TRIM(GstRegistrationNumber)," ","")) == 11 : CountryIsoCode == "IN" ? LEN(TRIM(GstRegistrationNumber)) == 15 : CountryIsoCode == "SG" ? LEN(TRIM(GstRegistrationNumber)) &gt;= 9 : LEN(TRIM(GstRegistrationNumber)) &gt; 0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">CountryIsoCode == "AU" ? LEN(REPLACE(TRIM(GstRegistrationNumber)," ","")) == 11 : CountryIsoCode == "IN" ? LEN(TRIM(GstRegistrationNumber)) == 15 : CountryIsoCode == "SG" ? LEN(TRIM(GstRegistrationNumber)) &gt;= 9 : LEN(TRIM(GstRegistrationNumber)) &gt; 0</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer APAC Versions\Apply APAC GST And Script Rules.Outputs[Derived Column Output].Columns[CustomerNameRoman]" dataType="wstr" length="100" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\Load Customer APAC Versions\Apply APAC GST And Script Rules.Outputs[Derived Column Output].Columns[CustomerNameRoman]" name="CustomerNameRoman" truncationRowDisposition="FailComponent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">LEN(TRIM(CustomerName)) == 0 ? "UNROMANISED-" + CustomerBusinessKey : UPPER(TRIM(CustomerName))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">LEN(TRIM(CustomerName)) == 0 ? "UNROMANISED-" + CustomerBusinessKey : UPPER(TRIM(CustomerName))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer APAC Versions\Apply APAC GST And Script Rules.Outputs[Derived Column Output].Columns[PostalCodeRequired]" dataType="bool" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\Load Customer APAC Versions\Apply APAC GST And Script Rules.Outputs[Derived Column Output].Columns[PostalCodeRequired]" name="PostalCodeRequired" truncationRowDisposition="FailComponent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">CountryIsoCode != "HK" &amp;&amp; CountryIsoCode != "MO"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">CountryIsoCode != "HK" &amp;&amp; CountryIsoCode != "MO"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer APAC Versions\Apply APAC GST And Script Rules.Outputs[Derived Column Output].Columns[FiscalYearLabel]" dataType="wstr" length="6" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\Load Customer APAC Versions\Apply APAC GST And Script Rules.Outputs[Derived Column Output].Columns[FiscalYearLabel]" name="FiscalYearLabel" truncationRowDisposition="FailComponent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEPART("mm", GETDATE()) &gt;= @[$Package::FiscalYearStartMonth] ? "FY" + (DT_WSTR,4)(YEAR(GETDATE()) + 1) : "FY" + (DT_WSTR,4)YEAR(GETDATE())</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEPART("mm", GETDATE()) &gt;= @[$Package::FiscalYearStartMonth] ? "FY" + (DT_WSTR,4)(YEAR(GETDATE()) + 1) : "FY" + (DT_WSTR,4)YEAR(GETDATE())</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer APAC Versions\Apply APAC GST And Script Rules.Outputs[Derived Column Output].Columns[ConsentRegimeCode]" dataType="wstr" length="8" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\Load Customer APAC Versions\Apply APAC GST And Script Rules.Outputs[Derived Column Output].Columns[ConsentRegimeCode]" name="ConsentRegimeCode" truncationRowDisposition="FailComponent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">CountryIsoCode == "JP" ? "APPI" : CountryIsoCode == "SG" ? "PDPA" : CountryIsoCode == "AU" ? "APP" : "LOCAL"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">CountryIsoCode == "JP" ? "APPI" : CountryIsoCode == "SG" ? "PDPA" : CountryIsoCode == "AU" ? "APP" : "LOCAL"</property>
