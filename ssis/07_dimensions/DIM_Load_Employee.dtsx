                  <outputColumn refId="Package\Load Employee Versions\Derive Employment Attributes.Outputs[Derived Column Output].Columns[TenureYears]" dataType="i4" lineageId="Package\Load Employee Versions\Derive Employment Attributes.Outputs[Derived Column Output].Columns[TenureYears]" name="TenureYears">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEDIFF("Day", HireDate, ISNULL(TerminationDate) ? GETDATE() : TerminationDate) / 365</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEDIFF("Day", HireDate, ISNULL(TerminationDate) ? GETDATE() : TerminationDate) / 365</property>
