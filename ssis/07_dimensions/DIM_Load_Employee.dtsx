    <DTS:Executable
      DTS:refId="Package\Close Out Superseded Versions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{334DAD99-E57C-0E3E-D022-77BA1F89D377}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Close Out Superseded Versions"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="UPDATE prior SET prior.[Valid To] = DATEADD(SECOND, -1, current_row.[Valid From]), prior.[Is Current Row] = 0 FROM [Dimension].[Employee] AS prior INNER JOIN [Dimension].[Employee] AS current_row     ON current_row.[WWI Employee ID] = prior.[WWI Employee ID]    AND current_row.[Row Version] = prior.[Row Version] + 1 WHERE prior.[Is Current Row] = 1;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Repair Manager Keys"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{90504242-5696-41B4-D605-8D230F774B8C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Repair Manager Keys"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="UPDATE e SET e.[Manager Key] = m.[Employee Key], e.[Rekeyed By Lineage Key] = ? FROM [Dimension].[Employee] AS e INNER JOIN [Dimension].[Employee] AS m     ON m.[WWI Employee ID] = e.[Manager Employee ID] AND m.[Is Current Row] = 1 WHERE e.[Manager Key] = -1 AND e.[Is Current Row] = 1;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Rebuild Reporting Depth"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AFAAB2FD-B47A-E887-67BC-7553C8EB8729}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Rebuild Reporting Depth"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="WITH chain AS ( SELECT [Employee Key], [Manager Key], 1 AS Depth FROM [Dimension].[Employee]   WHERE [Manager Key] IN (-1, 0) AND [Is Current Row] = 1  UNION ALL  SELECT e.[Employee Key], e.[Manager Key], chain.Depth + 1  FROM [Dimension].[Employee] AS e  INNER JOIN chain ON chain.[Employee Key] = e.[Manager Key]  WHERE e.[Is Current Row] = 1) UPDATE e SET e.[Reporting Depth] = chain.Depth FROM [Dimension].[Employee] AS e INNER JOIN chain ON chain.[Employee Key] = e.[Employee Key] OPTION (MAXRECURSION 32);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
