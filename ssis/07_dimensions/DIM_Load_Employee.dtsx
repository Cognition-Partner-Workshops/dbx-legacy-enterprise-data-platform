          <component refId="Package\Load Employee Versions\Derive Employment Attributes" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Employment Attributes" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\Load Employee Versions\Derive Employment Attributes.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load Employee Versions\Derive Employment Attributes.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Employee Versions\Derive Employment Attributes.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Employee Versions\Derive Employment Attributes.Outputs[Derived Column Output].Columns[ManagerKeyResolved]" dataType="i4" lineageId="Package\Load Employee Versions\Derive Employment Attributes.Outputs[Derived Column Output].Columns[ManagerKeyResolved]" name="ManagerKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(ManagerKey) ? -1 : ManagerKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(ManagerKey) ? -1 : ManagerKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Employee Versions\Derive Employment Attributes.Outputs[Derived Column Output].Columns[EmploymentStatusCode]" dataType="wstr" length="8" lineageId="Package\Load Employee Versions\Derive Employment Attributes.Outputs[Derived Column Output].Columns[EmploymentStatusCode]" name="EmploymentStatusCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(TerminationDate) ? "ACTIVE" : TerminationDate &gt; GETDATE() ? "NOTICE" : "LEAVER"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(TerminationDate) ? "ACTIVE" : TerminationDate &gt; GETDATE() ? "NOTICE" : "LEAVER"</property>
                    </properties>
