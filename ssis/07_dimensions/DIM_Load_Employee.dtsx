                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">PayrollRegionCode == "NA" ? "SEMI-MONTHLY" : PayrollRegionCode == "EU" ? "MONTHLY-EOM" : "MONTHLY-25TH"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PayrollRegionCode == "NA" ? "SEMI-MONTHLY" : PayrollRegionCode == "EU" ? "MONTHLY-EOM" : "MONTHLY-25TH"</property>
