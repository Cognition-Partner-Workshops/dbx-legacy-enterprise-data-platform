                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "EU" ? MonetaryValueFloor * (DT_NUMERIC,18,2)1.08 : RegionCode == "APAC" ? MonetaryValueFloor * (DT_NUMERIC,18,2)0.74 : MonetaryValueFloor</property>
