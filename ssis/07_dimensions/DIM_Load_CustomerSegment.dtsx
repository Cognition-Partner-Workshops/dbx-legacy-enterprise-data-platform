                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RecencyScoreFloor &gt;= 4 &amp;&amp; FrequencyScoreFloor &gt;= 4 ? "PLATINUM" : RecencyScoreFloor &gt;= 3 ? "GOLD" : RecencyScoreFloor &gt;= 2 ? "SILVER" : "BRONZE"</property>
