                  <inputColumn refId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Inputs[Derived Column Input].Columns[BillingPostalCode]" cachedDataType="wstr" cachedLength="12" cachedName="BillingPostalCode" lineageId="Package\Load Customer EU Versions\stg Customer EU.Outputs[OLE DB Source Output].Columns[BillingPostalCode]" name="BillingPostalCode" usageType="readOnly" />
