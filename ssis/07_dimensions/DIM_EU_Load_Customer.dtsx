                  <inputColumn refId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Inputs[Derived Column Input].Columns[VatPrefix]" cachedDataType="wstr" cachedLength="2" cachedName="VatPrefix" lineageId="Package\Load Customer EU Versions\Lookup Country VAT Regime.Outputs[Lookup Match Output].Columns[VatPrefix]" name="VatPrefix" usageType="readOnly" />
                  <inputColumn refId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Inputs[Derived Column Input].Columns[FiscalYearStartMonth]" cachedDataType="i4" cachedName="FiscalYearStartMonth" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\Load Customer EU Versions\Lookup Country VAT Regime.Outputs[Lookup Match Output].Columns[FiscalYearStartMonth]" name="FiscalYearStartMonth" truncationRowDisposition="FailComponent" usageType="readWrite">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(FiscalYearStartMonth) ? 1 : FiscalYearStartMonth</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(FiscalYearStartMonth) ? 1 : FiscalYearStartMonth</property>
                    </properties>
