            <outputs>
              <output refId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Outputs[Derived Column Output].Columns[VatNumberIsWellFormed]" dataType="bool" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Outputs[Derived Column Output].Columns[VatNumberIsWellFormed]" name="VatNumberIsWellFormed" truncationRowDisposition="FailComponent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">LEN(TRIM(VatRegistrationNumber)) &gt;= 8 &amp;&amp; UPPER(SUBSTRING(TRIM(VatRegistrationNumber),1,2)) == VatPrefix</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">LEN(TRIM(VatRegistrationNumber)) &gt;= 8 &amp;&amp; UPPER(SUBSTRING(TRIM(VatRegistrationNumber),1,2)) == VatPrefix</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Outputs[Derived Column Output].Columns[IsErasureRequested]" dataType="bool" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Outputs[Derived Column Output].Columns[IsErasureRequested]" name="IsErasureRequested" truncationRowDisposition="FailComponent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">!ISNULL(ErasureRequestedDate)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">!ISNULL(ErasureRequestedDate)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Outputs[Derived Column Output].Columns[RetentionExpired]" dataType="bool" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Outputs[Derived Column Output].Columns[RetentionExpired]" name="RetentionExpired" truncationRowDisposition="FailComponent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEDIFF("Month", LastActivityDate, GETDATE()) &gt; @[$Package::RetentionMonths]</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEDIFF("Month", LastActivityDate, GETDATE()) &gt; @[$Package::RetentionMonths]</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Outputs[Derived Column Output].Columns[CustomerNamePublished]" dataType="wstr" length="100" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Outputs[Derived Column Output].Columns[CustomerNamePublished]" name="CustomerNamePublished" truncationRowDisposition="FailComponent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(!ISNULL(ErasureRequestedDate) || ConsentStatusCode == "GDPR-WITHDRAWN") ? "REDACTED-" + RIGHT(CustomerBusinessKey,6) : CustomerName</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(!ISNULL(ErasureRequestedDate) || ConsentStatusCode == "GDPR-WITHDRAWN") ? "REDACTED-" + RIGHT(CustomerBusinessKey,6) : CustomerName</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Outputs[Derived Column Output].Columns[PostalCodeNormalised]" dataType="wstr" length="12" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Outputs[Derived Column Output].Columns[PostalCodeNormalised]" name="PostalCodeNormalised" truncationRowDisposition="FailComponent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">CountryIsoCode == "NL" ? UPPER(REPLACE(TRIM(BillingPostalCode)," ","")) : CountryIsoCode == "PL" ? SUBSTRING(REPLACE(TRIM(BillingPostalCode),"-",""),1,2) + "-" + SUBSTRING(REPLACE(TRIM(BillingPostalCode),"-",""),3,3) : UPPER(TRIM(BillingPostalCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">CountryIsoCode == "NL" ? UPPER(REPLACE(TRIM(BillingPostalCode)," ","")) : CountryIsoCode == "PL" ? SUBSTRING(REPLACE(TRIM(BillingPostalCode),"-",""),1,2) + "-" + SUBSTRING(REPLACE(TRIM(BillingPostalCode),"-",""),3,3) : UPPER(TRIM(BillingPostalCode))</property>
