                  <inputColumn refId="Package\Load Customer EU Versions\Apply GDPR And VAT Rules.Inputs[Derived Column Input].Columns[ErasureRequestedDate]" cachedDataType="dbTimeStamp" cachedName="ErasureRequestedDate" lineageId="Package\Load Customer EU Versions\stg Customer EU.Outputs[OLE DB Source Output].Columns[ErasureRequestedDate]" name="ErasureRequestedDate" usageType="readOnly" />
