    <DTS:Executable
      DTS:refId="Package\Close Out Superseded Versions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{334DAD99-E57C-0E3E-D022-77BA1F89D377}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Close Out Superseded Versions"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="UPDATE prior SET prior.[Valid To] = DATEADD(SECOND, -1, current_row.[Valid From]), prior.[Is Current Row] = 0 FROM [Dimension].[City] AS prior INNER JOIN [Dimension].[City] AS current_row     ON current_row.[WWI City ID] = prior.[WWI City ID]    AND current_row.[Row Version] = prior.[Row Version] + 1 WHERE prior.[Is Current Row] = 1;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
