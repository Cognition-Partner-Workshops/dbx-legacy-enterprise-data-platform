                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ContinentName == "North America" ? "NA" : ContinentName == "Europe" ? "EU" : ContinentName == "Asia" || ContinentName == "Oceania" ? "APAC" : "ROW"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ContinentName == "North America" ? "NA" : ContinentName == "Europe" ? "EU" : ContinentName == "Asia" || ContinentName == "Oceania" ? "APAC" : "ROW"</property>
                    </properties>
