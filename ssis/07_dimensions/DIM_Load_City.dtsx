                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">CountryIsoCode == "US" ? "ZIP" : CountryIsoCode == "CA" ? "FSA" : CountryIsoCode == "GB" ? "OUTCODE" : CountryIsoCode == "JP" ? "JIS" : "GENERIC"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">CountryIsoCode == "US" ? "ZIP" : CountryIsoCode == "CA" ? "FSA" : CountryIsoCode == "GB" ? "OUTCODE" : CountryIsoCode == "JP" ? "JIS" : "GENERIC"</property>
