                <outputColumns>
                  <outputColumn refId="Package\Load City Versions\Derive Geography Attributes.Outputs[Derived Column Output].Columns[PopulationChangePercent]" dataType="i4" lineageId="Package\Load City Versions\Derive Geography Attributes.Outputs[Derived Column Output].Columns[PopulationChangePercent]" name="PopulationChangePercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CurrentPopulation) || CurrentPopulation == 0 ? 100 : (ABS(LatestRecordedPopulation - CurrentPopulation) * 100) / CurrentPopulation</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CurrentPopulation) || CurrentPopulation == 0 ? 100 : (ABS(LatestRecordedPopulation - CurrentPopulation) * 100) / CurrentPopulation</property>
