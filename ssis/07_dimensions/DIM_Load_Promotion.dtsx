    <DTS:Executable
      DTS:refId="Package\Flag Overlapping Campaigns"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{72C7CE93-F19E-48FE-3197-F16E00F385D2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Flag Overlapping Campaigns"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="UPDATE p SET p.[Has Overlapping Campaign] = 1 FROM [Dimension].[Promotion] AS p WHERE EXISTS (SELECT 1 FROM [Dimension].[Promotion] AS o               WHERE o.[Promotion Key] &lt;&gt; p.[Promotion Key]                 AND o.[Region Code] = p.[Region Code]                 AND o.[Campaign Start Date] &lt;= p.[Campaign End Date]                 AND o.[Campaign End Date] &gt;= p.[Campaign Start Date]);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
