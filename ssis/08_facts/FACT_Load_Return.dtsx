          <component refId="Package\Load Fact Return\Derive Return Measures" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Return Measures" usesDispositions="true">
            <inputs>
              <input refId="Package\Load Fact Return\Derive Return Measures.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Fact Return\Derive Return Measures.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" dataType="i4" lineageId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" name="CustomerKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[StockItemKeyResolved]" dataType="i4" lineageId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[StockItemKeyResolved]" name="StockItemKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(StockItemKey) ? 0 : StockItemKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(StockItemKey) ? 0 : StockItemKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[DaysSinceInvoice]" dataType="i4" lineageId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[DaysSinceInvoice]" name="DaysSinceInvoice">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEDIFF("Day", OriginalInvoiceDate, ReturnDate)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEDIFF("Day", OriginalInvoiceDate, ReturnDate)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[RestockingFeeAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[RestockingFeeAmount]" name="RestockingFeeAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "EU" &amp;&amp; DATEDIFF("Day", OriginalInvoiceDate, ReturnDate) &lt;= @[$Package::EuWithdrawalDays] ? (DT_NUMERIC,18,2)0 : RegionCode == "NA" &amp;&amp; DATEDIFF("Day", OriginalInvoiceDate, ReturnDate) &gt; 30 ? ((DT_NUMERIC,18,2)QuantityReturned * UnitPrice) * (DT_NUMERIC,18,2)0.15 : RegionCode == "APAC" ? (DT_NUMERIC,18,2)5.00 : (DT_NUMERIC,18,2)0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "EU" &amp;&amp; DATEDIFF("Day", OriginalInvoiceDate, ReturnDate) &lt;= @[$Package::EuWithdrawalDays] ? (DT_NUMERIC,18,2)0 : RegionCode == "NA" &amp;&amp; DATEDIFF("Day", OriginalInvoiceDate, ReturnDate) &gt; 30 ? ((DT_NUMERIC,18,2)QuantityReturned * UnitPrice) * (DT_NUMERIC,18,2)0.15 : RegionCode == "APAC" ? (DT_NUMERIC,18,2)5.00 : (DT_NUMERIC,18,2)0</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[ReversalGrossAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[ReversalGrossAmount]" name="ReversalGrossAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">((DT_NUMERIC,18,2)QuantityReturned * UnitPrice) * -1</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">((DT_NUMERIC,18,2)QuantityReturned * UnitPrice) * -1</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[ReversalCostAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[ReversalCostAmount]" name="ReversalCostAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">((DT_NUMERIC,18,2)QuantityReturned * UnitCost) * -1</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">((DT_NUMERIC,18,2)QuantityReturned * UnitCost) * -1</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[ReversalMarginAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[ReversalMarginAmount]" name="ReversalMarginAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(((DT_NUMERIC,18,2)QuantityReturned * UnitPrice) - ((DT_NUMERIC,18,2)QuantityReturned * UnitCost)) * -1</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(((DT_NUMERIC,18,2)QuantityReturned * UnitPrice) - ((DT_NUMERIC,18,2)QuantityReturned * UnitCost)) * -1</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[IsSaleable]" dataType="bool" lineageId="Package\Load Fact Return\Derive Return Measures.Outputs[Derived Column Output].Columns[IsSaleable]" name="IsSaleable">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ReturnReasonCode != "DMG" &amp;&amp; ReturnReasonCode != "EXP"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ReturnReasonCode != "DMG" &amp;&amp; ReturnReasonCode != "EXP"</property>
                    </properties>
