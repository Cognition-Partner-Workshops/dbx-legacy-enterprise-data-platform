          <component refId="Package\Load Fact Shipment\Derive Delivery Lags" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Delivery Lags" usesDispositions="true">
            <inputs>
              <input refId="Package\Load Fact Shipment\Derive Delivery Lags.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Fact Shipment\Derive Delivery Lags.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" dataType="i4" lineageId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" name="CustomerKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[MilestoneStatusCode]" dataType="wstr" length="12" lineageId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[MilestoneStatusCode]" name="MilestoneStatusCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">!ISNULL(DeliveredAt) ? "DELIVERED" : !ISNULL(CustomsClearedAt) ? "CLEARED" : !ISNULL(DispatchedAt) ? "DISPATCHED" : !ISNULL(PackedAt) ? "PACKED" : "PICKED"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">!ISNULL(DeliveredAt) ? "DELIVERED" : !ISNULL(CustomsClearedAt) ? "CLEARED" : !ISNULL(DispatchedAt) ? "DISPATCHED" : !ISNULL(PackedAt) ? "PACKED" : "PICKED"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[PickToDispatchHours]" dataType="i4" lineageId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[PickToDispatchHours]" name="PickToDispatchHours">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(DispatchedAt) ? -1 : DATEDIFF("Hour", PickedAt, DispatchedAt)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(DispatchedAt) ? -1 : DATEDIFF("Hour", PickedAt, DispatchedAt)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[DispatchToDeliveryDays]" dataType="i4" lineageId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[DispatchToDeliveryDays]" name="DispatchToDeliveryDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(DeliveredAt) || ISNULL(DispatchedAt) ? -1 : DATEDIFF("Day", DispatchedAt, DeliveredAt)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(DeliveredAt) || ISNULL(DispatchedAt) ? -1 : DATEDIFF("Day", DispatchedAt, DeliveredAt)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[CustomsHoldDays]" dataType="i4" lineageId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[CustomsHoldDays]" name="CustomsHoldDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomsClearedAt) || ISNULL(DispatchedAt) ? 0 : DATEDIFF("Day", DispatchedAt, CustomsClearedAt)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomsClearedAt) || ISNULL(DispatchedAt) ? 0 : DATEDIFF("Day", DispatchedAt, CustomsClearedAt)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[DeliveredOnTime]" dataType="bool" lineageId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[DeliveredOnTime]" name="DeliveredOnTime">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">!ISNULL(DeliveredAt) &amp;&amp; (DT_DBDATE)DeliveredAt &lt;= (DT_DBDATE)PromisedDeliveryDate</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">!ISNULL(DeliveredAt) &amp;&amp; (DT_DBDATE)DeliveredAt &lt;= (DT_DBDATE)PromisedDeliveryDate</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[DaysLate]" dataType="i4" lineageId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[DaysLate]" name="DaysLate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(DeliveredAt) ? -1 : DATEDIFF("Day", PromisedDeliveryDate, DeliveredAt)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(DeliveredAt) ? -1 : DATEDIFF("Day", PromisedDeliveryDate, DeliveredAt)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[FreightPerKg]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[FreightPerKg]" name="FreightPerKg">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ShipmentWeightKg == 0 ? (DT_NUMERIC,18,2)0 : FreightChargeAmount / (DT_NUMERIC,18,2)ShipmentWeightKg</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ShipmentWeightKg == 0 ? (DT_NUMERIC,18,2)0 : FreightChargeAmount / (DT_NUMERIC,18,2)ShipmentWeightKg</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[OrderNumberDegenerate]" dataType="wstr" length="20" lineageId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[OrderNumberDegenerate]" name="OrderNumberDegenerate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">OrderNumber</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">OrderNumber</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[LineageKey]" dataType="i8" lineageId="Package\Load Fact Shipment\Derive Delivery Lags.Outputs[Derived Column Output].Columns[LineageKey]" name="LineageKey">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">@[User::PackageExecutionId]</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">@[User::PackageExecutionId]</property>
                    </properties>
                  </outputColumn>
