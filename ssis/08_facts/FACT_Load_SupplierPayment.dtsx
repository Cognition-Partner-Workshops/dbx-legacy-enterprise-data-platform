          <component refId="Package\Load Fact Supplier Payment\Derive Settlement Measures" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Settlement Measures" usesDispositions="true">
            <inputs>
              <input refId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[SupplierKeyResolved]" dataType="i4" lineageId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[SupplierKeyResolved]" name="SupplierKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(SupplierKey) ? 0 : SupplierKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(SupplierKey) ? 0 : SupplierKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[DiscountTakenPercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[DiscountTakenPercent]" name="DiscountTakenPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">InvoiceAmount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)SettlementDiscountAmount / (DT_NUMERIC,9,4)InvoiceAmount) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">InvoiceAmount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)SettlementDiscountAmount / (DT_NUMERIC,9,4)InvoiceAmount) * 100</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[DaysToSettle]" dataType="i4" lineageId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[DaysToSettle]" name="DaysToSettle">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEDIFF("Day", InvoiceDate, SettlementDate)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEDIFF("Day", InvoiceDate, SettlementDate)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[InvoiceAmountReporting]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[InvoiceAmountReporting]" name="InvoiceAmountReporting">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">InvoiceAmount * (ISNULL(FxRateToUsd) ? (DT_NUMERIC,18,8)1 : FxRateToUsd)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">InvoiceAmount * (ISNULL(FxRateToUsd) ? (DT_NUMERIC,18,8)1 : FxRateToUsd)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[SettledAmountReporting]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[SettledAmountReporting]" name="SettledAmountReporting">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SettledAmount * (ISNULL(SettlementRateToUsd) ? (DT_NUMERIC,18,8)1 : SettlementRateToUsd)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">SettledAmount * (ISNULL(SettlementRateToUsd) ? (DT_NUMERIC,18,8)1 : SettlementRateToUsd)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[RealisedFxGainLoss]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[RealisedFxGainLoss]" name="RealisedFxGainLoss">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(InvoiceAmount * (ISNULL(FxRateToUsd) ? (DT_NUMERIC,18,8)1 : FxRateToUsd)) - (SettledAmount * (ISNULL(SettlementRateToUsd) ? (DT_NUMERIC,18,8)1 : SettlementRateToUsd))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(InvoiceAmount * (ISNULL(FxRateToUsd) ? (DT_NUMERIC,18,8)1 : FxRateToUsd)) - (SettledAmount * (ISNULL(SettlementRateToUsd) ? (DT_NUMERIC,18,8)1 : SettlementRateToUsd))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[PaymentReferenceDegenerate]" dataType="wstr" length="30" lineageId="Package\Load Fact Supplier Payment\Derive Settlement Measures.Outputs[Derived Column Output].Columns[PaymentReferenceDegenerate]" name="PaymentReferenceDegenerate">
                    <properties>
