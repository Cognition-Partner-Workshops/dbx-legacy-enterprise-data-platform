          <component refId="Package\Load Fact Credit Note\Derive Credit Measures" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Credit Measures" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\Load Fact Credit Note\Derive Credit Measures.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Fact Credit Note\Derive Credit Measures.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" dataType="i4" lineageId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" name="CustomerKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output].Columns[RestatedNetAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output].Columns[RestatedNetAmount]" name="RestatedNetAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(OriginalNetAmount) ? (DT_NUMERIC,18,2)0 : OriginalNetAmount - CreditAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(OriginalNetAmount) ? (DT_NUMERIC,18,2)0 : OriginalNetAmount - CreditAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output].Columns[CreditPercentOfOriginal]" dataType="numeric" precision="9" scale="4" lineageId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output].Columns[CreditPercentOfOriginal]" name="CreditPercentOfOriginal">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(OriginalNetAmount) || OriginalNetAmount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)CreditAmount / (DT_NUMERIC,9,4)OriginalNetAmount) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(OriginalNetAmount) || OriginalNetAmount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)CreditAmount / (DT_NUMERIC,9,4)OriginalNetAmount) * 100</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output].Columns[RequiresSecondApproval]" dataType="bool" lineageId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output].Columns[RequiresSecondApproval]" name="RequiresSecondApproval">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">CreditAmount &gt; 10000 || (ISNULL(OriginalNetAmount) ? 0 : CreditAmount) &gt; (ISNULL(OriginalNetAmount) ? (DT_NUMERIC,18,2)0 : OriginalNetAmount)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">CreditAmount &gt; 10000 || (ISNULL(OriginalNetAmount) ? 0 : CreditAmount) &gt; (ISNULL(OriginalNetAmount) ? (DT_NUMERIC,18,2)0 : OriginalNetAmount)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output].Columns[TaxAdjustmentCode]" dataType="wstr" length="14" lineageId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output].Columns[TaxAdjustmentCode]" name="TaxAdjustmentCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "NA" ? "SALESTAX-ADJ" : RegionCode == "EU" ? "VAT-CREDIT" : "GST-ADJ"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "NA" ? "SALESTAX-ADJ" : RegionCode == "EU" ? "VAT-CREDIT" : "GST-ADJ"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output].Columns[CreditNoteDegenerate]" dataType="wstr" length="20" lineageId="Package\Load Fact Credit Note\Derive Credit Measures.Outputs[Derived Column Output].Columns[CreditNoteDegenerate]" name="CreditNoteDegenerate">
