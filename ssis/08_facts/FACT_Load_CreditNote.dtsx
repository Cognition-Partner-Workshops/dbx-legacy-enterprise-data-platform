    <DTS:Executable
      DTS:refId="Package\Restate Original Sale Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B6206B0F-5B40-60A4-FD8A-3B0286DC6044}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Restate Original Sale Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="UPDATE s SET s.[Net Amount] = s.[Net Amount] - c.[Credit Amount],     s.[Tax Amount] = s.[Tax Amount] - c.[Tax Credit Amount],     s.[Margin Amount] = (s.[Net Amount] - c.[Credit Amount]) - s.[Total Cost Amount],     s.[Is Restated] = 1, s.[Restated By Lineage Key] = ? FROM [Fact].[Sale] AS s INNER JOIN [Fact].[Credit Note] AS c ON c.[Original Sale Key] = s.[Sale Key] WHERE c.[Lineage Key] = ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
