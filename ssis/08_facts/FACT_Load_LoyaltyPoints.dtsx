          <component refId="Package\Load Fact Loyalty Points\Derive Points Measures" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Points Measures" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\Load Fact Loyalty Points\Derive Points Measures.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Fact Loyalty Points\Derive Points Measures.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" dataType="i4" lineageId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" name="CustomerKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[SignedPoints]" dataType="i4" lineageId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[SignedPoints]" name="SignedPoints">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">EventTypeCode == "REDEEM" || EventTypeCode == "EXPIRE" ? PointsQuantity * -1 : PointsQuantity</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">EventTypeCode == "REDEEM" || EventTypeCode == "EXPIRE" ? PointsQuantity * -1 : PointsQuantity</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[PointCashValue]" dataType="numeric" precision="18" scale="4" lineageId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[PointCashValue]" name="PointCashValue">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "NA" ? (DT_NUMERIC,18,4)0.0100 : RegionCode == "EU" ? (DT_NUMERIC,18,4)0.0085 : (DT_NUMERIC,18,4)0.0060</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "NA" ? (DT_NUMERIC,18,4)0.0100 : RegionCode == "EU" ? (DT_NUMERIC,18,4)0.0085 : (DT_NUMERIC,18,4)0.0060</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[EarnRatePerCurrencyUnit]" dataType="numeric" precision="9" scale="4" lineageId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[EarnRatePerCurrencyUnit]" name="EarnRatePerCurrencyUnit">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "NA" ? (DT_NUMERIC,9,4)1.0 : RegionCode == "EU" ? (DT_NUMERIC,9,4)0.8 : LoyaltyProgramCode == "DBL" ? (DT_NUMERIC,9,4)2.0 : (DT_NUMERIC,9,4)1.2</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "NA" ? (DT_NUMERIC,9,4)1.0 : RegionCode == "EU" ? (DT_NUMERIC,9,4)0.8 : LoyaltyProgramCode == "DBL" ? (DT_NUMERIC,9,4)2.0 : (DT_NUMERIC,9,4)1.2</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[LiabilityAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[LiabilityAmount]" name="LiabilityAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">PointsQuantity * (RegionCode == "NA" ? (DT_NUMERIC,18,4)0.0100 : RegionCode == "EU" ? (DT_NUMERIC,18,4)0.0085 : (DT_NUMERIC,18,4)0.0060)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PointsQuantity * (RegionCode == "NA" ? (DT_NUMERIC,18,4)0.0100 : RegionCode == "EU" ? (DT_NUMERIC,18,4)0.0085 : (DT_NUMERIC,18,4)0.0060)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[ExpiryDate]" dataType="dbTimeStamp" lineageId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[ExpiryDate]" name="ExpiryDate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "EU" ? DATEADD("Month", @[$Package::ExpiryMonthsEu], EventDate) : DATEADD("Month", @[$Package::ExpiryMonthsNa], EventDate)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "EU" ? DATEADD("Month", @[$Package::ExpiryMonthsEu], EventDate) : DATEADD("Month", @[$Package::ExpiryMonthsNa], EventDate)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[SourceInvoiceDegenerate]" dataType="wstr" length="20" lineageId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[SourceInvoiceDegenerate]" name="SourceInvoiceDegenerate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SourceInvoiceNumber</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">SourceInvoiceNumber</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[LineageKey]" dataType="i8" lineageId="Package\Load Fact Loyalty Points\Derive Points Measures.Outputs[Derived Column Output].Columns[LineageKey]" name="LineageKey">
                    <properties>
