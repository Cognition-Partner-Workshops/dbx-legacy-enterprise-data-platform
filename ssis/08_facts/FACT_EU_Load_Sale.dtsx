    <DTS:Executable
      DTS:refId="Package\Retry Held Lines With Prior Day Rate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9A1E00E2-4D0B-DC79-2F40-5518E5567463}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Retry Held Lines With Prior Day Rate"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="UPDATE s SET s.FxRateToUsd = r.RateToUsd, s.FxRateSourceCode = N'PRIORDAY' FROM work.CurrencyConversionScratch AS s CROSS APPLY (SELECT TOP (1) cr.RateToUsd FROM stg.CurrencyRate AS cr              WHERE cr.CurrencyCode = s.TransactionCurrency AND cr.RateTypeCode = N'CLOSE'                AND cr.RateDate &lt; s.FxRateDate ORDER BY cr.RateDate DESC) AS r WHERE s.FxRateToUsd IS NULL;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
