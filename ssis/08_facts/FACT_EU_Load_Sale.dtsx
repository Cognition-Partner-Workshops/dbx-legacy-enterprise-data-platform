                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">!ISNULL(CustomerVatNumber) &amp;&amp; LEN(TRIM(CustomerVatNumber)) &gt; 0 &amp;&amp; CustomerCountryIsoCode != ShipToCountryIsoCode ? (DT_NUMERIC,5,2)0 : ISNULL(StandardVatRatePercent) ? (DT_NUMERIC,5,2)0 : StandardVatRatePercent</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">!ISNULL(CustomerVatNumber) &amp;&amp; LEN(TRIM(CustomerVatNumber)) &gt; 0 &amp;&amp; CustomerCountryIsoCode != ShipToCountryIsoCode ? (DT_NUMERIC,5,2)0 : ISNULL(StandardVatRatePercent) ? (DT_NUMERIC,5,2)0 : StandardVatRatePercent</property>
