                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">((DT_NUMERIC,18,2)Quantity * UnitPrice) - (((DT_NUMERIC,18,2)Quantity * UnitPrice) * (DiscountPercent / 100))</property>
