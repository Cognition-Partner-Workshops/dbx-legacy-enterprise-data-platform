                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">!ISNULL(CustomerVatNumber) &amp;&amp; LEN(TRIM(CustomerVatNumber)) &gt; 0 &amp;&amp; CustomerCountryIsoCode != ShipToCountryIsoCode</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">!ISNULL(CustomerVatNumber) &amp;&amp; LEN(TRIM(CustomerVatNumber)) &gt; 0 &amp;&amp; CustomerCountryIsoCode != ShipToCountryIsoCode</property>
