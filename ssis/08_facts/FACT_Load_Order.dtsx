          <component refId="Package\Load Fact Order\Derive Order Measures" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Order Measures" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\Load Fact Order\Derive Order Measures.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Fact Order\Derive Order Measures.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" dataType="i4" lineageId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" name="CustomerKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[StockItemKeyResolved]" dataType="i4" lineageId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[StockItemKeyResolved]" name="StockItemKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(StockItemKey) ? 0 : StockItemKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(StockItemKey) ? 0 : StockItemKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[OrderedGrossAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[OrderedGrossAmount]" name="OrderedGrossAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_NUMERIC,18,2)QuantityOrdered * UnitPrice</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_NUMERIC,18,2)QuantityOrdered * UnitPrice</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[DiscountAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[DiscountAmount]" name="DiscountAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">((DT_NUMERIC,18,2)QuantityOrdered * UnitPrice) * (DiscountPercent / 100)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">((DT_NUMERIC,18,2)QuantityOrdered * UnitPrice) * (DiscountPercent / 100)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[OrderedNetAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[OrderedNetAmount]" name="OrderedNetAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">((DT_NUMERIC,18,2)QuantityOrdered * UnitPrice) - (((DT_NUMERIC,18,2)QuantityOrdered * UnitPrice) * (DiscountPercent / 100))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">((DT_NUMERIC,18,2)QuantityOrdered * UnitPrice) - (((DT_NUMERIC,18,2)QuantityOrdered * UnitPrice) * (DiscountPercent / 100))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[QuantityOutstanding]" dataType="i4" lineageId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[QuantityOutstanding]" name="QuantityOutstanding">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">QuantityOrdered - QuantityPicked</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">QuantityOrdered - QuantityPicked</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[IsBackordered]" dataType="bool" lineageId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[IsBackordered]" name="IsBackordered">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">QuantityPicked &lt; QuantityOrdered &amp;&amp; !ISNULL(BackorderNumber) &amp;&amp; LEN(TRIM(BackorderNumber)) &gt; 0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">QuantityPicked &lt; QuantityOrdered &amp;&amp; !ISNULL(BackorderNumber) &amp;&amp; LEN(TRIM(BackorderNumber)) &gt; 0</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[FillRatePercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[FillRatePercent]" name="FillRatePercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">QuantityOrdered == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)QuantityPicked / (DT_NUMERIC,9,4)QuantityOrdered) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">QuantityOrdered == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)QuantityPicked / (DT_NUMERIC,9,4)QuantityOrdered) * 100</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[OrderNumberDegenerate]" dataType="wstr" length="20" lineageId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[OrderNumberDegenerate]" name="OrderNumberDegenerate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">OrderNumber</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">OrderNumber</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[LineageKey]" dataType="i8" lineageId="Package\Load Fact Order\Derive Order Measures.Outputs[Derived Column Output].Columns[LineageKey]" name="LineageKey">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">@[User::PackageExecutionId]</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">@[User::PackageExecutionId]</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
