                  <outputColumn refId="Package\Detect Duplicate Sale Rows\Fact Sale Recent Window.Outputs[OLE DB Source Output].Columns[InvoiceNumber]" dataType="wstr" length="20" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Detect Duplicate Sale Rows\Fact Sale Recent Window.Outputs[OLE DB Source Output].ExternalColumns[InvoiceNumber]" lineageId="Package\Detect Duplicate Sale Rows\Fact Sale Recent Window.Outputs[OLE DB Source Output].Columns[InvoiceNumber]" name="InvoiceNumber" truncationRowDisposition="RedirectRow" />
