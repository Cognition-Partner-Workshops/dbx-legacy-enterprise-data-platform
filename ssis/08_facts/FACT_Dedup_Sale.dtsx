    <DTS:Executable
      DTS:refId="Package\Archive Losing Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DF6AABB7-DF07-4477-098C-D28A5D320278}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Archive Losing Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="INSERT INTO [Fact].[Sale Duplicate Archive]     ([Sale Key], [Invoice Number], [Invoice Line Number], [Net Amount],      [Original Lineage Key], [Archived By Lineage Key], [Archived At]) SELECT f.[Sale Key], f.[Invoice Number], f.[Invoice Line Number], f.[Net Amount],        f.[Lineage Key], ?, GETDATE() FROM [Fact].[Sale] AS f WHERE EXISTS (SELECT 1 FROM [Fact].[Sale] AS d               WHERE d.[Invoice Number] = f.[Invoice Number]                 AND d.[Invoice Line Number] = f.[Invoice Line Number]                 AND d.[Lineage Key] &gt; f.[Lineage Key]);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
