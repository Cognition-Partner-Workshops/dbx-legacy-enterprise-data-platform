          <component refId="Package\Load Fact Web Session\Derive Session Attributes" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Session Attributes" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\Load Fact Web Session\Derive Session Attributes.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Fact Web Session\Derive Session Attributes.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" dataType="i4" lineageId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" name="CustomerKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output].Columns[IsAnonymous]" dataType="bool" lineageId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output].Columns[IsAnonymous]" name="IsAnonymous">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomerKey)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomerKey)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output].Columns[IsLikelyBot]" dataType="bool" lineageId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output].Columns[IsLikelyBot]" name="IsLikelyBot">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">FINDSTRING(LOWER(UserAgentFamily),"bot",1) &gt; 0 || FINDSTRING(LOWER(UserAgentFamily),"spider",1) &gt; 0 || FINDSTRING(LOWER(UserAgentFamily),"crawler",1) &gt; 0 || PageViewCount &gt; 500</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">FINDSTRING(LOWER(UserAgentFamily),"bot",1) &gt; 0 || FINDSTRING(LOWER(UserAgentFamily),"spider",1) &gt; 0 || FINDSTRING(LOWER(UserAgentFamily),"crawler",1) &gt; 0 || PageViewCount &gt; 500</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output].Columns[IsBounce]" dataType="bool" lineageId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output].Columns[IsBounce]" name="IsBounce">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">PageViewCount &lt;= 1 || SessionDurationSeconds &lt; @[$Package::MinimumSessionSeconds]</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PageViewCount &lt;= 1 || SessionDurationSeconds &lt; @[$Package::MinimumSessionSeconds]</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output].Columns[PagesPerMinute]" dataType="numeric" precision="9" scale="4" lineageId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output].Columns[PagesPerMinute]" name="PagesPerMinute">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SessionDurationSeconds == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)PageViewCount / (DT_NUMERIC,9,4)SessionDurationSeconds) * 60</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">SessionDurationSeconds == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)PageViewCount / (DT_NUMERIC,9,4)SessionDurationSeconds) * 60</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output].Columns[SessionIdDegenerate]" dataType="wstr" length="40" lineageId="Package\Load Fact Web Session\Derive Session Attributes.Outputs[Derived Column Output].Columns[SessionIdDegenerate]" name="SessionIdDegenerate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SessionBusinessKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">SessionBusinessKey</property>
                    </properties>
