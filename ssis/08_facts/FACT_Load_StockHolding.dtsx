      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE f FROM [Fact].[Stock Holding] AS f INNER JOIN Dimension.Date AS d ON d.[Date Key] = f.[Position Date Key] WHERE d.[Date] = CAST(? AS date);"
