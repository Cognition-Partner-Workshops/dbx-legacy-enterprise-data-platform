                  <outputColumn refId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[StockItemKeyResolved]" dataType="i4" lineageId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[StockItemKeyResolved]" name="StockItemKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(StockItemKey) ? 0 : StockItemKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(StockItemKey) ? 0 : StockItemKey</property>
                    </properties>
                  </outputColumn>
