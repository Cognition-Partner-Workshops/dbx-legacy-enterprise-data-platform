                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">QuantityOnHand - QuantityAllocated</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">QuantityOnHand - QuantityAllocated</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[StockValueAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[StockValueAmount]" name="StockValueAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_NUMERIC,18,2)QuantityOnHand * UnitCostAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_NUMERIC,18,2)QuantityOnHand * UnitCostAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[IsBelowReorderLevel]" dataType="bool" lineageId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[IsBelowReorderLevel]" name="IsBelowReorderLevel">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(QuantityOnHand - QuantityAllocated) &lt; ReorderLevel</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(QuantityOnHand - QuantityAllocated) &lt; ReorderLevel</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[CoverRatio]" dataType="numeric" precision="9" scale="4" lineageId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[CoverRatio]" name="CoverRatio">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TargetStockLevel == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)QuantityOnHand / (DT_NUMERIC,9,4)TargetStockLevel)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TargetStockLevel == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)QuantityOnHand / (DT_NUMERIC,9,4)TargetStockLevel)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[DaysSinceStocktake]" dataType="i4" lineageId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[DaysSinceStocktake]" name="DaysSinceStocktake">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEDIFF("Day", LastStocktakeDate, PositionDate)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEDIFF("Day", LastStocktakeDate, PositionDate)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[StockStatusCode]" dataType="wstr" length="12" lineageId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[StockStatusCode]" name="StockStatusCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">QuantityOnHand == 0 ? "OUTOFSTOCK" : (QuantityOnHand - QuantityAllocated) &lt; 0 ? "OVERSOLD" : (QuantityOnHand - QuantityAllocated) &lt; ReorderLevel ? "REORDER" : "HEALTHY"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">QuantityOnHand == 0 ? "OUTOFSTOCK" : (QuantityOnHand - QuantityAllocated) &lt; 0 ? "OVERSOLD" : (QuantityOnHand - QuantityAllocated) &lt; ReorderLevel ? "REORDER" : "HEALTHY"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[LineageKey]" dataType="i8" lineageId="Package\Load Fact Stock Holding\Derive Position Measures.Outputs[Derived Column Output].Columns[LineageKey]" name="LineageKey">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">@[User::PackageExecutionId]</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">@[User::PackageExecutionId]</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
