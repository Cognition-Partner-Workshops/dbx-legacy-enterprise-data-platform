              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT pr.ReceiptBusinessKey, pr.PurchaseOrderNumber, pr.PurchaseOrderLineNumber, pr.SupplierBusinessKey, pr.StockItemBusinessKey, pr.OrderRaisedDate, pr.GoodsReceivedDate, pr.InvoiceReceivedDate, pr.PaymentSettledDate, pr.QuantityOrdered, pr.QuantityReceived, pr.ReceivedCostAmount, pr.InvoicedAmount, pr.TransactionCurrency FROM stg.PurchaseReceipt AS pr WHERE pr.LastModifiedAt &gt; ? AND pr.LastModifiedAt &lt;= ?;</property>
