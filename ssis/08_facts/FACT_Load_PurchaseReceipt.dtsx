    <DTS:Executable
      DTS:refId="Package\Update Milestones In Place"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7C82AAF3-8B47-589F-F096-8CA4FB93E7FF}"
