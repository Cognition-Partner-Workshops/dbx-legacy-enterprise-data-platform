                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TargetFactName == "Fact.Sale" ? "REVERSAL" : "RESTATEMENT"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TargetFactName == "Fact.Sale" ? "REVERSAL" : "RESTATEMENT"</property>
