    <DTS:Executable
      DTS:refId="Package\Apply Corrections"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Reversal rows first, then in-place restatements"
      DTS:DTSID="{F6DF9A16-6F4C-4B79-F8DD-F7EAC9E06F8A}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Apply Corrections">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Apply Corrections\Write Sale Reversal And Replacement Rows"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{FDC1D4A5-D4EB-1109-DA25-D9AF37E9D9C8}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Write Sale Reversal And Replacement Rows"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
            SQLTask:SqlStatementSource="INSERT INTO [Fact].[Sale]     ([Invoice Number], [Invoice Line Number], [Customer Key], [Stock Item Key],      [Invoice Date Key], [Net Amount], [Tax Amount], [Margin Amount],      [Is Reversal], [Reverses Sale Key], [Lineage Key]) SELECT s.[Invoice Number], s.[Invoice Line Number], s.[Customer Key], s.[Stock Item Key],        s.[Invoice Date Key], s.[Net Amount] * -1, s.[Tax Amount] * -1,        s.[Margin Amount] * -1, 1, s.[Sale Key], ? FROM [Fact].[Sale] AS s INNER JOIN work.SaleLineEnriched AS c ON c.TargetFactKey = s.[Sale Key] WHERE s.[Is Reversal] = 0;"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Apply Corrections\Restate Order Rows In Place"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C16DE04A-7DD8-925B-D5C4-28A46627AFC2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Restate Order Rows In Place"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
            SQLTask:SqlStatementSource="UPDATE f SET f.[Ordered Net Amount] = c.CorrectedAmount,     f.[Customer Key] = COALESCE(NULLIF(c.CorrectedDimensionKey, 0), f.[Customer Key]),     f.[Is Restated] = 1, f.[Restated By Lineage Key] = ? FROM [Fact].[Order] AS f INNER JOIN work.OrderLineEnriched AS c ON c.TargetFactKey = f.[Order Key];"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Apply Corrections\Restate Payment Rows In Place"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{0F45933B-5549-3DDD-94CF-813DD9EB45E9}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Restate Payment Rows In Place"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
            SQLTask:SqlStatementSource="UPDATE f SET f.[Payment Amount] = c.CorrectedAmount,     f.[Unapplied Amount] = c.CorrectedAmount - f.[Allocated Amount],     f.[Is Restated] = 1, f.[Restated By Lineage Key] = ? FROM [Fact].[Payment] AS f INNER JOIN work.PaymentMatched AS c ON c.TargetFactKey = f.[Payment Key];"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Apply Corrections.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{58F2BD6A-D9A9-5706-067F-6711C45666DE}"
          DTS:From="Package\Apply Corrections\Write Sale Reversal And Replacement Rows"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package\Apply Corrections\Restate Order Rows In Place" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Apply Corrections.PrecedenceConstraints[Constraint 1]"
          DTS:CreationName=""
          DTS:DTSID="{74B12111-68BE-5F74-993E-065FE46743D4}"
          DTS:From="Package\Apply Corrections\Restate Order Rows In Place"
          DTS:LogicalAnd="True"
