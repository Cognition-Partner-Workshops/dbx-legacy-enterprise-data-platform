                <outputColumns>
                  <outputColumn refId="Package\Load Fact GL Posting\Derive Posting Measures.Outputs[Derived Column Output].Columns[GlAccountKeyResolved]" dataType="i4" lineageId="Package\Load Fact GL Posting\Derive Posting Measures.Outputs[Derived Column Output].Columns[GlAccountKeyResolved]" name="GlAccountKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(GlAccountKey) ? 0 : GlAccountKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(GlAccountKey) ? 0 : GlAccountKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact GL Posting\Derive Posting Measures.Outputs[Derived Column Output].Columns[SignedAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact GL Posting\Derive Posting Measures.Outputs[Derived Column Output].Columns[SignedAmount]" name="SignedAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DebitAmount - CreditAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DebitAmount - CreditAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact GL Posting\Derive Posting Measures.Outputs[Derived Column Output].Columns[SignedAmountReporting]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact GL Posting\Derive Posting Measures.Outputs[Derived Column Output].Columns[SignedAmountReporting]" name="SignedAmountReporting">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DebitAmount - CreditAmount) * (ISNULL(FxRateToUsd) ? (DT_NUMERIC,18,8)1 : FxRateToUsd)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DebitAmount - CreditAmount) * (ISNULL(FxRateToUsd) ? (DT_NUMERIC,18,8)1 : FxRateToUsd)</property>
