                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DebitAmount &gt; 0 ? "DR" : "CR"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DebitAmount &gt; 0 ? "DR" : "CR"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact GL Posting\Derive Posting Measures.Outputs[Derived Column Output].Columns[IsManualJournal]" dataType="bool" lineageId="Package\Load Fact GL Posting\Derive Posting Measures.Outputs[Derived Column Output].Columns[IsManualJournal]" name="IsManualJournal">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">JournalSourceCode == "MANUAL" || JournalSourceCode == "SPREAD"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">JournalSourceCode == "MANUAL" || JournalSourceCode == "SPREAD"</property>
