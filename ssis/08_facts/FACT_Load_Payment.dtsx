                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PaymentMethodCode == "ACH" || PaymentMethodCode == "SEPA" ? "ELECTRONIC" : PaymentMethodCode == "CHQ" ? "PAPER" : PaymentMethodCode == "CARD" ? "CARD" : "OTHER"</property>
