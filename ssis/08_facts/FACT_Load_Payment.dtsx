                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEDIFF("Day", PaymentDate, ValueDate)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEDIFF("Day", PaymentDate, ValueDate)</property>
