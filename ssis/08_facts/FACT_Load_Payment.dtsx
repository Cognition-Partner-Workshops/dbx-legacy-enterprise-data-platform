    <DTS:Executable
      DTS:refId="Package\Remove Reprocessed Bank Batches"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6FAB3601-5C5B-169F-BF39-E8E9CC9080C0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Remove Reprocessed Bank Batches"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="WITH ranked AS (SELECT [Payment Key],   ROW_NUMBER() OVER (PARTITION BY [Bank Reference], [Payment Date]                      ORDER BY [Lineage Key] DESC) AS rn   FROM [Fact].[Payment] WHERE [Bank Reference] IS NOT NULL) DELETE FROM [Fact].[Payment] WHERE [Payment Key] IN (SELECT [Payment Key] FROM ranked WHERE rn &gt; 1);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
