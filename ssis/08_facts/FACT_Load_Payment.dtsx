                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Payment\Derive Payment Measures.Outputs[Derived Column Output].Columns[UnappliedAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Payment\Derive Payment Measures.Outputs[Derived Column Output].Columns[UnappliedAmount]" name="UnappliedAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">PaymentAmount - AllocatedAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PaymentAmount - AllocatedAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Payment\Derive Payment Measures.Outputs[Derived Column Output].Columns[IsFullyApplied]" dataType="bool" lineageId="Package\Load Fact Payment\Derive Payment Measures.Outputs[Derived Column Output].Columns[IsFullyApplied]" name="IsFullyApplied">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">PaymentAmount == AllocatedAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PaymentAmount == AllocatedAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Payment\Derive Payment Measures.Outputs[Derived Column Output].Columns[PaymentAmountReporting]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Payment\Derive Payment Measures.Outputs[Derived Column Output].Columns[PaymentAmountReporting]" name="PaymentAmountReporting">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">PaymentAmount * (ISNULL(FxRateToUsd) ? (DT_NUMERIC,18,8)1 : FxRateToUsd)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PaymentAmount * (ISNULL(FxRateToUsd) ? (DT_NUMERIC,18,8)1 : FxRateToUsd)</property>
