                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_NUMERIC,18,2)Quantity * UnitPrice</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_NUMERIC,18,2)Quantity * UnitPrice</property>
