                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(((DT_NUMERIC,18,2)Quantity * UnitPrice) - (((DT_NUMERIC,18,2)Quantity * UnitPrice) * (DiscountPercent / 100))) - ((DT_NUMERIC,18,2)Quantity * UnitCost)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(((DT_NUMERIC,18,2)Quantity * UnitPrice) - (((DT_NUMERIC,18,2)Quantity * UnitPrice) * (DiscountPercent / 100))) - ((DT_NUMERIC,18,2)Quantity * UnitCost)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Sale APAC\Calculate APAC Measures.Outputs[Derived Column Output].Columns[MarginPercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\Load Fact Sale APAC\Calculate APAC Measures.Outputs[Derived Column Output].Columns[MarginPercent]" name="MarginPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">((DT_NUMERIC,18,2)Quantity * UnitPrice) == 0 ? (DT_NUMERIC,9,4)0 : ((((DT_NUMERIC,18,2)Quantity * UnitPrice) - ((DT_NUMERIC,18,2)Quantity * UnitCost)) / ((DT_NUMERIC,18,2)Quantity * UnitPrice)) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">((DT_NUMERIC,18,2)Quantity * UnitPrice) == 0 ? (DT_NUMERIC,9,4)0 : ((((DT_NUMERIC,18,2)Quantity * UnitPrice) - ((DT_NUMERIC,18,2)Quantity * UnitCost)) / ((DT_NUMERIC,18,2)Quantity * UnitPrice)) * 100</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Sale APAC\Calculate APAC Measures.Outputs[Derived Column Output].Columns[DistributorRebateAccrual]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Sale APAC\Calculate APAC Measures.Outputs[Derived Column Output].Columns[DistributorRebateAccrual]" name="DistributorRebateAccrual">
                    <properties>
