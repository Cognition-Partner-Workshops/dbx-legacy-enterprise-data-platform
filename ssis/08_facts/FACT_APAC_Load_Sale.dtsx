                  <outputColumn refId="Package\Load Fact Sale APAC\Calculate APAC Measures.Outputs[Derived Column Output].Columns[GstRateApplied]" dataType="numeric" precision="5" scale="2" lineageId="Package\Load Fact Sale APAC\Calculate APAC Measures.Outputs[Derived Column Output].Columns[GstRateApplied]" name="GstRateApplied">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(GstRatePercent) ? (DT_NUMERIC,5,2)0 : GstRatePercent</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(GstRatePercent) ? (DT_NUMERIC,5,2)0 : GstRatePercent</property>
