                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEPART("mm", InvoiceDate) &gt;= @[$Package::FiscalYearStartMonth] ? "FY" + (DT_WSTR,4)(YEAR(InvoiceDate) + 1) : "FY" + (DT_WSTR,4)YEAR(InvoiceDate)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEPART("mm", InvoiceDate) &gt;= @[$Package::FiscalYearStartMonth] ? "FY" + (DT_WSTR,4)(YEAR(InvoiceDate) + 1) : "FY" + (DT_WSTR,4)YEAR(InvoiceDate)</property>
                    </properties>
                  </outputColumn>
