        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::SnapshotDate" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
