    <DTS:Executable
      DTS:refId="Package\Prune Snapshots Past Retention"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E01EAAFF-4A4E-C3DD-BFB5-E5C6C21B2C51}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Prune Snapshots Past Retention"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE f FROM [Fact].[Daily Inventory Snapshot] AS f INNER JOIN Dimension.Date AS d ON d.[Date Key] = f.[Position Date Key] WHERE d.[Date] &lt; DATEADD(DAY, -1 * ?, CAST(GETDATE() AS date));"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::RetentionDays" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
