          <component refId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Snapshot Attributes" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Outputs[Derived Column Output].Columns[StockItemKeyResolved]" dataType="i4" lineageId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Outputs[Derived Column Output].Columns[StockItemKeyResolved]" name="StockItemKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(StockItemKey) ? 0 : StockItemKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(StockItemKey) ? 0 : StockItemKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Outputs[Derived Column Output].Columns[AgedStockPercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Outputs[Derived Column Output].Columns[AgedStockPercent]" name="AgedStockPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TotalQuantityOnHand == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)TotalQuantityAged / (DT_NUMERIC,9,4)TotalQuantityOnHand) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TotalQuantityOnHand == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)TotalQuantityAged / (DT_NUMERIC,9,4)TotalQuantityOnHand) * 100</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Outputs[Derived Column Output].Columns[NetStockValueAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Outputs[Derived Column Output].Columns[NetStockValueAmount]" name="NetStockValueAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TotalStockValueAmount - TotalProvisionAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TotalStockValueAmount - TotalProvisionAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Outputs[Derived Column Output].Columns[CoverBandCode]" dataType="wstr" length="12" lineageId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Outputs[Derived Column Output].Columns[CoverBandCode]" name="CoverBandCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">AverageDaysOfCover &gt;= 90 ? "OVERSTOCKED" : AverageDaysOfCover &gt;= 30 ? "COMFORTABLE" : AverageDaysOfCover &gt;= 7 ? "TIGHT" : "CRITICAL"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">AverageDaysOfCover &gt;= 90 ? "OVERSTOCKED" : AverageDaysOfCover &gt;= 30 ? "COMFORTABLE" : AverageDaysOfCover &gt;= 7 ? "TIGHT" : "CRITICAL"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Outputs[Derived Column Output].Columns[LineageKey]" dataType="i8" lineageId="Package\Build Daily Inventory Snapshot\Derive Snapshot Attributes.Outputs[Derived Column Output].Columns[LineageKey]" name="LineageKey">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">@[User::PackageExecutionId]</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">@[User::PackageExecutionId]</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
