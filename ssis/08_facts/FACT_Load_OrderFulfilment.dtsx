          <component refId="Package\Load Fact Order Fulfilment\Derive Cycle Times" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Cycle Times" usesDispositions="true">
            <inputs>
              <input refId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" dataType="i4" lineageId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" name="CustomerKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[MilestoneStatusCode]" dataType="wstr" length="12" lineageId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[MilestoneStatusCode]" name="MilestoneStatusCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">!ISNULL(CashReceivedAt) ? "CASHED" : !ISNULL(InvoicedAt) ? "INVOICED" : !ISNULL(PickedAt) ? "PICKED" : !ISNULL(AllocatedAt) ? "ALLOCATED" : "ORDERED"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">!ISNULL(CashReceivedAt) ? "CASHED" : !ISNULL(InvoicedAt) ? "INVOICED" : !ISNULL(PickedAt) ? "PICKED" : !ISNULL(AllocatedAt) ? "ALLOCATED" : "ORDERED"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[OrderToAllocateHours]" dataType="i4" lineageId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[OrderToAllocateHours]" name="OrderToAllocateHours">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(AllocatedAt) ? -1 : DATEDIFF("Hour", OrderedAt, AllocatedAt)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(AllocatedAt) ? -1 : DATEDIFF("Hour", OrderedAt, AllocatedAt)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[OrderToInvoiceDays]" dataType="i4" lineageId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[OrderToInvoiceDays]" name="OrderToInvoiceDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(InvoicedAt) ? -1 : DATEDIFF("Day", OrderedAt, InvoicedAt)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(InvoicedAt) ? -1 : DATEDIFF("Day", OrderedAt, InvoicedAt)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[InvoiceToCashDays]" dataType="i4" lineageId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[InvoiceToCashDays]" name="InvoiceToCashDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CashReceivedAt) || ISNULL(InvoicedAt) ? -1 : DATEDIFF("Day", InvoicedAt, CashReceivedAt)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CashReceivedAt) || ISNULL(InvoicedAt) ? -1 : DATEDIFF("Day", InvoicedAt, CashReceivedAt)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[OrderToCashDays]" dataType="i4" lineageId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[OrderToCashDays]" name="OrderToCashDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CashReceivedAt) ? -1 : DATEDIFF("Day", OrderedAt, CashReceivedAt)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CashReceivedAt) ? -1 : DATEDIFF("Day", OrderedAt, CashReceivedAt)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[UninvoicedAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[UninvoicedAmount]" name="UninvoicedAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">OrderNetAmount - InvoicedAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">OrderNetAmount - InvoicedAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[UncollectedAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[UncollectedAmount]" name="UncollectedAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">InvoicedAmount - CashReceivedAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">InvoicedAmount - CashReceivedAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[IsStalled]" dataType="bool" lineageId="Package\Load Fact Order Fulfilment\Derive Cycle Times.Outputs[Derived Column Output].Columns[IsStalled]" name="IsStalled">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CashReceivedAt) &amp;&amp; DATEDIFF("Day", OrderedAt, GETDATE()) &gt; @[$Package::StalledOrderDays]</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CashReceivedAt) &amp;&amp; DATEDIFF("Day", OrderedAt, GETDATE()) &gt; @[$Package::StalledOrderDays]</property>
                    </properties>
                  </outputColumn>
