              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT ofm.OrderNumber, ofm.CustomerBusinessKey, ofm.OrderedAt, ofm.AllocatedAt, ofm.PickedAt, ofm.InvoicedAt, ofm.CashReceivedAt, ofm.OrderNetAmount, ofm.InvoicedAmount, ofm.CashReceivedAmount, ofm.TransactionCurrency, ofm.RegionCode FROM stg.OrderFulfilment AS ofm WHERE ofm.LastModifiedAt &gt; ? AND ofm.LastModifiedAt &lt;= ?;</property>
