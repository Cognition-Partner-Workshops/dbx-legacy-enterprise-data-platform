    <DTS:Executable
      DTS:refId="Package\Link Reversals To Original Movements"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D71D0506-0243-4DC9-1D0D-3A960840F1C5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Link Reversals To Original Movements"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="UPDATE r SET r.[Reverses Movement Key] = o.[Movement Key], r.[Is Reversal] = 1 FROM [Fact].[Movement] AS r INNER JOIN [Fact].[Movement] AS o ON o.[WWI Movement ID] = r.[Reverses WWI Movement ID] WHERE r.[Reverses WWI Movement ID] IS NOT NULL AND r.[Reverses Movement Key] IS NULL;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Queue Late Arriving Stock Item"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{31B14482-CAA3-8336-FC36-6D38CBE5A9EB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Queue Late Arriving Stock Item"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.LateArrivingDimensionQueue     (DimensionName, BusinessKey, PlaceholderKey, SourcePackageName, QueuedAt, RetryCount) SELECT DISTINCT N'Stock Item', r.BusinessKey, 0, N'FACT_Load_Movement', GETDATE(), 0 FROM err.RejectedLookupFailure AS r WHERE r.DimensionName = N'Stock Item' AND r.PackageExecutionId = ?   AND NOT EXISTS (SELECT 1 FROM work.LateArrivingDimensionQueue AS q                   WHERE q.DimensionName = r.DimensionName AND q.BusinessKey = r.BusinessKey                     AND q.ResolvedAt IS NULL);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
