          <component refId="Package\Load Fact Supplier Transaction\Derive AP Measures" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive AP Measures" usesDispositions="true">
            <inputs>
              <input refId="Package\Load Fact Supplier Transaction\Derive AP Measures.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load Fact Supplier Transaction\Derive AP Measures.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Fact Supplier Transaction\Derive AP Measures.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Fact Supplier Transaction\Derive AP Measures.Outputs[Derived Column Output].Columns[SupplierKeyResolved]" dataType="i4" lineageId="Package\Load Fact Supplier Transaction\Derive AP Measures.Outputs[Derived Column Output].Columns[SupplierKeyResolved]" name="SupplierKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(SupplierKey) ? 0 : SupplierKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(SupplierKey) ? 0 : SupplierKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Supplier Transaction\Derive AP Measures.Outputs[Derived Column Output].Columns[SignedAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Supplier Transaction\Derive AP Measures.Outputs[Derived Column Output].Columns[SignedAmount]" name="SignedAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TransactionTypeCode == "CRN" || TransactionTypeCode == "PAY" ? TransactionAmount * -1 : TransactionAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TransactionTypeCode == "CRN" || TransactionTypeCode == "PAY" ? TransactionAmount * -1 : TransactionAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Supplier Transaction\Derive AP Measures.Outputs[Derived Column Output].Columns[PayablesAgingBucket]" dataType="wstr" length="10" lineageId="Package\Load Fact Supplier Transaction\Derive AP Measures.Outputs[Derived Column Output].Columns[PayablesAgingBucket]" name="PayablesAgingBucket">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEDIFF("Day", DueDate, GETDATE()) &lt;= 0 ? "NOTDUE" : DATEDIFF("Day", DueDate, GETDATE()) &lt;= 30 ? "1-30" : DATEDIFF("Day", DueDate, GETDATE()) &lt;= 60 ? "31-60" : "60+"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEDIFF("Day", DueDate, GETDATE()) &lt;= 0 ? "NOTDUE" : DATEDIFF("Day", DueDate, GETDATE()) &lt;= 30 ? "1-30" : DATEDIFF("Day", DueDate, GETDATE()) &lt;= 60 ? "31-60" : "60+"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Supplier Transaction\Derive AP Measures.Outputs[Derived Column Output].Columns[IsReversalCandidate]" dataType="bool" lineageId="Package\Load Fact Supplier Transaction\Derive AP Measures.Outputs[Derived Column Output].Columns[IsReversalCandidate]" name="IsReversalCandidate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">IsAccrual &amp;&amp; TransactionTypeCode == "ACC"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">IsAccrual &amp;&amp; TransactionTypeCode == "ACC"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Supplier Transaction\Derive AP Measures.Outputs[Derived Column Output].Columns[SupplierInvoiceDegenerate]" dataType="wstr" length="30" lineageId="Package\Load Fact Supplier Transaction\Derive AP Measures.Outputs[Derived Column Output].Columns[SupplierInvoiceDegenerate]" name="SupplierInvoiceDegenerate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SupplierInvoiceNumber</property>
