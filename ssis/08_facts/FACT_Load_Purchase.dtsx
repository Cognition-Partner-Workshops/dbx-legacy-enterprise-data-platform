                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SupplierRegionCode == "APAC" ? ((DT_NUMERIC,18,2)QuantityOrdered * UnitCostAmount) + FreightAmount : (DT_NUMERIC,18,2)QuantityOrdered * UnitCostAmount</property>
