    <DTS:Executable
      DTS:refId="Package\Queue Late Arriving Supplier"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9F19F702-EA76-0227-963C-84B9A1CA3EDC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Queue Late Arriving Supplier"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.LateArrivingDimensionQueue     (DimensionName, BusinessKey, PlaceholderKey, SourcePackageName, QueuedAt, RetryCount) SELECT DISTINCT N'Supplier', r.BusinessKey, 0, N'FACT_Load_Purchase', GETDATE(), 0 FROM err.RejectedLookupFailure AS r WHERE r.DimensionName = N'Supplier' AND r.PackageExecutionId = ?   AND NOT EXISTS (SELECT 1 FROM work.LateArrivingDimensionQueue AS q                   WHERE q.DimensionName = r.DimensionName AND q.BusinessKey = r.BusinessKey                     AND q.ResolvedAt IS NULL);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
