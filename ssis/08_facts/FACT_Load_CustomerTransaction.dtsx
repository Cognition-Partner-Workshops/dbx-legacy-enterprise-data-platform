          <component refId="Package\Load Fact Customer Transaction\Derive Aging Attributes" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Aging Attributes" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" dataType="i4" lineageId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[CustomerKeyResolved]" name="CustomerKeyResolved">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomerKey) ? 0 : CustomerKey</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[DaysPastDue]" dataType="i4" lineageId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[DaysPastDue]" name="DaysPastDue">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEDIFF("Day", DueDate, GETDATE())</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEDIFF("Day", DueDate, GETDATE())</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[AgingBucketCode]" dataType="wstr" length="10" lineageId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[AgingBucketCode]" name="AgingBucketCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEDIFF("Day", DueDate, GETDATE()) &lt;= 0 ? "CURRENT" : RegionCode == "EU" ? (DATEDIFF("Day", DueDate, GETDATE()) &lt;= 30 ? "1-30" : DATEDIFF("Day", DueDate, GETDATE()) &lt;= 60 ? "31-60" : "60+") : RegionCode == "APAC" ? (DATEDIFF("Day", DueDate, GETDATE()) &lt;= 60 ? "1-60" : DATEDIFF("Day", DueDate, GETDATE()) &lt;= 120 ? "61-120" : "120+") : (DATEDIFF("Day", DueDate, GETDATE()) &lt;= 30 ? "1-30" : DATEDIFF("Day", DueDate, GETDATE()) &lt;= 60 ? "31-60" : DATEDIFF("Day", DueDate, GETDATE()) &lt;= 90 ? "61-90" : "90+")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEDIFF("Day", DueDate, GETDATE()) &lt;= 0 ? "CURRENT" : RegionCode == "EU" ? (DATEDIFF("Day", DueDate, GETDATE()) &lt;= 30 ? "1-30" : DATEDIFF("Day", DueDate, GETDATE()) &lt;= 60 ? "31-60" : "60+") : RegionCode == "APAC" ? (DATEDIFF("Day", DueDate, GETDATE()) &lt;= 60 ? "1-60" : DATEDIFF("Day", DueDate, GETDATE()) &lt;= 120 ? "61-120" : "120+") : (DATEDIFF("Day", DueDate, GETDATE()) &lt;= 30 ? "1-30" : DATEDIFF("Day", DueDate, GETDATE()) &lt;= 60 ? "31-60" : DATEDIFF("Day", DueDate, GETDATE()) &lt;= 90 ? "61-90" : "90+")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[IsDebitTransaction]" dataType="bool" lineageId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[IsDebitTransaction]" name="IsDebitTransaction">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TransactionTypeCode == "INV" || TransactionTypeCode == "DBN"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TransactionTypeCode == "INV" || TransactionTypeCode == "DBN"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[SignedAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[SignedAmount]" name="SignedAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TransactionTypeCode == "INV" || TransactionTypeCode == "DBN" ? TransactionAmount : TransactionAmount * -1</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TransactionTypeCode == "INV" || TransactionTypeCode == "DBN" ? TransactionAmount : TransactionAmount * -1</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[InvoiceNumberDegenerate]" dataType="wstr" length="20" lineageId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[InvoiceNumberDegenerate]" name="InvoiceNumberDegenerate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">InvoiceNumber</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">InvoiceNumber</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[LineageKey]" dataType="i8" lineageId="Package\Load Fact Customer Transaction\Derive Aging Attributes.Outputs[Derived Column Output].Columns[LineageKey]" name="LineageKey">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">@[User::PackageExecutionId]</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">@[User::PackageExecutionId]</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
