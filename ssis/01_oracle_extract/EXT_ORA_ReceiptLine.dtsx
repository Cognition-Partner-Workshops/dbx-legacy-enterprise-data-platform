    <DTS:Executable
      DTS:refId="Package\Extract Receipt Lines"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{F92AA659-1AAD-153E-EF13-12C9E8613A3E}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Receipt Lines"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA PO_RECEIPT_LINE" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  rl.RECEIPT_LINE_ID,
        rh.RECEIPT_HDR_ID,
        rh.RECEIPT_NBR,
        rl.PO_LINE_ID,
        ph.PO_NBR,
        rh.SUPP_ID,
        rl.PRODUCT_ID,
        rh.WAREHOUSE_CD,
        rl.RECEIVED_QTY,
        rl.ACCEPTED_QTY,
        rl.RECEIVED_QTY - rl.ACCEPTED_QTY                       AS REJECTED_QTY,
        rl.UOM_CD,
        rl.UNIT_COST_AMT,
        WWI_PROC.FN_RECEIPT_VARIANCE_PCT(rl.RECEIPT_LINE_ID)    AS VARIANCE_PCT,
        rl.INSPECTION_STATUS_CD,
        rl.REJECT_REASON_CD,
        rh.RECEIPT_DT
FROM    WWI_PROC.PO_RECEIPT_LINE rl
        INNER JOIN WWI_PROC.PO_RECEIPT_HDR rh
            ON rh.RECEIPT_HDR_ID = rl.RECEIPT_HDR_ID
        INNER JOIN WWI_PROC.PURCHASE_ORDER_LINE pl
            ON pl.PO_LINE_ID = rl.PO_LINE_ID
        INNER JOIN WWI_PROC.PURCHASE_ORDER_HDR ph
            ON ph.PO_HDR_ID = pl.PO_HDR_ID
WHERE   rl.RECEIPT_LINE_ID &gt; ?
  AND   rh.RECEIPT_STATUS_CD &lt;&gt; 'VOID'
ORDER BY rl.RECEIPT_LINE_ID</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output].Columns[RECEIPT_LINE_ID]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output].ExternalColumns[RECEIPT_LINE_ID]" lineageId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output].Columns[RECEIPT_LINE_ID]" name="RECEIPT_LINE_ID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output].Columns[RECEIPT_HDR_ID]" dataType="numeric" precision="12" scale="0" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output].ExternalColumns[RECEIPT_HDR_ID]" lineageId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output].Columns[RECEIPT_HDR_ID]" name="RECEIPT_HDR_ID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output].Columns[RECEIPT_NBR]" dataType="wstr" length="20" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output].ExternalColumns[RECEIPT_NBR]" lineageId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output].Columns[RECEIPT_NBR]" name="RECEIPT_NBR" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output].Columns[PO_LINE_ID]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output].ExternalColumns[PO_LINE_ID]" lineageId="Package\Extract Receipt Lines\ORA PO_RECEIPT_LINE.Outputs[OLE DB Source Output].Columns[PO_LINE_ID]" name="PO_LINE_ID" truncationRowDisposition="RedirectRow" />
