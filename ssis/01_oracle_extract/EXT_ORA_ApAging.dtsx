      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DELETE FROM raw.OracleApInvoiceHdr WHERE RecordKind = N'AGING' AND CAST(ExtractedAtUtc AS date) = CAST(SYSUTCDATETIME() AS date);"
