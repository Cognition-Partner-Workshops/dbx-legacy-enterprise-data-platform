    <DTS:Executable
      DTS:refId="Package\Load AP Aging Snapshot"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{F31D7B61-543E-FE49-5CD3-E319EEB9D83E}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load AP Aging Snapshot"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Load AP Aging Snapshot\ORA V_AP_AGING_CURRENT" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA V_AP_AGING_CURRENT" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">2400</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  a.AP_INVOICE_ID,
        a.INVOICE_NBR,
        a.SUPP_ID,
        a.REGION_CD,
        a.CURRENCY_CD,
        a.OUTSTANDING_AMT,
        WWI_FIN.FN_CONVERT_AMOUNT(a.OUTSTANDING_AMT, a.CURRENCY_CD, 'USD', a.SNAPSHOT_DT) AS OUTSTANDING_BASE_AMT,
        TRUNC(a.SNAPSHOT_DT) - TRUNC(a.DUE_DT)          AS DAYS_PAST_DUE,
        WWI_FIN.FN_AGING_BUCKET(a.DUE_DT, a.SNAPSHOT_DT) AS AGING_BUCKET_CD,
        a.DISPUTE_FLG,
        a.DUE_DT,
        a.SNAPSHOT_DT
FROM    WWI_FIN.V_AP_AGING_CURRENT a
WHERE   a.OUTSTANDING_AMT &lt;&gt; 0</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Load AP Aging Snapshot\ORA V_AP_AGING_CURRENT.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
