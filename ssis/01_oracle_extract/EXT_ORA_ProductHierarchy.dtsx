    <DTS:Executable
      DTS:refId="Package\Load Product Hierarchy"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{2BC6393B-1753-B97C-7212-09481ED06197}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Product Hierarchy"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Load Product Hierarchy\ORA PRODUCT_HIERARCHY" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA PRODUCT_HIERARCHY" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  h.HIERARCHY_NODE_ID,
        h.PARENT_NODE_ID,
        h.HIERARCHY_CD,
        h.NODE_CD,
        h.NODE_DESC,
        LEVEL                                                   AS NODE_LEVEL,
        SYS_CONNECT_BY_PATH(h.NODE_CD, '/')                     AS NODE_PATH,
        REGEXP_SUBSTR(SYS_CONNECT_BY_PATH(h.NODE_CD, '/'), '[^/]+', 1, 1) AS LEVEL1_CD,
        REGEXP_SUBSTR(SYS_CONNECT_BY_PATH(h.NODE_CD, '/'), '[^/]+', 1, 2) AS LEVEL2_CD,
        REGEXP_SUBSTR(SYS_CONNECT_BY_PATH(h.NODE_CD, '/'), '[^/]+', 1, 3) AS LEVEL3_CD,
        CASE WHEN CONNECT_BY_ISLEAF = 1 THEN 'Y' ELSE 'N' END   AS LEAF_FLG,
        h.LAST_UPDATE_DT
FROM    WWI_MDM.PRODUCT_HIERARCHY h
WHERE   h.HIERARCHY_CD = 'MERCH'
START WITH h.PARENT_NODE_ID IS NULL
CONNECT BY PRIOR h.HIERARCHY_NODE_ID = h.PARENT_NODE_ID
ORDER SIBLINGS BY h.NODE_CD</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Load Product Hierarchy\ORA PRODUCT_HIERARCHY.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
