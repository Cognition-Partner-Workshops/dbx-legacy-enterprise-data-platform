                  <outputColumn refId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].Columns[JOURNAL_NBR]" dataType="wstr" length="20" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].ExternalColumns[JOURNAL_NBR]" lineageId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].Columns[JOURNAL_NBR]" name="JOURNAL_NBR" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].Columns[JOURNAL_SOURCE_CD]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].ExternalColumns[JOURNAL_SOURCE_CD]" lineageId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].Columns[JOURNAL_SOURCE_CD]" name="JOURNAL_SOURCE_CD" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].Columns[JOURNAL_CATEGORY_CD]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].ExternalColumns[JOURNAL_CATEGORY_CD]" lineageId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].Columns[JOURNAL_CATEGORY_CD]" name="JOURNAL_CATEGORY_CD" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].Columns[LEDGER_CD]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].ExternalColumns[LEDGER_CD]" lineageId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].Columns[LEDGER_CD]" name="LEDGER_CD" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].Columns[REGION_CD]" dataType="wstr" length="8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].ExternalColumns[REGION_CD]" lineageId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Outputs[OLE DB Source Output].Columns[REGION_CD]" name="REGION_CD" truncationRowDisposition="RedirectRow" />
