    <DTS:Executable
      DTS:refId="Package\Clear Target Window"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{91479081-024B-27DD-F252-0254E7E0BEA1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Clear Target Window"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DELETE FROM raw.OracleGlJournalLine WHERE AccountingDate &gt;= CAST(? AS date) AND AccountingDate &lt; CAST(? AS date);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::WatermarkFrom" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::WatermarkTo" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Extract GL Journal Lines"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{9C5D8D54-EA64-3152-016A-D2CD92C2D6F0}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract GL Journal Lines"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA GL_JOURNAL_LINE" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">7200</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  l.GL_JOURNAL_LINE_ID,
        h.GL_JOURNAL_HDR_ID,
        h.JOURNAL_NBR,
        h.JOURNAL_SOURCE_CD,
        h.JOURNAL_CATEGORY_CD,
        h.LEDGER_CD,
        h.REGION_CD,
        l.GL_ACCOUNT_CD,
        l.COST_CENTER_CD,
        l.PRODUCT_LINE_CD,
        l.ENTERED_DR_AMT,
        l.ENTERED_CR_AMT,
        l.ACCOUNTED_DR_AMT,
        l.ACCOUNTED_CR_AMT,
        h.CURRENCY_CD,
        WWI_REF.FN_FISCAL_PERIOD(h.ACCOUNTING_DT, h.REGION_CD) AS FISCAL_PERIOD_CD,
        ps.PERIOD_STATUS_CD,
        h.ACCOUNTING_DT,
        h.POSTED_DT
FROM    WWI_FIN.GL_JOURNAL_LINE l
        INNER JOIN WWI_FIN.GL_JOURNAL_HDR h
            ON h.GL_JOURNAL_HDR_ID = l.GL_JOURNAL_HDR_ID
        INNER JOIN WWI_FIN.GL_PERIOD_STATUS ps
            ON ps.LEDGER_CD = h.LEDGER_CD
           AND ps.FISCAL_PERIOD_CD = WWI_REF.FN_FISCAL_PERIOD(h.ACCOUNTING_DT, h.REGION_CD)
WHERE   h.ACCOUNTING_DT &gt;= TO_DATE(?, 'YYYY-MM-DD')
  AND   h.ACCOUNTING_DT &lt;  TO_DATE(?, 'YYYY-MM-DD')
  AND   h.POSTING_STATUS_CD = 'P'
  AND   ps.PERIOD_STATUS_CD IN ('O', 'C')
ORDER BY h.ACCOUNTING_DT, l.GL_JOURNAL_LINE_ID</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract GL Journal Lines\ORA GL_JOURNAL_LINE.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
