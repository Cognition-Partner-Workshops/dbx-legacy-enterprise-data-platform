    <DTS:Executable
      DTS:refId="Package\Extract Purchase Orders"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{374F6C25-7BC3-2D7B-5E4E-F7368BF25355}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Purchase Orders"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Purchase Orders\ORA V_PURCHASE_ORDER_EXTRACT" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA V_PURCHASE_ORDER_EXTRACT" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">2400</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  h.PO_HDR_ID,
        h.PO_NBR,
        h.SUPP_ID,
        h.PURCH_ORG_CD,
        h.REGION_CD,
        h.PO_TYPE_CD,
        h.PO_STATUS_CD,
        h.APPROVAL_STATUS_CD,
        h.BUYER_CD,
        h.CURRENCY_CD,
        h.PO_TOTAL_AMT,
        WWI_FIN.FN_CONVERT_AMOUNT(h.PO_TOTAL_AMT, h.CURRENCY_CD, 'USD', h.ORDER_DT) AS PO_TOTAL_BASE_AMT,
        h.INCOTERM_CD,
        h.PAYMENT_TERMS_CD,
        h.CANCEL_REASON_CD,
        h.ORDER_DT,
        h.PROMISED_DT,
        h.LAST_UPDATE_DT
FROM    WWI_PROC.V_PURCHASE_ORDER_EXTRACT h
WHERE   h.LAST_UPDATE_DT &gt;= TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')
  AND   h.LAST_UPDATE_DT &lt;  TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')
  AND   h.PO_STATUS_CD IN ('OPEN', 'PART', 'CLSD', 'CANC')
  AND   h.APPROVAL_STATUS_CD &lt;&gt; 'DRFT'
  AND   h.PURCH_ORG_CD NOT IN ('TEST', 'TRNG')</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Purchase Orders\ORA V_PURCHASE_ORDER_EXTRACT.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
