                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">VOID_FLG == "Y" || PAYMENT_AMT &lt; 0 ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">VOID_FLG == "Y" || PAYMENT_AMT &lt; 0 ? "Y" : "N"</property>
