    <DTS:Executable
      DTS:refId="Package\Extract AP Payments"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{0B5741C8-F06B-1598-3008-F1EAA324B549}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract AP Payments"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA V_AP_PAYMENT_EXTRACT" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">2400</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  p.AP_PAYMENT_ID,
        p.PAYMENT_NBR,
        p.SUPP_ID,
        p.PAYMENT_METHOD_CD,
        p.PAYMENT_STATUS_CD,
        p.BANK_ACCOUNT_CD,
        p.CURRENCY_CD,
        p.PAYMENT_AMT,
        WWI_FIN.FN_CONVERT_AMOUNT(p.PAYMENT_AMT, p.CURRENCY_CD, 'USD', p.PAYMENT_DT) AS PAYMENT_BASE_AMT,
        fx.RATE                                              AS FX_RATE,
        WWI_FIN.FN_CONVERT_AMOUNT(p.PAYMENT_AMT, p.CURRENCY_CD, 'USD', p.PAYMENT_DT)
            - WWI_FIN.FN_CONVERT_AMOUNT(p.PAYMENT_AMT, p.CURRENCY_CD, 'USD', p.INVOICE_GL_DATE)
                                                             AS FX_GAIN_LOSS_AMT,
        p.REGION_CD,
        p.VOID_FLG,
        p.PAYMENT_DT,
        p.CLEARED_DT,
        p.LAST_UPDATE_DT
FROM    WWI_FIN.V_AP_PAYMENT_EXTRACT p
        LEFT OUTER JOIN WWI_REF.FX_RATE_DAILY fx
            ON fx.FROM_CURRENCY_CD = p.CURRENCY_CD
           AND fx.TO_CURRENCY_CD = 'USD'
           AND fx.RATE_DT = TRUNC(p.PAYMENT_DT)
           AND fx.RATE_TYPE_CD = 'SPOT'
WHERE   p.LAST_UPDATE_DT &gt;= TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')
  AND   p.LAST_UPDATE_DT &lt;  TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output].Columns[AP_PAYMENT_ID]" dataType="numeric" precision="12" scale="0" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output].ExternalColumns[AP_PAYMENT_ID]" lineageId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output].Columns[AP_PAYMENT_ID]" name="AP_PAYMENT_ID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output].Columns[PAYMENT_NBR]" dataType="wstr" length="30" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output].ExternalColumns[PAYMENT_NBR]" lineageId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output].Columns[PAYMENT_NBR]" name="PAYMENT_NBR" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output].Columns[SUPP_ID]" dataType="numeric" precision="12" scale="0" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output].ExternalColumns[SUPP_ID]" lineageId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output].Columns[SUPP_ID]" name="SUPP_ID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output].Columns[PAYMENT_METHOD_CD]" dataType="wstr" length="6" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output].ExternalColumns[PAYMENT_METHOD_CD]" lineageId="Package\Extract AP Payments\ORA V_AP_PAYMENT_EXTRACT.Outputs[OLE DB Source Output].Columns[PAYMENT_METHOD_CD]" name="PAYMENT_METHOD_CD" truncationRowDisposition="RedirectRow" />
