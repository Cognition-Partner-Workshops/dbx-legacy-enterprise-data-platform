                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CLEARED_DT) ? -1 : DATEDIFF("dd", PAYMENT_DT, CLEARED_DT)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CLEARED_DT) ? -1 : DATEDIFF("dd", PAYMENT_DT, CLEARED_DT)</property>
