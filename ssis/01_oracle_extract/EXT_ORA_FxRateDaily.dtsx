                  <outputColumn refId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[REGION_CD]" dataType="wstr" length="8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].ExternalColumns[REGION_CD]" lineageId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[REGION_CD]" name="REGION_CD" truncationRowDisposition="RedirectRow" />
