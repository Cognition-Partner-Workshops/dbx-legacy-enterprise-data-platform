                  <outputColumn refId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[RATE_DT]" dataType="dbTimeStamp" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].ExternalColumns[RATE_DT]" lineageId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[RATE_DT]" name="RATE_DT" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[FROM_CURRENCY_CD]" dataType="wstr" length="3" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].ExternalColumns[FROM_CURRENCY_CD]" lineageId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[FROM_CURRENCY_CD]" name="FROM_CURRENCY_CD" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[TO_CURRENCY_CD]" dataType="wstr" length="3" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].ExternalColumns[TO_CURRENCY_CD]" lineageId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[TO_CURRENCY_CD]" name="TO_CURRENCY_CD" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[RATE_TYPE_CD]" dataType="wstr" length="8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].ExternalColumns[RATE_TYPE_CD]" lineageId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[RATE_TYPE_CD]" name="RATE_TYPE_CD" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[RATE]" dataType="numeric" precision="18" scale="8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].ExternalColumns[RATE]" lineageId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[RATE]" name="RATE" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[INVERSE_RATE]" dataType="numeric" precision="18" scale="8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].ExternalColumns[INVERSE_RATE]" lineageId="Package\Extract FX Rates\ORA FX_RATE_DAILY.Outputs[OLE DB Source Output].Columns[INVERSE_RATE]" name="INVERSE_RATE" truncationRowDisposition="RedirectRow" />
