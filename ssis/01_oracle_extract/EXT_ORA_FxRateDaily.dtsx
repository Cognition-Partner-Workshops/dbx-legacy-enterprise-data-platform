      DTS:refId="Package\Clear Rate Window"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A0F8D8A0-4CB9-1081-E4C6-D11D4E17AD0C}"
