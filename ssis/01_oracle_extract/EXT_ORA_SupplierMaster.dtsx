    <DTS:Executable
      DTS:refId="Package\Extract Supplier Master"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{2EDB7884-13F7-19BB-89A2-93E5B95795C8}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Supplier Master"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Supplier Master\ORA SUPP_MASTER" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA SUPP_MASTER" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">2400</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  s.SUPP_ID,
        s.SUPP_NBR,
        s.SUPP_NAME,
        s.SUPP_STATUS_CD,
        s.SUPP_TYPE_CD,
        s.REGION_CD,
        s.COUNTRY_CD,
        s.CURRENCY_CD,
        s.PAYMENT_TERMS_CD,
        s.PAYMENT_METHOD_CD,
        b.BANK_ACCOUNT_MASKED,
        b.BANK_COUNTRY_CD,
        s.TAX_ID_MASKED,
        s.WITHHOLDING_RULE_CD,
        s.DIVERSITY_CLASSIFICATION_CD,
        cert.QUALITY_CERT_CD,
        cert.CERT_EXPIRY_DT,
        s.LAST_TRANSACTION_DT,
        s.LAST_UPDATE_DT
FROM    WWI_MDM.SUPP_MASTER s
        LEFT OUTER JOIN WWI_MDM.V_SUPPLIER_BANK_MASKED b
            ON b.SUPP_ID = s.SUPP_ID
           AND b.PRIMARY_FLG = 'Y'
        LEFT OUTER JOIN (
            SELECT SUPP_ID,
                   MAX(QUALITY_CERT_CD) KEEP (DENSE_RANK LAST ORDER BY CERT_EXPIRY_DT) AS QUALITY_CERT_CD,
                   MAX(CERT_EXPIRY_DT)                                                 AS CERT_EXPIRY_DT
            FROM   WWI_MDM.SUPP_CERTIFICATION
            GROUP BY SUPP_ID
        ) cert ON cert.SUPP_ID = s.SUPP_ID
WHERE   s.LAST_UPDATE_DT &gt;= TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')
  AND   s.LAST_UPDATE_DT &lt;  TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')
  AND   (s.LAST_TRANSACTION_DT &gt;= ADD_MONTHS(SYSDATE, -84) OR s.SUPP_STATUS_CD = 'ACTV')
  AND   s.MERGE_TARGET_SUPP_ID IS NULL</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Supplier Master\ORA SUPP_MASTER.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].Columns[SUPP_ID]" dataType="numeric" precision="12" scale="0" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].ExternalColumns[SUPP_ID]" lineageId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].Columns[SUPP_ID]" name="SUPP_ID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].Columns[SUPP_NBR]" dataType="wstr" length="20" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].ExternalColumns[SUPP_NBR]" lineageId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].Columns[SUPP_NBR]" name="SUPP_NBR" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].Columns[SUPP_NAME]" dataType="wstr" length="200" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].ExternalColumns[SUPP_NAME]" lineageId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].Columns[SUPP_NAME]" name="SUPP_NAME" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].Columns[SUPP_STATUS_CD]" dataType="wstr" length="4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].ExternalColumns[SUPP_STATUS_CD]" lineageId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].Columns[SUPP_STATUS_CD]" name="SUPP_STATUS_CD" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].Columns[SUPP_TYPE_CD]" dataType="wstr" length="6" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].ExternalColumns[SUPP_TYPE_CD]" lineageId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].Columns[SUPP_TYPE_CD]" name="SUPP_TYPE_CD" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].Columns[REGION_CD]" dataType="wstr" length="8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].ExternalColumns[REGION_CD]" lineageId="Package\Extract Supplier Master\ORA SUPP_MASTER.Outputs[OLE DB Source Output].Columns[REGION_CD]" name="REGION_CD" truncationRowDisposition="RedirectRow" />
