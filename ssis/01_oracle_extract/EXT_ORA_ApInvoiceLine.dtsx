    <DTS:Executable
      DTS:refId="Package\Extract AP Invoice Lines"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{F2F1A82A-8054-D12B-0459-78CF7682B30B}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract AP Invoice Lines"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract AP Invoice Lines\ORA AP_INVOICE_LINE" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA AP_INVOICE_LINE" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  l.AP_INVOICE_LINE_ID,
        l.AP_INVOICE_ID,
        l.LINE_NBR,
        l.DISTRIBUTION_TYPE_CD,
        l.COST_CENTER_CD,
        l.GL_ACCOUNT_CD,
        l.PROJECT_CD,
        l.PO_LINE_ID,
        l.LINE_AMT,
        l.LINE_TAX_AMT,
        h.CURRENCY_CD,
        l.EXPENSE_CATEGORY_CD,
        l.ACCRUAL_FLG,
        h.GL_DATE
FROM    WWI_FIN.AP_INVOICE_LINE l
        INNER JOIN WWI_FIN.AP_INVOICE_HDR h
            ON h.AP_INVOICE_ID = l.AP_INVOICE_ID
WHERE   l.AP_INVOICE_LINE_ID &gt; ?
  AND   l.AP_INVOICE_LINE_ID &lt;= ?
  AND   h.INVOICE_STATUS_CD &lt;&gt; 'CANC'
ORDER BY l.AP_INVOICE_LINE_ID</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract AP Invoice Lines\ORA AP_INVOICE_LINE.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
