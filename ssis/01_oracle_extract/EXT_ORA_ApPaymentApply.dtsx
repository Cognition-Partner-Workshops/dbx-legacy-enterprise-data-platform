    <DTS:Executable
      DTS:refId="Package\Extract Payment Applications"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{AA001AFD-D808-5B1E-DEEF-2D69614793D6}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Payment Applications"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Payment Applications\ORA AP_PAYMENT_APPLY" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA AP_PAYMENT_APPLY" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  a.PAYMENT_APPLY_ID,
        a.AP_PAYMENT_ID,
        a.AP_INVOICE_ID,
        p.PAYMENT_NBR,
        i.INVOICE_NBR,
        i.SUPP_ID,
        a.APPLIED_AMT,
        a.DISCOUNT_TAKEN_AMT,
        NVL(w.WITHHELD_AMT, 0)  AS WITHHELD_AMT,
        w.WITHHOLDING_RULE_CD,
        p.CURRENCY_CD,
        a.APPLIED_DT,
        i.INVOICE_DT
FROM    WWI_FIN.AP_PAYMENT_APPLY a
        INNER JOIN WWI_FIN.AP_PAYMENT p
            ON p.AP_PAYMENT_ID = a.AP_PAYMENT_ID
        INNER JOIN WWI_FIN.AP_INVOICE_HDR i
            ON i.AP_INVOICE_ID = a.AP_INVOICE_ID
        LEFT OUTER JOIN WWI_FIN.WITHHOLDING_RULE w
            ON w.WITHHOLDING_RULE_CD = i.WITHHOLDING_RULE_CD
WHERE   a.PAYMENT_APPLY_ID &gt; ?
ORDER BY a.PAYMENT_APPLY_ID</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Payment Applications\ORA AP_PAYMENT_APPLY.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Extract Payment Applications\ORA AP_PAYMENT_APPLY.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Extract Payment Applications\ORA AP_PAYMENT_APPLY.Outputs[OLE DB Source Output].Columns[PAYMENT_APPLY_ID]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Payment Applications\ORA AP_PAYMENT_APPLY.Outputs[OLE DB Source Output].ExternalColumns[PAYMENT_APPLY_ID]" lineageId="Package\Extract Payment Applications\ORA AP_PAYMENT_APPLY.Outputs[OLE DB Source Output].Columns[PAYMENT_APPLY_ID]" name="PAYMENT_APPLY_ID" truncationRowDisposition="RedirectRow" />
