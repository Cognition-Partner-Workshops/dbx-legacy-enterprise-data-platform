                  <outputColumn refId="Package\Extract Customer Master\ORA CUST_MASTER.Outputs[OLE DB Source Output].Columns[LEGAL_ENTITY_CD]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Customer Master\ORA CUST_MASTER.Outputs[OLE DB Source Output].ExternalColumns[LEGAL_ENTITY_CD]" lineageId="Package\Extract Customer Master\ORA CUST_MASTER.Outputs[OLE DB Source Output].Columns[LEGAL_ENTITY_CD]" name="LEGAL_ENTITY_CD" truncationRowDisposition="RedirectRow" />
