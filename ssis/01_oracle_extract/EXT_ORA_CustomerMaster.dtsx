    <DTS:Executable
      DTS:refId="Package\Extract Customer Master"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{DA911D3A-FEA6-3705-72D0-345EA982BCCE}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Customer Master"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Customer Master\ORA CUST_MASTER" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA CUST_MASTER" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  c.CUST_ID,
        c.CUST_NBR,
        c.CUST_NAME,
        WWI_MDM.FN_NORMALIZE_NAME(c.CUST_NAME)          AS CUST_NAME_NORM,
        c.LEGAL_ENTITY_CD,
        c.REGION_CD,
        c.COUNTRY_CD,
        WWI_MDM.FN_CUSTOMER_STATUS(c.CUST_ID)           AS CUST_STATUS_CD,
        cl.CLASSIFICATION_CD,
        cl.BUYING_GROUP_CD,
        cl.PRICE_LIST_CD,
        cp.CREDIT_LIMIT_AMT,
        cp.CREDIT_RATING_CD,
        cp.PAYMENT_TERMS_CD,
        c.CURRENCY_CD,
        c.TAX_REGISTRATION_NBR,
        CASE
            WHEN c.REGION_CD = 'EU'
                 AND c.CONSENT_CAPTURED_DT &lt; ADD_MONTHS(SYSDATE, -24) THEN NULL
            ELSE c.MARKETING_CONSENT_FLG
        END                                             AS MARKETING_CONSENT_FLG,
        c.CONSENT_CAPTURED_DT,
        c.FIRST_ORDER_DT,
        c.LAST_UPDATE_DT,
        c.LAST_UPDATE_USER
FROM    WWI_MDM.CUST_MASTER c
        LEFT OUTER JOIN WWI_MDM.CUST_CLASSIFICATION cl
            ON cl.CUST_ID = c.CUST_ID
           AND cl.EFFECTIVE_TO_DT IS NULL
        LEFT OUTER JOIN WWI_MDM.CUST_CREDIT_PROFILE cp
            ON cp.CUST_ID = c.CUST_ID
           AND cp.PROFILE_STATUS_CD = 'CURR'
WHERE   c.LAST_UPDATE_DT &gt;= TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')
  AND   c.LAST_UPDATE_DT &lt;  TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')
  AND   c.MERGE_TARGET_CUST_ID IS NULL
ORDER BY c.CUST_ID</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Customer Master\ORA CUST_MASTER.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Extract Customer Master\ORA CUST_MASTER.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
