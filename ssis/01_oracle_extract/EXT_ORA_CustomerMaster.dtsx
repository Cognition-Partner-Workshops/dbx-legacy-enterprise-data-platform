                  <outputColumn refId="Package\Extract Customer Master\ORA CUST_MASTER.Outputs[OLE DB Source Output].Columns[CUST_ID]" dataType="numeric" precision="12" scale="0" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Customer Master\ORA CUST_MASTER.Outputs[OLE DB Source Output].ExternalColumns[CUST_ID]" lineageId="Package\Extract Customer Master\ORA CUST_MASTER.Outputs[OLE DB Source Output].Columns[CUST_ID]" name="CUST_ID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Customer Master\ORA CUST_MASTER.Outputs[OLE DB Source Output].Columns[CUST_NBR]" dataType="wstr" length="20" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Customer Master\ORA CUST_MASTER.Outputs[OLE DB Source Output].ExternalColumns[CUST_NBR]" lineageId="Package\Extract Customer Master\ORA CUST_MASTER.Outputs[OLE DB Source Output].Columns[CUST_NBR]" name="CUST_NBR" truncationRowDisposition="RedirectRow" />
