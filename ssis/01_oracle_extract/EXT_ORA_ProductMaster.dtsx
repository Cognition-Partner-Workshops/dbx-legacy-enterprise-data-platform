                  <outputColumn refId="Package\Extract Product Master\ORA PRODUCT_MASTER.Outputs[OLE DB Source Output].Columns[PRODUCT_DESC]" dataType="wstr" length="200" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Product Master\ORA PRODUCT_MASTER.Outputs[OLE DB Source Output].ExternalColumns[PRODUCT_DESC]" lineageId="Package\Extract Product Master\ORA PRODUCT_MASTER.Outputs[OLE DB Source Output].Columns[PRODUCT_DESC]" name="PRODUCT_DESC" truncationRowDisposition="RedirectRow" />
