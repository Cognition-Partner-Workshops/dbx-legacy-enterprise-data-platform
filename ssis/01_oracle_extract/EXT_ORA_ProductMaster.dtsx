                  <outputColumn refId="Package\Extract Product Master\ORA PRODUCT_MASTER.Outputs[OLE DB Source Output].Columns[CATEGORY_DESC]" dataType="wstr" length="100" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Product Master\ORA PRODUCT_MASTER.Outputs[OLE DB Source Output].ExternalColumns[CATEGORY_DESC]" lineageId="Package\Extract Product Master\ORA PRODUCT_MASTER.Outputs[OLE DB Source Output].Columns[CATEGORY_DESC]" name="CATEGORY_DESC" truncationRowDisposition="RedirectRow" />
