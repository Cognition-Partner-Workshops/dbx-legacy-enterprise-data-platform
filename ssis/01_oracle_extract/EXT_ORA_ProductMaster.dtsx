    <DTS:Executable
      DTS:refId="Package\Detect Obsoleted Products"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{015123C1-476F-3936-3766-0DEBC75D6750}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Detect Obsoleted Products"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Detect Obsoleted Products\ORA CHANGE_LOG Product Deletes" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA CHANGE_LOG Product Deletes" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  TO_NUMBER(cg.PRIMARY_KEY_VALUE) AS PRODUCT_ID,
        cg.SECONDARY_KEY_VALUE          AS PRODUCT_CD,
        cg.CHANGE_DT                    AS LAST_UPDATE_DT
FROM    WWI_AUDIT.CHANGE_LOG cg
WHERE   cg.TABLE_NAME = 'PRODUCT_MASTER'
  AND   cg.OPERATION_CD IN ('D', 'O')
  AND   cg.CHANGE_DT &gt;= TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Detect Obsoleted Products\ORA CHANGE_LOG Product Deletes.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Detect Obsoleted Products\ORA CHANGE_LOG Product Deletes.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
