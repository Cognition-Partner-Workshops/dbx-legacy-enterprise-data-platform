    <DTS:Executable
      DTS:refId="Package\Assign Surrogate Keys"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DE9BA9C4-B8D7-9C6E-423D-16E37B1DE647}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Assign Surrogate Keys"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="UPDATE cc SET CostCenterKey = x.NewKey FROM raw.OracleCostCenter AS cc CROSS APPLY (SELECT ROW_NUMBER() OVER (ORDER BY cc.CostCenterCode) AS NewKey) AS x;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
