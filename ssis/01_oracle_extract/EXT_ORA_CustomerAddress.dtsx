    <DTS:Executable
      DTS:refId="Package\Extract Customer Addresses"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{2D98EE30-3EF2-6B2F-F94E-500A569083DE}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Customer Addresses"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Customer Addresses\ORA V_CUSTOMER_ADDRESS_CURRENT" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA V_CUSTOMER_ADDRESS_CURRENT" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  a.ADDRESS_ID,
        a.CUST_ID,
        a.ADDRESS_TYPE_CD,
        a.ADDRESS_LINE_1,
        a.ADDRESS_LINE_2,
        a.CITY_NAME,
        a.STATE_PROVINCE_CD,
        CASE a.REGION_CD
            WHEN 'NA'   THEN REGEXP_REPLACE(a.POSTAL_CD, '^([0-9]{5})([0-9]{4})$', '\1-\2')
            WHEN 'EU'   THEN UPPER(REPLACE(a.POSTAL_CD, ' ', ''))
            WHEN 'APAC' THEN TRIM(a.POSTAL_CD)
            ELSE a.POSTAL_CD
        END                                     AS POSTAL_CD,
        a.COUNTRY_CD,
        a.REGION_CD,
        a.VALIDATION_STATUS_CD,
        a.EFFECTIVE_FROM_DT,
        a.LAST_UPDATE_DT
FROM    WWI_MDM.V_CUSTOMER_ADDRESS_CURRENT a
WHERE   a.LAST_UPDATE_DT &gt;= TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')
  AND   a.LAST_UPDATE_DT &lt;  TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')
  AND   a.ADDRESS_TYPE_CD IN ('BILL', 'SHIP', 'STMT')</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Customer Addresses\ORA V_CUSTOMER_ADDRESS_CURRENT.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Extract Customer Addresses\ORA V_CUSTOMER_ADDRESS_CURRENT.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Extract Customer Addresses\ORA V_CUSTOMER_ADDRESS_CURRENT.Outputs[OLE DB Source Output].Columns[ADDRESS_ID]" dataType="numeric" precision="12" scale="0" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Customer Addresses\ORA V_CUSTOMER_ADDRESS_CURRENT.Outputs[OLE DB Source Output].ExternalColumns[ADDRESS_ID]" lineageId="Package\Extract Customer Addresses\ORA V_CUSTOMER_ADDRESS_CURRENT.Outputs[OLE DB Source Output].Columns[ADDRESS_ID]" name="ADDRESS_ID" truncationRowDisposition="RedirectRow" />
