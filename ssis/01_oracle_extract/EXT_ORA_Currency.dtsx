          <component refId="Package\Load Currencies\ORA V_CURRENCY_EXTRACT" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA V_CURRENCY_EXTRACT" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">300</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  c.CURRENCY_CD,
        c.CURRENCY_NAME,
        c.CURRENCY_SYMBOL,
        c.MINOR_UNIT_DIGITS,
        c.ISO_NUMERIC_CD,
        c.ACTIVE_FLG,
        CASE c.PRIMARY_REGION_CD
            WHEN 'NA'   THEN 'USD'
            WHEN 'EU'   THEN 'EUR'
            WHEN 'APAC' THEN 'SGD'
            ELSE 'USD'
        END                     AS REPORTING_CURRENCY_CD,
        c.PRIMARY_REGION_CD     AS REGION_CD,
        c.LAST_UPDATE_DT
FROM    WWI_REF.V_CURRENCY_EXTRACT c</property>
