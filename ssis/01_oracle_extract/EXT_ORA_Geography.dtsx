    <DTS:Executable
      DTS:refId="Package\Load Geography"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{99E78616-6DA7-8365-B0F8-2D2B110A36E0}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Geography"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Load Geography\ORA V_GEOGRAPHY_EXTRACT" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA V_GEOGRAPHY_EXTRACT" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  g.GEOGRAPHY_KEY                    AS GeographyKey,
        g.COUNTRY_CD,
        g.COUNTRY_NAME,
        g.REGION_CD,
        g.SUBREGION_CD,
        g.STATE_PROVINCE_CD,
        g.STATE_PROVINCE_NAME,
        g.CITY_NAME,
        CASE g.REGION_CD
            WHEN 'NA'   THEN REGEXP_REPLACE(g.POSTAL_CD, '^([0-9]{5})([0-9]{4})$', '\1-\2')
            WHEN 'EU'   THEN UPPER(REPLACE(g.POSTAL_CD, ' ', ''))
            ELSE UPPER(TRIM(g.POSTAL_CD))
        END                                 AS POSTAL_CD,
        CASE g.REGION_CD
            WHEN 'NA'   THEN 'ZIP5_PLUS4'
            WHEN 'EU'   THEN 'ALPHANUM'
            WHEN 'APAC' THEN 'NUMERIC6'
            ELSE 'FREEFORM'
        END                                 AS POSTAL_FORMAT_CD,
        g.TIME_ZONE_CD,
        g.LATITUDE,
        g.LONGITUDE
FROM    WWI_REF.V_GEOGRAPHY_EXTRACT g
WHERE   g.ACTIVE_FLG = 'Y'</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Load Geography\ORA V_GEOGRAPHY_EXTRACT.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
