                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TAX_TREATMENT_CD == "VAT" &amp;&amp; RECOVERABLE_TAX_AMT &gt; 0 ? "Y" : "N"</property>
