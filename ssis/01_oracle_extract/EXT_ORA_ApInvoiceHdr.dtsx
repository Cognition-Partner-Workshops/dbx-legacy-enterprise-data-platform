    <DTS:Executable
      DTS:refId="Package\Extract AP Invoice Headers"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{CE860517-8EC9-5364-DAF9-E2682AE0BA69}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract AP Invoice Headers"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="ORA V_AP_INVOICE_EXTRACT" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  i.AP_INVOICE_ID,
        i.INVOICE_NBR,
        i.SUPP_ID,
        i.LEGAL_ENTITY_CD,
        i.REGION_CD,
        i.INVOICE_TYPE_CD,
        i.INVOICE_STATUS_CD,
        i.CURRENCY_CD,
        i.INVOICE_AMT,
        WWI_FIN.FN_TAX_AMOUNT(i.AP_INVOICE_ID)  AS TAX_AMT,
        CASE i.REGION_CD
            WHEN 'EU'   THEN i.RECOVERABLE_VAT_AMT
            ELSE 0
        END                                     AS RECOVERABLE_TAX_AMT,
        CASE i.REGION_CD
            WHEN 'EU'   THEN i.NON_RECOVERABLE_VAT_AMT
            WHEN 'NA'   THEN i.SALES_TAX_AMT
            WHEN 'APAC' THEN i.GST_AMT
            ELSE 0
        END                                     AS NON_RECOVERABLE_TAX_AMT,
        CASE i.REGION_CD
            WHEN 'NA'   THEN 'SALESTAX'
            WHEN 'EU'   THEN 'VAT'
            WHEN 'APAC' THEN 'GST'
            ELSE 'NONE'
        END                                     AS TAX_TREATMENT_CD,
        i.TAX_REGISTRATION_NBR,
        WWI_FIN.FN_CONVERT_AMOUNT(i.INVOICE_AMT, i.CURRENCY_CD, 'USD', i.GL_DATE) AS BASE_AMT,
        i.PAYMENT_TERMS_CD,
        i.INVOICE_DT,
        WWI_FIN.FN_DUE_DATE(i.INVOICE_DT, i.PAYMENT_TERMS_CD) AS DUE_DT,
        i.GL_DATE,
        i.LAST_UPDATE_DT
FROM    WWI_FIN.V_AP_INVOICE_EXTRACT i
WHERE   i.LAST_UPDATE_DT &gt;= TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')
  AND   i.LAST_UPDATE_DT &lt;  TO_DATE(?, 'YYYY-MM-DD HH24:MI:SS')
  AND   NOT EXISTS (
            SELECT 1
            FROM   WWI_FIN.AP_INVOICE_HOLD h
            WHERE  h.AP_INVOICE_ID = i.AP_INVOICE_ID
              AND  h.RELEASE_DT IS NULL
        )</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Connections[OleDbConnection]" connectionManagerID="{219914C8-6320-598D-C999-94A3821DDB9A}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Oracle_ERP]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output].Columns[AP_INVOICE_ID]" dataType="numeric" precision="12" scale="0" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output].ExternalColumns[AP_INVOICE_ID]" lineageId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output].Columns[AP_INVOICE_ID]" name="AP_INVOICE_ID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output].Columns[INVOICE_NBR]" dataType="wstr" length="30" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output].ExternalColumns[INVOICE_NBR]" lineageId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output].Columns[INVOICE_NBR]" name="INVOICE_NBR" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output].Columns[SUPP_ID]" dataType="numeric" precision="12" scale="0" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output].ExternalColumns[SUPP_ID]" lineageId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output].Columns[SUPP_ID]" name="SUPP_ID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output].Columns[LEGAL_ENTITY_CD]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output].ExternalColumns[LEGAL_ENTITY_CD]" lineageId="Package\Extract AP Invoice Headers\ORA V_AP_INVOICE_EXTRACT.Outputs[OLE DB Source Output].Columns[LEGAL_ENTITY_CD]" name="LEGAL_ENTITY_CD" truncationRowDisposition="RedirectRow" />
