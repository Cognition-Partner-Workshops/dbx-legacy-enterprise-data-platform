                  <outputColumn refId="Package\Calculate Replenishment\stg StockItem With Position.Outputs[OLE DB Source Output].Columns[IsChillerStock]" dataType="bool" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate Replenishment\stg StockItem With Position.Outputs[OLE DB Source Output].ExternalColumns[IsChillerStock]" lineageId="Package\Calculate Replenishment\stg StockItem With Position.Outputs[OLE DB Source Output].Columns[IsChillerStock]" name="IsChillerStock" truncationRowDisposition="RedirectRow" />
