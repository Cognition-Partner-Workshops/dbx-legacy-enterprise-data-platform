    <DTS:Executable
      DTS:refId="Package\Calculate Replenishment"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{02C2EFFF-94FE-070B-3A59-F665BB0F7D3C}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Calculate Replenishment"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Calculate Replenishment\stg StockItem With Position" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="stg StockItem With Position" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  si.StockItemId
,       si.StockItemName
,       si.SupplierId
,       si.LeadTimeDays
,       si.ReorderLevel
,       si.TargetStockLevel
,       si.QuantityPerOuter
,       si.IsChillerStock
,       si.RegionCode
,       pos.WarehouseSiteCode
,       pos.QuantityOnHand
,       pos.QuantityOnOrder
,       pos.QuantityAllocated
,       ISNULL(dem.AverageDailyDemand, 0)               AS AverageDailyDemand
        /* Reorder point uses lead-time demand plus a regional safety factor.
           APAC carries more cover because of shipping variability, EU less
           because of the consolidated distribution centre. */
,       CASE si.RegionCode
            WHEN 'APAC' THEN 1.5
            WHEN 'EU'   THEN 1.1
            ELSE 1.25
        END                                             AS SafetyFactor
FROM    stg.StockItem AS si
INNER JOIN work.InventoryPositionDaily AS pos
        ON  pos.StockItemId = si.StockItemId
LEFT OUTER JOIN work.StockItemDemand AS dem
        ON  dem.StockItemId = si.StockItemId
        AND dem.WarehouseSiteCode = pos.WarehouseSiteCode
WHERE   si.IsDiscontinued = 0</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Calculate Replenishment\stg StockItem With Position.Connections[OleDbConnection]" connectionManagerID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Staging_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
