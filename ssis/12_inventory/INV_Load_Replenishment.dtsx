          <component refId="Package\Calculate Replenishment\Derive Reorder Point" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Reorder Point" usesDispositions="true">
            <inputs>
              <input refId="Package\Calculate Replenishment\Derive Reorder Point.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Calculate Replenishment\Derive Reorder Point.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Calculate Replenishment\Derive Reorder Point.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Calculate Replenishment\Derive Reorder Point.Outputs[Derived Column Output].Columns[ReorderPoint]" dataType="i4" lineageId="Package\Calculate Replenishment\Derive Reorder Point.Outputs[Derived Column Output].Columns[ReorderPoint]" name="ReorderPoint">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_I4)(AverageDailyDemand * LeadTimeDays * SafetyFactor)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_I4)(AverageDailyDemand * LeadTimeDays * SafetyFactor)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Calculate Replenishment\Derive Reorder Point.Outputs[Derived Column Output].Columns[ProjectedAvailable]" dataType="i4" lineageId="Package\Calculate Replenishment\Derive Reorder Point.Outputs[Derived Column Output].Columns[ProjectedAvailable]" name="ProjectedAvailable">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">QuantityOnHand + QuantityOnOrder - QuantityAllocated</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">QuantityOnHand + QuantityOnOrder - QuantityAllocated</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Calculate Replenishment\Derive Reorder Point.Outputs[Derived Column Output].Columns[DaysOfCover]" dataType="numeric" precision="18" scale="2" lineageId="Package\Calculate Replenishment\Derive Reorder Point.Outputs[Derived Column Output].Columns[DaysOfCover]" name="DaysOfCover">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">AverageDailyDemand == 0 ? (DT_NUMERIC,18,2)999 : (QuantityOnHand - QuantityAllocated) / AverageDailyDemand</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">AverageDailyDemand == 0 ? (DT_NUMERIC,18,2)999 : (QuantityOnHand - QuantityAllocated) / AverageDailyDemand</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
          <component refId="Package\Calculate Replenishment\Derive Suggested Quantity" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Suggested Quantity" usesDispositions="true">
            <inputs>
              <input refId="Package\Calculate Replenishment\Derive Suggested Quantity.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Calculate Replenishment\Derive Suggested Quantity.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Calculate Replenishment\Derive Suggested Quantity.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Calculate Replenishment\Derive Suggested Quantity.Outputs[Derived Column Output].Columns[RawSuggestedQuantity]" dataType="i4" lineageId="Package\Calculate Replenishment\Derive Suggested Quantity.Outputs[Derived Column Output].Columns[RawSuggestedQuantity]" name="RawSuggestedQuantity">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_I4)(AverageDailyDemand * @[$Package::CoverDays]) - ProjectedAvailable</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_I4)(AverageDailyDemand * @[$Package::CoverDays]) - ProjectedAvailable</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Calculate Replenishment\Derive Suggested Quantity.Outputs[Derived Column Output].Columns[SuggestedQuantity]" dataType="i4" lineageId="Package\Calculate Replenishment\Derive Suggested Quantity.Outputs[Derived Column Output].Columns[SuggestedQuantity]" name="SuggestedQuantity">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">((DT_I4)(AverageDailyDemand * @[$Package::CoverDays]) - ProjectedAvailable) &lt;= 0 ? 0 : ((QuantityPerOuter &lt;= 1) ? ((DT_I4)(AverageDailyDemand * @[$Package::CoverDays]) - ProjectedAvailable) : (((((DT_I4)(AverageDailyDemand * @[$Package::CoverDays]) - ProjectedAvailable) / QuantityPerOuter) + 1) * QuantityPerOuter)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">((DT_I4)(AverageDailyDemand * @[$Package::CoverDays]) - ProjectedAvailable) &lt;= 0 ? 0 : ((QuantityPerOuter &lt;= 1) ? ((DT_I4)(AverageDailyDemand * @[$Package::CoverDays]) - ProjectedAvailable) : (((((DT_I4)(AverageDailyDemand * @[$Package::CoverDays]) - ProjectedAvailable) / QuantityPerOuter) + 1) * QuantityPerOuter)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Calculate Replenishment\Derive Suggested Quantity.Outputs[Derived Column Output].Columns[IsStockoutRisk]" dataType="bool" lineageId="Package\Calculate Replenishment\Derive Suggested Quantity.Outputs[Derived Column Output].Columns[IsStockoutRisk]" name="IsStockoutRisk">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ProjectedAvailable &lt;= (DT_I4)(AverageDailyDemand * LeadTimeDays) ? (DT_BOOL)1 : (DT_BOOL)0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ProjectedAvailable &lt;= (DT_I4)(AverageDailyDemand * LeadTimeDays) ? (DT_BOOL)1 : (DT_BOOL)0</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
