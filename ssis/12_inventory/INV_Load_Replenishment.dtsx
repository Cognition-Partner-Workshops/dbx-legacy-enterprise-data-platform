    <DTS:Executable
      DTS:refId="Package\Suppress Chiller Suggestions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8A80F814-7EE2-3662-8CB8-7BBDF700F235}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Suppress Chiller Suggestions"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DELETE FROM work.ReplenishmentSuggestion WHERE IsChillerStock = 1;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Publish Inventory Health"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{20B7B498-8AF5-7843-E8E3-77F408C0F076}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Publish Inventory Health"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="MERGE Aggregate.[Daily Inventory Health] AS target&#10;USING (SELECT WarehouseSiteCode, RegionCode,&#10;              COUNT(*) AS SuggestionCount,&#10;              SUM(CASE WHEN IsStockoutRisk = 1 THEN 1 ELSE 0 END) AS StockoutRiskCount,&#10;              SUM(SuggestedQuantity) AS SuggestedUnits&#10;       FROM   work.ReplenishmentSuggestion&#10;       GROUP BY WarehouseSiteCode, RegionCode) AS source&#10;    ON  target.[Warehouse Site Code] = source.WarehouseSiteCode&#10;WHEN MATCHED THEN UPDATE SET target.[Suggestion Count] = source.SuggestionCount,&#10;                             target.[Stockout Risk Count] = source.StockoutRiskCount,&#10;                             target.[Suggested Units] = source.SuggestedUnits&#10;WHEN NOT MATCHED BY TARGET THEN&#10;    INSERT ([Warehouse Site Code], [Region Code], [Suggestion Count],&#10;            [Stockout Risk Count], [Suggested Units])&#10;    VALUES (source.WarehouseSiteCode, source.RegionCode, source.SuggestionCount,&#10;            source.StockoutRiskCount, source.SuggestedUnits);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Count Stockout Risks"
