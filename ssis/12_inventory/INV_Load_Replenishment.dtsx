                  <outputColumn refId="Package\Calculate Replenishment\stg StockItem With Position.Outputs[OLE DB Source Output].Columns[StockItemName]" dataType="wstr" length="100" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate Replenishment\stg StockItem With Position.Outputs[OLE DB Source Output].ExternalColumns[StockItemName]" lineageId="Package\Calculate Replenishment\stg StockItem With Position.Outputs[OLE DB Source Output].Columns[StockItemName]" name="StockItemName" truncationRowDisposition="RedirectRow" />
