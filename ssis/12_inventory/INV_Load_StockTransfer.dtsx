              <output refId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[StockTransferId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].ExternalColumns[StockTransferId]" lineageId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[StockTransferId]" name="StockTransferId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[TransferReference]" dataType="wstr" length="30" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].ExternalColumns[TransferReference]" lineageId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[TransferReference]" name="TransferReference" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[StockItemId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].ExternalColumns[StockItemId]" lineageId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[StockItemId]" name="StockItemId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[FromWarehouseSiteCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].ExternalColumns[FromWarehouseSiteCode]" lineageId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[FromWarehouseSiteCode]" name="FromWarehouseSiteCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[ToWarehouseSiteCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].ExternalColumns[ToWarehouseSiteCode]" lineageId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[ToWarehouseSiteCode]" name="ToWarehouseSiteCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[DespatchedAtUtc]" dataType="dbTimeStamp" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].ExternalColumns[DespatchedAtUtc]" lineageId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[DespatchedAtUtc]" name="DespatchedAtUtc" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[ReceivedAtUtc]" dataType="dbTimeStamp" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].ExternalColumns[ReceivedAtUtc]" lineageId="Package\Load Transfer Movements\stg StockMovement Transfers.Outputs[OLE DB Source Output].Columns[ReceivedAtUtc]" name="ReceivedAtUtc" truncationRowDisposition="RedirectRow" />
