    <DTS:Executable
      DTS:refId="Package\Truncate work_CycleCountVariance"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B91F5516-D41C-DA3E-11E0-6ED62C7FA817}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Truncate work_CycleCountVariance"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="TRUNCATE TABLE work.CycleCountVariance;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Build Variance Set"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FF3C49D4-ACF6-2C1A-59E9-8A739E91C51C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Variance Set"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.CycleCountVariance&#10;    (CycleCountId, StockItemId, WarehouseSiteCode, BinLocationCode, CountedQuantity,&#10;     SystemQuantity, VarianceQuantity, VarianceValue, CountedAtUtc, CountStatusCode)&#10;SELECT  cc.CycleCountId&#10;,       cc.StockItemId&#10;,       cc.WarehouseSiteCode&#10;,       cc.BinLocationCode&#10;,       cc.CountedQuantity&#10;,       ISNULL(pos.QuantityOnHand, 0)&#10;,       cc.CountedQuantity - ISNULL(pos.QuantityOnHand, 0)&#10;,       (cc.CountedQuantity - ISNULL(pos.QuantityOnHand, 0)) * ISNULL(si.UnitCost, 0)&#10;,       cc.CountedAtUtc&#10;,       CASE WHEN ABS(cc.CountedQuantity - ISNULL(pos.QuantityOnHand, 0)) &lt;= ?&#10;              AND ABS((cc.CountedQuantity - ISNULL(pos.QuantityOnHand, 0))&#10;                      * ISNULL(si.UnitCost, 0)) &lt;= ?&#10;             THEN N'AUTO' ELSE N'HOLD' END&#10;FROM    stg.CycleCount AS cc&#10;LEFT OUTER JOIN work.InventoryPositionDaily AS pos&#10;        ON  pos.StockItemId = cc.StockItemId&#10;        AND pos.WarehouseSiteCode = cc.WarehouseSiteCode&#10;        AND pos.BinLocationCode = cc.BinLocationCode&#10;LEFT OUTER JOIN stg.StockItem AS si ON si.StockItemId = cc.StockItemId&#10;WHERE   cc.LoadBatchId = ?&#10;AND     cc.CountedQuantity &lt;&gt; ISNULL(pos.QuantityOnHand, 0);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::CountToleranceUnits" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::CountToleranceValue" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Measure Variances"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5E28AE68-2788-43CB-5E2D-A522234614B8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Variances"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT SUM(CASE WHEN CountStatusCode = N'AUTO' THEN 1 ELSE 0 END) AS AutoPost,        SUM(CASE WHEN CountStatusCode = N'HOLD' THEN 1 ELSE 0 END) AS HeldForRecount FROM work.CycleCountVariance;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::VarianceCount" />
        <SQLTask:ResultBinding SQLTask:ResultName="1" SQLTask:DtsVariableName="User::HeldForRecountCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Post Adjustment Movements"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{88E34502-534E-C049-4FDF-B3A1CFF1917E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Post Adjustment Movements"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DECLARE @CycleCountId int, @StockItemId int, @Site nvarchar(10), @Qty int, @Value decimal(18,2);&#10;DECLARE variance_cur CURSOR LOCAL FAST_FORWARD FOR&#10;    SELECT CycleCountId, StockItemId, WarehouseSiteCode, VarianceQuantity, VarianceValue&#10;    FROM   work.CycleCountVariance&#10;    WHERE  CountStatusCode = N'AUTO'&#10;    ORDER BY CountedAtUtc;&#10;OPEN variance_cur;&#10;FETCH NEXT FROM variance_cur INTO @CycleCountId, @StockItemId, @Site, @Qty, @Value;&#10;WHILE @@FETCH_STATUS = 0&#10;BEGIN&#10;    EXEC Integration.usp_PostInventoryAdjustment&#10;         @StockItemId = @StockItemId, @WarehouseSiteCode = @Site,&#10;         @AdjustmentQuantity = @Qty, @AdjustmentValue = @Value,&#10;         @MovementReasonCode = N'CYCLECOUNT', @SourceReference = @CycleCountId;&#10;    FETCH NEXT FROM variance_cur INTO @CycleCountId, @StockItemId, @Site, @Qty, @Value;&#10;END&#10;CLOSE variance_cur;&#10;DEALLOCATE variance_cur;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Queue Recounts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9449E1EB-A4AF-435E-19C6-41E612DF4730}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Queue Recounts"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO etl.RejectedRecord     (BatchId, ObjectName, RejectStage, RejectReasonCode, RejectReason,      BusinessKey, LoggedAtUtc, IsReprocessed) SELECT ?, N'stg.CycleCount', N'Fact', N'COUNT_VARIANCE_HELD',        N'Cycle-count variance above tolerance; supervisor recount required',        CAST(CycleCountId AS nvarchar(20)), SYSUTCDATETIME(), 0 FROM   work.CycleCountVariance WHERE CountStatusCode = N'HOLD';"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Log Row Counts"
