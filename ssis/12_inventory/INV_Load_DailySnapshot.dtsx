        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS ExpiredChillerRows FROM Fact.[Daily Inventory Snapshot] WHERE [Snapshot Date] = CAST(? AS date) AND [Is Expired Chiller Stock] = 1;"
