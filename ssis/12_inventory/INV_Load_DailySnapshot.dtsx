    <DTS:Executable
      DTS:refId="Package\Load Inventory Snapshot"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{556C3882-3FBD-CF55-1C68-BD7A9A9E65E5}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Inventory Snapshot"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Load Inventory Snapshot\work InventoryPositionDaily" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="work InventoryPositionDaily" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  p.StockItemId
,       p.WarehouseSiteCode
,       p.BinLocationCode
,       p.SnapshotDate
,       p.QuantityOnHand
,       p.QuantityAllocated
,       p.QuantityOnOrder
,       p.QuantityInTransit
,       p.QuantityOnHand - p.QuantityAllocated          AS QuantityAvailable
,       p.LastMovementDate
,       si.UnitCost
,       si.IsChillerStock
,       si.ShelfLifeDays
,       (p.QuantityOnHand * si.UnitCost)                AS OnHandValue
        /* Ageing bands were agreed with the finance team in 2008 and are still
           what the obsolescence provision is calculated from. */
,       CASE
            WHEN p.LastMovementDate IS NULL                              THEN 'NEVER'
            WHEN DATEDIFF(DAY, p.LastMovementDate, p.SnapshotDate) &gt; 365 THEN 'D365P'
            WHEN DATEDIFF(DAY, p.LastMovementDate, p.SnapshotDate) &gt; 180 THEN 'D180'
            WHEN DATEDIFF(DAY, p.LastMovementDate, p.SnapshotDate) &gt; 90  THEN 'D090'
            ELSE 'FRESH'
        END                                             AS AgeBandCode
,       CASE WHEN si.IsChillerStock = 1
                  AND DATEDIFF(DAY, p.ReceiptDate, p.SnapshotDate) &gt; si.ShelfLifeDays
             THEN 1 ELSE 0 END                          AS IsExpiredChillerStock
FROM    work.InventoryPositionDaily AS p
INNER JOIN stg.StockItem AS si
        ON  si.StockItemId = p.StockItemId
WHERE   p.SnapshotDate = CAST(? AS date)</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Connections[OleDbConnection]" connectionManagerID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Staging_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].Columns[StockItemId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].ExternalColumns[StockItemId]" lineageId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].Columns[StockItemId]" name="StockItemId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].Columns[WarehouseSiteCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].ExternalColumns[WarehouseSiteCode]" lineageId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].Columns[WarehouseSiteCode]" name="WarehouseSiteCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].Columns[BinLocationCode]" dataType="wstr" length="12" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].ExternalColumns[BinLocationCode]" lineageId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].Columns[BinLocationCode]" name="BinLocationCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].Columns[SnapshotDate]" dataType="dbTimeStamp" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].ExternalColumns[SnapshotDate]" lineageId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].Columns[SnapshotDate]" name="SnapshotDate" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].Columns[QuantityOnHand]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].ExternalColumns[QuantityOnHand]" lineageId="Package\Load Inventory Snapshot\work InventoryPositionDaily.Outputs[OLE DB Source Output].Columns[QuantityOnHand]" name="QuantityOnHand" truncationRowDisposition="RedirectRow" />
