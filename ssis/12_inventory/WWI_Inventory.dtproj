<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="www.microsoft.com/SqlServer/SSIS" ToolsVersion="13.0">
  <DeploymentModel>Project</DeploymentModel>
  <ProductVersion>13.0.4001.0</ProductVersion>
  <SchemaVersion>9.0.1.0</SchemaVersion>
  <Database>
    <Name>WWI_Inventory.ispac</Name>
  </Database>
  <DeploymentInfoXml>
    <ProjectProtectionLevel>DontSaveSensitive</ProjectProtectionLevel>
  </DeploymentInfoXml>
  <Packages>
    <Package>
      <Name>INV_Load_DailySnapshot.dtsx</Name>
      <EntryPoint>false</EntryPoint>
    </Package>
    <Package>
      <Name>INV_Load_CycleCountVariance.dtsx</Name>
      <EntryPoint>false</EntryPoint>
    </Package>
    <Package>
      <Name>INV_Load_Replenishment.dtsx</Name>
      <EntryPoint>false</EntryPoint>
    </Package>
    <Package>
      <Name>INV_Load_StockTransfer.dtsx</Name>
      <EntryPoint>false</EntryPoint>
    </Package>
    <Package>
      <Name>INV_Reconcile_OnHand.dtsx</Name>
      <EntryPoint>false</EntryPoint>
    </Package>
  </Packages>
  <ConnectionManagers>
    <ConnectionManager>
      <Name>WWI_Staging_DB.conmgr</Name>
    </ConnectionManager>
    <ConnectionManager>
      <Name>WWI_DW_Destination_DB.conmgr</Name>
    </ConnectionManager>
    <ConnectionManager>
      <Name>WWI_Reject_Files.conmgr</Name>
    </ConnectionManager>
  </ConnectionManagers>
  <Configurations>
    <Configuration>
      <Name>Development</Name>
    </Configuration>
    <Configuration>
      <Name>Test</Name>
    </Configuration>
    <Configuration>
      <Name>Production</Name>
    </Configuration>
  </Configurations>
</Project>
