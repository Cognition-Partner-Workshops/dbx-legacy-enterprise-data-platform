          <component refId="Package\Calculate APAC Commission\Derive APAC Commission" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive APAC Commission" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\Calculate APAC Commission\Derive APAC Commission.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Calculate APAC Commission\Derive APAC Commission.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Calculate APAC Commission\Derive APAC Commission.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Calculate APAC Commission\Derive APAC Commission.Outputs[Derived Column Output].Columns[CommissionAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Calculate APAC Commission\Derive APAC Commission.Outputs[Derived Column Output].Columns[CommissionAmount]" name="CommissionAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">PlanCurrencyAmount * BaseRatePercent / 100 * SplitFactor</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PlanCurrencyAmount * BaseRatePercent / 100 * SplitFactor</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Calculate APAC Commission\Derive APAC Commission.Outputs[Derived Column Output].Columns[RegionCode]" dataType="wstr" length="4" lineageId="Package\Calculate APAC Commission\Derive APAC Commission.Outputs[Derived Column Output].Columns[RegionCode]" name="RegionCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_WSTR,4)"APAC"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_WSTR,4)"APAC"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Calculate APAC Commission\Derive APAC Commission.Outputs[Derived Column Output].Columns[IsPeriodBoundaryLine]" dataType="bool" lineageId="Package\Calculate APAC Commission\Derive APAC Commission.Outputs[Derived Column Output].Columns[IsPeriodBoundaryLine]" name="IsPeriodBoundaryLine">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEPART(month, InvoiceDate) != (DT_I4)SUBSTRING(CommissionPeriod, 7, 2) ? (DT_BOOL)1 : (DT_BOOL)0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEPART(month, InvoiceDate) != (DT_I4)SUBSTRING(CommissionPeriod, 7, 2) ? (DT_BOOL)1 : (DT_BOOL)0</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
