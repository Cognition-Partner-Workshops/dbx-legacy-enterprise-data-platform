    <DTS:Executable
      DTS:refId="Package\Check 445 Calendar Coverage"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6B1967DB-AF0C-4DB1-E1E6-CE350D7476E0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Check 445 Calendar Coverage"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS MissingCalendarDays FROM (    SELECT DISTINCT CAST(InvoiceDate AS date) AS CalendarDate     FROM   stg.SaleLine WHERE RegionCode = N'APAC' AND LoadBatchId = ?) AS d WHERE NOT EXISTS (SELECT 1 FROM stg.FiscalCalendar445 AS f                   WHERE f.CalendarDate = d.CalendarDate);"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::MissingCalendarCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Calculate APAC Commission"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{CAB49982-56A1-B9FF-EB44-C30035ED8C1A}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Calculate APAC Commission"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Calculate APAC Commission\stg SaleLine APAC" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="stg SaleLine APAC" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  sl.SaleLineId
,       sl.InvoiceNumber
,       sl.InvoiceDate
,       sl.SalespersonPersonId
,       sl.CustomerId
,       sl.CountryCode
,       sl.TerritoryCode
,       sl.CurrencyCode
,       sl.ExtendedPrice
,       sl.GstAmount
,       sl.ExtendedPrice - ISNULL(sl.GstAmount, 0)      AS GstExclusiveAmount
,       cp.PlanCode
,       cp.BaseRatePercent
,       cp.PlanCurrencyCode
,       cp.TeamSplitPercent
        /* APAC reports on a 4-4-5 calendar, so the commission period comes from
           the date dimension and not from the invoice month. */
,       d.FiscalPeriod445                               AS CommissionPeriod
,       d.FiscalYear445                                 AS CommissionFiscalYear
,       d.FiscalWeek445                                 AS CommissionFiscalWeek
FROM    stg.SaleLine AS sl
INNER JOIN stg.CommissionPlan AS cp
        ON  cp.SalespersonPersonId = sl.SalespersonPersonId
        AND cp.RegionCode = 'APAC'
        AND sl.InvoiceDate BETWEEN cp.EffectiveFrom AND ISNULL(cp.EffectiveTo, '9999-12-31')
INNER JOIN stg.FiscalCalendar445 AS d
        ON  d.CalendarDate = CAST(sl.InvoiceDate AS date)
WHERE   sl.RegionCode = 'APAC'
AND     sl.LoadBatchId = ?
AND     sl.LineTypeCode NOT IN ('SAMPLE', 'INTERNAL')</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Calculate APAC Commission\stg SaleLine APAC.Connections[OleDbConnection]" connectionManagerID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Staging_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[SaleLineId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].ExternalColumns[SaleLineId]" lineageId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[SaleLineId]" name="SaleLineId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[InvoiceNumber]" dataType="wstr" length="30" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].ExternalColumns[InvoiceNumber]" lineageId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[InvoiceNumber]" name="InvoiceNumber" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[InvoiceDate]" dataType="dbTimeStamp" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].ExternalColumns[InvoiceDate]" lineageId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[InvoiceDate]" name="InvoiceDate" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[SalespersonPersonId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].ExternalColumns[SalespersonPersonId]" lineageId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[SalespersonPersonId]" name="SalespersonPersonId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[CustomerId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].ExternalColumns[CustomerId]" lineageId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[CustomerId]" name="CustomerId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[CountryCode]" dataType="wstr" length="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].ExternalColumns[CountryCode]" lineageId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[CountryCode]" name="CountryCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[TerritoryCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].ExternalColumns[TerritoryCode]" lineageId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[TerritoryCode]" name="TerritoryCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[CurrencyCode]" dataType="wstr" length="3" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].ExternalColumns[CurrencyCode]" lineageId="Package\Calculate APAC Commission\stg SaleLine APAC.Outputs[OLE DB Source Output].Columns[CurrencyCode]" name="CurrencyCode" truncationRowDisposition="RedirectRow" />
