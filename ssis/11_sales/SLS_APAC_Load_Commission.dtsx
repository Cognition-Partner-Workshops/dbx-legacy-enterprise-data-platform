                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">@[$Package::TeamSplitEnabled] ? TeamSplitPercent / 100 : (DT_NUMERIC,18,2)1</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">@[$Package::TeamSplitEnabled] ? TeamSplitPercent / 100 : (DT_NUMERIC,18,2)1</property>
