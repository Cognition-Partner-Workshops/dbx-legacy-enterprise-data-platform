                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">GstExclusiveAmount * (DT_NUMERIC,18,2)ConversionRate</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">GstExclusiveAmount * (DT_NUMERIC,18,2)ConversionRate</property>
                    </properties>
