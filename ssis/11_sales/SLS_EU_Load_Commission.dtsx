                  <outputColumn refId="Package\Calculate EU Commission\Apply EU Plan Rules.Outputs[Derived Column Output].Columns[CommissionAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Calculate EU Commission\Apply EU Plan Rules.Outputs[Derived Column Output].Columns[CommissionAmount]" name="CommissionAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">StatutoryCapAmount &gt; 0 &amp;&amp; (NetAmountEur * BaseRatePercent / 100) &gt; StatutoryCapAmount ? StatutoryCapAmount : NetAmountEur * BaseRatePercent / 100</property>
