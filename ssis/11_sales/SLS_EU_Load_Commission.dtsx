                  <outputColumn refId="Package\Calculate EU Commission\stg SaleLine EU.Outputs[OLE DB Source Output].Columns[TerritoryCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate EU Commission\stg SaleLine EU.Outputs[OLE DB Source Output].ExternalColumns[TerritoryCode]" lineageId="Package\Calculate EU Commission\stg SaleLine EU.Outputs[OLE DB Source Output].Columns[TerritoryCode]" name="TerritoryCode" truncationRowDisposition="RedirectRow" />
