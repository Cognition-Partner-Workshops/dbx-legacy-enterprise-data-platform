                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">NetAmountEur * BaseRatePercent / 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">NetAmountEur * BaseRatePercent / 100</property>
                    </properties>
