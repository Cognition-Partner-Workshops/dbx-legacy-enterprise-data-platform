    <DTS:Executable
      DTS:refId="Package\Release Cash Basis Lines With Payment"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{743E4FF4-4585-8CE0-1540-5F23747A3361}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Release Cash Basis Lines With Payment"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.CommissionEu     (SaleLineId, SalespersonPersonId, CommissionPeriod, NetAmountEur, CommissionAmount,      RegionCode, CountryCode) SELECT h.SaleLineId, h.SalespersonPersonId, CONVERT(char(7), p.PaymentDate, 126),        h.NetAmountEur, h.CommissionAmount, h.RegionCode, h.CountryCode FROM   work.CommissionEuHeld AS h INNER JOIN stg.CustomerPayment AS p         ON  p.InvoiceNumber = h.InvoiceNumber         AND p.PaymentStatusCode = N'CLEARED';"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Count Capped Representatives"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BD15C503-BB87-4FB1-B985-DEE8D180CEDD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Count Capped Representatives"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT COUNT(DISTINCT SalespersonPersonId) AS CappedReps FROM work.CommissionEu WHERE RawCommissionAmount &gt; CommissionAmount;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::CappedRepCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
