                  <outputColumn refId="Package\Calculate EU Commission\stg SaleLine EU.Outputs[OLE DB Source Output].Columns[SalespersonPersonId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate EU Commission\stg SaleLine EU.Outputs[OLE DB Source Output].ExternalColumns[SalespersonPersonId]" lineageId="Package\Calculate EU Commission\stg SaleLine EU.Outputs[OLE DB Source Output].Columns[SalespersonPersonId]" name="SalespersonPersonId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Calculate EU Commission\stg SaleLine EU.Outputs[OLE DB Source Output].Columns[CustomerId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate EU Commission\stg SaleLine EU.Outputs[OLE DB Source Output].ExternalColumns[CustomerId]" lineageId="Package\Calculate EU Commission\stg SaleLine EU.Outputs[OLE DB Source Output].Columns[CustomerId]" name="CustomerId" truncationRowDisposition="RedirectRow" />
