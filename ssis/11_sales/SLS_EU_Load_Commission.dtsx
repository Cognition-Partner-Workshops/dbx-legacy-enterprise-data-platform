          <component refId="Package\Calculate EU Commission\Convert To EUR" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Convert To EUR" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\Calculate EU Commission\Convert To EUR.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Calculate EU Commission\Convert To EUR.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Calculate EU Commission\Convert To EUR.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Calculate EU Commission\Convert To EUR.Outputs[Derived Column Output].Columns[NetAmountEur]" dataType="numeric" precision="18" scale="2" lineageId="Package\Calculate EU Commission\Convert To EUR.Outputs[Derived Column Output].Columns[NetAmountEur]" name="NetAmountEur">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(EurConversionRate) || EurConversionRate == 0 ? NetCommissionableAmount : NetCommissionableAmount * (DT_NUMERIC,18,2)EurConversionRate</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(EurConversionRate) || EurConversionRate == 0 ? NetCommissionableAmount : NetCommissionableAmount * (DT_NUMERIC,18,2)EurConversionRate</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Calculate EU Commission\Convert To EUR.Outputs[Derived Column Output].Columns[IsCashBasisCountry]" dataType="bool" lineageId="Package\Calculate EU Commission\Convert To EUR.Outputs[Derived Column Output].Columns[IsCashBasisCountry]" name="IsCashBasisCountry">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">FINDSTRING(@[$Package::CashBasisCountries], CountryCode, 1) &gt; 0 ? (DT_BOOL)1 : (DT_BOOL)0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">FINDSTRING(@[$Package::CashBasisCountries], CountryCode, 1) &gt; 0 ? (DT_BOOL)1 : (DT_BOOL)0</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
