    <DTS:Executable
      DTS:refId="Package\Build Partner Feed Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2B9176DE-B0EB-22F4-C7B5-79C88621E0FA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Partner Feed Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="INSERT INTO work.PartnerFeedRow&#10;    (PartnerCode, InvoiceNumber, InvoiceDate, CustomerReference, StockItemCode,&#10;     Quantity, NetAmount, SettlementCurrencyCode, RegionCode)&#10;SELECT  pa.[Partner Code]&#10;,       s.[WWI Invoice ID]&#10;,       s.[Invoice Date Key]&#10;,       CASE WHEN c.[Region Code] = N'EU' AND ISNULL(c.[Share Consent Flag], 0) = 0&#10;             THEN N'REDACTED' ELSE c.[Customer Reference] END&#10;,       si.[Stock Item Code]&#10;,       s.Quantity&#10;,       s.[Total Excluding Tax] * ISNULL(fx.ConversionRate, 1)&#10;,       pa.[Settlement Currency Code]&#10;,       c.[Region Code]&#10;FROM    Fact.Sale AS s&#10;INNER JOIN Dimension.Customer AS c ON c.[Customer Key] = s.[Customer Key]&#10;INNER JOIN Dimension.[Stock Item] AS si ON si.[Stock Item Key] = s.[Stock Item Key]&#10;INNER JOIN Dimension.Partner AS pa ON pa.[Partner Key] = c.[Partner Key]&#10;LEFT OUTER JOIN work.FxRevaluationRate AS fx&#10;        ON  fx.CurrencyCode = s.[Currency Code]&#10;        AND fx.QuoteCurrencyCode = pa.[Settlement Currency Code]&#10;        AND fx.RateTypeCode = N'AVERAGE'&#10;WHERE   (? = N'ALL' OR pa.[Partner Code] = ?)&#10;AND     s.[Invoice Date Key] &gt;= DATEADD(DAY, -1, CAST(SYSDATETIME() AS date));"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::PartnerScope" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::PartnerScope" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Suppress Unconsented EU Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F1DCDCE6-F6ED-2B9C-90DF-82FE6683A795}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Suppress Unconsented EU Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DELETE FROM work.PartnerFeedRow WHERE RegionCode = N'EU' AND CustomerReference = N'REDACTED';"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Count Feed Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8A3D0868-9805-4B56-240C-4693C6DADFAF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Count Feed Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS FeedRows FROM work.PartnerFeedRow;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::ExportRowCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Build Outbound File Name"
      DTS:CreationName="Microsoft.ExpressionTask"
      DTS:Description="Expression Task"
      DTS:DTSID="{0B24C4E9-8572-3BC1-A957-8ACAFF0D798B}"
      DTS:ExecutableType="Microsoft.ExpressionTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Outbound File Name"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <ExpressionTask Expression='@[User::OutboundFilePath] = "partner_feed_" + (DT_WSTR,4)YEAR(GETDATE()) + RIGHT("0" + (DT_WSTR,2)MONTH(GETDATE()), 2) + RIGHT("0" + (DT_WSTR,2)DAY(GETDATE()), 2) + ".csv"' />
      </DTS:ObjectData>
    </DTS:Executable>
