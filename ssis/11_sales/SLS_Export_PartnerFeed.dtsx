                  <outputColumn refId="Package\Write Partner Feed\work PartnerFeedRow.Outputs[OLE DB Source Output].Columns[PartnerCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Write Partner Feed\work PartnerFeedRow.Outputs[OLE DB Source Output].ExternalColumns[PartnerCode]" lineageId="Package\Write Partner Feed\work PartnerFeedRow.Outputs[OLE DB Source Output].Columns[PartnerCode]" name="PartnerCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Write Partner Feed\work PartnerFeedRow.Outputs[OLE DB Source Output].Columns[InvoiceNumber]" dataType="wstr" length="30" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Write Partner Feed\work PartnerFeedRow.Outputs[OLE DB Source Output].ExternalColumns[InvoiceNumber]" lineageId="Package\Write Partner Feed\work PartnerFeedRow.Outputs[OLE DB Source Output].Columns[InvoiceNumber]" name="InvoiceNumber" truncationRowDisposition="RedirectRow" />
