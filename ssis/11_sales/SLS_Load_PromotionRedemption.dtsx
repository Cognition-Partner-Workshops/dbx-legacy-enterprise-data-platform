    <DTS:Executable
      DTS:refId="Package\Flag Over Budget Promotions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9F8AB3B6-1373-A4C8-BCDE-79241F588B22}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Flag Over Budget Promotions"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="UPDATE pe SET [Budget Status] = N'OVER' FROM Aggregate.[Promotion Effectiveness] AS pe INNER JOIN (SELECT PromotionId, BudgetAmount FROM stg.Promotion) AS b         ON b.PromotionId = pe.[Promotion ID] WHERE pe.[Discount Cost Amount] &gt; b.BudgetAmount;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
