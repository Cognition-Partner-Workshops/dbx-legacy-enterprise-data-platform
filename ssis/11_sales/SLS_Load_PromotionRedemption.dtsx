                  <outputColumn refId="Package\Attribute Redemptions\stg Promotion Redemptions.Outputs[OLE DB Source Output].Columns[DiscountValue]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Attribute Redemptions\stg Promotion Redemptions.Outputs[OLE DB Source Output].ExternalColumns[DiscountValue]" lineageId="Package\Attribute Redemptions\stg Promotion Redemptions.Outputs[OLE DB Source Output].Columns[DiscountValue]" name="DiscountValue" truncationRowDisposition="RedirectRow" />
