                  <outputColumn refId="Package\Attribute Redemptions\stg Promotion Redemptions.Outputs[OLE DB Source Output].Columns[PromotionCode]" dataType="wstr" length="20" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Attribute Redemptions\stg Promotion Redemptions.Outputs[OLE DB Source Output].ExternalColumns[PromotionCode]" lineageId="Package\Attribute Redemptions\stg Promotion Redemptions.Outputs[OLE DB Source Output].Columns[PromotionCode]" name="PromotionCode" truncationRowDisposition="RedirectRow" />
