    <DTS:Executable
      DTS:refId="Package\Find Territories Without Quota"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4811EABC-AFCA-866F-BB43-7768BC98116A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Find Territories Without Quota"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS MissingQuotas FROM stg.SalesTerritory AS t WHERE t.IsActive = 1 AND NOT EXISTS (SELECT 1 FROM stg.SalesQuota AS q                 WHERE q.TerritoryCode = t.TerritoryCode AND q.QuotaPeriod = ?);"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::AttainmentPeriod" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::MissingQuotaCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Build Attainment By Region"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5E1E879C-BE89-4D18-B54D-963D4761A848}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Attainment By Region"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.QuotaAttainment&#10;    (TerritoryCode, RegionCode, QuotaPeriod, QuotaAmount, ActualAmount, MeasureBasisCode)&#10;SELECT  t.TerritoryCode, N'NA', q.QuotaPeriod, q.QuotaAmount,&#10;        ISNULL(SUM(sl.ExtendedPrice + sl.TaxAmount), 0), N'INVOICED'&#10;FROM    stg.SalesTerritory AS t&#10;INNER JOIN stg.SalesQuota AS q ON q.TerritoryCode = t.TerritoryCode AND q.QuotaPeriod = ?&#10;LEFT OUTER JOIN stg.SaleLine AS sl&#10;        ON  sl.TerritoryCode = t.TerritoryCode AND sl.RegionCode = N'NA'&#10;        AND CONVERT(char(7), sl.InvoiceDate, 126) = q.QuotaPeriod&#10;WHERE   t.RegionCode = N'NA'&#10;GROUP BY t.TerritoryCode, q.QuotaPeriod, q.QuotaAmount&#10;UNION ALL&#10;SELECT  t.TerritoryCode, N'EU', q.QuotaPeriod, q.QuotaAmount,&#10;        ISNULL(SUM(sl.NetAmount), 0) - ISNULL(SUM(cn.CreditAmount), 0), N'NET_OF_CREDITS'&#10;FROM    stg.SalesTerritory AS t&#10;INNER JOIN stg.SalesQuota AS q ON q.TerritoryCode = t.TerritoryCode AND q.QuotaPeriod = ?&#10;LEFT OUTER JOIN stg.SaleLine AS sl&#10;        ON  sl.TerritoryCode = t.TerritoryCode AND sl.RegionCode = N'EU'&#10;        AND CONVERT(char(7), sl.InvoiceDate, 126) = q.QuotaPeriod&#10;LEFT OUTER JOIN stg.CreditNote AS cn&#10;        ON  cn.InvoiceNumber = sl.InvoiceNumber&#10;WHERE   t.RegionCode = N'EU'&#10;GROUP BY t.TerritoryCode, q.QuotaPeriod, q.QuotaAmount&#10;UNION ALL&#10;SELECT  t.TerritoryCode, N'APAC', q.QuotaPeriod, q.QuotaAmount,&#10;        ISNULL(SUM(ol.OrderLineAmount), 0), N'ORDER_INTAKE'&#10;FROM    stg.SalesTerritory AS t&#10;INNER JOIN stg.SalesQuota AS q ON q.TerritoryCode = t.TerritoryCode AND q.QuotaPeriod = ?&#10;LEFT OUTER JOIN stg.OrderLine AS ol&#10;        ON  ol.TerritoryCode = t.TerritoryCode&#10;LEFT OUTER JOIN stg.FiscalCalendar445 AS f&#10;        ON  f.CalendarDate = CAST(ol.OrderDate AS date)&#10;        AND f.FiscalPeriod445 = q.QuotaPeriod&#10;WHERE   t.RegionCode = N'APAC'&#10;GROUP BY t.TerritoryCode, q.QuotaPeriod, q.QuotaAmount;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::AttainmentPeriod" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::AttainmentPeriod" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::AttainmentPeriod" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
