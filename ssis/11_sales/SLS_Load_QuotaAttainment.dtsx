                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">QuotaAmount == 0 ? (DT_NUMERIC,18,2)0 : ActualAmount * 100 / QuotaAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">QuotaAmount == 0 ? (DT_NUMERIC,18,2)0 : ActualAmount * 100 / QuotaAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Publish Quota Attainment\Derive Attainment Metrics.Outputs[Derived Column Output].Columns[AttainmentBandCode]" dataType="wstr" length="8" lineageId="Package\Publish Quota Attainment\Derive Attainment Metrics.Outputs[Derived Column Output].Columns[AttainmentBandCode]" name="AttainmentBandCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">QuotaAmount == 0 ? (DT_WSTR,8)"NOQUOTA" : (ActualAmount * 100 / QuotaAmount &gt;= 120 ? (DT_WSTR,8)"OVER120" : (ActualAmount * 100 / QuotaAmount &gt;= 100 ? (DT_WSTR,8)"AT" : (ActualAmount * 100 / QuotaAmount &gt;= 80 ? (DT_WSTR,8)"NEAR" : (DT_WSTR,8)"UNDER")))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">QuotaAmount == 0 ? (DT_WSTR,8)"NOQUOTA" : (ActualAmount * 100 / QuotaAmount &gt;= 120 ? (DT_WSTR,8)"OVER120" : (ActualAmount * 100 / QuotaAmount &gt;= 100 ? (DT_WSTR,8)"AT" : (ActualAmount * 100 / QuotaAmount &gt;= 80 ? (DT_WSTR,8)"NEAR" : (DT_WSTR,8)"UNDER")))</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
