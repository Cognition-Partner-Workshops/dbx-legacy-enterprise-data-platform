                  <outputColumn refId="Package\Calculate NA Commission\stg SaleLine NA.Outputs[OLE DB Source Output].Columns[InvoiceNumber]" dataType="wstr" length="30" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Calculate NA Commission\stg SaleLine NA.Outputs[OLE DB Source Output].ExternalColumns[InvoiceNumber]" lineageId="Package\Calculate NA Commission\stg SaleLine NA.Outputs[OLE DB Source Output].Columns[InvoiceNumber]" name="InvoiceNumber" truncationRowDisposition="RedirectRow" />
