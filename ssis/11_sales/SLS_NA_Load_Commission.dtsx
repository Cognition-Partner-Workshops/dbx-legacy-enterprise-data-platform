          <component refId="Package\Calculate NA Commission\Apply NA Plan Rules" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Apply NA Plan Rules" usesDispositions="true">
            <inputs>
              <input refId="Package\Calculate NA Commission\Apply NA Plan Rules.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Calculate NA Commission\Apply NA Plan Rules.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Calculate NA Commission\Apply NA Plan Rules.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Calculate NA Commission\Apply NA Plan Rules.Outputs[Derived Column Output].Columns[BaseCommissionAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Calculate NA Commission\Apply NA Plan Rules.Outputs[Derived Column Output].Columns[BaseCommissionAmount]" name="BaseCommissionAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">CommissionableAmount * BaseRatePercent / 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">CommissionableAmount * BaseRatePercent / 100</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Calculate NA Commission\Apply NA Plan Rules.Outputs[Derived Column Output].Columns[AcceleratorCommissionAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Calculate NA Commission\Apply NA Plan Rules.Outputs[Derived Column Output].Columns[AcceleratorCommissionAmount]" name="AcceleratorCommissionAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">CommissionableAmount &gt; AcceleratorThresholdAmount ? (CommissionableAmount - AcceleratorThresholdAmount) * AcceleratorRatePercent / 100 : (DT_NUMERIC,18,2)0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">CommissionableAmount &gt; AcceleratorThresholdAmount ? (CommissionableAmount - AcceleratorThresholdAmount) * AcceleratorRatePercent / 100 : (DT_NUMERIC,18,2)0</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Calculate NA Commission\Apply NA Plan Rules.Outputs[Derived Column Output].Columns[HouseAccountFactor]" dataType="numeric" precision="18" scale="2" lineageId="Package\Calculate NA Commission\Apply NA Plan Rules.Outputs[Derived Column Output].Columns[HouseAccountFactor]" name="HouseAccountFactor">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(IsHouseAccount) ? (DT_NUMERIC,18,2)1 : (IsHouseAccount ? (DT_NUMERIC,18,2)@[$Package::HouseAccountRatePercent] / 100 : (DT_NUMERIC,18,2)1)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(IsHouseAccount) ? (DT_NUMERIC,18,2)1 : (IsHouseAccount ? (DT_NUMERIC,18,2)@[$Package::HouseAccountRatePercent] / 100 : (DT_NUMERIC,18,2)1)</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
