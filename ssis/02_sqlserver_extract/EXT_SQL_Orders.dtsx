                  <outputColumn refId="Package\Extract Orders\OLTP Sales.Orders.Outputs[OLE DB Source Output].Columns[CustomerID]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Orders\OLTP Sales.Orders.Outputs[OLE DB Source Output].ExternalColumns[CustomerID]" lineageId="Package\Extract Orders\OLTP Sales.Orders.Outputs[OLE DB Source Output].Columns[CustomerID]" name="CustomerID" truncationRowDisposition="RedirectRow" />
