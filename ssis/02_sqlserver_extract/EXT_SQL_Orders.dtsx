                  <outputColumn refId="Package\Extract Orders\OLTP Sales.Orders.Outputs[OLE DB Source Output].Columns[ContactPersonID]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Orders\OLTP Sales.Orders.Outputs[OLE DB Source Output].ExternalColumns[ContactPersonID]" lineageId="Package\Extract Orders\OLTP Sales.Orders.Outputs[OLE DB Source Output].Columns[ContactPersonID]" name="ContactPersonID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Orders\OLTP Sales.Orders.Outputs[OLE DB Source Output].Columns[BackorderOrderID]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Orders\OLTP Sales.Orders.Outputs[OLE DB Source Output].ExternalColumns[BackorderOrderID]" lineageId="Package\Extract Orders\OLTP Sales.Orders.Outputs[OLE DB Source Output].Columns[BackorderOrderID]" name="BackorderOrderID" truncationRowDisposition="RedirectRow" />
