      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}"
        SQLTask:SqlStatementSource="SELECT ISNULL(LastSyncVersion, 0) AS LastSyncVersion FROM Integration.ChangeTrackingWatermark WITH (NOLOCK) WHERE ObjectName = N'Sales.Orders';"
