    <DTS:Executable
      DTS:refId="Package\Extract Orders"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{8B08A44E-D011-FE90-B995-EDA3750BDB09}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Orders"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Orders\OLTP Sales.Orders" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="OLTP Sales.Orders" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  o.OrderID,
        o.CustomerID,
        o.SalespersonPersonID,
        o.PickedByPersonID,
        o.ContactPersonID,
        o.BackorderOrderID,
        o.OrderDate,
        o.ExpectedDeliveryDate,
        o.CustomerPurchaseOrderNumber,
        o.IsUndersupplyBackordered,
        o.Comments,
        o.DeliveryInstructions,
        st.SalesTerritoryID,
        ISNULL(sc.SalesChannelCode, N'DIRECT')  AS SalesChannelCode,
        o.PickingCompletedWhen,
        o.LastEditedWhen,
        o.LastEditedBy
FROM    Sales.Orders AS o WITH (NOLOCK)
        LEFT OUTER JOIN Sales.SalesTerritories AS st WITH (NOLOCK)
            ON st.SalesTerritoryID = o.SalesTerritoryID
        LEFT OUTER JOIN Sales.SalesChannels AS sc WITH (NOLOCK)
            ON sc.SalesChannelID = o.SalesChannelID
WHERE   o.OrderID &gt; ?
  AND   o.OrderID &lt;= ?
ORDER BY o.OrderID;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Orders\OLTP Sales.Orders.Connections[OleDbConnection]" connectionManagerID="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Source_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Extract Orders\OLTP Sales.Orders.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
