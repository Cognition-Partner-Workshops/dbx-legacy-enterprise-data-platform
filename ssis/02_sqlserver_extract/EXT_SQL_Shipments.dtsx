                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">OriginCountryCode == DestinationCountryCode ? "N" : "Y"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">OriginCountryCode == DestinationCountryCode ? "N" : "Y"</property>
