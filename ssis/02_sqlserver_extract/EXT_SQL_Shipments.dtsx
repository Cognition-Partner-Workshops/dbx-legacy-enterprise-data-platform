    <DTS:Executable
      DTS:refId="Package\Read Source Max ShipmentHeaderID"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{99AA916B-1EFB-1ADB-0537-6382D20E70E3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Read Source Max ShipmentHeaderID"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}"
        SQLTask:SqlStatementSource="SELECT ISNULL(MAX(ShipmentHeaderID), 0) AS MaxKey FROM Shipping.ShipmentHeaders WITH (NOLOCK);"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="300"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
