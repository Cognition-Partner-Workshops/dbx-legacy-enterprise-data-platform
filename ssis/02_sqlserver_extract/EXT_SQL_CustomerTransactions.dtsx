      <SQLTask:SqlTaskData
        SQLTask:Connection="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}"
        SQLTask:SqlStatementSource="SELECT ISNULL(MAX(CustomerTransactionID), 0) AS MaxKey FROM Sales.CustomerTransactions WITH (NOLOCK);"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="300"
        SQLTask:SqlStmtSourceType="DirectInput"
