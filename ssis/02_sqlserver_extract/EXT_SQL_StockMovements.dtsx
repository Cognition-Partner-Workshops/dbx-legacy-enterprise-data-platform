      <SQLTask:SqlTaskData
        SQLTask:Connection="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}"
        SQLTask:SqlStatementSource="SELECT ISNULL(MAX(StockItemTransactionID), 0) AS MaxKey FROM Warehouse.StockItemTransactions WITH (NOLOCK);"
