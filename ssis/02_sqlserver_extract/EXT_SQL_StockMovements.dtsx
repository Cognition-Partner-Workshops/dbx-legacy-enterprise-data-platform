    <DTS:Executable
      DTS:refId="Package\Extract Stock Movements"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{BFFE77C9-63A3-FA0A-DF05-520E4C2EBE6E}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Stock Movements"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Stock Movements\OLTP vw_StockMovementExtract" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="OLTP vw_StockMovementExtract" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">7200</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  m.StockItemTransactionID,
        m.StockItemID,
        m.TransactionTypeID,
        tt.TransactionTypeName,
        m.CustomerID,
        m.SupplierID,
        m.InvoiceID,
        m.PurchaseOrderID,
        m.Quantity,
        ws.WarehouseSiteCode,
        b.BinCode,
        CASE WHEN m.Quantity &gt;= 0 THEN N'IN' ELSE N'OUT' END AS MovementDirectionCode,
        m.TransactionOccurredWhen,
        m.LastEditedWhen
FROM    Warehouse.vw_StockMovementExtract AS m WITH (NOLOCK)
        INNER JOIN Application.TransactionTypes AS tt WITH (NOLOCK)
            ON tt.TransactionTypeID = m.TransactionTypeID
        LEFT OUTER JOIN Warehouse.Bins AS b WITH (NOLOCK)
            ON b.BinID = m.BinID
        LEFT OUTER JOIN Warehouse.WarehouseSites AS ws WITH (NOLOCK)
            ON ws.WarehouseSiteID = b.WarehouseSiteID
WHERE   m.StockItemTransactionID &gt; ?
  AND   m.StockItemTransactionID &lt;= ?
ORDER BY m.StockItemTransactionID;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Stock Movements\OLTP vw_StockMovementExtract.Connections[OleDbConnection]" connectionManagerID="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Source_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
