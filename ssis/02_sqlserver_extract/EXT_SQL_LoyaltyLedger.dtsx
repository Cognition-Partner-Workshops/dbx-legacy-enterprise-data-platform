                  <outputColumn refId="Package\Extract Loyalty Ledger\OLTP Loyalty_LoyaltyPointsLedger.Outputs[OLE DB Source Output].Columns[ProgramCode]" dataType="wstr" length="30" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Loyalty Ledger\OLTP Loyalty_LoyaltyPointsLedger.Outputs[OLE DB Source Output].ExternalColumns[ProgramCode]" lineageId="Package\Extract Loyalty Ledger\OLTP Loyalty_LoyaltyPointsLedger.Outputs[OLE DB Source Output].Columns[ProgramCode]" name="ProgramCode" truncationRowDisposition="RedirectRow" />
