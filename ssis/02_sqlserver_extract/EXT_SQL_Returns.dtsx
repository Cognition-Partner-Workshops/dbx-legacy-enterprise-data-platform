    <DTS:Executable
      DTS:refId="Package\Extract Return Lines"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{4535E819-AAF2-F07E-A150-8C35BF301837}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Return Lines"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Return Lines\OLTP vw_ReturnExtract" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="OLTP vw_ReturnExtract" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  rl.ReturnLineID,
        ra.ReturnAuthorizationID,
        ra.ReturnAuthorizationNumber,
        ra.CustomerID,
        rl.InvoiceLineID,
        rl.StockItemID,
        rl.ReturnedQuantity,
        rr.ReturnReasonCode,
        rr.ReturnReasonDescription,
        ISNULL(ri.InspectionOutcomeCode, N'PENDING')    AS InspectionOutcomeCode,
        ISNULL(ri.DispositionCode, N'UNKNOWN')          AS DispositionCode,
        rl.RefundAmount,
        ra.RegionCode,
        ra.ReturnedWhen,
        ri.InspectedWhen,
        rl.LastEditedWhen
FROM    Returns.vw_ReturnExtract AS rl WITH (NOLOCK)
        INNER JOIN Returns.ReturnAuthorizations AS ra WITH (NOLOCK)
            ON ra.ReturnAuthorizationID = rl.ReturnAuthorizationID
        INNER JOIN Returns.ReturnReasons AS rr WITH (NOLOCK)
            ON rr.ReturnReasonID = rl.ReturnReasonID
        LEFT OUTER JOIN Returns.ReturnInspections AS ri WITH (NOLOCK)
            ON ri.ReturnLineID = rl.ReturnLineID
WHERE   rl.ReturnLineID &gt; ?
ORDER BY rl.ReturnLineID;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Return Lines\OLTP vw_ReturnExtract.Connections[OleDbConnection]" connectionManagerID="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Source_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Extract Return Lines\OLTP vw_ReturnExtract.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Extract Return Lines\OLTP vw_ReturnExtract.Outputs[OLE DB Source Output].Columns[ReturnLineID]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Return Lines\OLTP vw_ReturnExtract.Outputs[OLE DB Source Output].ExternalColumns[ReturnLineID]" lineageId="Package\Extract Return Lines\OLTP vw_ReturnExtract.Outputs[OLE DB Source Output].Columns[ReturnLineID]" name="ReturnLineID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Return Lines\OLTP vw_ReturnExtract.Outputs[OLE DB Source Output].Columns[ReturnAuthorizationID]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Return Lines\OLTP vw_ReturnExtract.Outputs[OLE DB Source Output].ExternalColumns[ReturnAuthorizationID]" lineageId="Package\Extract Return Lines\OLTP vw_ReturnExtract.Outputs[OLE DB Source Output].Columns[ReturnAuthorizationID]" name="ReturnAuthorizationID" truncationRowDisposition="RedirectRow" />
