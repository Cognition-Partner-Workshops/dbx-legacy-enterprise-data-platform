    <DTS:Executable
      DTS:refId="Package\Extract Stock Transfers"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{1E55114A-162D-8D7D-AFE7-FF46A2966825}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Stock Transfers"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Stock Transfers\OLTP Warehouse.StockTransferLines" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="OLTP Warehouse.StockTransferLines" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  tl.StockTransferLineID,
        tl.StockTransferID,
        t.TransferReference,
        tl.StockItemID,
        fs.WarehouseSiteCode    AS FromSiteCode,
        ts.WarehouseSiteCode    AS ToSiteCode,
        tl.TransferQuantity,
        tl.ReceivedQuantity,
        t.TransferStatusCode,
        t.DispatchedWhen,
        tl.ReceivedWhen,
        tl.LastEditedWhen
FROM    Warehouse.StockTransferLines AS tl WITH (NOLOCK)
        INNER JOIN Warehouse.StockTransfers AS t WITH (NOLOCK)
            ON t.StockTransferID = tl.StockTransferID
        INNER JOIN Warehouse.WarehouseSites AS fs WITH (NOLOCK)
            ON fs.WarehouseSiteID = t.FromWarehouseSiteID
        INNER JOIN Warehouse.WarehouseSites AS ts WITH (NOLOCK)
            ON ts.WarehouseSiteID = t.ToWarehouseSiteID
WHERE   tl.StockTransferLineID &gt; ?
  AND   t.TransferStatusCode &lt;&gt; N'CANC'
ORDER BY tl.StockTransferLineID;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Stock Transfers\OLTP Warehouse.StockTransferLines.Connections[OleDbConnection]" connectionManagerID="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Source_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
