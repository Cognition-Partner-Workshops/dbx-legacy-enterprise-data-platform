    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Clear Session Window"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E56B983A-115F-8F63-F840-A7E73A81CB1A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Clear Session Window"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DELETE FROM raw.SqlWebSession WHERE SessionStartedWhen &gt;= CAST(? AS datetime2(7)) AND SessionStartedWhen &lt; CAST(? AS datetime2(7));"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::WatermarkFrom" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::WatermarkTo" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Extract Web Sessions"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{B7147F9A-EECC-029F-3CE9-2747CD8012FE}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Web Sessions"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="OLTP Ecommerce_WebSessions" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  ws.WebSessionID,
        ws.SessionGuid,
        ws.CustomerID,
        ws.RegionCode,
        ws.ChannelCode,
        ws.DeviceCategoryCode,
        CASE WHEN ws.RegionCode = N'EU' AND ws.AnalyticsConsentCode &lt;&gt; N'GRANTED'
             THEN NULL ELSE ws.DeviceFingerprint END    AS DeviceFingerprint,
        CASE WHEN ws.RegionCode = N'EU' AND ws.AnalyticsConsentCode &lt;&gt; N'GRANTED'
             THEN NULL ELSE ws.ReferrerDomain END       AS ReferrerDomain,
        ws.LandingPagePath,
        ws.PageViewCount,
        DATEDIFF(second, ws.SessionStartedWhen, ws.SessionEndedWhen) AS SessionDurationSeconds,
        CASE WHEN ch.CartHeaderID IS NULL THEN 0 ELSE 1 END          AS HasCartActivity,
        ws.HasCheckout,
        ws.AnalyticsConsentCode,
        ws.SessionStartedWhen,
        ws.SessionEndedWhen
FROM    Ecommerce.WebSessions AS ws WITH (NOLOCK)
        LEFT OUTER JOIN Ecommerce.CartHeaders AS ch WITH (NOLOCK)
            ON ch.WebSessionID = ws.WebSessionID
WHERE   ws.SessionStartedWhen &gt;= CAST(? AS datetime2(7))
  AND   ws.SessionStartedWhen &lt;  CAST(? AS datetime2(7));</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Connections[OleDbConnection]" connectionManagerID="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Source_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[WebSessionID]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].ExternalColumns[WebSessionID]" lineageId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[WebSessionID]" name="WebSessionID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[SessionGuid]" dataType="wstr" length="36" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].ExternalColumns[SessionGuid]" lineageId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[SessionGuid]" name="SessionGuid" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[CustomerID]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].ExternalColumns[CustomerID]" lineageId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[CustomerID]" name="CustomerID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[ChannelCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].ExternalColumns[ChannelCode]" lineageId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[ChannelCode]" name="ChannelCode" truncationRowDisposition="RedirectRow" />
