                  <outputColumn refId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[ReferrerDomain]" dataType="wstr" length="120" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].ExternalColumns[ReferrerDomain]" lineageId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[ReferrerDomain]" name="ReferrerDomain" truncationRowDisposition="RedirectRow" />
