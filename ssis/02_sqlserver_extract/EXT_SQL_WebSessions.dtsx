                  <outputColumn refId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[SessionStartedWhen]" dataType="dbTimeStamp" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].ExternalColumns[SessionStartedWhen]" lineageId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[SessionStartedWhen]" name="SessionStartedWhen" truncationRowDisposition="RedirectRow" />
