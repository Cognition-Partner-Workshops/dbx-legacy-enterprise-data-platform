                  <outputColumn refId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[HasCartActivity]" dataType="bool" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].ExternalColumns[HasCartActivity]" lineageId="Package\Extract Web Sessions\OLTP Ecommerce_WebSessions.Outputs[OLE DB Source Output].Columns[HasCartActivity]" name="HasCartActivity" truncationRowDisposition="RedirectRow" />
