                  <outputColumn refId="Package\Load Promotions\OLTP Sales_Promotions.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Promotions\OLTP Sales_Promotions.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\Load Promotions\OLTP Sales_Promotions.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
