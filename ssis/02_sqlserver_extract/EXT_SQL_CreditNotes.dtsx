                  <outputColumn refId="Package\Extract Credit Note Lines\OLTP vw_CreditNoteExtract.Outputs[OLE DB Source Output].Columns[CustomerID]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Credit Note Lines\OLTP vw_CreditNoteExtract.Outputs[OLE DB Source Output].ExternalColumns[CustomerID]" lineageId="Package\Extract Credit Note Lines\OLTP vw_CreditNoteExtract.Outputs[OLE DB Source Output].Columns[CustomerID]" name="CustomerID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Credit Note Lines\OLTP vw_CreditNoteExtract.Outputs[OLE DB Source Output].Columns[InvoiceID]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Credit Note Lines\OLTP vw_CreditNoteExtract.Outputs[OLE DB Source Output].ExternalColumns[InvoiceID]" lineageId="Package\Extract Credit Note Lines\OLTP vw_CreditNoteExtract.Outputs[OLE DB Source Output].Columns[InvoiceID]" name="InvoiceID" truncationRowDisposition="RedirectRow" />
