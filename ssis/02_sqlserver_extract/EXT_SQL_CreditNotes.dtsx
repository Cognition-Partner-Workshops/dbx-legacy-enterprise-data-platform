    <DTS:Executable
      DTS:refId="Package\Extract Credit Note Lines"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{5964A403-B415-C2C3-35E5-9A88DFEB2E02}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Credit Note Lines"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Credit Note Lines\OLTP vw_CreditNoteExtract" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="OLTP vw_CreditNoteExtract" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  cl.CreditNoteLineID,
        cn.CreditNoteID,
        cn.CreditNoteNumber,
        cn.CustomerID,
        cn.InvoiceID,
        cl.StockItemID,
        cl.CreditedQuantity,
        cl.CreditedExcludingTax,
        cl.CreditedTaxAmount,
        cl.CreditedIncludingTax,
        cn.RegionCode,
        CASE cn.RegionCode
            WHEN N'NA'   THEN N'SALESTAX'
            WHEN N'EU'   THEN N'VAT'
            WHEN N'APAC' THEN N'GST'
            ELSE N'NONE'
        END                                 AS TaxTreatmentCode,
        CASE cn.RegionCode
            WHEN N'NA'   THEN N'ORIGRATE'
            WHEN N'EU'   THEN N'CREDITREF'
            WHEN N'APAC' THEN N'ISSUEPRD'
            ELSE N'NONE'
        END                                 AS TaxReversalBasisCode,
        cn.CreditNoteDate,
        cl.LastEditedWhen
FROM    Returns.vw_CreditNoteExtract AS cl WITH (NOLOCK)
        INNER JOIN Returns.CreditNotes AS cn WITH (NOLOCK)
            ON cn.CreditNoteID = cl.CreditNoteID
WHERE   cl.CreditNoteLineID &gt; ?
  AND   cn.IsVoided = 0
ORDER BY cl.CreditNoteLineID;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Credit Note Lines\OLTP vw_CreditNoteExtract.Connections[OleDbConnection]" connectionManagerID="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Source_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Extract Credit Note Lines\OLTP vw_CreditNoteExtract.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
