                  <outputColumn refId="Package\Extract Credit Note Lines\OLTP vw_CreditNoteExtract.Outputs[OLE DB Source Output].Columns[CreditNoteLineID]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Credit Note Lines\OLTP vw_CreditNoteExtract.Outputs[OLE DB Source Output].ExternalColumns[CreditNoteLineID]" lineageId="Package\Extract Credit Note Lines\OLTP vw_CreditNoteExtract.Outputs[OLE DB Source Output].Columns[CreditNoteLineID]" name="CreditNoteLineID" truncationRowDisposition="RedirectRow" />
