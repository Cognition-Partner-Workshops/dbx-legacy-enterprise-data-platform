    <DTS:Executable
      DTS:refId="Package\Extract Order Lines"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{F49C0C29-CFA7-4F45-D513-500D51E3EE25}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Order Lines"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Order Lines\OLTP vw_OrderLineExtract" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="OLTP vw_OrderLineExtract" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">7200</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  ol.OrderLineID,
        ol.OrderID,
        ol.StockItemID,
        ol.Description,
        ol.PackageTypeName,
        ol.Quantity,
        ol.UnitPrice,
        ol.TaxRate,
        CAST(ol.Quantity * ol.UnitPrice * (1.0 + ol.TaxRate / 100.0) AS decimal(18,2)) AS ExtendedPrice,
        ISNULL(od.DiscountAmount, 0.00)                                                AS LineDiscountAmount,
        od.PromotionCode,
        ol.PickedQuantity,
        ol.PickingCompletedWhen,
        ol.LastEditedWhen
FROM    Sales.vw_OrderLineExtract AS ol WITH (NOLOCK)
        LEFT OUTER JOIN Sales.OrderDiscounts AS od WITH (NOLOCK)
            ON od.OrderLineID = ol.OrderLineID
           AND od.IsVoided = 0
WHERE   ol.OrderLineID &gt; ?
  AND   ol.OrderLineID &lt;= ?
ORDER BY ol.OrderLineID;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Order Lines\OLTP vw_OrderLineExtract.Connections[OleDbConnection]" connectionManagerID="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Source_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
