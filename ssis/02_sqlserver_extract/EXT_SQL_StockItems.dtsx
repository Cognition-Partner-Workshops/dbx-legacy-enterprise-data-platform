    <DTS:Executable
      DTS:refId="Package\Extract Stock Items"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{1F5274D0-4AAD-637D-64CD-661F36F1F8BE}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Extract Stock Items"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Extract Stock Items\OLTP Warehouse.StockItems" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="OLTP Warehouse.StockItems" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">2400</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  si.StockItemID,
        si.StockItemName,
        si.SupplierID,
        si.ColorID,
        si.UnitPackageID,
        si.OuterPackageID,
        si.Brand,
        si.Size,
        si.LeadTimeDays,
        si.QuantityPerOuter,
        si.IsChillerStock,
        si.Barcode,
        si.TaxRate,
        si.UnitPrice,
        si.RecommendedRetailPrice,
        si.TypicalWeightPerUnit,
        sh.QuantityOnHand,
        sh.ReorderLevel,
        sh.TargetStockLevel,
        rr.ReplenishmentRuleCode,
        si.ValidFrom,
        si.LastEditedWhen
FROM    Warehouse.StockItems AS si WITH (NOLOCK)
        LEFT OUTER JOIN Warehouse.StockItemHoldings AS sh WITH (NOLOCK)
            ON sh.StockItemID = si.StockItemID
        LEFT OUTER JOIN Warehouse.ReplenishmentRules AS rr WITH (NOLOCK)
            ON rr.StockItemID = si.StockItemID
           AND rr.IsCurrent = 1
WHERE   si.ValidFrom &gt;= DATEADD(minute, -240, CAST(? AS datetime2(7)))
  AND   si.ValidFrom &lt;  CAST(? AS datetime2(7));</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Extract Stock Items\OLTP Warehouse.StockItems.Connections[OleDbConnection]" connectionManagerID="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Source_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Extract Stock Items\OLTP Warehouse.StockItems.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Extract Stock Items\OLTP Warehouse.StockItems.Outputs[OLE DB Source Output].Columns[StockItemID]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Stock Items\OLTP Warehouse.StockItems.Outputs[OLE DB Source Output].ExternalColumns[StockItemID]" lineageId="Package\Extract Stock Items\OLTP Warehouse.StockItems.Outputs[OLE DB Source Output].Columns[StockItemID]" name="StockItemID" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Extract Stock Items\OLTP Warehouse.StockItems.Outputs[OLE DB Source Output].Columns[StockItemName]" dataType="wstr" length="100" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Extract Stock Items\OLTP Warehouse.StockItems.Outputs[OLE DB Source Output].ExternalColumns[StockItemName]" lineageId="Package\Extract Stock Items\OLTP Warehouse.StockItems.Outputs[OLE DB Source Output].Columns[StockItemName]" name="StockItemName" truncationRowDisposition="RedirectRow" />
