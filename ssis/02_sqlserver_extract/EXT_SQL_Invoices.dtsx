      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}"
        SQLTask:SqlStatementSource="SELECT ISNULL(MAX(InvoiceID), 0) AS MaxKey FROM Sales.Invoices WITH (NOLOCK);"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="300"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
