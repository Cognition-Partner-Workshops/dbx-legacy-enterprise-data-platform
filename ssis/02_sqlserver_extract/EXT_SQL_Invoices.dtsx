    <DTS:Executable
      DTS:refId="Package\Read Source Max InvoiceID"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C37D980B-D04E-998E-16F8-3D771C543AEB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
