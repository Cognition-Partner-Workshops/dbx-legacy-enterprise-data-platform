<?xml version="1.0"?>
<DTS:ConnectionManager xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:ObjectName="WWI_Staging_DB"
  DTS:DTSID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
  DTS:CreationName="OLEDB"
  DTS:Description="WideWorldImporters staging database (raw, stg, work, err, etl schemas).">
  <DTS:PropertyExpression DTS:Name="ServerName">@[$Project::SqlServerHost] + "," + (DT_WSTR, 12) @[$Project::SqlServerPort]</DTS:PropertyExpression>
  <DTS:PropertyExpression DTS:Name="InitialCatalog">@[$Project::SqlServerStagingDb]</DTS:PropertyExpression>
  <DTS:PropertyExpression DTS:Name="UserName">@[$Project::SqlServerUser]</DTS:PropertyExpression>
  <DTS:ObjectData>
    <DTS:ConnectionManager
      DTS:ConnectionString="Data Source=sqlserver.internal.example,1433;Initial Catalog=WideWorldImporters_Staging;Provider=MSOLEDBSQL19.1;Auto Translate=False;Trust Server Certificate=True;" />
  </DTS:ObjectData>
</DTS:ConnectionManager>
