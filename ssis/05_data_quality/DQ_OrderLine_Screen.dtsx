              <output refId="Package\DFT Screen Order Line\Evaluate Order Line Rules.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Screen Order Line\Evaluate Order Line Rules.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Screen Order Line\Evaluate Order Line Rules.Outputs[Derived Column Output].Columns[QuantityOutOfRangeFlag]" dataType="wstr" length="1" errorOrTruncationOperation="Computation" errorRowDisposition="FailComponent" lineageId="Package\DFT Screen Order Line\Evaluate Order Line Rules.Outputs[Derived Column Output].Columns[QuantityOutOfRangeFlag]" name="QuantityOutOfRangeFlag" truncationRowDisposition="FailComponent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">Quantity &lt;= 0 || Quantity &gt; 10000 ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">Quantity &lt;= 0 || Quantity &gt; 10000 ? "Y" : "N"</property>
                    </properties>
