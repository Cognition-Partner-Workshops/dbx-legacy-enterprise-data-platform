                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">Quantity &lt;= 0 || Quantity &gt; 10000 ? "DQ_OL_QTY_RANGE" : (UnitPriceAmount &gt; 250000 ? "DQ_OL_PRICE_OUTLIER" : "DQ_OL_EXTENSION")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">Quantity &lt;= 0 || Quantity &gt; 10000 ? "DQ_OL_QTY_RANGE" : (UnitPriceAmount &gt; 250000 ? "DQ_OL_PRICE_OUTLIER" : "DQ_OL_EXTENSION")</property>
