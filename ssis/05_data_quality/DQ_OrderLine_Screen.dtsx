                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UnitPriceAmount &gt; 250000 ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UnitPriceAmount &gt; 250000 ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
