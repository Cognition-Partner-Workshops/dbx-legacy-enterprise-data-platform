                  <outputColumn refId="Package\DFT Screen Partner File\Evaluate File Row Rules.Outputs[Derived Column Output].Columns[DelimiterBreachFlag]" dataType="wstr" length="1" lineageId="Package\DFT Screen Partner File\Evaluate File Row Rules.Outputs[Derived Column Output].Columns[DelimiterBreachFlag]" name="DelimiterBreachFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DelimiterCount != 8 ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DelimiterCount != 8 ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Screen Partner File\Evaluate File Row Rules.Outputs[Derived Column Output].Columns[UnparsableDateFlag]" dataType="wstr" length="1" lineageId="Package\DFT Screen Partner File\Evaluate File Row Rules.Outputs[Derived Column Output].Columns[UnparsableDateFlag]" name="UnparsableDateFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(SaleDateText) || LEN(TRIM(SaleDateText)) &lt; 8 || (FINDSTRING(SaleDateText, "/", 1) == 0 &amp;&amp; FINDSTRING(SaleDateText, "-", 1) == 0) ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(SaleDateText) || LEN(TRIM(SaleDateText)) &lt; 8 || (FINDSTRING(SaleDateText, "/", 1) == 0 &amp;&amp; FINDSTRING(SaleDateText, "-", 1) == 0) ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Screen Partner File\Evaluate File Row Rules.Outputs[Derived Column Output].Columns[UnparsableAmountFlag]" dataType="wstr" length="1" lineageId="Package\DFT Screen Partner File\Evaluate File Row Rules.Outputs[Derived Column Output].Columns[UnparsableAmountFlag]" name="UnparsableAmountFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(AmountText) || LEN(REPLACE(REPLACE(REPLACE(TRIM(AmountText), ",", ""), "$", ""), ".", "")) == 0 ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(AmountText) || LEN(REPLACE(REPLACE(REPLACE(TRIM(AmountText), ",", ""), "$", ""), ".", "")) == 0 ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Screen Partner File\Evaluate File Row Rules.Outputs[Derived Column Output].Columns[HighBitFlag]" dataType="wstr" length="1" lineageId="Package\DFT Screen Partner File\Evaluate File Row Rules.Outputs[Derived Column Output].Columns[HighBitFlag]" name="HighBitFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">FINDSTRING(RawLine, "\uFFFD", 1) &gt; 0 ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">FINDSTRING(RawLine, "\uFFFD", 1) &gt; 0 ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Screen Partner File\Evaluate File Row Rules.Outputs[Derived Column Output].Columns[RejectReasonCode]" dataType="wstr" length="30" lineageId="Package\DFT Screen Partner File\Evaluate File Row Rules.Outputs[Derived Column Output].Columns[RejectReasonCode]" name="RejectReasonCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DelimiterCount != 8 ? "DQ_FILE_DELIMITER" : (ISNULL(SaleDateText) ? "DQ_FILE_DATE" : "DQ_FILE_AMOUNT")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DelimiterCount != 8 ? "DQ_FILE_DELIMITER" : (ISNULL(SaleDateText) ? "DQ_FILE_DATE" : "DQ_FILE_AMOUNT")</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
