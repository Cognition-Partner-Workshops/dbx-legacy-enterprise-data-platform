              <output refId="Package\DFT Reconcile Control Totals\Count Objects Reconciled.Outputs[Row Count Output]" name="Row Count Output" synchronousInputId="Package\DFT Reconcile Control Totals\Count Objects Reconciled.Inputs[Row Count Input]" />
            </outputs>
          </component>
          <component refId="Package\DFT Reconcile Control Totals\Compute Variance Percent" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Compute Variance Percent" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Reconcile Control Totals\Compute Variance Percent.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Reconcile Control Totals\Compute Variance Percent.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Reconcile Control Totals\Compute Variance Percent.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Reconcile Control Totals\Compute Variance Percent.Outputs[Derived Column Output].Columns[RejectPercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\DFT Reconcile Control Totals\Compute Variance Percent.Outputs[Derived Column Output].Columns[RejectPercent]" name="RejectPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SourceRowCount == 0 ? (DT_NUMERIC,9,4)0 : (DT_NUMERIC,9,4)(100.0 * RejectRowCount / SourceRowCount)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">SourceRowCount == 0 ? (DT_NUMERIC,9,4)0 : (DT_NUMERIC,9,4)(100.0 * RejectRowCount / SourceRowCount)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Reconcile Control Totals\Compute Variance Percent.Outputs[Derived Column Output].Columns[VariancePercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\DFT Reconcile Control Totals\Compute Variance Percent.Outputs[Derived Column Output].Columns[VariancePercent]" name="VariancePercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SourceRowCount == 0 ? (DT_NUMERIC,9,4)0 : (DT_NUMERIC,9,4)(100.0 * VarianceRowCount / SourceRowCount)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">SourceRowCount == 0 ? (DT_NUMERIC,9,4)0 : (DT_NUMERIC,9,4)(100.0 * VarianceRowCount / SourceRowCount)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Reconcile Control Totals\Compute Variance Percent.Outputs[Derived Column Output].Columns[ReconciliationStatusCode]" dataType="wstr" length="12" lineageId="Package\DFT Reconcile Control Totals\Compute Variance Percent.Outputs[Derived Column Output].Columns[ReconciliationStatusCode]" name="ReconciliationStatusCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SourceRowCount == 0 ? "EMPTY" : (ABS(VarianceRowCount) == 0 ? "BALANCED" : (ABS(100.0 * VarianceRowCount / SourceRowCount) &lt;= 0.5 ? "WITHIN_TOL" : "BREACH"))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">SourceRowCount == 0 ? "EMPTY" : (ABS(VarianceRowCount) == 0 ? "BALANCED" : (ABS(100.0 * VarianceRowCount / SourceRowCount) &lt;= 0.5 ? "WITHIN_TOL" : "BREACH"))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Reconcile Control Totals\Compute Variance Percent.Outputs[Derived Column Output].Columns[RejectReasonCode]" dataType="wstr" length="30" lineageId="Package\DFT Reconcile Control Totals\Compute Variance Percent.Outputs[Derived Column Output].Columns[RejectReasonCode]" name="RejectReasonCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">"DQ_RECON_BREACH"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">"DQ_RECON_BREACH"</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
          <component refId="Package\DFT Reconcile Control Totals\Route Reconciliation Outcome" componentClassID="Microsoft.ConditionalSplit" description="Conditional Split" name="Route Reconciliation Outcome" version="1">
