      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogPackageStart @BatchId = ?, @PackageName = ?, @PackageExecutionId = ? OUTPUT;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="True"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="System::PackageName" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::PackageExecutionId" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Measure Batch Reject Rate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{89DA3549-7965-88CD-3D0F-41F09C803EB1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Batch Reject Rate"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT @Measure = CAST(100.0 * SUM(ISNULL(a.RejectRowCount, 0)) / NULLIF(SUM(ISNULL(a.SourceRowCount, 0)), 0) AS DECIMAL(9,4)) FROM etl.RowCountAudit AS a INNER JOIN etl.PackageExecution AS e ON e.PackageExecutionId = a.PackageExecutionId WHERE e.BatchId = ?;&#10;INSERT INTO etl.DataQualityResult&#10;    (BatchId, PackageExecutionId, ObjectName, RuleCode, MeasuredValue, EvaluatedAtUtc)&#10;VALUES (?, ?, N'etl.RowCountAudit', N'DQ_BATCH_REJECT_RATE', @Measure, SYSUTCDATETIME());&#10;SELECT @Measure AS MeasuredValue;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::MeasuredValue" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DFT Reconcile Control Totals"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{AF88EF8E-3B7B-3381-514C-F94E9D872CD5}"
      DTS:ExecutableType="Microsoft.Pipeline"
