          <path refId="Package\DFT Reconcile Control Totals.Paths[Derived Column Output 2]" endId="Package\DFT Reconcile Control Totals\Route Reconciliation Outcome.Inputs[Conditional Split Input]" name="Derived Column Output 2" startId="Package\DFT Reconcile Control Totals\Compute Variance Percent.Outputs[Derived Column Output]" />
          <path refId="Package\DFT Reconcile Control Totals.Paths[Balanced 3]" endId="Package\DFT Reconcile Control Totals\Count Objects Balanced.Inputs[Row Count Input]" name="Balanced 3" startId="Package\DFT Reconcile Control Totals\Route Reconciliation Outcome.Outputs[Balanced]" />
