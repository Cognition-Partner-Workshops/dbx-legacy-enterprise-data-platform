                  <outputColumn refId="Package\DFT Reconcile Control Totals\ETL RowCountAudit.Outputs[OLE DB Source Output].Columns[VarianceRowCount]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Reconcile Control Totals\ETL RowCountAudit.Outputs[OLE DB Source Output].ExternalColumns[VarianceRowCount]" lineageId="Package\DFT Reconcile Control Totals\ETL RowCountAudit.Outputs[OLE DB Source Output].Columns[VarianceRowCount]" name="VarianceRowCount" truncationRowDisposition="RedirectRow" />
