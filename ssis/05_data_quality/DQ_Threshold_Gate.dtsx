                  <outputColumn refId="Package\DFT Reconcile Control Totals\ETL RowCountAudit.Outputs[OLE DB Source Output].Columns[SourceRowCount]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Reconcile Control Totals\ETL RowCountAudit.Outputs[OLE DB Source Output].ExternalColumns[SourceRowCount]" lineageId="Package\DFT Reconcile Control Totals\ETL RowCountAudit.Outputs[OLE DB Source Output].Columns[SourceRowCount]" name="SourceRowCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Reconcile Control Totals\ETL RowCountAudit.Outputs[OLE DB Source Output].Columns[TargetRowCount]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Reconcile Control Totals\ETL RowCountAudit.Outputs[OLE DB Source Output].ExternalColumns[TargetRowCount]" lineageId="Package\DFT Reconcile Control Totals\ETL RowCountAudit.Outputs[OLE DB Source Output].Columns[TargetRowCount]" name="TargetRowCount" truncationRowDisposition="RedirectRow" />
