          <component refId="Package\DFT Screen Invoice Line\Evaluate Invoice Line Rules" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Evaluate Invoice Line Rules" usesDispositions="true">
            <inputs>
              <input refId="Package\DFT Screen Invoice Line\Evaluate Invoice Line Rules.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Screen Invoice Line\Evaluate Invoice Line Rules.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Screen Invoice Line\Evaluate Invoice Line Rules.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Screen Invoice Line\Evaluate Invoice Line Rules.Outputs[Derived Column Output].Columns[RegimeMismatchFlag]" dataType="wstr" length="1" lineageId="Package\DFT Screen Invoice Line\Evaluate Invoice Line Rules.Outputs[Derived Column Output].Columns[RegimeMismatchFlag]" name="RegimeMismatchFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(RegionCode == "EU" &amp;&amp; TaxRegimeCode != "VAT") || (RegionCode == "APAC" &amp;&amp; TaxRegimeCode != "GST") || (RegionCode == "NA" &amp;&amp; TaxRegimeCode != "SUT") ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(RegionCode == "EU" &amp;&amp; TaxRegimeCode != "VAT") || (RegionCode == "APAC" &amp;&amp; TaxRegimeCode != "GST") || (RegionCode == "NA" &amp;&amp; TaxRegimeCode != "SUT") ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Screen Invoice Line\Evaluate Invoice Line Rules.Outputs[Derived Column Output].Columns[TaxMismatchFlag]" dataType="wstr" length="1" lineageId="Package\DFT Screen Invoice Line\Evaluate Invoice Line Rules.Outputs[Derived Column Output].Columns[TaxMismatchFlag]" name="TaxMismatchFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TaxVarianceAmount &gt; (DT_NUMERIC,18,2)0.02 ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TaxVarianceAmount &gt; (DT_NUMERIC,18,2)0.02 ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Screen Invoice Line\Evaluate Invoice Line Rules.Outputs[Derived Column Output].Columns[MinorUnitBreachFlag]" dataType="wstr" length="1" lineageId="Package\DFT Screen Invoice Line\Evaluate Invoice Line Rules.Outputs[Derived Column Output].Columns[MinorUnitBreachFlag]" name="MinorUnitBreachFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">MinorUnitDigits == 0 &amp;&amp; NetAmount != (DT_NUMERIC,18,2)ROUND(NetAmount, 0) ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">MinorUnitDigits == 0 &amp;&amp; NetAmount != (DT_NUMERIC,18,2)ROUND(NetAmount, 0) ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Screen Invoice Line\Evaluate Invoice Line Rules.Outputs[Derived Column Output].Columns[RejectReasonCode]" dataType="wstr" length="30" lineageId="Package\DFT Screen Invoice Line\Evaluate Invoice Line Rules.Outputs[Derived Column Output].Columns[RejectReasonCode]" name="RejectReasonCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TaxVarianceAmount &gt; (DT_NUMERIC,18,2)0.02 ? "DQ_IL_TAX_MISMATCH" : ((RegionCode == "EU" &amp;&amp; TaxRegimeCode != "VAT") ? "DQ_IL_REGIME" : "DQ_IL_MINOR_UNIT")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TaxVarianceAmount &gt; (DT_NUMERIC,18,2)0.02 ? "DQ_IL_TAX_MISMATCH" : ((RegionCode == "EU" &amp;&amp; TaxRegimeCode != "VAT") ? "DQ_IL_REGIME" : "DQ_IL_MINOR_UNIT")</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
          <component refId="Package\DFT Screen Invoice Line\Route Invoice Line Failures" componentClassID="Microsoft.ConditionalSplit" description="Conditional Split" name="Route Invoice Line Failures">
