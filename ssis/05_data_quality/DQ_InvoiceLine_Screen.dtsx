            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">7200</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT l.InvoiceLineId, l.InvoiceId, l.StockItemId, l.Quantity, l.NetAmount,
       l.RecomputedTaxAmount, l.TaxVarianceAmount, s.SaleCurrencyCode, s.TaxRegimeCode,
       s.RegionCode
FROM stg.SaleLine AS l
     INNER JOIN stg.Sale AS s ON s.InvoiceId = l.InvoiceId
WHERE l.BatchId = ?;</property>
