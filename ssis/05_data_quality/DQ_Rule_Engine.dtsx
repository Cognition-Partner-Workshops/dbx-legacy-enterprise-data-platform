    <DTS:Executable
      DTS:refId="Package\Register Quality Rejects - etl_DataQualityResult"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6E1E02AA-DBBD-D830-FC52-1F2942CEF187}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Register Quality Rejects - etl_DataQualityResult"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DECLARE @RejectId BIGINT, @Key NVARCHAR(200), @Reason NVARCHAR(50);&#10;DECLARE dq_cur CURSOR LOCAL FAST_FORWARD FOR&#10;    SELECT r.RejectedRowId, r.BusinessKey, r.RejectReasonCode&#10;    FROM [err].[RejectedConstraintViolation] AS r&#10;    WHERE r.BatchId = ? AND r.LoggedToControl = 0;&#10;OPEN dq_cur;&#10;FETCH NEXT FROM dq_cur INTO @RejectId, @Key, @Reason;&#10;WHILE @@FETCH_STATUS = 0&#10;BEGIN&#10;    EXEC etl.usp_LogRejectedRecord @PackageExecutionId = ?, @BatchId = ?, @SourceSystemCode = ?, @ObjectName = N'etl.DataQualityResult', @BusinessKey = @Key, @RejectReasonCode = @Reason, @RejectStage = N'RuleEngine';&#10;    UPDATE [err].[RejectedConstraintViolation] SET LoggedToControl = 1 WHERE RejectedRowId = @RejectId;&#10;    FETCH NEXT FROM dq_cur INTO @RejectId, @Key, @Reason;&#10;END&#10;CLOSE dq_cur;&#10;DEALLOCATE dq_cur;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="3" SQLTask:DtsVariableName="$Package::SourceSystemCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Evaluate Each Configured Rule"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{79EC91FB-535F-C5FB-757A-B6AB78981CB1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Evaluate Each Configured Rule"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DECLARE @RuleId INT, @RuleCode NVARCHAR(30), @ObjectName NVARCHAR(200), @RuleExpression NVARCHAR(1000), @Sql NVARCHAR(MAX), @Measure DECIMAL(18,4);&#10;DECLARE rule_cur CURSOR LOCAL FAST_FORWARD FOR&#10;    SELECT DataQualityRuleId, RuleCode, ObjectName, RuleExpression&#10;    FROM etl.DataQualityRule WHERE IsActive = 1 ORDER BY RuleGroupCode, RuleCode;&#10;OPEN rule_cur;&#10;FETCH NEXT FROM rule_cur INTO @RuleId, @RuleCode, @ObjectName, @RuleExpression;&#10;WHILE @@FETCH_STATUS = 0&#10;BEGIN&#10;    SET @Sql = N'SELECT @Out = CAST(COUNT_BIG(*) AS DECIMAL(18,4)) FROM ' + @ObjectName +&#10;               N' WHERE ' + @RuleExpression + N';';&#10;    BEGIN TRY&#10;        EXEC sp_executesql @Sql, N'@Out DECIMAL(18,4) OUTPUT', @Out = @Measure OUTPUT;&#10;    END TRY&#10;    BEGIN CATCH&#10;        SET @Measure = -1;&#10;    END CATCH&#10;    INSERT INTO etl.DataQualityResult&#10;        (BatchId, PackageExecutionId, ObjectName, RuleCode, MeasuredValue, EvaluatedAtUtc)&#10;    VALUES (?, ?, @ObjectName, @RuleCode, @Measure, SYSUTCDATETIME());&#10;    FETCH NEXT FROM rule_cur INTO @RuleId, @RuleCode, @ObjectName, @RuleExpression;&#10;END&#10;CLOSE rule_cur;&#10;DEALLOCATE rule_cur;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Count Failing Rules"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{38BA1064-A790-6C2C-935F-2A436D56F3E3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Count Failing Rules"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT @FailedRuleCount = COUNT(*)&#10;FROM etl.DataQualityResult AS r&#10;     INNER JOIN etl.DataQualityRule AS d ON d.RuleCode = r.RuleCode&#10;WHERE r.BatchId = ? AND r.MeasuredValue &gt; d.ThresholdValue;&#10;SELECT @FailedRuleCount AS FailedRuleCount;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::FailedRuleCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
