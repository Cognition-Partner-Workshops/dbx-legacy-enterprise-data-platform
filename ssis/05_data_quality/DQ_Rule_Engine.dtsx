          <component refId="Package\DFT Load Rule Set\Classify Rule Severity" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Classify Rule Severity" usesDispositions="true">
            <inputs>
              <input refId="Package\DFT Load Rule Set\Classify Rule Severity.Inputs[Derived Column Input]" name="Derived Column Input">
                <inputColumns>
                  <inputColumn refId="Package\DFT Load Rule Set\Classify Rule Severity.Inputs[Derived Column Input].Columns[SeverityCode]" cachedName="SeverityCode" lineageId="Package\DFT Load Rule Set\ETL DataQualityRule.Outputs[OLE DB Source Output].Columns[SeverityCode]" name="SeverityCode" usageType="readWrite">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(SeverityCode) ? "WARN" : SeverityCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(SeverityCode) ? "WARN" : SeverityCode))</property>
                    </properties>
                  </inputColumn>
                </inputColumns>
              </input>
            </inputs>
            <outputs>
              <output refId="Package\DFT Load Rule Set\Classify Rule Severity.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Load Rule Set\Classify Rule Severity.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Load Rule Set\Classify Rule Severity.Outputs[Derived Column Output].Columns[BlockingFlag]" dataType="wstr" length="1" lineageId="Package\DFT Load Rule Set\Classify Rule Severity.Outputs[Derived Column Output].Columns[BlockingFlag]" name="BlockingFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(SeverityCode) ? "WARN" : SeverityCode)) == "FAIL" ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(SeverityCode) ? "WARN" : SeverityCode)) == "FAIL" ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Rule Set\Classify Rule Severity.Outputs[Derived Column Output].Columns[EvaluatedAtUtc]" dataType="dbTimeStamp" lineageId="Package\DFT Load Rule Set\Classify Rule Severity.Outputs[Derived Column Output].Columns[EvaluatedAtUtc]" name="EvaluatedAtUtc">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">GETUTCDATE()</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">GETUTCDATE()</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
