      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogError @PackageExecutionId = ?, @BatchId = ?, @ErrorCode = 50000, @ErrorDescription = N'One or more configured data quality rules exceeded their threshold.', @SourceName = ?;"
        SQLTask:ResultType="ResultSetType_None"
