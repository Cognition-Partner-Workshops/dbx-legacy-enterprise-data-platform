          <component refId="Package\DFT Reprocess Rejects\Prepare Retry" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Prepare Retry" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Reprocess Rejects\Prepare Retry.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Reprocess Rejects\Prepare Retry.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Reprocess Rejects\Prepare Retry.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Reprocess Rejects\Prepare Retry.Outputs[Derived Column Output].Columns[RetryCount]" dataType="i4" lineageId="Package\DFT Reprocess Rejects\Prepare Retry.Outputs[Derived Column Output].Columns[RetryCount]" name="RetryCount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(RetryCount) ? 1 : RetryCount + 1</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(RetryCount) ? 1 : RetryCount + 1</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Reprocess Rejects\Prepare Retry.Outputs[Derived Column Output].Columns[AgeDays]" dataType="i4" lineageId="Package\DFT Reprocess Rejects\Prepare Retry.Outputs[Derived Column Output].Columns[AgeDays]" name="AgeDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DATEDIFF("day", FirstRejectedAtUtc, GETUTCDATE())</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DATEDIFF("day", FirstRejectedAtUtc, GETUTCDATE())</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Reprocess Rejects\Prepare Retry.Outputs[Derived Column Output].Columns[StockItemId]" dataType="i4" lineageId="Package\DFT Reprocess Rejects\Prepare Retry.Outputs[Derived Column Output].Columns[StockItemId]" name="StockItemId">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_I4)TOKEN(BusinessKey, "|", 2)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_I4)TOKEN(BusinessKey, "|", 2)</property>
                    </properties>
                  </outputColumn>
