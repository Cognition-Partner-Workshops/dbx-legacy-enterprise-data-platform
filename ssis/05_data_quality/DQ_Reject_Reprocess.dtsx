    <DTS:Executable
      DTS:refId="Package\Register Quality Rejects - err.RejectedLookupFailure"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{533A0420-1D2A-7FE3-911B-6CF73B896410}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Register Quality Rejects - err.RejectedLookupFailure"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DECLARE @RejectId BIGINT, @Key NVARCHAR(200), @Reason NVARCHAR(50);&#10;DECLARE dq_cur CURSOR LOCAL FAST_FORWARD FOR&#10;    SELECT r.RejectedRowId, r.BusinessKey, r.RejectReasonCode&#10;    FROM [err].[RejectedLookupFailure] AS r&#10;    WHERE r.BatchId = ? AND r.LoggedToControl = 0;&#10;OPEN dq_cur;&#10;FETCH NEXT FROM dq_cur INTO @RejectId, @Key, @Reason;&#10;WHILE @@FETCH_STATUS = 0&#10;BEGIN&#10;    EXEC etl.usp_LogRejectedRecord @PackageExecutionId = ?, @BatchId = ?, @SourceSystemCode = ?, @ObjectName = N'err.RejectedLookupFailure', @BusinessKey = @Key, @RejectReasonCode = @Reason, @RejectStage = N'Reprocess';&#10;    UPDATE [err].[RejectedLookupFailure] SET LoggedToControl = 1 WHERE RejectedRowId = @RejectId;&#10;    FETCH NEXT FROM dq_cur INTO @RejectId, @Key, @Reason;&#10;END&#10;CLOSE dq_cur;&#10;DEALLOCATE dq_cur;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="3" SQLTask:DtsVariableName="$Package::SourceSystemCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Close Reprocessed Rejects"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FC90AFB9-AED6-CE9A-E8D3-D27D07AAB0F5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Close Reprocessed Rejects"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="UPDATE err.RejectedLookupFailure&#10;SET Reprocessed = 1, ReprocessedAtUtc = SYSUTCDATETIME(), ReprocessedByExecutionId = ?&#10;WHERE Reprocessed = 0 AND RetryCount &lt; 5&#10;  AND EXISTS (SELECT 1 FROM stg.StockItem AS s&#10;              WHERE CAST(s.StockItemId AS NVARCHAR(20)) = PARSENAME(REPLACE(err.RejectedLookupFailure.BusinessKey, N'|', N'.'), 1));"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
