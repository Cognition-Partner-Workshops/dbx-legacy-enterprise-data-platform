<?xml version="1.0"?>
<DTS:ConnectionManager xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:ObjectName="WWI_Source_DB"
  DTS:DTSID="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}"
  DTS:CreationName="OLEDB"
  DTS:Description="WideWorldImporters OLTP source database.">
  <DTS:PropertyExpression DTS:Name="ConnectionString">"Data Source=" + @[$Project::SqlServerHost] + "," + (DT_WSTR, 12) @[$Project::SqlServerPort] + ";Initial Catalog=" + @[$Project::SqlServerOltpDb] + ";Provider=" + @[$Project::SqlServerProvider] + ";Auto Translate=False;" + (LEN(@[$Project::SqlServerUser]) &gt; 0 ? "User ID=" + @[$Project::SqlServerUser] + ";" : "Integrated Security=SSPI;") + (@[$Project::SqlServerTrustServerCertificate] ? "TrustServerCertificate=True;" : "")</DTS:PropertyExpression>
  <DTS:ObjectData>
    <DTS:ConnectionManager
      DTS:ConnectionString="Data Source=sqlserver.internal.example,1433;Initial Catalog=WideWorldImporters;Provider=MSOLEDBSQL19.1;Auto Translate=False;" />
  </DTS:ObjectData>
</DTS:ConnectionManager>
