    <DTS:Executable
      DTS:refId="Package\Measure Orphan Payment Rate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FD73B12D-8A56-CBBA-4CDD-E3E5449748B8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Orphan Payment Rate"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DECLARE @Measure DECIMAL(18,4);&#10;SELECT @Measure = CAST(100.0 * SUM(CASE WHEN m.PaymentNumber IS NULL THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0) AS DECIMAL(9,4)) FROM stg.Payment AS p LEFT OUTER JOIN work.PaymentMatched AS m ON m.PaymentNumber = p.PaymentNumber;&#10;INSERT INTO etl.DataQualityResult&#10;    (BatchId, PackageExecutionId, ObjectName, RuleCode, MeasuredValue, EvaluatedAtUtc)&#10;VALUES (?, ?, N'stg.Payment', N'DQ_PAY_ORPHAN_RATE', @Measure, SYSUTCDATETIME());&#10;SELECT @Measure AS MeasuredValue;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::MeasuredValue" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
