          <component refId="Package\DFT Screen Supplier\Normalize Tax Identifier" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Normalize Tax Identifier" usesDispositions="true">
            <inputs>
              <input refId="Package\DFT Screen Supplier\Normalize Tax Identifier.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Screen Supplier\Normalize Tax Identifier.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Screen Supplier\Normalize Tax Identifier.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Screen Supplier\Normalize Tax Identifier.Outputs[Derived Column Output].Columns[NormalizedTaxId]" dataType="wstr" length="30" lineageId="Package\DFT Screen Supplier\Normalize Tax Identifier.Outputs[Derived Column Output].Columns[NormalizedTaxId]" name="NormalizedTaxId">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(TaxIdentifier) ? "NONE" : UPPER(REPLACE(REPLACE(TRIM(TaxIdentifier), "-", ""), " ", ""))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(TaxIdentifier) ? "NONE" : UPPER(REPLACE(REPLACE(TRIM(TaxIdentifier), "-", ""), " ", ""))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Screen Supplier\Normalize Tax Identifier.Outputs[Derived Column Output].Columns[TermsMissingFlag]" dataType="wstr" length="1" lineageId="Package\DFT Screen Supplier\Normalize Tax Identifier.Outputs[Derived Column Output].Columns[TermsMissingFlag]" name="TermsMissingFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(PaymentTermsCode) || TRIM(PaymentTermsCode) == "" ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(PaymentTermsCode) || TRIM(PaymentTermsCode) == "" ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
