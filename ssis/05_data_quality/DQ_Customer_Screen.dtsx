              <output refId="Package\DFT Screen Customer\Evaluate Customer Rules.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Screen Customer\Evaluate Customer Rules.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Screen Customer\Evaluate Customer Rules.Outputs[Derived Column Output].Columns[NameMissingFlag]" dataType="wstr" length="1" lineageId="Package\DFT Screen Customer\Evaluate Customer Rules.Outputs[Derived Column Output].Columns[NameMissingFlag]" name="NameMissingFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomerName) || TRIM(CustomerName) == "" ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomerName) || TRIM(CustomerName) == "" ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Screen Customer\Evaluate Customer Rules.Outputs[Derived Column Output].Columns[TaxIdMissingFlag]" dataType="wstr" length="1" lineageId="Package\DFT Screen Customer\Evaluate Customer Rules.Outputs[Derived Column Output].Columns[TaxIdMissingFlag]" name="TaxIdMissingFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(TaxRegistrationNumber) || LEN(TRIM(TaxRegistrationNumber)) &lt; 6 ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(TaxRegistrationNumber) || LEN(TRIM(TaxRegistrationNumber)) &lt; 6 ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Screen Customer\Evaluate Customer Rules.Outputs[Derived Column Output].Columns[ConsentBreachFlag]" dataType="wstr" length="1" lineageId="Package\DFT Screen Customer\Evaluate Customer Rules.Outputs[Derived Column Output].Columns[ConsentBreachFlag]" name="ConsentBreachFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "EU" &amp;&amp; (MarketingConsentFlag != "Y" &amp;&amp; MarketingConsentFlag != "N") ? "Y" : (RegionCode == "EU" &amp;&amp; RetentionMonths &gt; 24 ? "Y" : "N")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "EU" &amp;&amp; (MarketingConsentFlag != "Y" &amp;&amp; MarketingConsentFlag != "N") ? "Y" : (RegionCode == "EU" &amp;&amp; RetentionMonths &gt; 24 ? "Y" : "N")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Screen Customer\Evaluate Customer Rules.Outputs[Derived Column Output].Columns[CreditImplausibleFlag]" dataType="wstr" length="1" lineageId="Package\DFT Screen Customer\Evaluate Customer Rules.Outputs[Derived Column Output].Columns[CreditImplausibleFlag]" name="CreditImplausibleFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">CreditLimitAmount &lt; 0 || CreditLimitAmount &gt; 100000000 ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">CreditLimitAmount &lt; 0 || CreditLimitAmount &gt; 100000000 ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Screen Customer\Evaluate Customer Rules.Outputs[Derived Column Output].Columns[RejectReasonCode]" dataType="wstr" length="30" lineageId="Package\DFT Screen Customer\Evaluate Customer Rules.Outputs[Derived Column Output].Columns[RejectReasonCode]" name="RejectReasonCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CustomerName) || TRIM(CustomerName) == "" ? "DQ_CUST_NAME_NULL" : (RegionCode == "EU" &amp;&amp; (MarketingConsentFlag != "Y" &amp;&amp; MarketingConsentFlag != "N") ? "DQ_CUST_CONSENT" : (CreditLimitAmount &lt; 0 ? "DQ_CUST_CREDIT_NEG" : "DQ_CUST_COUNTRY"))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CustomerName) || TRIM(CustomerName) == "" ? "DQ_CUST_NAME_NULL" : (RegionCode == "EU" &amp;&amp; (MarketingConsentFlag != "Y" &amp;&amp; MarketingConsentFlag != "N") ? "DQ_CUST_CONSENT" : (CreditLimitAmount &lt; 0 ? "DQ_CUST_CREDIT_NEG" : "DQ_CUST_COUNTRY"))</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
