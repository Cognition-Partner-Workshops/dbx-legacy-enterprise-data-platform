    <DTS:Executable
      DTS:refId="Package\Refresh Aging Summary"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7BBE031E-31D4-B67F-1BBF-63E46157A381}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Refresh Aging Summary"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DECLARE @LedgerCode nvarchar(10), @BucketCode nvarchar(6);&#10;DECLARE aging_cur CURSOR LOCAL FAST_FORWARD FOR&#10;    SELECT DISTINCT LedgerCode, AgingBucketCode FROM work.ApAgingStaging ORDER BY LedgerCode, AgingBucketCode;&#10;OPEN aging_cur;&#10;FETCH NEXT FROM aging_cur INTO @LedgerCode, @BucketCode;&#10;WHILE @@FETCH_STATUS = 0&#10;BEGIN&#10;    EXEC Integration.usp_RefreshApAgingSummary @LedgerCode = @LedgerCode, @BucketCode = @BucketCode;&#10;    FETCH NEXT FROM aging_cur INTO @LedgerCode, @BucketCode;&#10;END&#10;CLOSE aging_cur;&#10;DEALLOCATE aging_cur;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
