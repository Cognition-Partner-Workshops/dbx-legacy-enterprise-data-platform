          <component refId="Package\Load AP Aging Buckets\Derive Aging Attributes" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Aging Attributes" usesDispositions="true">
            <inputs>
              <input refId="Package\Load AP Aging Buckets\Derive Aging Attributes.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Load AP Aging Buckets\Derive Aging Attributes.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load AP Aging Buckets\Derive Aging Attributes.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load AP Aging Buckets\Derive Aging Attributes.Outputs[Derived Column Output].Columns[IsPastDue]" dataType="bool" lineageId="Package\Load AP Aging Buckets\Derive Aging Attributes.Outputs[Derived Column Output].Columns[IsPastDue]" name="IsPastDue">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DaysPastDue &gt; 0 ? (DT_BOOL)1 : (DT_BOOL)0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DaysPastDue &gt; 0 ? (DT_BOOL)1 : (DT_BOOL)0</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load AP Aging Buckets\Derive Aging Attributes.Outputs[Derived Column Output].Columns[AgingBucketSort]" dataType="i4" lineageId="Package\Load AP Aging Buckets\Derive Aging Attributes.Outputs[Derived Column Output].Columns[AgingBucketSort]" name="AgingBucketSort">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(AgingBucketCode == "CURRENT") ? 0 : ((AgingBucketCode == "B030") ? 1 : ((AgingBucketCode == "B060") ? 2 : ((AgingBucketCode == "B090") ? 3 : 4)))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(AgingBucketCode == "CURRENT") ? 0 : ((AgingBucketCode == "B030") ? 1 : ((AgingBucketCode == "B060") ? 2 : ((AgingBucketCode == "B090") ? 3 : 4)))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load AP Aging Buckets\Derive Aging Attributes.Outputs[Derived Column Output].Columns[DiscountAtRisk]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load AP Aging Buckets\Derive Aging Attributes.Outputs[Derived Column Output].Columns[DiscountAtRisk]" name="DiscountAtRisk">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DaysPastDue &gt; 0 ? (DT_NUMERIC,18,2)0 : OpenAmount * EarlyPaymentDiscountPercent / 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DaysPastDue &gt; 0 ? (DT_NUMERIC,18,2)0 : OpenAmount * EarlyPaymentDiscountPercent / 100</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
