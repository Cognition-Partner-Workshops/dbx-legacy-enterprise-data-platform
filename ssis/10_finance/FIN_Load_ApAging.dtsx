    <DTS:Executable
      DTS:refId="Package\Load AP Aging Buckets"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{517F574E-E421-EADE-8384-1441080E793F}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load AP Aging Buckets"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Load AP Aging Buckets\stg ApInvoice Open Items" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="stg ApInvoice Open Items" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  ai.ApInvoiceKey
,       ai.SupplierId
,       ai.SupplierSiteCode
,       ai.InvoiceNumber
,       ai.InvoiceDate
,       ai.DueDate
,       ai.CurrencyCode
,       ai.LedgerCode
,       ai.RegionCode
,       ai.InvoiceAmount
,       ai.PaidAmount
,       ai.InvoiceAmount - ai.PaidAmount        AS OpenAmount
,       DATEDIFF(DAY, ai.DueDate, ?)            AS DaysPastDue
        /* Buckets have not changed since the 2004 conversion. The business
           still calls the last one "90+" even though it is really 91 and over. */
,       CASE
            WHEN DATEDIFF(DAY, ai.DueDate, ?) &lt;= 0  THEN 'CURRENT'
            WHEN DATEDIFF(DAY, ai.DueDate, ?) &lt;= 30 THEN 'B030'
            WHEN DATEDIFF(DAY, ai.DueDate, ?) &lt;= 60 THEN 'B060'
            WHEN DATEDIFF(DAY, ai.DueDate, ?) &lt;= 90 THEN 'B090'
            ELSE 'B090P'
        END                                     AS AgingBucketCode
        /* NA books gross of sales tax, EU books net of recoverable VAT and
           APAC books net of GST input credit. Three different rules, three
           different columns, all of them load into the same fact. */
,       CASE ai.RegionCode
            WHEN 'NA'   THEN ai.InvoiceAmount
            WHEN 'EU'   THEN ai.InvoiceAmount - ISNULL(ai.RecoverableVatAmount, 0)
            WHEN 'APAC' THEN ai.InvoiceAmount - ISNULL(ai.GstInputCreditAmount, 0)
            ELSE ai.InvoiceAmount
        END                                     AS ReportableAmount
,       ISNULL(pt.DiscountPercent, 0)           AS EarlyPaymentDiscountPercent
FROM    stg.ApInvoice AS ai
LEFT OUTER JOIN stg.PaymentTerms AS pt
        ON  pt.PaymentTermsCode = ai.PaymentTermsCode
WHERE   ai.InvoiceAmount - ai.PaidAmount &lt;&gt; 0
AND     ai.InvoiceStatusCode NOT IN ('CANC', 'VOID', 'DRAFT')
AND     ai.LoadBatchId = ?</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Connections[OleDbConnection]" connectionManagerID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Staging_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[ApInvoiceKey]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].ExternalColumns[ApInvoiceKey]" lineageId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[ApInvoiceKey]" name="ApInvoiceKey" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[SupplierId]" dataType="wstr" length="20" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].ExternalColumns[SupplierId]" lineageId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[SupplierId]" name="SupplierId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[SupplierSiteCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].ExternalColumns[SupplierSiteCode]" lineageId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[SupplierSiteCode]" name="SupplierSiteCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[InvoiceNumber]" dataType="wstr" length="30" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].ExternalColumns[InvoiceNumber]" lineageId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[InvoiceNumber]" name="InvoiceNumber" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[InvoiceDate]" dataType="dbTimeStamp" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].ExternalColumns[InvoiceDate]" lineageId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[InvoiceDate]" name="InvoiceDate" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[DueDate]" dataType="dbTimeStamp" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].ExternalColumns[DueDate]" lineageId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[DueDate]" name="DueDate" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[CurrencyCode]" dataType="wstr" length="3" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].ExternalColumns[CurrencyCode]" lineageId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[CurrencyCode]" name="CurrencyCode" truncationRowDisposition="RedirectRow" />
