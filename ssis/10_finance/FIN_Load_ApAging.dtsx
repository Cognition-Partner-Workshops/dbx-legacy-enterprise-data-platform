                  <outputColumn refId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[DaysPastDue]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].ExternalColumns[DaysPastDue]" lineageId="Package\Load AP Aging Buckets\stg ApInvoice Open Items.Outputs[OLE DB Source Output].Columns[DaysPastDue]" name="DaysPastDue" truncationRowDisposition="RedirectRow" />
