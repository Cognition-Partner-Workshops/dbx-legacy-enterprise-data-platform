  DTS:DTSID="{D726EB9C-BFF7-E662-7C84-C7CB8E47F8C2}"
  DTS:Description="Ties the AP and AR subledgers back to the GL control accounts by ledger and period and writes the variance rows the controllers sign off. A variance inside the ledger tolerance is recorded as explained; anything larger is raised to operations."
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="13.0.4001.0"
  DTS:LocaleID="1033"
  DTS:ObjectName="FIN_Reconcile_SubledgerToGl"
  DTS:PackageType="5"
  DTS:ProtectionLevel="0"
  DTS:VersionBuild="1"
  DTS:VersionGUID="{5585AD9F-0F36-63E8-7A0A-1D4575D5FF2C}">
