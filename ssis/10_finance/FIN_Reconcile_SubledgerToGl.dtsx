  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Log Package Start"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{96FC3B55-0E93-CA83-AF5B-5378451DDAB5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Package Start"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogPackageStart @BatchId = ?, @PackageName = ?, @PackageExecutionId = ? OUTPUT;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="True"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="System::PackageName" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::PackageExecutionId" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Build Reconciliation Set"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9AECDDB5-5DAE-FBE6-5617-0164CED21AD9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Reconciliation Set"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="WITH subledger AS (&#10;    SELECT  p.[Ledger Code]      AS LedgerCode&#10;    ,       p.[Accounting Period] AS AccountingPeriod&#10;    ,       p.[Control Account]  AS AccountCode&#10;    ,       SUM(p.[Functional Amount]) AS SubledgerAmount&#10;    FROM    Fact.Payment AS p&#10;    WHERE   p.[Accounting Period] = ?&#10;    GROUP BY p.[Ledger Code], p.[Accounting Period], p.[Control Account]&#10;), ledger AS (&#10;    SELECT  g.[Ledger Code]      AS LedgerCode&#10;    ,       g.[Accounting Period] AS AccountingPeriod&#10;    ,       g.[Account Code]     AS AccountCode&#10;    ,       SUM(g.[Functional Debit Amount] - g.[Functional Credit Amount]) AS LedgerAmount&#10;    FROM    Fact.[GL Posting] AS g&#10;    WHERE   g.[Accounting Period] = ?&#10;    GROUP BY g.[Ledger Code], g.[Accounting Period], g.[Account Code]&#10;)&#10;INSERT INTO etl.ReconciliationResult&#10;    (BatchId, ReconciliationName, LedgerCode, AccountingPeriod, AccountCode,&#10;     SourceAmount, TargetAmount, VarianceAmount, VarianceStatus, EvaluatedAtUtc)&#10;SELECT  ?&#10;,       N'Subledger to GL'&#10;,       COALESCE(s.LedgerCode, l.LedgerCode)&#10;,       COALESCE(s.AccountingPeriod, l.AccountingPeriod)&#10;,       COALESCE(s.AccountCode, l.AccountCode)&#10;,       ISNULL(s.SubledgerAmount, 0)&#10;,       ISNULL(l.LedgerAmount, 0)&#10;,       ISNULL(s.SubledgerAmount, 0) - ISNULL(l.LedgerAmount, 0)&#10;,       CASE WHEN ABS(ISNULL(s.SubledgerAmount, 0) - ISNULL(l.LedgerAmount, 0)) &lt;= ?&#10;             THEN N'Within tolerance' ELSE N'Variance' END&#10;,       SYSUTCDATETIME()&#10;FROM    subledger AS s&#10;FULL OUTER JOIN ledger AS l&#10;        ON  l.LedgerCode = s.LedgerCode&#10;        AND l.AccountCode = s.AccountCode&#10;        AND l.AccountingPeriod = s.AccountingPeriod;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::AccountingPeriod" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::AccountingPeriod" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="3" SQLTask:DtsVariableName="$Package::VarianceTolerance" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Measure Variances"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5E28AE68-2788-43CB-5E2D-A522234614B8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Variances"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS VarianceRows, ISNULL(MAX(ABS(VarianceAmount)), 0) AS LargestVariance FROM etl.ReconciliationResult WHERE BatchId = ? AND VarianceStatus = N'Variance';"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::VarianceRowCount" />
        <SQLTask:ResultBinding SQLTask:ResultName="1" SQLTask:DtsVariableName="User::LargestVariance" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Apply Known Explanations"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B0F6AED2-B6C1-7345-2DBF-A9A7420CE06B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Apply Known Explanations"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="UPDATE r SET VarianceStatus = N'Explained', ExplanationCode = c.ConfigurationValue FROM etl.ReconciliationResult AS r INNER JOIN etl.Configuration AS c         ON c.ConfigurationKey = N'Finance.KnownVariance.' + r.AccountCode WHERE r.BatchId = ? AND r.VarianceStatus = N'Variance';"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Raise Unexplained Variances"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{78A1F22C-B027-4D73-DC5F-61CC60959F3B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Raise Unexplained Variances"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO etl.RejectedRecord     (BatchId, ObjectName, RejectStage, RejectReasonCode, RejectReason,      BusinessKey, LoggedAtUtc, IsReprocessed) SELECT ?, N'etl.ReconciliationResult', N'Fact', N'SUBLEDGER_VARIANCE',        N'Subledger to GL variance outside tolerance',        LedgerCode + N'|' + AccountCode, SYSUTCDATETIME(), 0 FROM etl.ReconciliationResult WHERE BatchId = ? AND VarianceStatus = N'Variance';"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Log Row Counts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F41C9678-F52A-5CFF-3FAA-181DE511DC84}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Row Counts"
      DTS:ThreadHint="0">
      <DTS:Variables />
