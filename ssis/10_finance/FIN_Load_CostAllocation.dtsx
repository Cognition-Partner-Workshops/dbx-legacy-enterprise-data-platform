    <DTS:Executable
      DTS:refId="Package\Count Allocation Rules"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AF0E5FA5-4422-F849-1844-37FCE057533D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Count Allocation Rules"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS RuleCount FROM stg.CostCentre AS cc INNER JOIN stg.CostAllocationRule AS r ON r.SourceCostCentreCode = cc.CostCentreCode WHERE r.RuleSetCode = ? AND r.IsActive = 1;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::AllocationRuleSet" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RuleCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Apply Allocation Rules"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A8DC2B33-D5B3-4FAD-02E4-AC02B232E777}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Apply Allocation Rules"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DECLARE @RuleId int, @Driver nvarchar(20), @Source nvarchar(10), @Basis nvarchar(20);&#10;DECLARE rule_cur CURSOR LOCAL FAST_FORWARD FOR&#10;    SELECT AllocationRuleId, DriverCode, SourceCostCentreCode, AllocationBasisCode&#10;    FROM   stg.CostAllocationRule&#10;    WHERE  RuleSetCode = ? AND IsActive = 1&#10;    ORDER BY RuleSequence;&#10;OPEN rule_cur;&#10;FETCH NEXT FROM rule_cur INTO @RuleId, @Driver, @Source, @Basis;&#10;WHILE @@FETCH_STATUS = 0&#10;BEGIN&#10;    INSERT INTO work.CostAllocationResult&#10;        (AllocationRuleId, SourceCostCentreCode, TargetCostCentreCode, DriverCode,&#10;         AllocatedAmount, AccountingPeriod)&#10;    SELECT  @RuleId, @Source, t.TargetCostCentreCode, @Driver,&#10;            src.PoolAmount * (t.DriverValue / NULLIF(SUM(t.DriverValue) OVER (), 0)),&#10;            ?&#10;    FROM    stg.CostAllocationTarget AS t&#10;    CROSS APPLY (SELECT SUM(Amount) AS PoolAmount&#10;                 FROM   stg.CostCentreBalance&#10;                 WHERE  CostCentreCode = @Source AND AccountingPeriod = ?) AS src&#10;    WHERE   t.AllocationRuleId = @RuleId;&#10;    FETCH NEXT FROM rule_cur INTO @RuleId, @Driver, @Source, @Basis;&#10;END&#10;CLOSE rule_cur;&#10;DEALLOCATE rule_cur;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::AllocationRuleSet" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::AccountingPeriod" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::AccountingPeriod" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Measure Unallocated Residual"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1C2F99FB-1F13-3F8F-8631-5D968E52E9CA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Unallocated Residual"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT ISNULL(SUM(b.Amount), 0) - ISNULL((SELECT SUM(AllocatedAmount) FROM work.CostAllocationResult WHERE AccountingPeriod = ?), 0) AS Residual FROM stg.CostCentreBalance AS b INNER JOIN stg.CostAllocationRule AS r ON r.SourceCostCentreCode = b.CostCentreCode WHERE b.AccountingPeriod = ? AND r.RuleSetCode = ? AND r.IsActive = 1;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::AccountingPeriod" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::AccountingPeriod" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::AllocationRuleSet" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::UnallocatedAmount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
