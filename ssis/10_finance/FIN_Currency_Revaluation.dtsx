              <output refId="Package\Load Closing Rates\Derive Inverse Rate.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Closing Rates\Derive Inverse Rate.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Closing Rates\Derive Inverse Rate.Outputs[Derived Column Output].Columns[InverseRate]" dataType="numeric" precision="18" scale="8" lineageId="Package\Load Closing Rates\Derive Inverse Rate.Outputs[Derived Column Output].Columns[InverseRate]" name="InverseRate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ConversionRate == 0 ? (DT_NUMERIC,18,8)0 : 1 / ConversionRate</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ConversionRate == 0 ? (DT_NUMERIC,18,8)0 : 1 / ConversionRate</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Closing Rates\Derive Inverse Rate.Outputs[Derived Column Output].Columns[IsTriangulated]" dataType="bool" lineageId="Package\Load Closing Rates\Derive Inverse Rate.Outputs[Derived Column Output].Columns[IsTriangulated]" name="IsTriangulated">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">QuoteCurrencyCode != "USD" ? (DT_BOOL)1 : (DT_BOOL)0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">QuoteCurrencyCode != "USD" ? (DT_BOOL)1 : (DT_BOOL)0</property>
