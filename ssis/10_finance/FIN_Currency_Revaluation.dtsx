    <DTS:Executable
      DTS:refId="Package\Find Missing Rates"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{50FBED15-B796-2DA4-2530-5919C7C6434D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Find Missing Rates"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS MissingRates FROM (    SELECT DISTINCT c.CurrencyCode FROM stg.ApInvoice AS c     WHERE c.InvoiceAmount - c.PaidAmount &lt;&gt; 0) AS open_items WHERE NOT EXISTS (SELECT 1 FROM work.FxRevaluationRate AS r                   WHERE r.CurrencyCode = open_items.CurrencyCode                     AND r.RateTypeCode = N'CLOSING');"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::MissingRateCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Revalue Open Items"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9BB320D0-F803-0B4F-9DEC-9C26F8E7B9B5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Revalue Open Items"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="UPDATE p&#10;SET    p.[Revalued Functional Amount] = p.[Transaction Amount] * r.ConversionRate&#10;,      p.[Unrealised Gain Loss Amount] =&#10;           (p.[Transaction Amount] * r.ConversionRate) - p.[Functional Amount]&#10;,      p.[Revaluation Rate Date] = r.RateDate&#10;,      p.[Revaluation Rate Type] = CASE WHEN p.[Account Class] = N'PL' THEN N'AVERAGE' ELSE N'CLOSING' END&#10;FROM   Fact.Payment AS p&#10;INNER JOIN work.FxRevaluationRate AS r&#10;        ON  r.CurrencyCode = p.[Transaction Currency Code]&#10;        AND r.RateTypeCode = CASE WHEN p.[Account Class] = N'PL' THEN N'AVERAGE' ELSE N'CLOSING' END&#10;        AND r.QuoteCurrencyCode = CASE&#10;                WHEN p.[Ledger Code] LIKE N'EU%'   THEN N'EUR'&#10;                WHEN p.[Ledger Code] LIKE N'APAC%' THEN p.[Entity Currency Code]&#10;                ELSE N'USD' END&#10;WHERE  p.[Open Amount] &lt;&gt; 0;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Count Revalued Items"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6AABE844-41AA-97C2-0908-5BE3E3E3612E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Count Revalued Items"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS RevaluedItems FROM Fact.Payment WHERE [Revaluation Rate Date] = CAST(? AS date);"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::RevaluationDate" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::RevaluedItemCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
