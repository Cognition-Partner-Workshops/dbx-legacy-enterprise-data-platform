        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.WithholdingCertificateQueue     (SupplierId, JurisdictionCode, WithholdingAmount, QueuedAtUtc, BatchId) SELECT SupplierId, JurisdictionCode, SUM(WithholdingAmount), SYSUTCDATETIME(), ? FROM   work.WithholdingTaxLine WHERE  WithholdingCertificateRequired = 1 GROUP BY SupplierId, JurisdictionCode;"
