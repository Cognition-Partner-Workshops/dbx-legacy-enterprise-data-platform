                  <outputColumn refId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].Columns[ApInvoiceKey]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].ExternalColumns[ApInvoiceKey]" lineageId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].Columns[ApInvoiceKey]" name="ApInvoiceKey" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].Columns[SupplierId]" dataType="wstr" length="20" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].ExternalColumns[SupplierId]" lineageId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].Columns[SupplierId]" name="SupplierId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].Columns[SupplierTaxRegistrationNumber]" dataType="wstr" length="30" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].ExternalColumns[SupplierTaxRegistrationNumber]" lineageId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].Columns[SupplierTaxRegistrationNumber]" name="SupplierTaxRegistrationNumber" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].Columns[JurisdictionCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].ExternalColumns[JurisdictionCode]" lineageId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].Columns[JurisdictionCode]" name="JurisdictionCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
