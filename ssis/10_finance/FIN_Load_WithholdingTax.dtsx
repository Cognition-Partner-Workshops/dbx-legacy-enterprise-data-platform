                  <outputColumn refId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].Columns[TaxCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].ExternalColumns[TaxCode]" lineageId="Package\Split Withholding Tax\stg ApInvoiceLine.Outputs[OLE DB Source Output].Columns[TaxCode]" name="TaxCode" truncationRowDisposition="RedirectRow" />
