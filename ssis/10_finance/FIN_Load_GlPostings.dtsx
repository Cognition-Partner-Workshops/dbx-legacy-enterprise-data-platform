                  <outputColumn refId="Package\Load GL Postings\stg GlJournalLine Posted.Outputs[OLE DB Source Output].Columns[GlJournalLineId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load GL Postings\stg GlJournalLine Posted.Outputs[OLE DB Source Output].ExternalColumns[GlJournalLineId]" lineageId="Package\Load GL Postings\stg GlJournalLine Posted.Outputs[OLE DB Source Output].Columns[GlJournalLineId]" name="GlJournalLineId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load GL Postings\stg GlJournalLine Posted.Outputs[OLE DB Source Output].Columns[JournalNumber]" dataType="wstr" length="30" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load GL Postings\stg GlJournalLine Posted.Outputs[OLE DB Source Output].ExternalColumns[JournalNumber]" lineageId="Package\Load GL Postings\stg GlJournalLine Posted.Outputs[OLE DB Source Output].Columns[JournalNumber]" name="JournalNumber" truncationRowDisposition="RedirectRow" />
