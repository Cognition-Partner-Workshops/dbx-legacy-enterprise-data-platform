    <DTS:Executable
      DTS:refId="Package\Check Journal Balance"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3C2489D8-E101-ED86-A0E6-4F84DC4C9A02}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Check Journal Balance"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS UnbalancedJournals FROM (&#10;    SELECT JournalNumber&#10;    FROM   stg.GlJournalLine&#10;    WHERE  LoadBatchId = ?&#10;    GROUP BY JournalNumber&#10;    HAVING ABS(SUM(EnteredDebitAmount) - SUM(EnteredCreditAmount)) &gt; 0.005&#10;) AS unbalanced;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::UnbalancedJournalCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load GL Postings"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{269F5135-42D9-2E62-F7C4-79BC6A7D29B5}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load GL Postings"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Load GL Postings\stg GlJournalLine Posted" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="stg GlJournalLine Posted" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  gl.GlJournalLineId
,       gl.JournalNumber
,       gl.JournalLineNumber
,       gl.LedgerCode
,       gl.CostCentreCode
,       gl.AccountCode
,       gl.PostingDate
,       gl.AccountingPeriod
,       gl.CurrencyCode
,       gl.EnteredDebitAmount
,       gl.EnteredCreditAmount
,       gl.SourceSubledgerCode
,       gl.SourceDocumentNumber
        /* The ERP stores the ledger's functional currency amount only when the
           journal is not in the ledger currency, so the ETL has always had to
           fall back to the entered amount. */
,       ISNULL(gl.FunctionalDebitAmount, gl.EnteredDebitAmount)   AS FunctionalDebitAmount
,       ISNULL(gl.FunctionalCreditAmount, gl.EnteredCreditAmount) AS FunctionalCreditAmount
,       CASE
            WHEN gl.LedgerCode LIKE 'EU%'   THEN 'VAT'
            WHEN gl.LedgerCode LIKE 'APAC%' THEN 'GST'
            ELSE 'SALESTAX'
        END                                                       AS TaxRegimeCode
FROM    stg.GlJournalLine AS gl
INNER JOIN etl.Configuration AS cfg
        ON  cfg.ConfigurationKey = 'Finance.OpenPeriod.' + gl.LedgerCode
        AND cfg.ConfigurationValue = gl.AccountingPeriod
WHERE   gl.JournalStatusCode = 'POSTED'
AND     gl.LoadBatchId = ?</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Load GL Postings\stg GlJournalLine Posted.Connections[OleDbConnection]" connectionManagerID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Staging_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
