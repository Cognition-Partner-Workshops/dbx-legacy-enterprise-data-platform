                  <outputColumn refId="Package\Load GL Postings\stg GlJournalLine Posted.Outputs[OLE DB Source Output].Columns[LedgerCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load GL Postings\stg GlJournalLine Posted.Outputs[OLE DB Source Output].ExternalColumns[LedgerCode]" lineageId="Package\Load GL Postings\stg GlJournalLine Posted.Outputs[OLE DB Source Output].Columns[LedgerCode]" name="LedgerCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load GL Postings\stg GlJournalLine Posted.Outputs[OLE DB Source Output].Columns[CostCentreCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load GL Postings\stg GlJournalLine Posted.Outputs[OLE DB Source Output].ExternalColumns[CostCentreCode]" lineageId="Package\Load GL Postings\stg GlJournalLine Posted.Outputs[OLE DB Source Output].Columns[CostCentreCode]" name="CostCentreCode" truncationRowDisposition="RedirectRow" />
