      DTS:Description="Execute SQL Task"
      DTS:DTSID="{03259AF5-18F8-E3B2-90DF-5C8F982ACA9A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Refuse Close"
