        SQLTask:SqlStatementSource="EXEC etl.usp_LogError @BatchId = ?, @ErrorSeverity = N'Error', @ErrorCode = 51001, @ErrorDescription = N'Period lock refused: unexplained subledger variances remain.', @SourceName = N'FIN_Close_PeriodLock';"
        SQLTask:ResultType="ResultSetType_None"
