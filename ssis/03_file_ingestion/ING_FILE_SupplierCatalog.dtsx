              <component refId="Package\Foreach Supplier Catalog File\Ingest Supplier Catalog\Parse Catalog Detail" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Parse Catalog Detail" usesDispositions="true" version="1">
