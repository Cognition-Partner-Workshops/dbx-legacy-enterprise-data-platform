        <DTS:Executable
          DTS:refId="Package\Foreach Supplier Catalog File\Compute Price Checksum"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{26077292-272D-A0EF-A2FE-D8375B78AF58}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Compute Price Checksum"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="SELECT CAST(ISNULL(SUM(CAST(NetPrice * 100 AS bigint)) % 1000000, 0) AS int) AS PriceChecksum FROM raw.FileSupplierCatalog WHERE PackageExecutionId = ?;"
            SQLTask:ResultType="ResultSetType_SingleRow"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
            <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::PriceChecksum" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Supplier Catalog File\Reconcile Control Totals"
