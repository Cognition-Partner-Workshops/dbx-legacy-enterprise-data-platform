          DTS:CreationName=""
          DTS:DTSID="{8141C10C-5682-29E4-E4CE-C222E99C50B9}"
          DTS:From="Package\Foreach Supplier Catalog File\Compute Price Checksum"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 3"
          DTS:To="Package\Foreach Supplier Catalog File\Reconcile Control Totals" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Foreach Supplier Catalog File.PrecedenceConstraints[Constraint 4]"
          DTS:CreationName=""
          DTS:DTSID="{C3E57DAD-0054-33A5-BDFD-DC96D096A161}"
          DTS:From="Package\Foreach Supplier Catalog File\Reconcile Control Totals"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 4"
          DTS:EvalOp="2"
          DTS:Expression="@[User::MalformedRowCount] &gt; 0"
          DTS:To="Package\Foreach Supplier Catalog File\Log Rejected Rows" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Foreach Supplier Catalog File.PrecedenceConstraints[Constraint 5]"
          DTS:CreationName=""
          DTS:DTSID="{12E73DF6-54A2-C743-2C8E-9E43BE833E5A}"
          DTS:From="Package\Foreach Supplier Catalog File\Reconcile Control Totals"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 5"
          DTS:EvalOp="2"
          DTS:Expression="@[User::ControlTotalsMatch] == 1 &amp;&amp; @[User::PriceChecksum] == @[User::FooterChecksum]"
          DTS:To="Package\Foreach Supplier Catalog File\Archive Processed File" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Foreach Supplier Catalog File.PrecedenceConstraints[Constraint 6]"
          DTS:CreationName=""
          DTS:DTSID="{975D5A31-4A4C-0A03-8355-A11E6EA976C1}"
          DTS:From="Package\Foreach Supplier Catalog File\Log Rejected Rows"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 6"
          DTS:EvalOp="2"
          DTS:Expression="@[User::ControlTotalsMatch] == 1"
          DTS:To="Package\Foreach Supplier Catalog File\Archive Processed File" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Foreach Supplier Catalog File.PrecedenceConstraints[Constraint 7]"
          DTS:CreationName=""
          DTS:DTSID="{1FD6F9C3-245E-D92A-71C7-24CCA8186BC3}"
          DTS:From="Package\Foreach Supplier Catalog File\Reconcile Control Totals"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 7"
          DTS:EvalOp="2"
          DTS:Expression="@[User::ControlTotalsMatch] == 0 || @[User::PriceChecksum] != @[User::FooterChecksum]"
          DTS:To="Package\Foreach Supplier Catalog File\Move Poison File" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Foreach Supplier Catalog File.PrecedenceConstraints[Constraint 8]"
