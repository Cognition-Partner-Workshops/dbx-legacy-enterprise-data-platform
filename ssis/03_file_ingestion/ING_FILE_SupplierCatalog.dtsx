                </inputs>
                <outputs>
                  <output refId="Package\Foreach Supplier Catalog File\Ingest Supplier Catalog\Parse Catalog Detail.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Foreach Supplier Catalog File\Ingest Supplier Catalog\Parse Catalog Detail.Inputs[Derived Column Input]">
                    <outputColumns>
                      <outputColumn refId="Package\Foreach Supplier Catalog File\Ingest Supplier Catalog\Parse Catalog Detail.Outputs[Derived Column Output].Columns[EffectiveFromDate]" dataType="dbTimeStamp" lineageId="Package\Foreach Supplier Catalog File\Ingest Supplier Catalog\Parse Catalog Detail.Outputs[Derived Column Output].Columns[EffectiveFromDate]" name="EffectiveFromDate">
                        <properties>
                          <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_DBDATE)(SUBSTRING(EffectiveFromText,1,4) + "-" + SUBSTRING(EffectiveFromText,5,2) + "-" + SUBSTRING(EffectiveFromText,7,2))</property>
                          <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_DBDATE)(SUBSTRING(EffectiveFromText,1,4) + "-" + SUBSTRING(EffectiveFromText,5,2) + "-" + SUBSTRING(EffectiveFromText,7,2))</property>
                        </properties>
                      </outputColumn>
                      <outputColumn refId="Package\Foreach Supplier Catalog File\Ingest Supplier Catalog\Parse Catalog Detail.Outputs[Derived Column Output].Columns[EffectiveToDate]" dataType="dbTimeStamp" lineageId="Package\Foreach Supplier Catalog File\Ingest Supplier Catalog\Parse Catalog Detail.Outputs[Derived Column Output].Columns[EffectiveToDate]" name="EffectiveToDate">
                        <properties>
                          <property dataType="System.String" description="The expression used to compute this column." name="Expression">LEN(TRIM(EffectiveToText)) == 8 ? (DT_DBDATE)(SUBSTRING(EffectiveToText,1,4) + "-" + SUBSTRING(EffectiveToText,5,2) + "-" + SUBSTRING(EffectiveToText,7,2)) : (DT_DBDATE)"9999-12-31"</property>
                          <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">LEN(TRIM(EffectiveToText)) == 8 ? (DT_DBDATE)(SUBSTRING(EffectiveToText,1,4) + "-" + SUBSTRING(EffectiveToText,5,2) + "-" + SUBSTRING(EffectiveToText,7,2)) : (DT_DBDATE)"9999-12-31"</property>
                        </properties>
                      </outputColumn>
                      <outputColumn refId="Package\Foreach Supplier Catalog File\Ingest Supplier Catalog\Parse Catalog Detail.Outputs[Derived Column Output].Columns[ListPrice]" dataType="numeric" precision="18" scale="2" lineageId="Package\Foreach Supplier Catalog File\Ingest Supplier Catalog\Parse Catalog Detail.Outputs[Derived Column Output].Columns[ListPrice]" name="ListPrice">
