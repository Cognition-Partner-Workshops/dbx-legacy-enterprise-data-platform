                    <outputColumns>
                      <outputColumn refId="Package\Foreach FX Override File\Ingest FX Overrides\Measure Deviation.Outputs[Derived Column Output].Columns[DeviationBasisPoints]" dataType="i4" lineageId="Package\Foreach FX Override File\Ingest FX Overrides\Measure Deviation.Outputs[Derived Column Output].Columns[DeviationBasisPoints]" name="DeviationBasisPoints">
                        <properties>
                          <property dataType="System.String" description="The expression used to compute this column." name="Expression">PublishedRate == 0 ? 0 : (DT_I4)(ABS(OverrideRate - PublishedRate) / PublishedRate * 10000)</property>
                          <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PublishedRate == 0 ? 0 : (DT_I4)(ABS(OverrideRate - PublishedRate) / PublishedRate * 10000)</property>
                        </properties>
                      </outputColumn>
                    </outputColumns>
                    <externalMetadataColumns />
                  </output>
                </outputs>
