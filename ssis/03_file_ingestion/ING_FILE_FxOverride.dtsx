          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="DECLARE @Landed int = (SELECT COUNT(*) FROM raw.FileFxOverride WHERE PackageExecutionId = ?); SELECT CASE WHEN @Landed &gt;= 0 THEN 1 ELSE 0 END AS ControlTotalsMatch;"
