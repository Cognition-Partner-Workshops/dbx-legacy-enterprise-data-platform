              <component refId="Package\Foreach FX Override File\Ingest FX Overrides\Lookup Published Rate" componentClassID="Microsoft.Lookup" description="Lookup" name="Lookup Published Rate" usesDispositions="true" version="6">
                <properties>
                  <property dataType="System.String" description="The SQL command used to populate the lookup cache." name="SqlCommand">SELECT FROM_CURRENCY_CD + '/' + TO_CURRENCY_CD AS RatePairCode,
       TRY_CONVERT(DATE, RATE_DT) AS RateDate,
       TRY_CONVERT(DECIMAL(18,8), CONVERSION_RATE) AS PublishedRate
FROM raw.OracleFxRate WITH (NOLOCK) WHERE RATE_TYPE_CD = N'SPOT';</property>
