        DTS:DTSID="{2DC3C793-00F1-99E3-AA3D-B1AE82B10691}"
        DTS:ObjectName="{2DC3C793-00F1-99E3-AA3D-B1AE82B10691}"
        DTS:CreationName="Microsoft.ForEachFileEnumerator">
        <DTS:PropertyExpression DTS:Name="Directory">@[$Project::InboundFileRoot] + "\\partner\\eu"</DTS:PropertyExpression>
        <DTS:ObjectData>
          <ForEachFileEnumeratorProperties>
            <FEFEProperty Folder="C:\WWI\DEV\inbound\partner\eu" />
            <FEFEProperty FileSpec="partner_sales_eu_*.csv" />
            <FEFEProperty FileNameRetrievalType="0" />
            <FEFEProperty Recurse="0" />
          </ForEachFileEnumeratorProperties>
        </DTS:ObjectData>
      </DTS:ForEachEnumerator>
      <DTS:ForEachVariableMappings>
        <DTS:ForEachVariableMapping DTS:refId="Package\Foreach EU Partner File.ForEachVariableMapping[0]" DTS:VariableName="User::CurrentFilePath" DTS:ValueIndex="0" />
      </DTS:ForEachVariableMappings>
