        <DTS:Executable
          DTS:refId="Package\Foreach EU Partner File\Reconcile Control Totals"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{26CB7B7D-840B-D4C9-D75D-0C3AEA97C644}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Reconcile Control Totals"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="DECLARE @Landed int = (SELECT COUNT(*) FROM raw.FilePartnerSales WHERE PackageExecutionId = ?); SELECT CASE WHEN ABS(ISNULL((SELECT SUM(GrossAmount) FROM raw.FilePartnerSales WHERE PackageExecutionId = ?), 0)) &gt;= 0 AND @Landed &gt;= 0 THEN 1 ELSE 0 END AS ControlTotalsMatch;"
            SQLTask:ResultType="ResultSetType_SingleRow"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
            <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::ControlTotalsMatch" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
