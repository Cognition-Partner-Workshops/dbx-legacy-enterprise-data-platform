                  <output refId="Package\Foreach Carrier Scan File\Ingest Carrier Scans\Carrier Scan File.Outputs[Flat File Source Output]" name="Flat File Source Output">
                    <outputColumns>
                      <outputColumn refId="Package\Foreach Carrier Scan File\Ingest Carrier Scans\Carrier Scan File.Outputs[Flat File Source Output].Columns[CarrierCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Foreach Carrier Scan File\Ingest Carrier Scans\Carrier Scan File.Outputs[Flat File Source Output].ExternalColumns[CarrierCode]" lineageId="Package\Foreach Carrier Scan File\Ingest Carrier Scans\Carrier Scan File.Outputs[Flat File Source Output].Columns[CarrierCode]" name="CarrierCode" truncationRowDisposition="RedirectRow" />
