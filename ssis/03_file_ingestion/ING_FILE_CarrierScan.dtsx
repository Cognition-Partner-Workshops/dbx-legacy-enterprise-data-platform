                </inputs>
                <outputs>
                  <output refId="Package\Foreach Carrier Scan File\Ingest Carrier Scans\Parse Scan Event.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Foreach Carrier Scan File\Ingest Carrier Scans\Parse Scan Event.Inputs[Derived Column Input]">
                    <outputColumns>
                      <outputColumn refId="Package\Foreach Carrier Scan File\Ingest Carrier Scans\Parse Scan Event.Outputs[Derived Column Output].Columns[ScanTimestampUtc]" dataType="dbTimeStamp" lineageId="Package\Foreach Carrier Scan File\Ingest Carrier Scans\Parse Scan Event.Outputs[Derived Column Output].Columns[ScanTimestampUtc]" name="ScanTimestampUtc">
                        <properties>
                          <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_DBTIMESTAMP)SUBSTRING(ScanTimestampText,1,19)</property>
                          <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_DBTIMESTAMP)SUBSTRING(ScanTimestampText,1,19)</property>
                        </properties>
                      </outputColumn>
                      <outputColumn refId="Package\Foreach Carrier Scan File\Ingest Carrier Scans\Parse Scan Event.Outputs[Derived Column Output].Columns[ScanOffsetMinutes]" dataType="i4" lineageId="Package\Foreach Carrier Scan File\Ingest Carrier Scans\Parse Scan Event.Outputs[Derived Column Output].Columns[ScanOffsetMinutes]" name="ScanOffsetMinutes">
                        <properties>
                          <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_I4)((DT_I4)SUBSTRING(ScanTimestampText,21,2) * 60 + (DT_I4)SUBSTRING(ScanTimestampText,24,2))</property>
                          <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_I4)((DT_I4)SUBSTRING(ScanTimestampText,21,2) * 60 + (DT_I4)SUBSTRING(ScanTimestampText,24,2))</property>
