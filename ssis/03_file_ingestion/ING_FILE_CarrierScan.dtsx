                        <properties>
                          <property dataType="System.String" description="The expression used to compute this column." name="Expression">LEN(TRIM(ExceptionReasonCode)) &gt; 0 ? "Y" : "N"</property>
                          <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">LEN(TRIM(ExceptionReasonCode)) &gt; 0 ? "Y" : "N"</property>
