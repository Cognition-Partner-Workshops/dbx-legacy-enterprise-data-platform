                        <properties>
                          <property dataType="System.String" description="The expression used to compute this column." name="Expression">ScanStatusCode == "DLV" || ScanStatusCode == "POD" ? "Y" : "N"</property>
                          <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ScanStatusCode == "DLV" || ScanStatusCode == "POD" ? "Y" : "N"</property>
