          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="SELECT COUNT(*) AS DuplicateScanCount FROM (SELECT TrackingNumber, ScanStatusCode, ScanTimestampUtc FROM raw.FileCarrierScan WHERE PackageExecutionId = ? GROUP BY TrackingNumber, ScanStatusCode, ScanTimestampUtc HAVING COUNT(*) &gt; 1) AS d;"
            SQLTask:ResultType="ResultSetType_SingleRow"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
