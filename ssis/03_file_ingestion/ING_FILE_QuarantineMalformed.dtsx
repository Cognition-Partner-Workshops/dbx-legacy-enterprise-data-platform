                        <properties>
                          <property dataType="System.String" description="The expression used to compute this column." name="Expression">FINDSTRING(@[User::CurrentFileName], "partner_sales_na", 1) &gt; 0 ? "PARTNER_NA" : (FINDSTRING(@[User::CurrentFileName], "partner_sales_eu", 1) &gt; 0 ? "PARTNER_EU" : (FINDSTRING(@[User::CurrentFileName], "partner_sales_apac", 1) &gt; 0 ? "PARTNER_APAC" : (FINDSTRING(@[User::CurrentFileName], "carrier_scan", 1) &gt; 0 ? "CARRIER" : (FINDSTRING(@[User::CurrentFileName], "supplier_catalog", 1) &gt; 0 ? "SUPPLIER" : (FINDSTRING(@[User::CurrentFileName], "fx_override", 1) &gt; 0 ? "FX" : "UNKNOWN")))))</property>
