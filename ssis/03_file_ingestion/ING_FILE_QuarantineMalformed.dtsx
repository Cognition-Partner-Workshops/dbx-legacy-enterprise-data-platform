                  <connection refId="Package\Foreach Quarantined File\Sweep Quarantined Rows\Quarantined File.Connections[FlatFileConnection]" connectionManagerID="{5B9B814D-2D49-C9BB-A7CD-36353A6059BF}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Inbound_Files]" description="The connection used to access the source." name="FlatFileConnection" />
