      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Package Start"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogPackageStart @BatchId = ?, @PackageName = ?, @PackageExecutionId = ? OUTPUT;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="True"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="System::PackageName" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::PackageExecutionId" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Foreach Quarantined File"
      DTS:CreationName="STOCK:FOREACHLOOP"
      DTS:Description="Loop everything sitting in the quarantine folder."
      DTS:DTSID="{3972C5C5-EBF7-7EA4-10AE-4E7DC4A62955}"
      DTS:ExecutableType="STOCK:FOREACHLOOP"
      DTS:LocaleID="-1"
      DTS:ObjectName="Foreach Quarantined File">
      <DTS:Variables />
      <DTS:ForEachEnumerator
        DTS:ObjectName="ForeachFileEnumerator"
        DTS:CreationName="Microsoft.ForEachFileEnumerator">
        <DTS:ObjectData>
          <FEFE Folder="@[$Project::RejectFileRoot]\quarantine" FileSpec="*" FileNameRetrieval="1" Recurse="0" />
        </DTS:ObjectData>
      </DTS:ForEachEnumerator>
      <DTS:ForEachVariableMappings>
        <DTS:ForEachVariableMapping DTS:refId="Package\Foreach Quarantined File.ForEachVariableMapping[0]" DTS:VariableName="User::CurrentFilePath" DTS:ValueIndex="0" />
      </DTS:ForEachVariableMappings>
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Foreach Quarantined File\Derive File Paths"
          DTS:CreationName="Microsoft.ExpressionTask"
          DTS:Description="Expression Task"
          DTS:DTSID="{5CA013DD-E2C9-9756-ACAB-DC04E94ED929}"
          DTS:ExecutableType="Microsoft.ExpressionTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Derive File Paths"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <ExpressionTask Expression='@[User::CurrentFileName] = RIGHT(@[User::CurrentFilePath], FINDSTRING(REVERSE(@[User::CurrentFilePath]), "\\", 1) - 1); @[User::ArchiveFilePath] = @[$Project::ArchiveFileRoot] + "\\quarantine\\" + @[User::CurrentFileName]; @[User::RejectFilePath] = @[$Project::RejectFileRoot] + "\\quarantine\\" + @[User::CurrentFileName] + ".rej"; @[User::PoisonFilePath] = @[$Project::RejectFileRoot] + "\\poison\\" + @[User::CurrentFileName]' />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Quarantined File\Register Inbound File"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{594A45FB-FBCD-4DC1-75FE-8CBDA6AD756C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Register Inbound File"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="INSERT INTO etl.FileIngestionLog (PackageExecutionId, ObjectName, FileName, FilePath, ReceivedAtUtc, Status) VALUES (?, N'err.RejectedFileRow', ?, ?, SYSUTCDATETIME(), N'Received'); SELECT CAST(SCOPE_IDENTITY() AS bigint) AS InboundFileId;"
            SQLTask:ResultType="ResultSetType_SingleRow"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
            <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::CurrentFileName" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
            <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="User::CurrentFilePath" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
            <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::InboundFileId" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach Quarantined File\Sweep Quarantined Rows"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{E29806FC-846E-A3E7-1661-A0A3860778AC}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Sweep Quarantined Rows"
          DTS:ThreadHint="0">
          <DTS:Variables />
