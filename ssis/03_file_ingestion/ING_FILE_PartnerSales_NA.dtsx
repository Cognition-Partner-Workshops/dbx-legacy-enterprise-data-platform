        DTS:DTSID="{A35A357D-2434-61E4-2845-36480CF586F2}"
        DTS:ObjectName="{A35A357D-2434-61E4-2845-36480CF586F2}"
        DTS:CreationName="Microsoft.ForEachFileEnumerator">
        <DTS:PropertyExpression DTS:Name="Directory">@[$Project::InboundFileRoot] + "\\partner\\na"</DTS:PropertyExpression>
        <DTS:ObjectData>
          <ForEachFileEnumeratorProperties>
            <FEFEProperty Folder="C:\WWI\DEV\inbound\partner\na" />
            <FEFEProperty FileSpec="partner_sales_na_*.csv" />
            <FEFEProperty FileNameRetrievalType="0" />
            <FEFEProperty Recurse="0" />
          </ForEachFileEnumeratorProperties>
        </DTS:ObjectData>
      </DTS:ForEachEnumerator>
      <DTS:ForEachVariableMappings>
        <DTS:ForEachVariableMapping DTS:refId="Package\Foreach NA Partner File.ForEachVariableMapping[0]" DTS:VariableName="User::CurrentFilePath" DTS:ValueIndex="0" />
      </DTS:ForEachVariableMappings>
