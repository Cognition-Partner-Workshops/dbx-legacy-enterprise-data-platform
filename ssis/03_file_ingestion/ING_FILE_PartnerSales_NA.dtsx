    <DTS:Executable
      DTS:refId="Package\Foreach NA Partner File"
      DTS:CreationName="STOCK:FOREACHLOOP"
      DTS:Description="Loop the NA partner drop folder."
      DTS:DTSID="{00C33432-70F2-C4E4-A37B-67C9CE69049F}"
      DTS:ExecutableType="STOCK:FOREACHLOOP"
      DTS:LocaleID="-1"
      DTS:ObjectName="Foreach NA Partner File">
      <DTS:Variables />
      <DTS:ForEachEnumerator
        DTS:ObjectName="ForeachFileEnumerator"
        DTS:CreationName="Microsoft.ForEachFileEnumerator">
        <DTS:ObjectData>
          <FEFE Folder="@[$Project::InboundFileRoot]\partner\na" FileSpec="partner_sales_na_*.csv" FileNameRetrieval="1" Recurse="0" />
        </DTS:ObjectData>
      </DTS:ForEachEnumerator>
      <DTS:ForEachVariableMappings>
        <DTS:ForEachVariableMapping DTS:refId="Package\Foreach NA Partner File.ForEachVariableMapping[0]" DTS:VariableName="User::CurrentFilePath" DTS:ValueIndex="0" />
      </DTS:ForEachVariableMappings>
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Foreach NA Partner File\Derive File Paths"
          DTS:CreationName="Microsoft.ExpressionTask"
          DTS:Description="Expression Task"
          DTS:DTSID="{61C0E199-20A9-4F1C-5F98-924A75C9BD6F}"
          DTS:ExecutableType="Microsoft.ExpressionTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Derive File Paths"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <ExpressionTask Expression='@[User::CurrentFileName] = RIGHT(@[User::CurrentFilePath], FINDSTRING(REVERSE(@[User::CurrentFilePath]), "\\", 1) - 1); @[User::ArchiveFilePath] = @[$Project::ArchiveFileRoot] + "\\partner/na\\" + @[User::CurrentFileName]; @[User::RejectFilePath] = @[$Project::RejectFileRoot] + "\\partner/na\\" + @[User::CurrentFileName] + ".rej"; @[User::PoisonFilePath] = @[$Project::RejectFileRoot] + "\\poison\\" + @[User::CurrentFileName]' />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Foreach NA Partner File\Register Inbound File"
