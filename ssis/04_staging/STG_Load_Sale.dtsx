              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT l.InvoiceLineID, l.InvoiceID, l.StockItemID, l.Quantity, l.UnitPrice, l.TaxRate,
       l.TaxAmount, l.LineProfit, l.ExtendedPrice
FROM raw.SqlInvoiceLine AS l
     INNER JOIN raw.SqlInvoice AS i ON i.InvoiceID = l.InvoiceID
WHERE i.LastEditedWhen &gt; CONVERT(datetime2(3), ?) AND i.LastEditedWhen &lt;= CONVERT(datetime2(3), ?);</property>
