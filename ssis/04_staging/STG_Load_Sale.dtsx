          <component refId="Package\DFT Sale Header\Tag Sale Region" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Tag Sale Region" usesDispositions="true">
            <inputs>
              <input refId="Package\DFT Sale Header\Tag Sale Region.Inputs[Derived Column Input]" name="Derived Column Input">
                <inputColumns>
                  <inputColumn refId="Package\DFT Sale Header\Tag Sale Region.Inputs[Derived Column Input].Columns[DeliveryMethodCode]" cachedName="DeliveryMethodCode" lineageId="Package\DFT Sale Header\RAW SQL Invoice.Outputs[OLE DB Source Output].Columns[DeliveryMethodCode]" name="DeliveryMethodCode" usageType="readWrite">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(DeliveryMethodCode) ? "UNKNOWN" : DeliveryMethodCode))</property>
