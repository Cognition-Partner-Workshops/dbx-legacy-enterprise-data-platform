          <component refId="Package\DFT Conform Cost Center\Cleanse Cost Center" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Cleanse Cost Center" usesDispositions="true">
            <inputs>
              <input refId="Package\DFT Conform Cost Center\Cleanse Cost Center.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Conform Cost Center\Cleanse Cost Center.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output].Columns[CostCenterCode]" dataType="wstr" length="12" lineageId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output].Columns[CostCenterCode]" name="CostCenterCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(REPLACE(TRIM(CC_CODE)," ",""))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(REPLACE(TRIM(CC_CODE)," ",""))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output].Columns[CostCenterName]" dataType="wstr" length="80" lineageId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output].Columns[CostCenterName]" name="CostCenterName">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TRIM(CC_NAME)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TRIM(CC_NAME)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output].Columns[ParentCostCenterCode]" dataType="wstr" length="12" lineageId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output].Columns[ParentCostCenterCode]" name="ParentCostCenterCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(PARENT_CC_CODE) || TRIM(PARENT_CC_CODE) == "" ? "ROOT" : UPPER(TRIM(PARENT_CC_CODE))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(PARENT_CC_CODE) || TRIM(PARENT_CC_CODE) == "" ? "ROOT" : UPPER(TRIM(PARENT_CC_CODE))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output].Columns[CompanyCode]" dataType="wstr" length="6" lineageId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output].Columns[CompanyCode]" name="CompanyCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(COMPANY_CD) ? "1000" : COMPANY_CD))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(COMPANY_CD) ? "1000" : COMPANY_CD))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output].Columns[RegionCode]" dataType="wstr" length="4" lineageId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output].Columns[RegionCode]" name="RegionCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(REGION_CD) ? "NA" : REGION_CD))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(REGION_CD) ? "NA" : REGION_CD))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output].Columns[FunctionCode]" dataType="wstr" length="8" lineageId="Package\DFT Conform Cost Center\Cleanse Cost Center.Outputs[Derived Column Output].Columns[FunctionCode]" name="FunctionCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(FUNCTION_CD) ? "GEN" : FUNCTION_CD))</property>
