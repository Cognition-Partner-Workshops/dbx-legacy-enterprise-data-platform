          <component refId="Package\DFT Conform Cost Center\Derive Hierarchy Path" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Hierarchy Path" usesDispositions="true">
            <inputs>
              <input refId="Package\DFT Conform Cost Center\Derive Hierarchy Path.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Conform Cost Center\Derive Hierarchy Path.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Conform Cost Center\Derive Hierarchy Path.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Conform Cost Center\Derive Hierarchy Path.Outputs[Derived Column Output].Columns[HierarchyPath]" dataType="wstr" length="40" lineageId="Package\DFT Conform Cost Center\Derive Hierarchy Path.Outputs[Derived Column Output].Columns[HierarchyPath]" name="HierarchyPath">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">CompanyCode + "/" + (ISNULL(ParentCostCenterName) ? "ORPHAN" : ParentCostCenterCode) + "/" + CostCenterCode</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">CompanyCode + "/" + (ISNULL(ParentCostCenterName) ? "ORPHAN" : ParentCostCenterCode) + "/" + CostCenterCode</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Cost Center\Derive Hierarchy Path.Outputs[Derived Column Output].Columns[HierarchyLevel]" dataType="i4" lineageId="Package\DFT Conform Cost Center\Derive Hierarchy Path.Outputs[Derived Column Output].Columns[HierarchyLevel]" name="HierarchyLevel">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ParentCostCenterCode == "ROOT" ? 1 : (ISNULL(ParentCostCenterName) ? 3 : 2)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ParentCostCenterCode == "ROOT" ? 1 : (ISNULL(ParentCostCenterName) ? 3 : 2)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Cost Center\Derive Hierarchy Path.Outputs[Derived Column Output].Columns[ChangeHash]" dataType="wstr" length="128" lineageId="Package\DFT Conform Cost Center\Derive Hierarchy Path.Outputs[Derived Column Output].Columns[ChangeHash]" name="ChangeHash">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM((DT_WSTR,60)[CostCenterName])) + "|" + UPPER(TRIM((DT_WSTR,60)[ParentCostCenterCode])) + "|" + UPPER(TRIM((DT_WSTR,60)[FunctionCode])) + "|" + UPPER(TRIM((DT_WSTR,60)[IsActiveFlag]))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM((DT_WSTR,60)[CostCenterName])) + "|" + UPPER(TRIM((DT_WSTR,60)[ParentCostCenterCode])) + "|" + UPPER(TRIM((DT_WSTR,60)[FunctionCode])) + "|" + UPPER(TRIM((DT_WSTR,60)[IsActiveFlag]))</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
