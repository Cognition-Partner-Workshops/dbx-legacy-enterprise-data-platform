                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(ApprovedBy) || TRIM(ApprovedBy) == "" ? "N" : "Y"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(ApprovedBy) || TRIM(ApprovedBy) == "" ? "N" : "Y"</property>
