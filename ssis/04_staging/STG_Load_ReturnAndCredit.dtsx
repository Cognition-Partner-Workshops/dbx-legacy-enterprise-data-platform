                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Return Line\Apply Return Window.Outputs[Derived Column Output].Columns[StockItemId]" dataType="i4" lineageId="Package\DFT Return Line\Apply Return Window.Outputs[Derived Column Output].Columns[StockItemId]" name="StockItemId">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">StockItemID</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">StockItemID</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Return Line\Apply Return Window.Outputs[Derived Column Output].Columns[SourceReturnReasonCode]" dataType="wstr" length="10" lineageId="Package\DFT Return Line\Apply Return Window.Outputs[Derived Column Output].Columns[SourceReturnReasonCode]" name="SourceReturnReasonCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(ReturnReasonCode) ? "UNSTATED" : ReturnReasonCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(ReturnReasonCode) ? "UNSTATED" : ReturnReasonCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Return Line\Apply Return Window.Outputs[Derived Column Output].Columns[RegionCode]" dataType="wstr" length="4" lineageId="Package\DFT Return Line\Apply Return Window.Outputs[Derived Column Output].Columns[RegionCode]" name="RegionCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Return Line\Apply Return Window.Outputs[Derived Column Output].Columns[ReturnWindowDays]" dataType="i4" lineageId="Package\DFT Return Line\Apply Return Window.Outputs[Derived Column Output].Columns[ReturnWindowDays]" name="ReturnWindowDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode)) == "EU" ? 14 : (UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode)) == "APAC" ? 7 : 30)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode)) == "EU" ? 14 : (UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode)) == "APAC" ? 7 : 30)</property>
                    </properties>
