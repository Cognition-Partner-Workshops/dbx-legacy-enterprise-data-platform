                <outputColumns>
                  <outputColumn refId="Package\DFT Return Line\Apply Return Window.Outputs[Derived Column Output].Columns[ReturnLineId]" dataType="i4" lineageId="Package\DFT Return Line\Apply Return Window.Outputs[Derived Column Output].Columns[ReturnLineId]" name="ReturnLineId">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ReturnLineID</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ReturnLineID</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Return Line\Apply Return Window.Outputs[Derived Column Output].Columns[InvoiceId]" dataType="i4" lineageId="Package\DFT Return Line\Apply Return Window.Outputs[Derived Column Output].Columns[InvoiceId]" name="InvoiceId">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">InvoiceID</property>
