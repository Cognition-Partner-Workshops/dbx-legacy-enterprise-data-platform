                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CreditAmount) ? "NONE" : (CreditAmount &lt; 500 ? "AUTO" : (CreditAmount &lt; 5000 ? "MGR" : "FIN"))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CreditAmount) ? "NONE" : (CreditAmount &lt; 500 ? "AUTO" : (CreditAmount &lt; 5000 ? "MGR" : "FIN"))</property>
                    </properties>
