                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">JOURNAL_LINE_NBR</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">JOURNAL_LINE_NBR</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[LedgerCode]" dataType="wstr" length="8" lineageId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[LedgerCode]" name="LedgerCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(LEDGER_CD))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(LEDGER_CD))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[GlAccountCode]" dataType="wstr" length="20" lineageId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[GlAccountCode]" name="GlAccountCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">REPLACE(UPPER(TRIM(GL_ACCOUNT_CD)), "-", "")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">REPLACE(UPPER(TRIM(GL_ACCOUNT_CD)), "-", "")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[CostCenterCode]" dataType="wstr" length="12" lineageId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[CostCenterCode]" name="CostCenterCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(COST_CENTER_CD) ? "UNALLOC" : COST_CENTER_CD))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(COST_CENTER_CD) ? "UNALLOC" : COST_CENTER_CD))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[RegionCode]" dataType="wstr" length="4" lineageId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[RegionCode]" name="RegionCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(REGION_CD))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(REGION_CD))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[FiscalYear]" dataType="i4" lineageId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[FiscalYear]" name="FiscalYear">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(REGION_CD)) == "NA" ? (MONTH(ACCOUNTING_DT) &gt;= 7 ? YEAR(ACCOUNTING_DT) + 1 : YEAR(ACCOUNTING_DT)) : (UPPER(TRIM(REGION_CD)) == "APAC" ? (MONTH(ACCOUNTING_DT) &gt;= 4 ? YEAR(ACCOUNTING_DT) + 1 : YEAR(ACCOUNTING_DT)) : YEAR(ACCOUNTING_DT))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(REGION_CD)) == "NA" ? (MONTH(ACCOUNTING_DT) &gt;= 7 ? YEAR(ACCOUNTING_DT) + 1 : YEAR(ACCOUNTING_DT)) : (UPPER(TRIM(REGION_CD)) == "APAC" ? (MONTH(ACCOUNTING_DT) &gt;= 4 ? YEAR(ACCOUNTING_DT) + 1 : YEAR(ACCOUNTING_DT)) : YEAR(ACCOUNTING_DT))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[FiscalPeriod]" dataType="i4" lineageId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[FiscalPeriod]" name="FiscalPeriod">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(REGION_CD)) == "NA" ? ((MONTH(ACCOUNTING_DT) + 5) % 12) + 1 : (UPPER(TRIM(REGION_CD)) == "APAC" ? ((MONTH(ACCOUNTING_DT) + 8) % 12) + 1 : MONTH(ACCOUNTING_DT))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(REGION_CD)) == "NA" ? ((MONTH(ACCOUNTING_DT) + 5) % 12) + 1 : (UPPER(TRIM(REGION_CD)) == "APAC" ? ((MONTH(ACCOUNTING_DT) + 8) % 12) + 1 : MONTH(ACCOUNTING_DT))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[DebitAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[DebitAmount]" name="DebitAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(DEBIT_AMT) ? (DT_NUMERIC,18,2)0 : DEBIT_AMT</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(DEBIT_AMT) ? (DT_NUMERIC,18,2)0 : DEBIT_AMT</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[CreditAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[CreditAmount]" name="CreditAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CREDIT_AMT) ? (DT_NUMERIC,18,2)0 : CREDIT_AMT</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CREDIT_AMT) ? (DT_NUMERIC,18,2)0 : CREDIT_AMT</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[SignedAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[SignedAmount]" name="SignedAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_NUMERIC,18,2)((ISNULL(DEBIT_AMT) ? (DT_NUMERIC,18,2)0 : DEBIT_AMT) - (ISNULL(CREDIT_AMT) ? (DT_NUMERIC,18,2)0 : CREDIT_AMT))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_NUMERIC,18,2)((ISNULL(DEBIT_AMT) ? (DT_NUMERIC,18,2)0 : DEBIT_AMT) - (ISNULL(CREDIT_AMT) ? (DT_NUMERIC,18,2)0 : CREDIT_AMT))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[JournalCurrencyCode]" dataType="wstr" length="3" lineageId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[JournalCurrencyCode]" name="JournalCurrencyCode">
                    <properties>
