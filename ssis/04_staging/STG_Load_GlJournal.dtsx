                <outputColumns>
                  <outputColumn refId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[JournalId]" dataType="wstr" length="30" lineageId="Package\DFT Conform GL Journal\Derive Fiscal Attributes.Outputs[Derived Column Output].Columns[JournalId]" name="JournalId">
