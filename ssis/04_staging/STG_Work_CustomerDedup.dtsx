                <properties>
                  <property dataType="System.String" description="The condition for this output." name="Expression">AddressQualityCode == "OK"</property>
                  <property dataType="System.String" description="The condition as displayed." name="FriendlyExpression">AddressQualityCode == "OK"</property>
                  <property dataType="System.Int32" description="Evaluation order." name="EvaluationOrder">0</property>
                </properties>
              </output>
              <output refId="Package\DFT Standardize Customer Address\Screen Address Quality.Outputs[Missing Postal Code]" exclusionGroup="1" name="Missing Postal Code" synchronousInputId="Package\DFT Standardize Customer Address\Screen Address Quality.Inputs[Conditional Split Input]">
                <properties>
