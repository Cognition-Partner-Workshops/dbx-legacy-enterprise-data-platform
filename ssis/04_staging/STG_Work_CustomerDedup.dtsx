            </inputs>
            <outputs>
              <output refId="Package\DFT Standardize Customer Address\Standardize By Region.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Standardize Customer Address\Standardize By Region.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Standardize Customer Address\Standardize By Region.Outputs[Derived Column Output].Columns[AddressLine1Standardized]" dataType="wstr" length="100" lineageId="Package\DFT Standardize Customer Address\Standardize By Region.Outputs[Derived Column Output].Columns[AddressLine1Standardized]" name="AddressLine1Standardized">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(RegionCode)) == "NA" ? UPPER(REPLACE(REPLACE(REPLACE(TRIM(AddressLine1), "Street", "ST"), "Avenue", "AVE"), "Suite", "STE")) : (UPPER(TRIM(RegionCode)) == "EU" ? TRIM(AddressLine1) : UPPER(TRIM(AddressLine1)))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(RegionCode)) == "NA" ? UPPER(REPLACE(REPLACE(REPLACE(TRIM(AddressLine1), "Street", "ST"), "Avenue", "AVE"), "Suite", "STE")) : (UPPER(TRIM(RegionCode)) == "EU" ? TRIM(AddressLine1) : UPPER(TRIM(AddressLine1)))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Standardize Customer Address\Standardize By Region.Outputs[Derived Column Output].Columns[PostalCodeStandardized]" dataType="wstr" length="16" lineageId="Package\DFT Standardize Customer Address\Standardize By Region.Outputs[Derived Column Output].Columns[PostalCodeStandardized]" name="PostalCodeStandardized">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(RegionCode)) == "NA" ? LEFT(REPLACE(TRIM(PostalCode), " ", ""), 5) : (UPPER(TRIM(RegionCode)) == "EU" ? UPPER(TRIM(CountryCode)) + "-" + REPLACE(TRIM(PostalCode), " ", "") : REPLACE(REPLACE(TRIM(PostalCode), "-", ""), " ", ""))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(RegionCode)) == "NA" ? LEFT(REPLACE(TRIM(PostalCode), " ", ""), 5) : (UPPER(TRIM(RegionCode)) == "EU" ? UPPER(TRIM(CountryCode)) + "-" + REPLACE(TRIM(PostalCode), " ", "") : REPLACE(REPLACE(TRIM(PostalCode), "-", ""), " ", ""))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Standardize Customer Address\Standardize By Region.Outputs[Derived Column Output].Columns[CityNameStandardized]" dataType="wstr" length="60" lineageId="Package\DFT Standardize Customer Address\Standardize By Region.Outputs[Derived Column Output].Columns[CityNameStandardized]" name="CityNameStandardized">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CityName))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CityName))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Standardize Customer Address\Standardize By Region.Outputs[Derived Column Output].Columns[AddressQualityCode]" dataType="wstr" length="8" lineageId="Package\DFT Standardize Customer Address\Standardize By Region.Outputs[Derived Column Output].Columns[AddressQualityCode]" name="AddressQualityCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(AddressLine1) || TRIM(AddressLine1) == "" ? "MISSING" : (ISNULL(PostalCode) || TRIM(PostalCode) == "" ? "NOPOST" : "OK")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(AddressLine1) || TRIM(AddressLine1) == "" ? "MISSING" : (ISNULL(PostalCode) || TRIM(PostalCode) == "" ? "NOPOST" : "OK")</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
          <component refId="Package\DFT Standardize Customer Address\Screen Address Quality" componentClassID="Microsoft.ConditionalSplit" description="Conditional Split" name="Screen Address Quality" version="1">
