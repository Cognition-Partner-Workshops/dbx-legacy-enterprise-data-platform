          <component refId="Package\DFT Deduplicate Customer\Build Blocking Key" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Build Blocking Key" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Deduplicate Customer\Build Blocking Key.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Deduplicate Customer\Build Blocking Key.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Deduplicate Customer\Build Blocking Key.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Deduplicate Customer\Build Blocking Key.Outputs[Derived Column Output].Columns[NormalizedName]" dataType="wstr" length="100" lineageId="Package\DFT Deduplicate Customer\Build Blocking Key.Outputs[Derived Column Output].Columns[NormalizedName]" name="NormalizedName">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(REPLACE(REPLACE(REPLACE(TRIM(CustomerName), " ", ""), ".", ""), ",", ""))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(REPLACE(REPLACE(REPLACE(TRIM(CustomerName), " ", ""), ".", ""), ",", ""))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Deduplicate Customer\Build Blocking Key.Outputs[Derived Column Output].Columns[BlockingKey]" dataType="wstr" length="40" lineageId="Package\DFT Deduplicate Customer\Build Blocking Key.Outputs[Derived Column Output].Columns[BlockingKey]" name="BlockingKey">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">LEFT(UPPER(REPLACE(TRIM(CustomerName), " ", "")), 8) + "|" + UPPER(TRIM(CountryCode)) + "|" + LEFT(UPPER(REPLACE(TRIM(ISNULL(PostalCode) ? "00000" : PostalCode), " ", "")), 5)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">LEFT(UPPER(REPLACE(TRIM(CustomerName), " ", "")), 8) + "|" + UPPER(TRIM(CountryCode)) + "|" + LEFT(UPPER(REPLACE(TRIM(ISNULL(PostalCode) ? "00000" : PostalCode), " ", "")), 5)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Deduplicate Customer\Build Blocking Key.Outputs[Derived Column Output].Columns[TaxKey]" dataType="wstr" length="30" lineageId="Package\DFT Deduplicate Customer\Build Blocking Key.Outputs[Derived Column Output].Columns[TaxKey]" name="TaxKey">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(TaxRegistrationNumber) || TRIM(TaxRegistrationNumber) == "" ? "NONE" : UPPER(REPLACE(TRIM(TaxRegistrationNumber), "-", ""))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(TaxRegistrationNumber) || TRIM(TaxRegistrationNumber) == "" ? "NONE" : UPPER(REPLACE(TRIM(TaxRegistrationNumber), "-", ""))</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
