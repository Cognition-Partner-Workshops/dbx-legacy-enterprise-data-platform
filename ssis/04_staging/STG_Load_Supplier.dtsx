                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM((DT_WSTR,60)[SupplierName])) + "|" + UPPER(TRIM((DT_WSTR,60)[TaxIdentifier])) + "|" + UPPER(TRIM((DT_WSTR,60)[PaymentTermsCode])) + "|" + UPPER(TRIM((DT_WSTR,60)[SupplierStatusCode])) + "|" + UPPER(TRIM((DT_WSTR,60)[LeadTimeDays]))</property>
