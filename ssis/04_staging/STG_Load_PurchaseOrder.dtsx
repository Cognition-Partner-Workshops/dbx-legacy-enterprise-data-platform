                  <outputColumn refId="Package\DFT Purchase Order Header\Standardize PO Header.Outputs[Derived Column Output].Columns[PurchaseOrderNumber]" dataType="wstr" length="20" lineageId="Package\DFT Purchase Order Header\Standardize PO Header.Outputs[Derived Column Output].Columns[PurchaseOrderNumber]" name="PurchaseOrderNumber">
