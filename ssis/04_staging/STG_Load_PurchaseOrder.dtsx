            <inputs>
              <input refId="Package\DFT Purchase Order Header\Convert PO Amounts.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Purchase Order Header\Convert PO Amounts.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Purchase Order Header\Convert PO Amounts.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Purchase Order Header\Convert PO Amounts.Outputs[Derived Column Output].Columns[OrderTotalAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\DFT Purchase Order Header\Convert PO Amounts.Outputs[Derived Column Output].Columns[OrderTotalAmount]" name="OrderTotalAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(PO_TOTAL_AMT) ? (DT_NUMERIC,18,2)0 : PO_TOTAL_AMT</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(PO_TOTAL_AMT) ? (DT_NUMERIC,18,2)0 : PO_TOTAL_AMT</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Purchase Order Header\Convert PO Amounts.Outputs[Derived Column Output].Columns[OrderTotalAmountUsd]" dataType="numeric" precision="18" scale="2" lineageId="Package\DFT Purchase Order Header\Convert PO Amounts.Outputs[Derived Column Output].Columns[OrderTotalAmountUsd]" name="OrderTotalAmountUsd">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_NUMERIC,18,2)((ISNULL(PO_TOTAL_AMT) ? (DT_NUMERIC,18,2)0 : PO_TOTAL_AMT) * ConversionRate)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_NUMERIC,18,2)((ISNULL(PO_TOTAL_AMT) ? (DT_NUMERIC,18,2)0 : PO_TOTAL_AMT) * ConversionRate)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Purchase Order Header\Convert PO Amounts.Outputs[Derived Column Output].Columns[PromisedDate]" dataType="dbTimeStamp" lineageId="Package\DFT Purchase Order Header\Convert PO Amounts.Outputs[Derived Column Output].Columns[PromisedDate]" name="PromisedDate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(PROMISED_DT) ? PO_DT : PROMISED_DT</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(PROMISED_DT) ? PO_DT : PROMISED_DT</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Purchase Order Header\Convert PO Amounts.Outputs[Derived Column Output].Columns[ChangeHash]" dataType="wstr" length="128" lineageId="Package\DFT Purchase Order Header\Convert PO Amounts.Outputs[Derived Column Output].Columns[ChangeHash]" name="ChangeHash">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM((DT_WSTR,60)[PurchaseOrderNumber])) + "|" + UPPER(TRIM((DT_WSTR,60)[OrderStatusCode])) + "|" + UPPER(TRIM((DT_WSTR,60)[OrderTotalAmount])) + "|" + UPPER(TRIM((DT_WSTR,60)[PromisedDate]))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM((DT_WSTR,60)[PurchaseOrderNumber])) + "|" + UPPER(TRIM((DT_WSTR,60)[OrderStatusCode])) + "|" + UPPER(TRIM((DT_WSTR,60)[OrderTotalAmount])) + "|" + UPPER(TRIM((DT_WSTR,60)[PromisedDate]))</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
