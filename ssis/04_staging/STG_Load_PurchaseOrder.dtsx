        <components>
          <component refId="Package\DFT Purchase Order Line\RAW Oracle PO Line" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="RAW Oracle PO Line" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">7200</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT l.PO_NBR, l.PO_LINE_NBR, l.ITEM_CODE, l.UOM_CD, l.ORDER_QTY,
       l.UNIT_PRICE_AMT, l.TAX_CODE, l.NEED_BY_DT
FROM raw.OraclePurchaseOrderLine AS l
     INNER JOIN raw.OraclePurchaseOrderHdr AS h ON h.PO_NBR = l.PO_NBR
WHERE h.LAST_UPD_DT &gt; CONVERT(datetime2(3), ?) AND h.LAST_UPD_DT &lt;= CONVERT(datetime2(3), ?);</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
