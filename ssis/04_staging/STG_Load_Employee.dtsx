              <output refId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Conform Employee\Split Employee Names.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[EmployeeId]" dataType="i4" lineageId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[EmployeeId]" name="EmployeeId">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SalespersonPersonID</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">SalespersonPersonID</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[FullName]" dataType="wstr" length="100" lineageId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[FullName]" name="FullName">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TRIM(FullName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TRIM(FullName)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[GivenName]" dataType="wstr" length="50" lineageId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[GivenName]" name="GivenName">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">FINDSTRING(TRIM(FullName), " ", 1) &gt; 0 ? LEFT(TRIM(FullName), FINDSTRING(TRIM(FullName), " ", 1) - 1) : TRIM(FullName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">FINDSTRING(TRIM(FullName), " ", 1) &gt; 0 ? LEFT(TRIM(FullName), FINDSTRING(TRIM(FullName), " ", 1) - 1) : TRIM(FullName)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[FamilyName]" dataType="wstr" length="50" lineageId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[FamilyName]" name="FamilyName">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">FINDSTRING(TRIM(FullName), " ", 1) &gt; 0 ? SUBSTRING(TRIM(FullName), FINDSTRING(TRIM(FullName), " ", 1) + 1, 50) : ""</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">FINDSTRING(TRIM(FullName), " ", 1) &gt; 0 ? SUBSTRING(TRIM(FullName), FINDSTRING(TRIM(FullName), " ", 1) + 1, 50) : ""</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[PreferredName]" dataType="wstr" length="50" lineageId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[PreferredName]" name="PreferredName">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(PreferredName) ? TRIM(FullName) : TRIM(PreferredName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(PreferredName) ? TRIM(FullName) : TRIM(PreferredName)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[RegionCode]" dataType="wstr" length="4" lineageId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[RegionCode]" name="RegionCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[EmailAddress]" dataType="wstr" length="256" lineageId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[EmailAddress]" name="EmailAddress">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode)) == "EU" ? "masked@example.invalid" : LOWER(TRIM(ISNULL(EmailAddress) ? "" : EmailAddress))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode)) == "EU" ? "masked@example.invalid" : LOWER(TRIM(ISNULL(EmailAddress) ? "" : EmailAddress))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[PhoneNumberLast4]" dataType="wstr" length="4" lineageId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[PhoneNumberLast4]" name="PhoneNumberLast4">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(PhoneNumber) ? "0000" : RIGHT(REPLACE(REPLACE(TRIM(PhoneNumber), "-", ""), " ", ""), 4)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(PhoneNumber) ? "0000" : RIGHT(REPLACE(REPLACE(TRIM(PhoneNumber), "-", ""), " ", ""), 4)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[IsCurrentFlag]" dataType="wstr" length="1" lineageId="Package\DFT Conform Employee\Split Employee Names.Outputs[Derived Column Output].Columns[IsCurrentFlag]" name="IsCurrentFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(ValidTo) || ValidTo &gt; GETDATE() ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(ValidTo) || ValidTo &gt; GETDATE() ? "Y" : "N"</property>
                    </properties>
