                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SalespersonPersonID</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">SalespersonPersonID</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Salesperson\Prepare Quota Conversion.Outputs[Derived Column Output].Columns[SalesTerritoryCode]" dataType="wstr" length="12" lineageId="Package\DFT Conform Salesperson\Prepare Quota Conversion.Outputs[Derived Column Output].Columns[SalesTerritoryCode]" name="SalesTerritoryCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(SalesTerritoryCode) ? "UNASSIGNED" : SalesTerritoryCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(SalesTerritoryCode) ? "UNASSIGNED" : SalesTerritoryCode))</property>
                    </properties>
