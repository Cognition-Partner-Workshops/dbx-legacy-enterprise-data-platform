                  <outputColumn refId="Package\DFT Conform Salesperson\Prepare Quota Conversion.Outputs[Derived Column Output].Columns[QuotaCurrencyCode]" dataType="wstr" length="3" lineageId="Package\DFT Conform Salesperson\Prepare Quota Conversion.Outputs[Derived Column Output].Columns[QuotaCurrencyCode]" name="QuotaCurrencyCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(QuotaCurrencyCode) ? "USD" : QuotaCurrencyCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(QuotaCurrencyCode) ? "USD" : QuotaCurrencyCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Salesperson\Prepare Quota Conversion.Outputs[Derived Column Output].Columns[QuotaAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\DFT Conform Salesperson\Prepare Quota Conversion.Outputs[Derived Column Output].Columns[QuotaAmount]" name="QuotaAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(QuotaAmount) ? (DT_NUMERIC,18,2)0 : QuotaAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(QuotaAmount) ? (DT_NUMERIC,18,2)0 : QuotaAmount</property>
