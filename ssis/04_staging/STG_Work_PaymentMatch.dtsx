            </inputs>
            <outputs>
              <output refId="Package\DFT Match Payments To Invoices\Score Payment Match.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Match Payments To Invoices\Score Payment Match.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Match Payments To Invoices\Score Payment Match.Outputs[Derived Column Output].Columns[AmountVariance]" dataType="numeric" precision="18" scale="2" lineageId="Package\DFT Match Payments To Invoices\Score Payment Match.Outputs[Derived Column Output].Columns[AmountVariance]" name="AmountVariance">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(GrossAmount) ? (DT_NUMERIC,18,2)0 : (DT_NUMERIC,18,2)ABS(PaymentAmount - GrossAmount)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(GrossAmount) ? (DT_NUMERIC,18,2)0 : (DT_NUMERIC,18,2)ABS(PaymentAmount - GrossAmount)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Match Payments To Invoices\Score Payment Match.Outputs[Derived Column Output].Columns[MatchTypeCode]" dataType="wstr" length="10" lineageId="Package\DFT Match Payments To Invoices\Score Payment Match.Outputs[Derived Column Output].Columns[MatchTypeCode]" name="MatchTypeCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(InvoiceNumber) ? "UNMATCHED" : (ABS(PaymentAmount - GrossAmount) &lt;= (DT_NUMERIC,18,2)0.01 ? "EXACT" : (ABS(PaymentAmount - GrossAmount) &lt;= GrossAmount * (DT_NUMERIC,18,2)0.02 ? "TOLERANCE" : "VARIANCE"))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(InvoiceNumber) ? "UNMATCHED" : (ABS(PaymentAmount - GrossAmount) &lt;= (DT_NUMERIC,18,2)0.01 ? "EXACT" : (ABS(PaymentAmount - GrossAmount) &lt;= GrossAmount * (DT_NUMERIC,18,2)0.02 ? "TOLERANCE" : "VARIANCE"))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Match Payments To Invoices\Score Payment Match.Outputs[Derived Column Output].Columns[DaysLate]" dataType="i4" lineageId="Package\DFT Match Payments To Invoices\Score Payment Match.Outputs[Derived Column Output].Columns[DaysLate]" name="DaysLate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(DueDate) ? 0 : DATEDIFF("day", DueDate, PaymentDate)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(DueDate) ? 0 : DATEDIFF("day", DueDate, PaymentDate)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Match Payments To Invoices\Score Payment Match.Outputs[Derived Column Output].Columns[LatePaymentFlag]" dataType="wstr" length="1" lineageId="Package\DFT Match Payments To Invoices\Score Payment Match.Outputs[Derived Column Output].Columns[LatePaymentFlag]" name="LatePaymentFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(DueDate) ? "N" : (PaymentDate &gt; DueDate ? "Y" : "N")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(DueDate) ? "N" : (PaymentDate &gt; DueDate ? "Y" : "N")</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
          <component refId="Package\DFT Match Payments To Invoices\Route Match Outcome" componentClassID="Microsoft.ConditionalSplit" description="Conditional Split" name="Route Match Outcome" version="1">
