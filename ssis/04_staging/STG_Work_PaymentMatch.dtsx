      <pipeline version="1">
        <components>
          <component refId="Package\DFT Match Payments To Invoices\STG Payment Joined To Invoice" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="STG Payment Joined To Invoice" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">7200</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT p.PaymentNumber, p.SupplierCode, p.PaymentAmount, p.PaymentCurrencyCode, p.PaymentDate,
       i.InvoiceNumber, i.GrossAmount, i.DueDate
FROM stg.Payment AS p
     LEFT OUTER JOIN stg.ApInvoice AS i
       ON i.SupplierCode = p.SupplierCode
      AND i.InvoiceCurrencyCode = p.PaymentCurrencyCode
ORDER BY p.SupplierCode, p.PaymentDate;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
