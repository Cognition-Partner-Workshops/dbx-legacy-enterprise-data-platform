          <component refId="Package\DFT Conform Web Session\Apply Consent Rules" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Apply Consent Rules" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Conform Web Session\Apply Consent Rules.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Conform Web Session\Apply Consent Rules.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[SessionGuid]" dataType="wstr" length="36" lineageId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[SessionGuid]" name="SessionGuid">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(SessionGuid))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(SessionGuid))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[RegionCode]" dataType="wstr" length="4" lineageId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[RegionCode]" name="RegionCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(RegionCode) ? "NA" : RegionCode</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(RegionCode) ? "NA" : RegionCode</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[ConsentGivenFlag]" dataType="wstr" length="1" lineageId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[ConsentGivenFlag]" name="ConsentGivenFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(ConsentFlag) ? "N" : ConsentFlag)) == "Y" ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(ConsentFlag) ? "N" : ConsentFlag)) == "Y" ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[CustomerId]" dataType="i4" lineageId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[CustomerId]" name="CustomerId">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(ISNULL(RegionCode) ? "NA" : RegionCode) == "EU" &amp;&amp; UPPER(TRIM(ISNULL(ConsentFlag) ? "N" : ConsentFlag)) != "Y" ? -1 : (ISNULL(CustomerID) ? -1 : CustomerID)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(ISNULL(RegionCode) ? "NA" : RegionCode) == "EU" &amp;&amp; UPPER(TRIM(ISNULL(ConsentFlag) ? "N" : ConsentFlag)) != "Y" ? -1 : (ISNULL(CustomerID) ? -1 : CustomerID)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[UserAgentFamily]" dataType="wstr" length="40" lineageId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[UserAgentFamily]" name="UserAgentFamily">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(ConsentFlag) ? "N" : ConsentFlag)) != "Y" ? "SUPPRESSED" : LEFT(TRIM(ISNULL(UserAgentText) ? "UNKNOWN" : UserAgentText), 40)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(ConsentFlag) ? "N" : ConsentFlag)) != "Y" ? "SUPPRESSED" : LEFT(TRIM(ISNULL(UserAgentText) ? "UNKNOWN" : UserAgentText), 40)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[LandingPagePath]" dataType="wstr" length="200" lineageId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[LandingPagePath]" name="LandingPagePath">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(LandingPageUrl) ? "/" : LOWER(LEFT(TOKEN(REPLACE(LandingPageUrl, "://", " "), " ", 2), 200))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(LandingPageUrl) ? "/" : LOWER(LEFT(TOKEN(REPLACE(LandingPageUrl, "://", " "), " ", 2), 200))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[ChannelCode]" dataType="wstr" length="10" lineageId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[ChannelCode]" name="ChannelCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(ChannelCode) ? "WEB" : ChannelCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(ChannelCode) ? "WEB" : ChannelCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[DeviceTypeCode]" dataType="wstr" length="10" lineageId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[DeviceTypeCode]" name="DeviceTypeCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(DeviceTypeCode) ? "UNKNOWN" : DeviceTypeCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(DeviceTypeCode) ? "UNKNOWN" : DeviceTypeCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[PageViewCount]" dataType="i4" lineageId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[PageViewCount]" name="PageViewCount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(PageViewCount) ? 0 : PageViewCount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(PageViewCount) ? 0 : PageViewCount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[DurationSeconds]" dataType="i4" lineageId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[DurationSeconds]" name="DurationSeconds">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(DurationSeconds) || DurationSeconds &lt; 0 ? 0 : DurationSeconds</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(DurationSeconds) || DurationSeconds &lt; 0 ? 0 : DurationSeconds</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[BounceFlag]" dataType="wstr" length="1" lineageId="Package\DFT Conform Web Session\Apply Consent Rules.Outputs[Derived Column Output].Columns[BounceFlag]" name="BounceFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(PageViewCount) || PageViewCount &lt;= 1 ? "Y" : "N"</property>
