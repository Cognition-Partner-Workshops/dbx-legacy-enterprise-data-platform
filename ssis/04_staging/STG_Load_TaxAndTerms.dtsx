                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(REPLACE(TRIM(TERMS_CODE)," ",""))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(REPLACE(TRIM(TERMS_CODE)," ",""))</property>
