                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(JURISDICTION_CD) ? (ISNULL(COUNTRY_CD) ? "UNKNOWN" : COUNTRY_CD) : JURISDICTION_CD))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(JURISDICTION_CD) ? (ISNULL(COUNTRY_CD) ? "UNKNOWN" : COUNTRY_CD) : JURISDICTION_CD))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Tax Rate\Derive Regional Tax Attributes.Outputs[Derived Column Output].Columns[RatePercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\DFT Conform Tax Rate\Derive Regional Tax Attributes.Outputs[Derived Column Output].Columns[RatePercent]" name="RatePercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(RATE_PCT) ? (DT_NUMERIC,9,4)0 : RATE_PCT</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(RATE_PCT) ? (DT_NUMERIC,9,4)0 : RATE_PCT</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Tax Rate\Derive Regional Tax Attributes.Outputs[Derived Column Output].Columns[IsRecoverableFlag]" dataType="wstr" length="1" lineageId="Package\DFT Conform Tax Rate\Derive Regional Tax Attributes.Outputs[Derived Column Output].Columns[IsRecoverableFlag]" name="IsRecoverableFlag">
                    <properties>
