                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Tax Rate\Derive Regional Tax Attributes.Outputs[Derived Column Output].Columns[TaxTypeCode]" dataType="wstr" length="8" lineageId="Package\DFT Conform Tax Rate\Derive Regional Tax Attributes.Outputs[Derived Column Output].Columns[TaxTypeCode]" name="TaxTypeCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(REGION_CD) ? "NA" : REGION_CD)) == "EU" ? "VAT" : (UPPER(TRIM(ISNULL(REGION_CD) ? "NA" : REGION_CD)) == "APAC" ? "GST" : "SALESTAX")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(REGION_CD) ? "NA" : REGION_CD)) == "EU" ? "VAT" : (UPPER(TRIM(ISNULL(REGION_CD) ? "NA" : REGION_CD)) == "APAC" ? "GST" : "SALESTAX")</property>
                    </properties>
