          <component refId="Package\DFT Conform Promotion\Type Promotions" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Type Promotions" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Conform Promotion\Type Promotions.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Conform Promotion\Type Promotions.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Conform Promotion\Type Promotions.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Conform Promotion\Type Promotions.Outputs[Derived Column Output].Columns[PromotionCode]" dataType="wstr" length="20" lineageId="Package\DFT Conform Promotion\Type Promotions.Outputs[Derived Column Output].Columns[PromotionCode]" name="PromotionCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(PromotionCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(PromotionCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Promotion\Type Promotions.Outputs[Derived Column Output].Columns[PromotionName]" dataType="wstr" length="100" lineageId="Package\DFT Conform Promotion\Type Promotions.Outputs[Derived Column Output].Columns[PromotionName]" name="PromotionName">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TRIM(PromotionName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TRIM(PromotionName)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Promotion\Type Promotions.Outputs[Derived Column Output].Columns[PromotionTypeCode]" dataType="wstr" length="10" lineageId="Package\DFT Conform Promotion\Type Promotions.Outputs[Derived Column Output].Columns[PromotionTypeCode]" name="PromotionTypeCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(DiscountPercent) || DiscountPercent == 0 ? "AMOUNT" : "PERCENT"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(DiscountPercent) || DiscountPercent == 0 ? "AMOUNT" : "PERCENT"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Promotion\Type Promotions.Outputs[Derived Column Output].Columns[RegionCode]" dataType="wstr" length="4" lineageId="Package\DFT Conform Promotion\Type Promotions.Outputs[Derived Column Output].Columns[RegionCode]" name="RegionCode">
