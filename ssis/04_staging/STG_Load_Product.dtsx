                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(NET_WEIGHT) ? (DT_NUMERIC,18,4)0 : (DT_NUMERIC,18,4)(NET_WEIGHT * ISNULL(WeightFactorKg) ? 1 : WeightFactorKg)</property>
