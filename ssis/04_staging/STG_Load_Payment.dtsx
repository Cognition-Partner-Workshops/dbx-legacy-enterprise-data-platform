                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(VALUE_DT) ? (UPPER(TRIM(REGION_CD)) == "EU" ? DATEADD("day", 2, PAY_DT) : DATEADD("day", 1, PAY_DT)) : VALUE_DT</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(VALUE_DT) ? (UPPER(TRIM(REGION_CD)) == "EU" ? DATEADD("day", 2, PAY_DT) : DATEADD("day", 1, PAY_DT)) : VALUE_DT</property>
                    </properties>
                  </outputColumn>
