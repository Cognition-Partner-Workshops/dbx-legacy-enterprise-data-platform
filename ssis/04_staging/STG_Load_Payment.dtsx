                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(PAY_STATUS_CD)) == "P" ? "PAID" : (UPPER(TRIM(PAY_STATUS_CD)) == "V" ? "VOID" : "PEND")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(PAY_STATUS_CD)) == "P" ? "PAID" : (UPPER(TRIM(PAY_STATUS_CD)) == "V" ? "VOID" : "PEND")</property>
