                  <inputColumn refId="Package\DFT Shipment Header\Standardize Shipment.Inputs[Derived Column Input].Columns[CarrierCode]" cachedDataType="wstr" cachedLength="10" cachedName="CarrierCode" lineageId="Package\DFT Shipment Header\RAW SQL Shipment.Outputs[OLE DB Source Output].Columns[CarrierCode]" name="CarrierCode" usageType="readWrite">
                    <properties>
