              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT l.ShipmentLineID, l.ShipmentID, l.StockItemID, l.QuantityShipped, l.LineWeightKg
FROM raw.SqlShipmentLine AS l
     INNER JOIN raw.SqlShipment AS s ON s.ShipmentID = l.ShipmentID
