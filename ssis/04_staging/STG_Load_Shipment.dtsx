                    </properties>
                  </inputColumn>
                  <inputColumn refId="Package\DFT Shipment Header\Standardize Shipment.Inputs[Derived Column Input].Columns[DestinationPostalCode]" cachedDataType="wstr" cachedLength="12" cachedName="DestinationPostalCode" lineageId="Package\DFT Shipment Header\RAW SQL Shipment.Outputs[OLE DB Source Output].Columns[DestinationPostalCode]" name="DestinationPostalCode" usageType="readWrite">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(DestinationCountryCode)) == "USA" || UPPER(TRIM(DestinationCountryCode)) == "CAN" ? LEFT(REPLACE(TRIM(DestinationPostalCode), " ", ""), 5) : (UPPER(TRIM(DestinationCountryCode)) == "JPN" || UPPER(TRIM(DestinationCountryCode)) == "AUS" ? REPLACE(REPLACE(TRIM(DestinationPostalCode), "-", ""), " ", "") : UPPER(TRIM(DestinationCountryCode)) + "-" + REPLACE(TRIM(DestinationPostalCode), " ", ""))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(DestinationCountryCode)) == "USA" || UPPER(TRIM(DestinationCountryCode)) == "CAN" ? LEFT(REPLACE(TRIM(DestinationPostalCode), " ", ""), 5) : (UPPER(TRIM(DestinationCountryCode)) == "JPN" || UPPER(TRIM(DestinationCountryCode)) == "AUS" ? REPLACE(REPLACE(TRIM(DestinationPostalCode), "-", ""), " ", "") : UPPER(TRIM(DestinationCountryCode)) + "-" + REPLACE(TRIM(DestinationPostalCode), " ", ""))</property>
