              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT l.OrderLineID, l.OrderID, l.StockItemID, l.Description, l.Quantity, l.UnitPrice,
       l.TaxRate, l.PackageTypeCode, l.PickingCompletedWhen
FROM raw.SqlOrderLine AS l
     INNER JOIN raw.SqlOrder AS o ON o.OrderID = l.OrderID
WHERE o.LastEditedWhen &gt; CONVERT(datetime2(3), ?) AND o.LastEditedWhen &lt;= CONVERT(datetime2(3), ?);</property>
