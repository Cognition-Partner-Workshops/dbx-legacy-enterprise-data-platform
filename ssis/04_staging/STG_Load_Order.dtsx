          <component refId="Package\DFT Order Header\Clean Order Header" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Clean Order Header" usesDispositions="true">
            <inputs>
              <input refId="Package\DFT Order Header\Clean Order Header.Inputs[Derived Column Input]" name="Derived Column Input">
                <inputColumns>
                  <inputColumn refId="Package\DFT Order Header\Clean Order Header.Inputs[Derived Column Input].Columns[ExpectedDeliveryDate]" cachedName="ExpectedDeliveryDate" lineageId="Package\DFT Order Header\RAW SQL Order.Outputs[OLE DB Source Output].Columns[ExpectedDeliveryDate]" name="ExpectedDeliveryDate" usageType="readWrite">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(ExpectedDeliveryDate) ? DATEADD("day", 3, OrderDate) : ExpectedDeliveryDate</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(ExpectedDeliveryDate) ? DATEADD("day", 3, OrderDate) : ExpectedDeliveryDate</property>
