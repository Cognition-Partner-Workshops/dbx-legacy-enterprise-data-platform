              </input>
            </inputs>
            <outputs>
              <output refId="Package\DFT Order Header\Clean Order Header.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Order Header\Clean Order Header.Inputs[Derived Column Input]">
