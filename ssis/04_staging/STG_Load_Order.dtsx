                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(SalespersonPersonID) ? -1 : SalespersonPersonID</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(SalespersonPersonID) ? -1 : SalespersonPersonID</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Order Header\Clean Order Header.Outputs[Derived Column Output].Columns[CustomerPoNumber]" dataType="wstr" length="20" lineageId="Package\DFT Order Header\Clean Order Header.Outputs[Derived Column Output].Columns[CustomerPoNumber]" name="CustomerPoNumber">
                    <properties>
