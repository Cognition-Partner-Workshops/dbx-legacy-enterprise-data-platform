      <pipeline version="1">
        <components>
          <component refId="Package\DFT Conform FX Rate\RAW Oracle FX Rate" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="RAW Oracle FX Rate" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">0</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="Specifies the variable that contains the name of the database object used to open a rowset." name="OpenRowsetVariable"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT FROM_CURRENCY_CD AS FROM_CCY, TO_CURRENCY_CD AS TO_CCY,
       TRY_CONVERT(DATE, RATE_DT) AS EFF_FROM_DT,
       TRY_CONVERT(DECIMAL(18,8), CONVERSION_RATE) AS RATE,
       RATE_TYPE_CD, RATE_SOURCE_CD AS SRC_SYSTEM_CD
FROM raw.OracleFxRate
WHERE BatchId = ? AND TRY_CONVERT(DECIMAL(18,8), CONVERSION_RATE) &gt; 0
UNION ALL
SELECT FromCurrencyCode, ToCurrencyCode,
       TRY_CONVERT(DATE, RateDate),
       TRY_CONVERT(DECIMAL(18,8), ConversionRate),
       N'OVERRIDE', N'FILE_FX'
FROM raw.FileFxOverride WHERE BatchId = ?;</property>
