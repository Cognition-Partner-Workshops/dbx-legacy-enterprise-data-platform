                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(REGION_CD) ? "NA" : REGION_CD))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(REGION_CD) ? "NA" : REGION_CD))</property>
