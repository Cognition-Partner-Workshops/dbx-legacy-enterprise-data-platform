                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TRIM(CUST_NAME) == TRIM(ISNULL(TRADING_NAME) ? "" : TRADING_NAME) ? NULL(DT_WSTR,100) : TRIM(TRADING_NAME)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TRIM(CUST_NAME) == TRIM(ISNULL(TRADING_NAME) ? "" : TRADING_NAME) ? NULL(DT_WSTR,100) : TRIM(TRADING_NAME)</property>
