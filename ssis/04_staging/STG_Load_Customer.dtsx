                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(REGION_CD)) == "EU" ? (UPPER(TRIM(ISNULL(CONSENT_FLAG) ? "N" : CONSENT_FLAG)) == "Y" ? "Y" : "N") : (UPPER(TRIM(ISNULL(CONSENT_FLAG) ? "Y" : CONSENT_FLAG)) == "N" ? "N" : "Y")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(REGION_CD)) == "EU" ? (UPPER(TRIM(ISNULL(CONSENT_FLAG) ? "N" : CONSENT_FLAG)) == "Y" ? "Y" : "N") : (UPPER(TRIM(ISNULL(CONSENT_FLAG) ? "Y" : CONSENT_FLAG)) == "N" ? "N" : "Y")</property>
                    </properties>
