                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(REGION_CD)) == "EU" ? 24 : (UPPER(TRIM(REGION_CD)) == "APAC" ? 60 : 84)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(REGION_CD)) == "EU" ? 24 : (UPPER(TRIM(REGION_CD)) == "APAC" ? 60 : 84)</property>
