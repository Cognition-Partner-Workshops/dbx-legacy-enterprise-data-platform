                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CUST_CLASS_CD) || TRIM(CUST_CLASS_CD) == "" ? "UNCL" : UPPER(TRIM(CUST_CLASS_CD))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CUST_CLASS_CD) || TRIM(CUST_CLASS_CD) == "" ? "UNCL" : UPPER(TRIM(CUST_CLASS_CD))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Conform Customer\Cleanse Customer Attributes.Outputs[Derived Column Output].Columns[CreditStatusCode]" dataType="wstr" length="4" lineageId="Package\DFT Conform Customer\Cleanse Customer Attributes.Outputs[Derived Column Output].Columns[CreditStatusCode]" name="CreditStatusCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(CREDIT_STATUS_CD) ? "NEW" : CREDIT_STATUS_CD))</property>
