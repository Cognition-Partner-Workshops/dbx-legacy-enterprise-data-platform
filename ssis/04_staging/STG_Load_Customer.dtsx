                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(REPLACE(REPLACE(TRIM(TAX_REG_NBR)," ",""),"-",""))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(REPLACE(REPLACE(TRIM(TAX_REG_NBR)," ",""),"-",""))</property>
                    </properties>
                  </outputColumn>
