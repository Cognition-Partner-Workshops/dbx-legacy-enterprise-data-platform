                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM((DT_WSTR,60)[InvoiceNumber])) + "|" + UPPER(TRIM((DT_WSTR,60)[SupplierCode])) + "|" + UPPER(TRIM((DT_WSTR,60)[GrossAmount])) + "|" + UPPER(TRIM((DT_WSTR,60)[TaxAmount])) + "|" + UPPER(TRIM((DT_WSTR,60)[OnHoldFlag]))</property>
