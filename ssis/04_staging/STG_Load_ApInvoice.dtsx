                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(TaxRatePercent) ? (DT_NUMERIC,18,2)0 : (DT_NUMERIC,18,2)(LineAmount * TaxRatePercent / 100)</property>
