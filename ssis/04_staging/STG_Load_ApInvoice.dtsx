                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(PO_NBR) ? NULL(DT_WSTR,20) : UPPER(TRIM(PO_NBR))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(PO_NBR) ? NULL(DT_WSTR,20) : UPPER(TRIM(PO_NBR))</property>
                    </properties>
