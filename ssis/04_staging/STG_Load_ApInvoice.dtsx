                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_NUMERIC,18,2)((ISNULL(GROSS_AMT) ? (DT_NUMERIC,18,2)0 : GROSS_AMT) - (ISNULL(TAX_AMT) ? (DT_NUMERIC,18,2)0 : TAX_AMT))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_NUMERIC,18,2)((ISNULL(GROSS_AMT) ? (DT_NUMERIC,18,2)0 : GROSS_AMT) - (ISNULL(TAX_AMT) ? (DT_NUMERIC,18,2)0 : TAX_AMT))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT AP Invoice Header\Classify Invoice Tax.Outputs[Derived Column Output].Columns[InvoiceCurrencyCode]" dataType="wstr" length="3" lineageId="Package\DFT AP Invoice Header\Classify Invoice Tax.Outputs[Derived Column Output].Columns[InvoiceCurrencyCode]" name="InvoiceCurrencyCode">
