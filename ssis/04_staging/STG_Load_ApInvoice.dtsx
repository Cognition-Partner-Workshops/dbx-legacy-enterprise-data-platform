              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT l.INVOICE_NBR, l.INV_LINE_NBR, l.COST_CENTER_CD, l.GL_ACCOUNT_CD,
       l.LINE_AMT, l.TAX_CODE, l.PO_NBR
