                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(TAX_AMT) ? (DT_NUMERIC,18,2)0 : TAX_AMT</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(TAX_AMT) ? (DT_NUMERIC,18,2)0 : TAX_AMT</property>
