          <component refId="Package\DFT AP Invoice Line\RAW Oracle AP Invoice Line" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="RAW Oracle AP Invoice Line" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">7200</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="Specifies the variable that contains the name of the database object used to open a rowset." name="OpenRowsetVariable"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT l.INVOICE_NBR, l.INV_LINE_NBR, l.COST_CENTER_CD, l.GL_ACCOUNT_CD,
       l.LINE_AMT, l.TAX_CODE, l.PO_NBR
FROM raw.OracleApInvoiceLine AS l
     INNER JOIN raw.OracleApInvoiceHdr AS h ON h.INVOICE_NBR = l.INVOICE_NBR
WHERE h.INVOICE_DT &gt; CONVERT(datetime2(3), ?) AND h.INVOICE_DT &lt;= CONVERT(datetime2(3), ?);</property>
              <property dataType="System.String" description="The variable that contains the SQL command to be executed." name="SqlCommandVariable"></property>
