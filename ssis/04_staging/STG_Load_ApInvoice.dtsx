                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(REGION_CD)) == "EU" ? "VAT" : (UPPER(TRIM(REGION_CD)) == "APAC" ? "GST" : "SUT")</property>
