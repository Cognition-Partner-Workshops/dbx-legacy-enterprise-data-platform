                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(DUE_DT) ? DATEADD("day", NetDays, INVOICE_DT) : DUE_DT</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(DUE_DT) ? DATEADD("day", NetDays, INVOICE_DT) : DUE_DT</property>
