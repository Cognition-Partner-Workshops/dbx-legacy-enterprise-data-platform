                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(TargetDescription) || TRIM(TargetDescription) == "" ? "Unmapped" : TRIM(TargetDescription)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(TargetDescription) || TRIM(TargetDescription) == "" ? "Unmapped" : TRIM(TargetDescription)</property>
