          <component refId="Package\DFT Scan Staging For Unmapped Codes\STG Observed Codes" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="STG Observed Codes" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT N'PAYMENT_METHOD' AS CodeSetName, N'ORA_ERP' AS SourceSystemCode,
       SourcePaymentMethodCode AS SourceCode, COUNT_BIG(*) AS OccurrenceCount
FROM stg.Payment GROUP BY SourcePaymentMethodCode
UNION ALL
SELECT N'RETURN_REASON', N'WWI_OLTP', SourceReturnReasonCode, COUNT_BIG(*)
FROM stg.[Return] GROUP BY SourceReturnReasonCode
UNION ALL
SELECT N'TRANSACTION_TYPE', N'WWI_OLTP', TransactionTypeCode, COUNT_BIG(*)
FROM stg.StockMovement GROUP BY TransactionTypeCode;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
