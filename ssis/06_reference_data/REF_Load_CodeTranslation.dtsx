                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM((DT_WSTR,60)CodeSetName)) + "|" + UPPER(TRIM((DT_WSTR,60)SourceSystemCode)) + "|" + UPPER(TRIM((DT_WSTR,60)SourceCode)) + "|" + UPPER(TRIM((DT_WSTR,60)TargetCode))</property>
