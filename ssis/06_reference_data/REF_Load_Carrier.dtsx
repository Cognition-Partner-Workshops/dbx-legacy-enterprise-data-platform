            </outputs>
          </component>
          <component refId="Package\DFT Publish Carrier Dimension\Conform Carrier" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Conform Carrier" usesDispositions="true">
            <inputs>
              <input refId="Package\DFT Publish Carrier Dimension\Conform Carrier.Inputs[Derived Column Input]" name="Derived Column Input">
                <inputColumns>
                  <inputColumn refId="Package\DFT Publish Carrier Dimension\Conform Carrier.Inputs[Derived Column Input].Columns[CarrierCode]" cachedName="CarrierCode" lineageId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Output].Columns[CarrierCode]" name="CarrierCode" usageType="readWrite">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CarrierCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CarrierCode))</property>
                    </properties>
                  </inputColumn>
                  <inputColumn refId="Package\DFT Publish Carrier Dimension\Conform Carrier.Inputs[Derived Column Input].Columns[CarrierName]" cachedName="CarrierName" lineageId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Output].Columns[CarrierName]" name="CarrierName" usageType="readWrite">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CarrierName) ? UPPER(TRIM(CarrierCode)) : TRIM(CarrierName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CarrierName) ? UPPER(TRIM(CarrierCode)) : TRIM(CarrierName)</property>
                    </properties>
                  </inputColumn>
                </inputColumns>
              </input>
            </inputs>
            <outputs>
              <output refId="Package\DFT Publish Carrier Dimension\Conform Carrier.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Publish Carrier Dimension\Conform Carrier.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Publish Carrier Dimension\Conform Carrier.Outputs[Derived Column Output].Columns[CrossBorderFlag]" dataType="wstr" length="1" lineageId="Package\DFT Publish Carrier Dimension\Conform Carrier.Outputs[Derived Column Output].Columns[CrossBorderFlag]" name="CrossBorderFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "ALL" ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "ALL" ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Carrier Dimension\Conform Carrier.Outputs[Derived Column Output].Columns[OnTimeTargetDays]" dataType="numeric" precision="9" scale="2" lineageId="Package\DFT Publish Carrier Dimension\Conform Carrier.Outputs[Derived Column Output].Columns[OnTimeTargetDays]" name="OnTimeTargetDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "APAC" ? (DT_NUMERIC,9,2)5 : (RegionCode == "EU" ? (DT_NUMERIC,9,2)3 : (DT_NUMERIC,9,2)4)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "APAC" ? (DT_NUMERIC,9,2)5 : (RegionCode == "EU" ? (DT_NUMERIC,9,2)3 : (DT_NUMERIC,9,2)4)</property>
                    </properties>
                  </outputColumn>
