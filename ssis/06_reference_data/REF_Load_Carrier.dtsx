                  <outputColumn refId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Error Output].Columns[ErrorColumn]" dataType="i4" lineageId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Error Output].Columns[ErrorColumn]" name="ErrorColumn" specialFlags="1" />
