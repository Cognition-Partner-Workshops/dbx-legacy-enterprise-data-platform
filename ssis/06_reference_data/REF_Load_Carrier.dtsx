                  <outputColumn refId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Error Output].Columns[CarrierName]" dataType="wstr" length="60" lineageId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Error Output].Columns[CarrierName]" name="CarrierName" />
                  <outputColumn refId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Error Output].Columns[ServiceLevelCode]" dataType="wstr" length="10" lineageId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Error Output].Columns[ServiceLevelCode]" name="ServiceLevelCode" />
