                  <outputColumn refId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].Columns[CarrierCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].ExternalColumns[CarrierCode]" lineageId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].Columns[CarrierCode]" name="CarrierCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].Columns[CarrierName]" dataType="wstr" length="60" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].ExternalColumns[CarrierName]" lineageId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].Columns[CarrierName]" name="CarrierName" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].Columns[ServiceLevelCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].ExternalColumns[ServiceLevelCode]" lineageId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].Columns[ServiceLevelCode]" name="ServiceLevelCode" truncationRowDisposition="RedirectRow" />
