                  <outputColumn refId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Error Output].Columns[ShipmentCount]" dataType="i4" lineageId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Error Output].Columns[ShipmentCount]" name="ShipmentCount" />
                  <outputColumn refId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Error Output].Columns[AverageTransitDays]" dataType="numeric" precision="9" scale="2" lineageId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Error Output].Columns[AverageTransitDays]" name="AverageTransitDays" />
                  <outputColumn refId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Error Output].Columns[ErrorCode]" dataType="i4" lineageId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Error Output].Columns[ErrorCode]" name="ErrorCode" specialFlags="1" />
