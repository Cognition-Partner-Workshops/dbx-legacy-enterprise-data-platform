                  <outputColumn refId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].Columns[ShipmentCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].ExternalColumns[ShipmentCount]" lineageId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].Columns[ShipmentCount]" name="ShipmentCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].Columns[AverageTransitDays]" dataType="numeric" precision="9" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].ExternalColumns[AverageTransitDays]" lineageId="Package\DFT Load Carrier\STG Carrier Usage.Outputs[OLE DB Source Output].Columns[AverageTransitDays]" name="AverageTransitDays" truncationRowDisposition="RedirectRow" />
