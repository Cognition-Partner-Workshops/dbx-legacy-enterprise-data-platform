                  <outputColumn refId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Output].Columns[CarrierName]" dataType="wstr" length="60" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Output].ExternalColumns[CarrierName]" lineageId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Output].Columns[CarrierName]" name="CarrierName" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
