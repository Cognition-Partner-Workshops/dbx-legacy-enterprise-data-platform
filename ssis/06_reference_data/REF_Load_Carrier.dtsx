            </inputs>
            <outputs>
              <output refId="Package\DFT Load Carrier\Count Carriers Read.Outputs[Row Count Output]" name="Row Count Output" synchronousInputId="Package\DFT Load Carrier\Count Carriers Read.Inputs[Row Count Input]" />
            </outputs>
          </component>
          <component refId="Package\DFT Load Carrier\Conform Carrier" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Conform Carrier" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Load Carrier\Conform Carrier.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Load Carrier\Conform Carrier.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Load Carrier\Conform Carrier.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Load Carrier\Conform Carrier.Outputs[Derived Column Output].Columns[CarrierCode]" dataType="wstr" length="10" lineageId="Package\DFT Load Carrier\Conform Carrier.Outputs[Derived Column Output].Columns[CarrierCode]" name="CarrierCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CarrierCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CarrierCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Carrier\Conform Carrier.Outputs[Derived Column Output].Columns[ServiceLevelCode]" dataType="wstr" length="10" lineageId="Package\DFT Load Carrier\Conform Carrier.Outputs[Derived Column Output].Columns[ServiceLevelCode]" name="ServiceLevelCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(ServiceLevelCode) || TRIM(ServiceLevelCode) == "" ? (AverageTransitDays &lt;= 1 ? "NEXTDAY" : (AverageTransitDays &lt;= 3 ? "EXPRESS" : "STANDARD")) : UPPER(TRIM(ServiceLevelCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(ServiceLevelCode) || TRIM(ServiceLevelCode) == "" ? (AverageTransitDays &lt;= 1 ? "NEXTDAY" : (AverageTransitDays &lt;= 3 ? "EXPRESS" : "STANDARD")) : UPPER(TRIM(ServiceLevelCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Carrier\Conform Carrier.Outputs[Derived Column Output].Columns[CrossBorderFlag]" dataType="wstr" length="1" lineageId="Package\DFT Load Carrier\Conform Carrier.Outputs[Derived Column Output].Columns[CrossBorderFlag]" name="CrossBorderFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "ALL" ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "ALL" ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Carrier\Conform Carrier.Outputs[Derived Column Output].Columns[OnTimeTargetDays]" dataType="numeric" precision="9" scale="2" lineageId="Package\DFT Load Carrier\Conform Carrier.Outputs[Derived Column Output].Columns[OnTimeTargetDays]" name="OnTimeTargetDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "APAC" ? (DT_NUMERIC,9,2)5 : (RegionCode == "EU" ? (DT_NUMERIC,9,2)3 : (DT_NUMERIC,9,2)4)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "APAC" ? (DT_NUMERIC,9,2)5 : (RegionCode == "EU" ? (DT_NUMERIC,9,2)3 : (DT_NUMERIC,9,2)4)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Carrier\Conform Carrier.Outputs[Derived Column Output].Columns[CodeValue]" dataType="wstr" length="60" lineageId="Package\DFT Load Carrier\Conform Carrier.Outputs[Derived Column Output].Columns[CodeValue]" name="CodeValue">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CarrierCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CarrierCode))</property>
                    </properties>
                  </outputColumn>
