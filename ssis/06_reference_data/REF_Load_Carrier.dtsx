                  <outputColumn refId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Output].Columns[SourceCodeCount]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Output].ExternalColumns[SourceCodeCount]" lineageId="Package\DFT Publish Carrier Dimension\REF Carrier Conformed.Outputs[OLE DB Source Output].Columns[SourceCodeCount]" name="SourceCodeCount" truncationRowDisposition="RedirectRow" />
