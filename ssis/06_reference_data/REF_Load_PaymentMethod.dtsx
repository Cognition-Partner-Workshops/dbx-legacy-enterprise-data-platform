            <properties>
              <property dataType="System.String" description="The variable that receives the row count." name="VariableName">User::RowsRead</property>
            </properties>
            <inputs>
              <input refId="Package\DFT Load Payment Method\Count Methods Read.Inputs[Row Count Input]" name="Row Count Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Load Payment Method\Count Methods Read.Outputs[Row Count Output]" name="Row Count Output" synchronousInputId="Package\DFT Load Payment Method\Count Methods Read.Inputs[Row Count Input]" />
            </outputs>
          </component>
          <component refId="Package\DFT Load Payment Method\Conform Payment Method" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Conform Payment Method" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Load Payment Method\Conform Payment Method.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Load Payment Method\Conform Payment Method.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Load Payment Method\Conform Payment Method.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Load Payment Method\Conform Payment Method.Outputs[Derived Column Output].Columns[PaymentMethodCode]" dataType="wstr" length="12" lineageId="Package\DFT Load Payment Method\Conform Payment Method.Outputs[Derived Column Output].Columns[PaymentMethodCode]" name="PaymentMethodCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(PaymentMethodCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(PaymentMethodCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Payment Method\Conform Payment Method.Outputs[Derived Column Output].Columns[SettlementTypeCode]" dataType="wstr" length="10" lineageId="Package\DFT Load Payment Method\Conform Payment Method.Outputs[Derived Column Output].Columns[SettlementTypeCode]" name="SettlementTypeCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SettlementTypeCode != "UNKNOWN" ? UPPER(TRIM(SettlementTypeCode)) : (RegionCode == "EU" ? "SEPA" : (RegionCode == "APAC" ? "RTGS" : "ACH"))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">SettlementTypeCode != "UNKNOWN" ? UPPER(TRIM(SettlementTypeCode)) : (RegionCode == "EU" ? "SEPA" : (RegionCode == "APAC" ? "RTGS" : "ACH"))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Payment Method\Conform Payment Method.Outputs[Derived Column Output].Columns[ElectronicFlag]" dataType="wstr" length="1" lineageId="Package\DFT Load Payment Method\Conform Payment Method.Outputs[Derived Column Output].Columns[ElectronicFlag]" name="ElectronicFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(PaymentMethodCode)) == "CHQ" || UPPER(TRIM(PaymentMethodCode)) == "CASH" ? "N" : "Y"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(PaymentMethodCode)) == "CHQ" || UPPER(TRIM(PaymentMethodCode)) == "CASH" ? "N" : "Y"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Payment Method\Conform Payment Method.Outputs[Derived Column Output].Columns[CodeValue]" dataType="wstr" length="60" lineageId="Package\DFT Load Payment Method\Conform Payment Method.Outputs[Derived Column Output].Columns[CodeValue]" name="CodeValue">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(PaymentMethodCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(PaymentMethodCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Payment Method\Conform Payment Method.Outputs[Derived Column Output].Columns[CodeDescription]" dataType="wstr" length="200" lineageId="Package\DFT Load Payment Method\Conform Payment Method.Outputs[Derived Column Output].Columns[CodeDescription]" name="CodeDescription">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TRIM(PaymentMethodName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TRIM(PaymentMethodName)</property>
