                  <outputColumn refId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].Columns[SettlementTypeCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].ExternalColumns[SettlementTypeCode]" lineageId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].Columns[SettlementTypeCode]" name="SettlementTypeCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].Columns[UsageCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].ExternalColumns[UsageCount]" lineageId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].Columns[UsageCount]" name="UsageCount" truncationRowDisposition="RedirectRow" />
