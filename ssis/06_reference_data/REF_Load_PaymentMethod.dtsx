          <component refId="Package\DFT Publish Payment Method Dimension\Conform Payment Method" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Conform Payment Method" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Publish Payment Method Dimension\Conform Payment Method.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Publish Payment Method Dimension\Conform Payment Method.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Publish Payment Method Dimension\Conform Payment Method.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Publish Payment Method Dimension\Conform Payment Method.Outputs[Derived Column Output].Columns[PaymentMethodCode]" dataType="wstr" length="12" lineageId="Package\DFT Publish Payment Method Dimension\Conform Payment Method.Outputs[Derived Column Output].Columns[PaymentMethodCode]" name="PaymentMethodCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(PaymentMethodCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(PaymentMethodCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Payment Method Dimension\Conform Payment Method.Outputs[Derived Column Output].Columns[PaymentMethodName]" dataType="wstr" length="60" lineageId="Package\DFT Publish Payment Method Dimension\Conform Payment Method.Outputs[Derived Column Output].Columns[PaymentMethodName]" name="PaymentMethodName">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(PaymentMethodName) ? UPPER(TRIM(PaymentMethodCode)) : TRIM(PaymentMethodName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(PaymentMethodName) ? UPPER(TRIM(PaymentMethodCode)) : TRIM(PaymentMethodName)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Payment Method Dimension\Conform Payment Method.Outputs[Derived Column Output].Columns[SettlementTypeCode]" dataType="wstr" length="10" lineageId="Package\DFT Publish Payment Method Dimension\Conform Payment Method.Outputs[Derived Column Output].Columns[SettlementTypeCode]" name="SettlementTypeCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "EU" ? "SEPA" : (RegionCode == "APAC" ? "RTGS" : "ACH")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "EU" ? "SEPA" : (RegionCode == "APAC" ? "RTGS" : "ACH")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Payment Method Dimension\Conform Payment Method.Outputs[Derived Column Output].Columns[ElectronicFlag]" dataType="wstr" length="1" lineageId="Package\DFT Publish Payment Method Dimension\Conform Payment Method.Outputs[Derived Column Output].Columns[ElectronicFlag]" name="ElectronicFlag">
                    <properties>
