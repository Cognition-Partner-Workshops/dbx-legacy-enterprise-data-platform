                  <outputColumn refId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Error Output].Columns[SettlementTypeCode]" dataType="wstr" length="10" lineageId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Error Output].Columns[SettlementTypeCode]" name="SettlementTypeCode" />
                  <outputColumn refId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Error Output].Columns[UsageCount]" dataType="i4" lineageId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Error Output].Columns[UsageCount]" name="UsageCount" />
                  <outputColumn refId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Error Output].Columns[ErrorCode]" dataType="i4" lineageId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Error Output].Columns[ErrorCode]" name="ErrorCode" specialFlags="1" />
