                  <outputColumn refId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].Columns[PaymentMethodCode]" dataType="wstr" length="12" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].ExternalColumns[PaymentMethodCode]" lineageId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].Columns[PaymentMethodCode]" name="PaymentMethodCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].Columns[SourcePaymentMethodCode]" dataType="wstr" length="12" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].ExternalColumns[SourcePaymentMethodCode]" lineageId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].Columns[SourcePaymentMethodCode]" name="SourcePaymentMethodCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].Columns[PaymentMethodName]" dataType="wstr" length="60" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].ExternalColumns[PaymentMethodName]" lineageId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output].Columns[PaymentMethodName]" name="PaymentMethodName" truncationRowDisposition="RedirectRow" />
