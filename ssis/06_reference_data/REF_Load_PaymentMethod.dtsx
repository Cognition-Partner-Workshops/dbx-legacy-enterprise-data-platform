      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\DFT Load Payment Method\STG Payment Method Usage" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="STG Payment Method Usage" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT p.PaymentMethodCode, p.SourcePaymentMethodCode,
       ISNULL(x.TargetDescription, p.PaymentMethodCode) AS PaymentMethodName,
       p.RegionCode, ISNULL(x.AttributeValue, N'UNKNOWN') AS SettlementTypeCode,
       COUNT_BIG(*) AS UsageCount
FROM stg.Payment AS p
     LEFT OUTER JOIN ref.CodeCrosswalk AS x
       ON x.CodeSetName = N'PAYMENT_METHOD' AND x.SourceCode = p.SourcePaymentMethodCode
GROUP BY p.PaymentMethodCode, p.SourcePaymentMethodCode, x.TargetDescription, p.RegionCode,
         x.AttributeValue;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\DFT Load Payment Method\STG Payment Method Usage.Connections[OleDbConnection]" connectionManagerID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Staging_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
