                  <outputColumn refId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Error Output].Columns[PaymentMethodName]" dataType="wstr" length="60" lineageId="Package\DFT Load Payment Method\STG Payment Method Usage.Outputs[OLE DB Source Error Output].Columns[PaymentMethodName]" name="PaymentMethodName" />
