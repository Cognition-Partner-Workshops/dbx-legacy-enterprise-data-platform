                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(PaymentTermsCode)) == "DISC210" ? 10 : 0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(PaymentTermsCode)) == "DISC210" ? 10 : 0</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Outputs[Derived Column Output].Columns[DiscountPercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Outputs[Derived Column Output].Columns[DiscountPercent]" name="DiscountPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(PaymentTermsCode)) == "DISC210" ? (DT_NUMERIC,9,4)2 : (DT_NUMERIC,9,4)0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(PaymentTermsCode)) == "DISC210" ? (DT_NUMERIC,9,4)2 : (DT_NUMERIC,9,4)0</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Outputs[Derived Column Output].Columns[NetDaysCapped]" dataType="i4" lineageId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Outputs[Derived Column Output].Columns[NetDaysCapped]" name="NetDaysCapped">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "EU" &amp;&amp; NetDays &gt; 60 ? 60 : (RegionCode == "APAC" &amp;&amp; NetDays &gt; 90 ? 90 : NetDays)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "EU" &amp;&amp; NetDays &gt; 60 ? 60 : (RegionCode == "APAC" &amp;&amp; NetDays &gt; 90 ? 90 : NetDays)</property>
