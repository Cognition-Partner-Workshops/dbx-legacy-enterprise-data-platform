                  <outputColumn refId="Package\DFT Publish Payment Terms Dimension\REF PaymentTerms Conformed.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Payment Terms Dimension\REF PaymentTerms Conformed.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\DFT Publish Payment Terms Dimension\REF PaymentTerms Conformed.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
