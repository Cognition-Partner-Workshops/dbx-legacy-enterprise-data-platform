                  <outputColumn refId="Package\DFT Publish Payment Terms Dimension\REF PaymentTerms Conformed.Outputs[OLE DB Source Error Output].Columns[RegionCode]" dataType="wstr" length="4" lineageId="Package\DFT Publish Payment Terms Dimension\REF PaymentTerms Conformed.Outputs[OLE DB Source Error Output].Columns[RegionCode]" name="RegionCode" />
