          <component refId="Package\DFT Load Payment Terms\Conform Payment Terms" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Conform Payment Terms" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Load Payment Terms\Conform Payment Terms.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Load Payment Terms\Conform Payment Terms.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output].Columns[PaymentTermsCode]" dataType="wstr" length="10" lineageId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output].Columns[PaymentTermsCode]" name="PaymentTermsCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(PaymentTermsCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(PaymentTermsCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output].Columns[NetDays]" dataType="i4" lineageId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output].Columns[NetDays]" name="NetDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "EU" &amp;&amp; NetDays &gt; 60 ? 60 : (RegionCode == "APAC" &amp;&amp; NetDays &gt; 90 ? 90 : NetDays)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "EU" &amp;&amp; NetDays &gt; 60 ? 60 : (RegionCode == "APAC" &amp;&amp; NetDays &gt; 90 ? 90 : NetDays)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output].Columns[DiscountDays]" dataType="i4" lineageId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output].Columns[DiscountDays]" name="DiscountDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DiscountDays &gt; NetDays ? 0 : DiscountDays</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DiscountDays &gt; NetDays ? 0 : DiscountDays</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output].Columns[DiscountPercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output].Columns[DiscountPercent]" name="DiscountPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DiscountPercent &gt; 10 ? (DT_NUMERIC,9,4)0 : DiscountPercent</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DiscountPercent &gt; 10 ? (DT_NUMERIC,9,4)0 : DiscountPercent</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output].Columns[EarlySettlementFlag]" dataType="wstr" length="1" lineageId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output].Columns[EarlySettlementFlag]" name="EarlySettlementFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DiscountDays &gt; 0 &amp;&amp; DiscountPercent &gt; 0 ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DiscountDays &gt; 0 &amp;&amp; DiscountPercent &gt; 0 ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output].Columns[CodeValue]" dataType="wstr" length="60" lineageId="Package\DFT Load Payment Terms\Conform Payment Terms.Outputs[Derived Column Output].Columns[CodeValue]" name="CodeValue">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(PaymentTermsCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(PaymentTermsCode))</property>
                    </properties>
                  </outputColumn>
