            <outputs>
              <output refId="Package\DFT Publish Payment Terms Dimension\Count Terms Read.Outputs[Row Count Output]" name="Row Count Output" synchronousInputId="Package\DFT Publish Payment Terms Dimension\Count Terms Read.Inputs[Row Count Input]" />
            </outputs>
          </component>
          <component refId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Conform Payment Terms" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Outputs[Derived Column Output].Columns[PaymentTermsCode]" dataType="wstr" length="10" lineageId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Outputs[Derived Column Output].Columns[PaymentTermsCode]" name="PaymentTermsCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(PaymentTermsCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(PaymentTermsCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Outputs[Derived Column Output].Columns[PaymentTermsName]" dataType="wstr" length="60" lineageId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Outputs[Derived Column Output].Columns[PaymentTermsName]" name="PaymentTermsName">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(PaymentTermsName) ? UPPER(TRIM(PaymentTermsCode)) : TRIM(PaymentTermsName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(PaymentTermsName) ? UPPER(TRIM(PaymentTermsCode)) : TRIM(PaymentTermsName)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Outputs[Derived Column Output].Columns[NetDays]" dataType="i4" lineageId="Package\DFT Publish Payment Terms Dimension\Conform Payment Terms.Outputs[Derived Column Output].Columns[NetDays]" name="NetDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(PaymentTermsCode)) == "EOM" ? 30 : (UPPER(TRIM(PaymentTermsCode)) == "DISC210" ? 30 : (DT_I4)(RIGHT(UPPER(TRIM(PaymentTermsCode)), 2)))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(PaymentTermsCode)) == "EOM" ? 30 : (UPPER(TRIM(PaymentTermsCode)) == "DISC210" ? 30 : (DT_I4)(RIGHT(UPPER(TRIM(PaymentTermsCode)), 2)))</property>
                    </properties>
                  </outputColumn>
