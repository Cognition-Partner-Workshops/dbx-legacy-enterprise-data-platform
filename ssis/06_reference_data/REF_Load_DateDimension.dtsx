                  <outputColumn refId="Package\DFT Generate Calendar\STG Calendar Spine.Outputs[OLE DB Source Output].Columns[CalendarYear]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Generate Calendar\STG Calendar Spine.Outputs[OLE DB Source Output].ExternalColumns[CalendarYear]" lineageId="Package\DFT Generate Calendar\STG Calendar Spine.Outputs[OLE DB Source Output].Columns[CalendarYear]" name="CalendarYear" truncationRowDisposition="RedirectRow" />
