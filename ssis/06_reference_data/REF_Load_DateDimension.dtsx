    <DTS:Executable
      DTS:refId="Package\DFT Generate Calendar"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{C52F6444-8ACF-2376-5DEC-C4947CF13AFE}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="DFT Generate Calendar"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\DFT Generate Calendar\STG Calendar Spine" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="STG Calendar Spine" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">WITH DateSpine AS
(
    SELECT CONVERT(date, N'2005-01-01') AS CalendarDate
    UNION ALL
    SELECT DATEADD(day, 1, CalendarDate) FROM DateSpine
    WHERE CalendarDate &lt; CONVERT(date, N'2035-12-31')
)
SELECT s.CalendarDate, YEAR(s.CalendarDate) AS CalendarYear,
       MONTH(s.CalendarDate) AS CalendarMonth, DAY(s.CalendarDate) AS CalendarDay,
       DATEPART(weekday, s.CalendarDate) AS DayOfWeekNumber,
       DATENAME(month, s.CalendarDate) AS MonthName,
       DATENAME(weekday, s.CalendarDate) AS DayName,
       (SELECT FiscalYearStartMonth FROM ref.Region WHERE RegionCode = N'NA')
           AS FiscalYearStartMonthNa,
       (SELECT FiscalYearStartMonth FROM ref.Region WHERE RegionCode = N'EU')
           AS FiscalYearStartMonthEu,
       (SELECT FiscalYearStartMonth FROM ref.Region WHERE RegionCode = N'APAC')
           AS FiscalYearStartMonthApac
FROM DateSpine AS s
OPTION (MAXRECURSION 0);</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\DFT Generate Calendar\STG Calendar Spine.Connections[OleDbConnection]" connectionManagerID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Staging_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\DFT Generate Calendar\STG Calendar Spine.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
