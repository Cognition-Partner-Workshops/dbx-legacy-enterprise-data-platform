<?xml version="1.0"?>
<DTS:ConnectionManager xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:ObjectName="WWI_Source_DB"
  DTS:DTSID="{6013BF6D-BE65-C752-81B9-00A20CDE3DE7}"
  DTS:CreationName="OLEDB"
  DTS:Description="WideWorldImporters OLTP source database.">
  <DTS:PropertyExpression DTS:Name="ServerName">@[$Project::SqlServerHost] + "," + (DT_WSTR, 12) @[$Project::SqlServerPort]</DTS:PropertyExpression>
  <DTS:PropertyExpression DTS:Name="InitialCatalog">@[$Project::SqlServerOltpDb]</DTS:PropertyExpression>
  <DTS:PropertyExpression DTS:Name="UserName">@[$Project::SqlServerUser]</DTS:PropertyExpression>
  <DTS:ObjectData>
    <DTS:ConnectionManager
      DTS:ConnectionString="Data Source=sqlserver.internal.example,1433;Initial Catalog=WideWorldImporters;Provider=MSOLEDBSQL19.1;Auto Translate=False;Trust Server Certificate=True;" />
  </DTS:ObjectData>
</DTS:ConnectionManager>
