    <DTS:Executable
      DTS:refId="Package\DFT Publish Currency Dimension"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{FA80F110-D568-2B42-37F6-FB8F1932E687}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="DFT Publish Currency Dimension"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\DFT Publish Currency Dimension\REF Currency Conformed" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="REF Currency Conformed" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT c.CurrencyCode, c.CurrencyName, c.CurrencySymbol, c.MinorUnitDigits,
       c.RoundingRuleCode, c.IsReportingCurrency, c.IsEuroLegacy, c.RetiredDate,
       f.ConversionRate AS LatestRateToUsd, f.RateDate AS LatestRateDate
FROM ref.Currency AS c
     OUTER APPLY (SELECT TOP (1) r.ConversionRate, r.RateDate
                  FROM ref.FxRateDaily AS r
                  WHERE r.FromCurrencyCode = c.CurrencyCode
                    AND r.ToCurrencyCode = N'USD'
                    AND r.RateTypeCode = N'CORPORATE'
                  ORDER BY r.RateDate DESC) AS f
WHERE c.IsActive = 1;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\DFT Publish Currency Dimension\REF Currency Conformed.Connections[OleDbConnection]" connectionManagerID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Staging_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
