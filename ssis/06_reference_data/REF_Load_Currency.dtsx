          <component refId="Package\DFT Load FX Rates\Close FX Intervals" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Close FX Intervals" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Load FX Rates\Close FX Intervals.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Load FX Rates\Close FX Intervals.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Load FX Rates\Close FX Intervals.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Load FX Rates\Close FX Intervals.Outputs[Derived Column Output].Columns[EffectiveToDate]" dataType="dbTimeStamp" lineageId="Package\DFT Load FX Rates\Close FX Intervals.Outputs[Derived Column Output].Columns[EffectiveToDate]" name="EffectiveToDate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(EffectiveToDate) ? (DT_DBTIMESTAMP)"9999-12-31" : EffectiveToDate</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(EffectiveToDate) ? (DT_DBTIMESTAMP)"9999-12-31" : EffectiveToDate</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load FX Rates\Close FX Intervals.Outputs[Derived Column Output].Columns[InverseRate]" dataType="numeric" precision="18" scale="6" lineageId="Package\DFT Load FX Rates\Close FX Intervals.Outputs[Derived Column Output].Columns[InverseRate]" name="InverseRate">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ConversionRate == 0 ? (DT_NUMERIC,18,6)0 : (DT_NUMERIC,18,6)(1.0 / ConversionRate)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ConversionRate == 0 ? (DT_NUMERIC,18,6)0 : (DT_NUMERIC,18,6)(1.0 / ConversionRate)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load FX Rates\Close FX Intervals.Outputs[Derived Column Output].Columns[RateSourceCode]" dataType="wstr" length="10" lineageId="Package\DFT Load FX Rates\Close FX Intervals.Outputs[Derived Column Output].Columns[RateSourceCode]" name="RateSourceCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(RateSourceCode) ? "ECB" : RateSourceCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(RateSourceCode) ? "ECB" : RateSourceCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load FX Rates\Close FX Intervals.Outputs[Derived Column Output].Columns[CurrencyPairCode]" dataType="wstr" length="6" lineageId="Package\DFT Load FX Rates\Close FX Intervals.Outputs[Derived Column Output].Columns[CurrencyPairCode]" name="CurrencyPairCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(FromCurrencyCode)) + UPPER(TRIM(ToCurrencyCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(FromCurrencyCode)) + UPPER(TRIM(ToCurrencyCode))</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
