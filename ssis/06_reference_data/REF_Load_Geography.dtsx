          <component refId="Package\DFT Load Geography\Standardize Geography" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Standardize Geography" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Load Geography\Standardize Geography.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Load Geography\Standardize Geography.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[CountryCode]" dataType="wstr" length="3" lineageId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[CountryCode]" name="CountryCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CountryCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CountryCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[CityNameStandardized]" dataType="wstr" length="60" lineageId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[CityNameStandardized]" name="CityNameStandardized">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CityName))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CityName))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[PostalCodeStandardized]" dataType="wstr" length="16" lineageId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[PostalCodeStandardized]" name="PostalCodeStandardized">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(RegionCode)) == "NA" ? LEFT(REPLACE(TRIM(PostalCode), " ", ""), 5) : (UPPER(TRIM(RegionCode)) == "EU" ? UPPER(TRIM(CountryCode)) + "-" + REPLACE(TRIM(PostalCode), " ", "") : REPLACE(REPLACE(TRIM(PostalCode), "-", ""), " ", ""))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(RegionCode)) == "NA" ? LEFT(REPLACE(TRIM(PostalCode), " ", ""), 5) : (UPPER(TRIM(RegionCode)) == "EU" ? UPPER(TRIM(CountryCode)) + "-" + REPLACE(TRIM(PostalCode), " ", "") : REPLACE(REPLACE(TRIM(PostalCode), "-", ""), " ", ""))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[PostalPrefix]" dataType="wstr" length="3" lineageId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[PostalPrefix]" name="PostalPrefix">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">LEFT(REPLACE(TRIM(PostalCode), " ", ""), 3)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">LEFT(REPLACE(TRIM(PostalCode), " ", ""), 3)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[GeographyKeyText]" dataType="wstr" length="130" lineageId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[GeographyKeyText]" name="GeographyKeyText">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CountryCode)) + "|" + UPPER(TRIM(ISNULL(StateProvinceCode) ? "XX" : StateProvinceCode)) + "|" + UPPER(TRIM(CityName))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CountryCode)) + "|" + UPPER(TRIM(ISNULL(StateProvinceCode) ? "XX" : StateProvinceCode)) + "|" + UPPER(TRIM(CityName))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[CodeValue]" dataType="wstr" length="60" lineageId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[CodeValue]" name="CodeValue">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CountryCode)) + "|" + UPPER(TRIM(ISNULL(StateProvinceCode) ? "XX" : StateProvinceCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CountryCode)) + "|" + UPPER(TRIM(ISNULL(StateProvinceCode) ? "XX" : StateProvinceCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[CodeDescription]" dataType="wstr" length="200" lineageId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[CodeDescription]" name="CodeDescription">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TRIM(CountryName) + " / " + TRIM(ISNULL(StateProvinceName) ? "" : StateProvinceName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TRIM(CountryName) + " / " + TRIM(ISNULL(StateProvinceName) ? "" : StateProvinceName)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[ChangeHash]" dataType="wstr" length="200" lineageId="Package\DFT Load Geography\Standardize Geography.Outputs[Derived Column Output].Columns[ChangeHash]" name="ChangeHash">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM((DT_WSTR,60)CountryCode)) + "|" + UPPER(TRIM((DT_WSTR,60)StateProvinceCode)) + "|" + UPPER(TRIM((DT_WSTR,60)CityName)) + "|" + UPPER(TRIM((DT_WSTR,60)PostalCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM((DT_WSTR,60)CountryCode)) + "|" + UPPER(TRIM((DT_WSTR,60)StateProvinceCode)) + "|" + UPPER(TRIM((DT_WSTR,60)CityName)) + "|" + UPPER(TRIM((DT_WSTR,60)PostalCode))</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
