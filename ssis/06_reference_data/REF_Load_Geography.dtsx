          <component refId="Package\DFT Publish Geography Dimension\Standardize Geography" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Standardize Geography" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Publish Geography Dimension\Standardize Geography.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Publish Geography Dimension\Standardize Geography.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[CountryCode]" dataType="wstr" length="2" lineageId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[CountryCode]" name="CountryCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CountryCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CountryCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[GeographyCode]" dataType="wstr" length="20" lineageId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[GeographyCode]" name="GeographyCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CountryCode)) + "|" + UPPER(TRIM(RegionCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CountryCode)) + "|" + UPPER(TRIM(RegionCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[GeographyName]" dataType="wstr" length="100" lineageId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[GeographyName]" name="GeographyName">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TRIM(CountryName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TRIM(CountryName)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[TaxStructureCode]" dataType="wstr" length="12" lineageId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[TaxStructureCode]" name="TaxStructureCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TaxRegimeCode == "VAT" ? "EU_VAT" : (TaxRegimeCode == "GST" ? "APAC_GST" : "NA_SALESTAX")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TaxRegimeCode == "VAT" ? "EU_VAT" : (TaxRegimeCode == "GST" ? "APAC_GST" : "NA_SALESTAX")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[ReverseChargeFlag]" dataType="wstr" length="1" lineageId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[ReverseChargeFlag]" name="ReverseChargeFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TaxRegimeCode == "VAT" &amp;&amp; ReverseChargeEligible == TRUE ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TaxRegimeCode == "VAT" &amp;&amp; ReverseChargeEligible == TRUE ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[EuStatusCode]" dataType="wstr" length="12" lineageId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[EuStatusCode]" name="EuStatusCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">IsEuMemberState == TRUE ? "MEMBER" : (ISNULL(EuExitDate) ? "NONMEMBER" : "EXITED")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">IsEuMemberState == TRUE ? "MEMBER" : (ISNULL(EuExitDate) ? "NONMEMBER" : "EXITED")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[LineageKey]" dataType="wstr" length="40" lineageId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[LineageKey]" name="LineageKey">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_WSTR,40)"REF_Load_Geography"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_WSTR,40)"REF_Load_Geography"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[ChangeHash]" dataType="wstr" length="200" lineageId="Package\DFT Publish Geography Dimension\Standardize Geography.Outputs[Derived Column Output].Columns[ChangeHash]" name="ChangeHash">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM((DT_WSTR,60)CountryCode)) + "|" + UPPER(TRIM((DT_WSTR,60)CountryName)) + "|" + UPPER(TRIM((DT_WSTR,60)RegionCode)) + "|" + UPPER(TRIM((DT_WSTR,60)TaxJurisdictionCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM((DT_WSTR,60)CountryCode)) + "|" + UPPER(TRIM((DT_WSTR,60)CountryName)) + "|" + UPPER(TRIM((DT_WSTR,60)RegionCode)) + "|" + UPPER(TRIM((DT_WSTR,60)TaxJurisdictionCode))</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
