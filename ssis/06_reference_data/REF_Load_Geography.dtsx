    <DTS:Executable
      DTS:refId="Package\DFT Publish Geography Dimension"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{BE7297A5-AD84-14E3-1375-8BB9EC55D09A}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="DFT Publish Geography Dimension"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\DFT Publish Geography Dimension\REF Geography Conformed" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="REF Geography Conformed" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT c.CountryCode, c.CountryCodeIso3, c.CountryName, c.RegionCode, c.SubRegionName,
       c.LocalCurrencyCode, c.IsEuMemberState, c.EuExitDate, r.TaxRegimeCode,
       j.TaxJurisdictionCode, j.CombinedRatePercent, j.ReverseChargeEligible,
       c.PostalFormatMask
FROM ref.Country AS c
     INNER JOIN ref.Region AS r ON r.RegionCode = c.RegionCode
     OUTER APPLY (SELECT TOP (1) t.TaxJurisdictionCode, t.CombinedRatePercent,
                         t.ReverseChargeEligible
                  FROM ref.TaxJurisdiction AS t
                  WHERE t.CountryCode = c.CountryCode
                    AND t.StateProvinceCode IS NULL
                    AND (t.EffectiveToDate IS NULL
                         OR t.EffectiveToDate &gt;= CONVERT(date, GETDATE()))
                  ORDER BY t.EffectiveFromDate DESC) AS j
WHERE c.IsActive = 1;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Connections[OleDbConnection]" connectionManagerID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Staging_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[CountryCode]" dataType="wstr" length="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].ExternalColumns[CountryCode]" lineageId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[CountryCode]" name="CountryCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[CountryCodeIso3]" dataType="wstr" length="3" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].ExternalColumns[CountryCodeIso3]" lineageId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[CountryCodeIso3]" name="CountryCodeIso3" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[CountryName]" dataType="wstr" length="100" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].ExternalColumns[CountryName]" lineageId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[CountryName]" name="CountryName" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[SubRegionName]" dataType="wstr" length="100" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].ExternalColumns[SubRegionName]" lineageId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[SubRegionName]" name="SubRegionName" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[LocalCurrencyCode]" dataType="wstr" length="3" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].ExternalColumns[LocalCurrencyCode]" lineageId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[LocalCurrencyCode]" name="LocalCurrencyCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[IsEuMemberState]" dataType="bool" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].ExternalColumns[IsEuMemberState]" lineageId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[IsEuMemberState]" name="IsEuMemberState" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[EuExitDate]" dataType="dbTimeStamp" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].ExternalColumns[EuExitDate]" lineageId="Package\DFT Publish Geography Dimension\REF Geography Conformed.Outputs[OLE DB Source Output].Columns[EuExitDate]" name="EuExitDate" truncationRowDisposition="RedirectRow" />
