    <DTS:Executable
      DTS:refId="Package\Version Reference Set - SALES_CHANNEL"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D3293985-96F7-EAB3-AEC6-7AC90233638E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Version Reference Set - SALES_CHANNEL"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DECLARE @Now DATETIME2(3) = SYSUTCDATETIME();&#10;BEGIN TRANSACTION;&#10;UPDATE ref.SalesChannel&#10;SET ValidTo = @Now, IsCurrent = 0&#10;WHERE IsCurrent = 1&#10;  AND EXISTS (SELECT 1 FROM ref.SalesChannel_Incoming AS i&#10;              WHERE i.BatchId = ? AND i.CodeValue = ref.SalesChannel.CodeValue&#10;                AND i.ChangeHash &lt;&gt; ref.SalesChannel.ChangeHash);&#10;INSERT INTO ref.SalesChannel (CodeValue, CodeDescription, RegionCode, ChangeHash, ValidFrom, ValidTo, IsCurrent, VersionNumber, CodeSetName)&#10;SELECT i.CodeValue, i.CodeDescription, i.RegionCode, i.ChangeHash, @Now, CONVERT(DATETIME2(3), N'9999-12-31'), 1,&#10;       ISNULL((SELECT MAX(p.VersionNumber) FROM ref.SalesChannel AS p WHERE p.CodeValue = i.CodeValue), 0) + 1,&#10;       N'SALES_CHANNEL'&#10;FROM ref.SalesChannel_Incoming AS i&#10;WHERE i.BatchId = ?&#10;  AND NOT EXISTS (SELECT 1 FROM ref.SalesChannel AS c&#10;                  WHERE c.CodeValue = i.CodeValue AND c.IsCurrent = 1&#10;                    AND c.ChangeHash = i.ChangeHash);&#10;COMMIT TRANSACTION;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
