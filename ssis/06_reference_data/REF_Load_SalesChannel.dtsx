                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ChannelCode)) == "PARTNER" ? "PARTNER" : "DIGITAL"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ChannelCode)) == "PARTNER" ? "PARTNER" : "DIGITAL"</property>
