            </outputs>
          </component>
          <component refId="Package\DFT Publish Sales Channel Dimension\Conform Sales Channel" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Conform Sales Channel" usesDispositions="true">
            <inputs>
              <input refId="Package\DFT Publish Sales Channel Dimension\Conform Sales Channel.Inputs[Derived Column Input]" name="Derived Column Input">
                <inputColumns>
                  <inputColumn refId="Package\DFT Publish Sales Channel Dimension\Conform Sales Channel.Inputs[Derived Column Input].Columns[ChannelCode]" cachedName="ChannelCode" lineageId="Package\DFT Publish Sales Channel Dimension\REF SalesChannel Conformed.Outputs[OLE DB Source Output].Columns[ChannelCode]" name="ChannelCode" usageType="readWrite">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ChannelCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ChannelCode))</property>
                    </properties>
                  </inputColumn>
                  <inputColumn refId="Package\DFT Publish Sales Channel Dimension\Conform Sales Channel.Inputs[Derived Column Input].Columns[ChannelName]" cachedName="ChannelName" lineageId="Package\DFT Publish Sales Channel Dimension\REF SalesChannel Conformed.Outputs[OLE DB Source Output].Columns[ChannelName]" name="ChannelName" usageType="readWrite">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(ChannelName) ? UPPER(TRIM(ChannelCode)) + " channel" : TRIM(ChannelName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(ChannelName) ? UPPER(TRIM(ChannelCode)) + " channel" : TRIM(ChannelName)</property>
                    </properties>
                  </inputColumn>
                </inputColumns>
              </input>
            </inputs>
            <outputs>
              <output refId="Package\DFT Publish Sales Channel Dimension\Conform Sales Channel.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Publish Sales Channel Dimension\Conform Sales Channel.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Publish Sales Channel Dimension\Conform Sales Channel.Outputs[Derived Column Output].Columns[ChannelGroupCode]" dataType="wstr" length="10" lineageId="Package\DFT Publish Sales Channel Dimension\Conform Sales Channel.Outputs[Derived Column Output].Columns[ChannelGroupCode]" name="ChannelGroupCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ChannelCode)) == "ONLINE" ? "DIGITAL" : (UPPER(TRIM(ChannelCode)) == "PARTNER" ? "PARTNER" : "DIRECT")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ChannelCode)) == "ONLINE" ? "DIGITAL" : (UPPER(TRIM(ChannelCode)) == "PARTNER" ? "PARTNER" : "DIRECT")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Sales Channel Dimension\Conform Sales Channel.Outputs[Derived Column Output].Columns[DigitalFlag]" dataType="wstr" length="1" lineageId="Package\DFT Publish Sales Channel Dimension\Conform Sales Channel.Outputs[Derived Column Output].Columns[DigitalFlag]" name="DigitalFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ChannelCode)) == "ONLINE" ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ChannelCode)) == "ONLINE" ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
