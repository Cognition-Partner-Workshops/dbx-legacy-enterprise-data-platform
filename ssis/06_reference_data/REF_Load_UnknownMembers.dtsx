      <pipeline version="1">
        <components>
          <component refId="Package\DFT Publish Unknown Members\REF Unknown Members" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="REF Unknown Members" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT N'ref.StatusCode' AS ReferenceTableName, s.ConformedStatusCode AS UnknownCodeValue,
       s.ConformedStatusName AS UnknownDescription, s.StatusDomainCode AS DomainCode
FROM ref.StatusCode AS s
WHERE s.ConformedStatusCode = N'UNKNOWN'
UNION ALL
SELECT N'ref.ReasonCode', r.ConformedReasonCode, r.ConformedReasonName, r.ReasonDomainCode
FROM ref.ReasonCode AS r
WHERE r.ConformedReasonCode = N'UNKNOWN';</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
