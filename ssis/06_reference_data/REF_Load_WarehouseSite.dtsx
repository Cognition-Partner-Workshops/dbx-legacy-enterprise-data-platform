          <component refId="Package\DFT Publish Warehouse Site Dimension\Standardize Site" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Standardize Site" usesDispositions="true">
            <inputs>
              <input refId="Package\DFT Publish Warehouse Site Dimension\Standardize Site.Inputs[Derived Column Input]" name="Derived Column Input">
                <inputColumns>
                  <inputColumn refId="Package\DFT Publish Warehouse Site Dimension\Standardize Site.Inputs[Derived Column Input].Columns[WarehouseSiteCode]" cachedName="WarehouseSiteCode" lineageId="Package\DFT Publish Warehouse Site Dimension\REF Warehouse Site Conformed.Outputs[OLE DB Source Output].Columns[WarehouseSiteCode]" name="WarehouseSiteCode" usageType="readWrite">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(WarehouseSiteCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(WarehouseSiteCode))</property>
                    </properties>
                  </inputColumn>
                </inputColumns>
              </input>
            </inputs>
            <outputs>
              <output refId="Package\DFT Publish Warehouse Site Dimension\Standardize Site.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Publish Warehouse Site Dimension\Standardize Site.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Publish Warehouse Site Dimension\Standardize Site.Outputs[Derived Column Output].Columns[PostalCodeStandardized]" dataType="wstr" length="20" lineageId="Package\DFT Publish Warehouse Site Dimension\Standardize Site.Outputs[Derived Column Output].Columns[PostalCodeStandardized]" name="PostalCodeStandardized">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TruncateToLength &gt; 0 ? LEFT(REPLACE(REPLACE(UPPER(TRIM(ISNULL(PostalCode) ? "" : PostalCode)), " ", ""), "-", ""), TruncateToLength) : REPLACE(REPLACE(UPPER(TRIM(ISNULL(PostalCode) ? "" : PostalCode)), " ", ""), "-", "")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TruncateToLength &gt; 0 ? LEFT(REPLACE(REPLACE(UPPER(TRIM(ISNULL(PostalCode) ? "" : PostalCode)), " ", ""), "-", ""), TruncateToLength) : REPLACE(REPLACE(UPPER(TRIM(ISNULL(PostalCode) ? "" : PostalCode)), " ", ""), "-", "")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Warehouse Site Dimension\Standardize Site.Outputs[Derived Column Output].Columns[SiteTypeCode]" dataType="wstr" length="10" lineageId="Package\DFT Publish Warehouse Site Dimension\Standardize Site.Outputs[Derived Column Output].Columns[SiteTypeCode]" name="SiteTypeCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">MovementCount &gt; 100000 ? "DC" : (MovementCount &gt; 10000 ? "REGIONAL" : "SATELLITE")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">MovementCount &gt; 100000 ? "DC" : (MovementCount &gt; 10000 ? "REGIONAL" : "SATELLITE")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Warehouse Site Dimension\Standardize Site.Outputs[Derived Column Output].Columns[LineageKey]" dataType="wstr" length="40" lineageId="Package\DFT Publish Warehouse Site Dimension\Standardize Site.Outputs[Derived Column Output].Columns[LineageKey]" name="LineageKey">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_WSTR,40)"REF_Load_WarehouseSite"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_WSTR,40)"REF_Load_WarehouseSite"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Warehouse Site Dimension\Standardize Site.Outputs[Derived Column Output].Columns[ChangeHash]" dataType="wstr" length="200" lineageId="Package\DFT Publish Warehouse Site Dimension\Standardize Site.Outputs[Derived Column Output].Columns[ChangeHash]" name="ChangeHash">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM((DT_WSTR,60)WarehouseSiteCode)) + "|" + UPPER(TRIM((DT_WSTR,60)WarehouseSiteName)) + "|" + UPPER(TRIM((DT_WSTR,60)CountryCode)) + "|" + UPPER(TRIM((DT_WSTR,60)PostalCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM((DT_WSTR,60)WarehouseSiteCode)) + "|" + UPPER(TRIM((DT_WSTR,60)WarehouseSiteName)) + "|" + UPPER(TRIM((DT_WSTR,60)CountryCode)) + "|" + UPPER(TRIM((DT_WSTR,60)PostalCode))</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
