    <DTS:Executable
      DTS:refId="Package\DFT Publish Warehouse Site Dimension"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{140B6475-FF64-B3CB-8D1D-5E061AB0191C}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="DFT Publish Warehouse Site Dimension"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\DFT Publish Warehouse Site Dimension\REF Warehouse Site Conformed" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="REF Warehouse Site Conformed" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT m.WarehouseSiteId, MAX(m.WarehouseSiteCode) AS WarehouseSiteCode,
       MAX(m.WarehouseSiteName) AS WarehouseSiteName, c.CountryCode, c.RegionCode,
       MAX(m.PostalCode) AS PostalCode, MAX(p.FormatMask) AS FormatMask,
       MAX(p.StripCharacters) AS StripCharacters,
       MAX(CONVERT(TINYINT, p.UpperCaseFlag)) AS UpperCaseFlag,
       MAX(CONVERT(INT, p.TruncateToLength)) AS TruncateToLength,
       COUNT_BIG(*) AS MovementCount
FROM stg.StockMovement AS m
     INNER JOIN ref.Country AS c ON c.CountryCode = LEFT(UPPER(m.CountryCode), 2)
     LEFT OUTER JOIN ref.PostalFormatRule AS p
       ON p.CountryCode = c.CountryCode AND p.RulePriority = 1
GROUP BY m.WarehouseSiteId, c.CountryCode, c.RegionCode;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
