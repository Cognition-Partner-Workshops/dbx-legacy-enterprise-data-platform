          <component refId="Package\DFT Load Warehouse Site\Standardize Site" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Standardize Site" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Load Warehouse Site\Standardize Site.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Load Warehouse Site\Standardize Site.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[WarehouseSiteCode]" dataType="wstr" length="10" lineageId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[WarehouseSiteCode]" name="WarehouseSiteCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(WarehouseSiteCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(WarehouseSiteCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[CountryCode]" dataType="wstr" length="3" lineageId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[CountryCode]" name="CountryCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(CountryCode) ? "USA" : CountryCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(CountryCode) ? "USA" : CountryCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[PostalCodeStandardized]" dataType="wstr" length="16" lineageId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[PostalCodeStandardized]" name="PostalCodeStandardized">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode)) == "NA" ? LEFT(REPLACE(TRIM(ISNULL(PostalCode) ? "00000" : PostalCode), " ", ""), 5) : (UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode)) == "EU" ? UPPER(TRIM(CountryCode)) + "-" + REPLACE(TRIM(ISNULL(PostalCode) ? "0000" : PostalCode), " ", "") : REPLACE(REPLACE(TRIM(ISNULL(PostalCode) ? "0000" : PostalCode), "-", ""), " ", ""))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode)) == "NA" ? LEFT(REPLACE(TRIM(ISNULL(PostalCode) ? "00000" : PostalCode), " ", ""), 5) : (UPPER(TRIM(ISNULL(RegionCode) ? "NA" : RegionCode)) == "EU" ? UPPER(TRIM(CountryCode)) + "-" + REPLACE(TRIM(ISNULL(PostalCode) ? "0000" : PostalCode), " ", "") : REPLACE(REPLACE(TRIM(ISNULL(PostalCode) ? "0000" : PostalCode), "-", ""), " ", ""))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[SiteTypeCode]" dataType="wstr" length="10" lineageId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[SiteTypeCode]" name="SiteTypeCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">MovementCount &gt; 100000 ? "DC" : (MovementCount &gt; 10000 ? "REGIONAL" : "SATELLITE")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">MovementCount &gt; 100000 ? "DC" : (MovementCount &gt; 10000 ? "REGIONAL" : "SATELLITE")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[CodeValue]" dataType="wstr" length="60" lineageId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[CodeValue]" name="CodeValue">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(WarehouseSiteCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(WarehouseSiteCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[CodeDescription]" dataType="wstr" length="200" lineageId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[CodeDescription]" name="CodeDescription">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TRIM(WarehouseSiteName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TRIM(WarehouseSiteName)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[ChangeHash]" dataType="wstr" length="200" lineageId="Package\DFT Load Warehouse Site\Standardize Site.Outputs[Derived Column Output].Columns[ChangeHash]" name="ChangeHash">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM((DT_WSTR,60)WarehouseSiteCode)) + "|" + UPPER(TRIM((DT_WSTR,60)WarehouseSiteName)) + "|" + UPPER(TRIM((DT_WSTR,60)CountryCode)) + "|" + UPPER(TRIM((DT_WSTR,60)PostalCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM((DT_WSTR,60)WarehouseSiteCode)) + "|" + UPPER(TRIM((DT_WSTR,60)WarehouseSiteName)) + "|" + UPPER(TRIM((DT_WSTR,60)CountryCode)) + "|" + UPPER(TRIM((DT_WSTR,60)PostalCode))</property>
                    </properties>
