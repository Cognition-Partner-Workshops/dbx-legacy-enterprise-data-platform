    <DTS:Executable
      DTS:refId="Package\Version Reference Set - TRANSACTION_TYPE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2A6A66B8-B77F-72DD-30D1-8A67340F48EB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Version Reference Set - TRANSACTION_TYPE"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DECLARE @Now DATETIME2(3) = SYSUTCDATETIME();&#10;BEGIN TRANSACTION;&#10;UPDATE ref.TransactionType&#10;SET ValidTo = @Now, IsCurrent = 0&#10;WHERE IsCurrent = 1&#10;  AND EXISTS (SELECT 1 FROM ref.TransactionType_Incoming AS i&#10;              WHERE i.BatchId = ? AND i.CodeValue = ref.TransactionType.CodeValue&#10;                AND i.ChangeHash &lt;&gt; ref.TransactionType.ChangeHash);&#10;INSERT INTO ref.TransactionType (CodeValue, CodeDescription, RegionCode, ChangeHash, ValidFrom, ValidTo, IsCurrent, VersionNumber, CodeSetName)&#10;SELECT i.CodeValue, i.CodeDescription, i.RegionCode, i.ChangeHash, @Now, CONVERT(DATETIME2(3), N'9999-12-31'), 1,&#10;       ISNULL((SELECT MAX(p.VersionNumber) FROM ref.TransactionType AS p WHERE p.CodeValue = i.CodeValue), 0) + 1,&#10;       N'TRANSACTION_TYPE'&#10;FROM ref.TransactionType_Incoming AS i&#10;WHERE i.BatchId = ?&#10;  AND NOT EXISTS (SELECT 1 FROM ref.TransactionType AS c&#10;                  WHERE c.CodeValue = i.CodeValue AND c.IsCurrent = 1&#10;                    AND c.ChangeHash = i.ChangeHash);&#10;COMMIT TRANSACTION;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Report Unmapped Codes - TRANSACTION_TYPE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7C6A2DFD-9F80-08EC-0961-360E00B35136}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Report Unmapped Codes - TRANSACTION_TYPE"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO err.UnmappedCode (BatchId, CodeSetName, SourceSystemCode, SourceCode, OccurrenceCount, FirstSeenAtUtc)&#10;SELECT ?, N'TRANSACTION_TYPE', s.SourceSystemCode, s.SourceCode, COUNT_BIG(*), SYSUTCDATETIME()&#10;FROM stg.StockMovement AS s&#10;WHERE NOT EXISTS (SELECT 1 FROM ref.CodeCrosswalk AS x&#10;                  WHERE x.CodeSetName = N'TRANSACTION_TYPE' AND x.SourceCode = s.SourceCode&#10;                    AND x.SourceSystemCode = s.SourceSystemCode)&#10;GROUP BY s.SourceSystemCode, s.SourceCode;&#10;SELECT @@ROWCOUNT AS UnmappedCodeCount;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::UnmappedCodeCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Log Unmapped Codes - TRANSACTION_TYPE"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{57993C15-D8CC-BBE6-9228-A991070CF5CC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Unmapped Codes - TRANSACTION_TYPE"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DECLARE @Code NVARCHAR(60), @System NVARCHAR(20);&#10;DECLARE unmapped_cur CURSOR LOCAL FAST_FORWARD FOR&#10;    SELECT u.SourceCode, u.SourceSystemCode FROM err.UnmappedCode AS u&#10;    WHERE u.BatchId = ? AND u.CodeSetName = N'TRANSACTION_TYPE' AND u.LoggedToControl = 0;&#10;OPEN unmapped_cur;&#10;FETCH NEXT FROM unmapped_cur INTO @Code, @System;&#10;WHILE @@FETCH_STATUS = 0&#10;BEGIN&#10;    EXEC etl.usp_LogRejectedRecord @PackageExecutionId = ?, @BatchId = ?, @SourceSystemCode = @System, @ObjectName = N'ref.CodeCrosswalk', @BusinessKey = @Code, @RejectReasonCode = N'REF_UNMAPPED_CODE', @RejectStage = N'Reference';&#10;    UPDATE err.UnmappedCode SET LoggedToControl = 1&#10;    WHERE BatchId = ? AND CodeSetName = N'TRANSACTION_TYPE' AND SourceCode = @Code;&#10;    FETCH NEXT FROM unmapped_cur INTO @Code, @System;&#10;END&#10;CLOSE unmapped_cur;&#10;DEALLOCATE unmapped_cur;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="3" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
