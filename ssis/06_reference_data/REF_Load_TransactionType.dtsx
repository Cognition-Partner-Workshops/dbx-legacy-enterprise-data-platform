                  <outputColumn refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Error Output].Columns[AffectsLedger]" dataType="bool" lineageId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Error Output].Columns[AffectsLedger]" name="AffectsLedger" />
                  <outputColumn refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Error Output].Columns[UsageCount]" dataType="i4" lineageId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Error Output].Columns[UsageCount]" name="UsageCount" />
