                  <outputColumn refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Error Output].Columns[MovementDirectionCode]" dataType="wstr" length="3" lineageId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Error Output].Columns[MovementDirectionCode]" name="MovementDirectionCode" />
