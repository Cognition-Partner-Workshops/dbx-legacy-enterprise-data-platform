            </outputs>
          </component>
          <component refId="Package\DFT Load Transaction Type\Conform Transaction Type" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Conform Transaction Type" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Load Transaction Type\Conform Transaction Type.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Load Transaction Type\Conform Transaction Type.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Load Transaction Type\Conform Transaction Type.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Load Transaction Type\Conform Transaction Type.Outputs[Derived Column Output].Columns[TransactionTypeCode]" dataType="wstr" length="12" lineageId="Package\DFT Load Transaction Type\Conform Transaction Type.Outputs[Derived Column Output].Columns[TransactionTypeCode]" name="TransactionTypeCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(TransactionTypeCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(TransactionTypeCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Transaction Type\Conform Transaction Type.Outputs[Derived Column Output].Columns[MovementSign]" dataType="i4" lineageId="Package\DFT Load Transaction Type\Conform Transaction Type.Outputs[Derived Column Output].Columns[MovementSign]" name="MovementSign">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">MovementDirectionCode == "OUT" ? -1 : 1</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">MovementDirectionCode == "OUT" ? -1 : 1</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Transaction Type\Conform Transaction Type.Outputs[Derived Column Output].Columns[ReversalAllowedFlag]" dataType="wstr" length="1" lineageId="Package\DFT Load Transaction Type\Conform Transaction Type.Outputs[Derived Column Output].Columns[ReversalAllowedFlag]" name="ReversalAllowedFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(TransactionTypeCode)) == "ADJ" || UPPER(TRIM(TransactionTypeCode)) == "RET" ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(TransactionTypeCode)) == "ADJ" || UPPER(TRIM(TransactionTypeCode)) == "RET" ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Transaction Type\Conform Transaction Type.Outputs[Derived Column Output].Columns[CodeValue]" dataType="wstr" length="60" lineageId="Package\DFT Load Transaction Type\Conform Transaction Type.Outputs[Derived Column Output].Columns[CodeValue]" name="CodeValue">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(TransactionTypeCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(TransactionTypeCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Transaction Type\Conform Transaction Type.Outputs[Derived Column Output].Columns[CodeDescription]" dataType="wstr" length="200" lineageId="Package\DFT Load Transaction Type\Conform Transaction Type.Outputs[Derived Column Output].Columns[CodeDescription]" name="CodeDescription">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TRIM(TransactionTypeName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TRIM(TransactionTypeName)</property>
                    </properties>
                  </outputColumn>
