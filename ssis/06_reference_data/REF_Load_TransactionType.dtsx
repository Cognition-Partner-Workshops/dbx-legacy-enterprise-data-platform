    <DTS:Executable
      DTS:refId="Package\DFT Load Transaction Type"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{132D1B8D-84C1-47D8-08CB-1EA8B64AC1CF}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="DFT Load Transaction Type"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\DFT Load Transaction Type\STG Transaction Type Usage" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="STG Transaction Type Usage" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT m.TransactionTypeCode,
       ISNULL(x.TargetDescription, m.TransactionTypeCode) AS TransactionTypeName,
       CASE WHEN SUM(m.SignedQuantity) &gt;= 0 THEN N'IN' ELSE N'OUT' END AS MovementDirectionCode,
       CAST(1 AS bit) AS AffectsInventory,
       CAST(CASE WHEN m.TransactionTypeCode IN (N'SALE', N'PURCH') THEN 1 ELSE 0 END AS bit)
           AS AffectsLedger,
       COUNT_BIG(*) AS UsageCount
FROM stg.StockMovement AS m
     LEFT OUTER JOIN ref.CodeCrosswalk AS x
       ON x.CodeSetName = N'TRANSACTION_TYPE' AND x.SourceCode = m.TransactionTypeCode
GROUP BY m.TransactionTypeCode, x.TargetDescription;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Connections[OleDbConnection]" connectionManagerID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Staging_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].Columns[TransactionTypeCode]" dataType="wstr" length="12" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].ExternalColumns[TransactionTypeCode]" lineageId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].Columns[TransactionTypeCode]" name="TransactionTypeCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].Columns[TransactionTypeName]" dataType="wstr" length="60" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].ExternalColumns[TransactionTypeName]" lineageId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].Columns[TransactionTypeName]" name="TransactionTypeName" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].Columns[MovementDirectionCode]" dataType="wstr" length="3" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].ExternalColumns[MovementDirectionCode]" lineageId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].Columns[MovementDirectionCode]" name="MovementDirectionCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].Columns[AffectsInventory]" dataType="bool" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].ExternalColumns[AffectsInventory]" lineageId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].Columns[AffectsInventory]" name="AffectsInventory" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].Columns[AffectsLedger]" dataType="bool" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].ExternalColumns[AffectsLedger]" lineageId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].Columns[AffectsLedger]" name="AffectsLedger" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].Columns[UsageCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].ExternalColumns[UsageCount]" lineageId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].Columns[UsageCount]" name="UsageCount" truncationRowDisposition="RedirectRow" />
                </outputColumns>
