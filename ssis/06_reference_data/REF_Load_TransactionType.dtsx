                  <externalMetadataColumn refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].ExternalColumns[TransactionTypeName]" dataType="wstr" length="60" name="TransactionTypeName" />
                  <externalMetadataColumn refId="Package\DFT Load Transaction Type\STG Transaction Type Usage.Outputs[OLE DB Source Output].ExternalColumns[MovementDirectionCode]" dataType="wstr" length="3" name="MovementDirectionCode" />
