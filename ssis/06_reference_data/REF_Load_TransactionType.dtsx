                  <externalMetadataColumn refId="Package\DFT Publish Transaction Type Dimension\REF TransactionType Conformed.Outputs[OLE DB Source Output].ExternalColumns[SourceCodeCount]" dataType="i8" name="SourceCodeCount" />
