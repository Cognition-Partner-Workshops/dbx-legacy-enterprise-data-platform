                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(TransactionTypeCode)) == "PURCH" || UPPER(TRIM(TransactionTypeCode)) == "RET" ? 1 : -1</property>
