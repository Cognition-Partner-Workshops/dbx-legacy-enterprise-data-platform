                  <outputColumn refId="Package\DFT Publish Transaction Type Dimension\REF TransactionType Conformed.Outputs[OLE DB Source Output].Columns[TransactionTypeName]" dataType="wstr" length="60" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Transaction Type Dimension\REF TransactionType Conformed.Outputs[OLE DB Source Output].ExternalColumns[TransactionTypeName]" lineageId="Package\DFT Publish Transaction Type Dimension\REF TransactionType Conformed.Outputs[OLE DB Source Output].Columns[TransactionTypeName]" name="TransactionTypeName" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Publish Transaction Type Dimension\REF TransactionType Conformed.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Transaction Type Dimension\REF TransactionType Conformed.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\DFT Publish Transaction Type Dimension\REF TransactionType Conformed.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
