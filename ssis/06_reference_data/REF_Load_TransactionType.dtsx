        <components>
          <component refId="Package\DFT Publish Unit Of Measure\REF UnitOfMeasure Conformed" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="REF UnitOfMeasure Conformed" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT u.UomCode, u.UomName, u.UomClassCode, u.BaseUomCode, u.DecimalPrecision,
       ISNULL(c.ConversionFactor, CONVERT(DECIMAL(18,8), 1)) AS ConversionFactor
FROM ref.UnitOfMeasure AS u
     LEFT OUTER JOIN ref.UomConversion AS c
       ON c.FromUomCode = u.UomCode AND c.ToUomCode = u.BaseUomCode
      AND c.StockItemBusinessKey = N'*'
WHERE u.IsActive = 1;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
