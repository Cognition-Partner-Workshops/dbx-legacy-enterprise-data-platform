                  <outputColumn refId="Package\DFT Publish Transaction Type Dimension\REF TransactionType Conformed.Outputs[OLE DB Source Output].Columns[SourceCodeCount]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Publish Transaction Type Dimension\REF TransactionType Conformed.Outputs[OLE DB Source Output].ExternalColumns[SourceCodeCount]" lineageId="Package\DFT Publish Transaction Type Dimension\REF TransactionType Conformed.Outputs[OLE DB Source Output].Columns[SourceCodeCount]" name="SourceCodeCount" truncationRowDisposition="RedirectRow" />
