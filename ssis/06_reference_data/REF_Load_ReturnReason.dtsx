            </outputs>
          </component>
          <component refId="Package\DFT Load Return Reason\Classify Return Reason" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Classify Return Reason" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Load Return Reason\Classify Return Reason.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Load Return Reason\Classify Return Reason.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[ReturnReasonCode]" dataType="wstr" length="12" lineageId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[ReturnReasonCode]" name="ReturnReasonCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ReturnReasonCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ReturnReasonCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[ReasonCategoryCode]" dataType="wstr" length="10" lineageId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[ReasonCategoryCode]" name="ReasonCategoryCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ReturnReasonCode)) == "DAMAGED" || UPPER(TRIM(ReturnReasonCode)) == "FAULTY" ? "QUALITY" : (UPPER(TRIM(ReturnReasonCode)) == "LATE" ? "SERVICE" : (UPPER(TRIM(ReturnReasonCode)) == "CHANGEDMIND" ? "CUSTOMER" : "OTHER"))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ReturnReasonCode)) == "DAMAGED" || UPPER(TRIM(ReturnReasonCode)) == "FAULTY" ? "QUALITY" : (UPPER(TRIM(ReturnReasonCode)) == "LATE" ? "SERVICE" : (UPPER(TRIM(ReturnReasonCode)) == "CHANGEDMIND" ? "CUSTOMER" : "OTHER"))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[SupplierRecoverableFlag]" dataType="wstr" length="1" lineageId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[SupplierRecoverableFlag]" name="SupplierRecoverableFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ReturnReasonCode)) == "DAMAGED" || UPPER(TRIM(ReturnReasonCode)) == "FAULTY" ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ReturnReasonCode)) == "DAMAGED" || UPPER(TRIM(ReturnReasonCode)) == "FAULTY" ? "Y" : "N"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[RestockingFeePercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[RestockingFeePercent]" name="RestockingFeePercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "EU" ? (DT_NUMERIC,9,4)0 : (UPPER(TRIM(ReturnReasonCode)) == "CHANGEDMIND" ? (DT_NUMERIC,9,4)15 : (DT_NUMERIC,9,4)0)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "EU" ? (DT_NUMERIC,9,4)0 : (UPPER(TRIM(ReturnReasonCode)) == "CHANGEDMIND" ? (DT_NUMERIC,9,4)15 : (DT_NUMERIC,9,4)0)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[CodeValue]" dataType="wstr" length="60" lineageId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[CodeValue]" name="CodeValue">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ReturnReasonCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ReturnReasonCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[CodeDescription]" dataType="wstr" length="200" lineageId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[CodeDescription]" name="CodeDescription">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TRIM(ReturnReasonDescription)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TRIM(ReturnReasonDescription)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[ChangeHash]" dataType="wstr" length="200" lineageId="Package\DFT Load Return Reason\Classify Return Reason.Outputs[Derived Column Output].Columns[ChangeHash]" name="ChangeHash">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM((DT_WSTR,60)ReturnReasonCode)) + "|" + UPPER(TRIM((DT_WSTR,60)ReturnReasonDescription)) + "|" + UPPER(TRIM((DT_WSTR,60)RegionCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM((DT_WSTR,60)ReturnReasonCode)) + "|" + UPPER(TRIM((DT_WSTR,60)ReturnReasonDescription)) + "|" + UPPER(TRIM((DT_WSTR,60)RegionCode))</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
