          <component refId="Package\DFT Load Return Reason\Count Return Reasons Read" componentClassID="Microsoft.RowCount" description="Row Count" name="Count Return Reasons Read" version="1">
            <properties>
              <property dataType="System.String" description="The variable that receives the row count." name="VariableName">User::RowsRead</property>
            </properties>
