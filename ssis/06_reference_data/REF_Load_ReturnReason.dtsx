      DTS:ObjectName="DFT Publish Return Reason Dimension"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\DFT Publish Return Reason Dimension\REF ReturnReason Conformed" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="REF ReturnReason Conformed" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT r.ConformedReasonCode AS ReturnReasonCode, r.ConformedReasonName AS ReturnReasonName,
       r.ReasonGroupCode, r.IsCustomerFault, r.IsSupplierFault, r.RequiresApproval,
       (SELECT COUNT_BIG(*) FROM ref.CodeCrosswalk AS x
        WHERE x.CodeDomainCode = N'RETURN'
          AND x.ConformedCodeValue = r.ConformedReasonCode
          AND x.EffectiveToDate IS NULL) AS SourceCodeCount
FROM ref.ReasonCode AS r
WHERE r.ReasonDomainCode = N'RETURN' AND r.IsActive = 1;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
