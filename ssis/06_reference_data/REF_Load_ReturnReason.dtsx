                  <outputColumn refId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Error Output].Columns[ReturnReasonDescription]" dataType="wstr" length="80" lineageId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Error Output].Columns[ReturnReasonDescription]" name="ReturnReasonDescription" />
                  <outputColumn refId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Error Output].Columns[RegionCode]" dataType="wstr" length="4" lineageId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Error Output].Columns[RegionCode]" name="RegionCode" />
                  <outputColumn refId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Error Output].Columns[OccurrenceCount]" dataType="i4" lineageId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Error Output].Columns[OccurrenceCount]" name="OccurrenceCount" />
