                  <outputColumn refId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Output].Columns[ReturnReasonDescription]" dataType="wstr" length="80" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Output].ExternalColumns[ReturnReasonDescription]" lineageId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Output].Columns[ReturnReasonDescription]" name="ReturnReasonDescription" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Output].Columns[OccurrenceCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Output].ExternalColumns[OccurrenceCount]" lineageId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Output].Columns[OccurrenceCount]" name="OccurrenceCount" truncationRowDisposition="RedirectRow" />
