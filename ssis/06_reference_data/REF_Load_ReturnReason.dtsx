                  <outputColumn refId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Error Output].Columns[ErrorColumn]" dataType="i4" lineageId="Package\DFT Load Return Reason\STG Return Reason Usage.Outputs[OLE DB Source Error Output].Columns[ErrorColumn]" name="ErrorColumn" specialFlags="1" />
