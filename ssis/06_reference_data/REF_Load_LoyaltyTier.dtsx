                  <outputColumn refId="Package\DFT Publish Loyalty Tier Dimension\Conform Loyalty Tier.Outputs[Derived Column Output].Columns[LineageKey]" dataType="wstr" length="40" lineageId="Package\DFT Publish Loyalty Tier Dimension\Conform Loyalty Tier.Outputs[Derived Column Output].Columns[LineageKey]" name="LineageKey">
