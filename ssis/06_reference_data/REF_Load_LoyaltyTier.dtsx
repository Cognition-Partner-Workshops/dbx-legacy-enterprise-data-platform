                  <outputColumn refId="Package\DFT Load Loyalty Tier\STG Loyalty Tier Distribution.Outputs[OLE DB Source Output].Columns[ProgramCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Loyalty Tier\STG Loyalty Tier Distribution.Outputs[OLE DB Source Output].ExternalColumns[ProgramCode]" lineageId="Package\DFT Load Loyalty Tier\STG Loyalty Tier Distribution.Outputs[OLE DB Source Output].Columns[ProgramCode]" name="ProgramCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\DFT Load Loyalty Tier\STG Loyalty Tier Distribution.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Loyalty Tier\STG Loyalty Tier Distribution.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\DFT Load Loyalty Tier\STG Loyalty Tier Distribution.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
