      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="DFT Publish Loyalty Tier Dimension"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\DFT Publish Loyalty Tier Dimension\REF LoyaltyTier Conformed" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="REF LoyaltyTier Conformed" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT x.ConformedCodeValue AS LoyaltyTierCode,
       MAX(CASE WHEN x.IsDefaultForConformed = 1 THEN x.SourceCodeDescription END) AS TierName,
       ISNULL(x.RegionCode, N'ALL') AS RegionCode,
       MIN(x.EffectiveFromDate) AS EffectiveFromDate,
       COUNT_BIG(*) AS SourceCodeCount
FROM ref.CodeCrosswalk AS x
WHERE x.CodeDomainCode = N'LOYALTY_TIER'
  AND x.EffectiveToDate IS NULL
GROUP BY x.ConformedCodeValue, ISNULL(x.RegionCode, N'ALL');</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
