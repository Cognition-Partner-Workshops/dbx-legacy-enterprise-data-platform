                  <outputColumn refId="Package\DFT Load Loyalty Tier\STG Loyalty Tier Distribution.Outputs[OLE DB Source Output].Columns[TotalPoints]" dataType="i8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\DFT Load Loyalty Tier\STG Loyalty Tier Distribution.Outputs[OLE DB Source Output].ExternalColumns[TotalPoints]" lineageId="Package\DFT Load Loyalty Tier\STG Loyalty Tier Distribution.Outputs[OLE DB Source Output].Columns[TotalPoints]" name="TotalPoints" truncationRowDisposition="RedirectRow" />
