                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM((DT_WSTR,60)LoyaltyTierCode)) + "|" + UPPER(TRIM((DT_WSTR,60)TierName)) + "|" + UPPER(TRIM((DT_WSTR,60)RegionCode))</property>
