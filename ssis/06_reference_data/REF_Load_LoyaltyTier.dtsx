                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(LoyaltyTierCode)) == "TIER4" ? 1 : (UPPER(TRIM(LoyaltyTierCode)) == "TIER3" ? 2 : (UPPER(TRIM(LoyaltyTierCode)) == "TIER2" ? 3 : 4))</property>
