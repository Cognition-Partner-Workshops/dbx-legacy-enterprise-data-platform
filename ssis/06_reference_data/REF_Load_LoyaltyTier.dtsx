          <component refId="Package\DFT Publish Loyalty Tier Dimension\Conform Loyalty Tier" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Conform Loyalty Tier" usesDispositions="true">
            <inputs>
              <input refId="Package\DFT Publish Loyalty Tier Dimension\Conform Loyalty Tier.Inputs[Derived Column Input]" name="Derived Column Input">
                <inputColumns>
                  <inputColumn refId="Package\DFT Publish Loyalty Tier Dimension\Conform Loyalty Tier.Inputs[Derived Column Input].Columns[LoyaltyTierCode]" cachedName="LoyaltyTierCode" lineageId="Package\DFT Publish Loyalty Tier Dimension\REF LoyaltyTier Conformed.Outputs[OLE DB Source Output].Columns[LoyaltyTierCode]" name="LoyaltyTierCode" usageType="readWrite">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(LoyaltyTierCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(LoyaltyTierCode))</property>
                    </properties>
                  </inputColumn>
                  <inputColumn refId="Package\DFT Publish Loyalty Tier Dimension\Conform Loyalty Tier.Inputs[Derived Column Input].Columns[TierName]" cachedName="TierName" lineageId="Package\DFT Publish Loyalty Tier Dimension\REF LoyaltyTier Conformed.Outputs[OLE DB Source Output].Columns[TierName]" name="TierName" usageType="readWrite">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(TierName) ? UPPER(TRIM(LoyaltyTierCode)) : TRIM(TierName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(TierName) ? UPPER(TRIM(LoyaltyTierCode)) : TRIM(TierName)</property>
                    </properties>
                  </inputColumn>
                </inputColumns>
              </input>
            </inputs>
