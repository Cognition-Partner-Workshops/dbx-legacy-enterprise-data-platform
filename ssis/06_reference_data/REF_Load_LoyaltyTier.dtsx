                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "APAC" ? (DT_NUMERIC,18,2)1.5 : (DT_NUMERIC,18,2)1</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "APAC" ? (DT_NUMERIC,18,2)1.5 : (DT_NUMERIC,18,2)1</property>
                    </properties>
