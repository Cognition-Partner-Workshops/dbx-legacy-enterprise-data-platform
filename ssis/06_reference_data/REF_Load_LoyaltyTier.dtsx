      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\DFT Load Loyalty Tier\STG Loyalty Tier Distribution" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="STG Loyalty Tier Distribution" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT l.LoyaltyTierCode, l.ProgramCode, l.RegionCode,
       COUNT_BIG(DISTINCT l.CustomerId) AS MemberCount,
       SUM(CAST(l.NetPointsBalance AS BIGINT)) AS TotalPoints
FROM stg.LoyaltyLedger AS l
GROUP BY l.LoyaltyTierCode, l.ProgramCode, l.RegionCode;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
