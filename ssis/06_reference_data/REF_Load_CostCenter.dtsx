                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">LEFT(UPPER(TRIM(CostCenterCode)), 2)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">LEFT(UPPER(TRIM(CostCenterCode)), 2)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Cost Center Dimension\Conform Cost Center.Outputs[Derived Column Output].Columns[SuspenseFlag]" dataType="wstr" length="1" lineageId="Package\DFT Publish Cost Center Dimension\Conform Cost Center.Outputs[Derived Column Output].Columns[SuspenseFlag]" name="SuspenseFlag">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CostCenterCode)) == "SUSP" ? "Y" : "N"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CostCenterCode)) == "SUSP" ? "Y" : "N"</property>
                    </properties>
