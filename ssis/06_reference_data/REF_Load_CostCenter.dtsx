          <component refId="Package\DFT Publish Cost Center Dimension\Conform Cost Center" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Conform Cost Center" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Publish Cost Center Dimension\Conform Cost Center.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Publish Cost Center Dimension\Conform Cost Center.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Publish Cost Center Dimension\Conform Cost Center.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Publish Cost Center Dimension\Conform Cost Center.Outputs[Derived Column Output].Columns[CostCenterCode]" dataType="wstr" length="12" lineageId="Package\DFT Publish Cost Center Dimension\Conform Cost Center.Outputs[Derived Column Output].Columns[CostCenterCode]" name="CostCenterCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CostCenterCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CostCenterCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Cost Center Dimension\Conform Cost Center.Outputs[Derived Column Output].Columns[CostCenterName]" dataType="wstr" length="60" lineageId="Package\DFT Publish Cost Center Dimension\Conform Cost Center.Outputs[Derived Column Output].Columns[CostCenterName]" name="CostCenterName">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(CostCenterName) ? UPPER(TRIM(CostCenterCode)) : TRIM(CostCenterName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(CostCenterName) ? UPPER(TRIM(CostCenterCode)) : TRIM(CostCenterName)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Publish Cost Center Dimension\Conform Cost Center.Outputs[Derived Column Output].Columns[ParentCostCenterCode]" dataType="wstr" length="12" lineageId="Package\DFT Publish Cost Center Dimension\Conform Cost Center.Outputs[Derived Column Output].Columns[ParentCostCenterCode]" name="ParentCostCenterCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CostCenterCode)) == "CORP" ? "ROOT" : "CORP"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CostCenterCode)) == "CORP" ? "ROOT" : "CORP"</property>
                    </properties>
