      DTS:DTSID="{97C4293F-6B0B-6035-6485-AC0FD8C8AD4B}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="DFT Publish Cost Center Dimension"
