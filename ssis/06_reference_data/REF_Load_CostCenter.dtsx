        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DECLARE @Unmapped TABLE (CodeDomainCode NVARCHAR(30), SourceSystemCode NVARCHAR(20),&#10;                         SourceObjectName NVARCHAR(200), SourceColumnName NVARCHAR(100),&#10;                         SourceCodeValue NVARCHAR(50), OccurrenceCount BIGINT,&#10;                         FirstObservedAtUtc DATETIME2(3));&#10;INSERT INTO @Unmapped&#10;EXEC ref.usp_ReportUnmappedCodes @BatchId = ?, @PackageExecutionId = ?, @CodeDomainCode = N'COST_CENTER';&#10;SELECT COUNT_BIG(*) AS UnmappedCodeCount FROM @Unmapped;"
