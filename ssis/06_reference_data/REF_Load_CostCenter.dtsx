          <component refId="Package\DFT Load Cost Center\Conform Cost Center" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Conform Cost Center" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\DFT Load Cost Center\Conform Cost Center.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\DFT Load Cost Center\Conform Cost Center.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output].Columns[CostCenterCode]" dataType="wstr" length="12" lineageId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output].Columns[CostCenterCode]" name="CostCenterCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CostCenterCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CostCenterCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output].Columns[ParentCostCenterCode]" dataType="wstr" length="12" lineageId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output].Columns[ParentCostCenterCode]" name="ParentCostCenterCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(ParentCostCenterCode) || TRIM(ParentCostCenterCode) == "" ? "ROOT" : UPPER(TRIM(ParentCostCenterCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(ParentCostCenterCode) || TRIM(ParentCostCenterCode) == "" ? "ROOT" : UPPER(TRIM(ParentCostCenterCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output].Columns[CompanyCode]" dataType="wstr" length="6" lineageId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output].Columns[CompanyCode]" name="CompanyCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(ISNULL(CompanyCode) ? "0001" : CompanyCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(ISNULL(CompanyCode) ? "0001" : CompanyCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output].Columns[FunctionCode]" dataType="wstr" length="2" lineageId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output].Columns[FunctionCode]" name="FunctionCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">LEN(UPPER(TRIM(CostCenterCode))) &gt;= 4 ? SUBSTRING(UPPER(TRIM(CostCenterCode)), 3, 2) : "XX"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">LEN(UPPER(TRIM(CostCenterCode))) &gt;= 4 ? SUBSTRING(UPPER(TRIM(CostCenterCode)), 3, 2) : "XX"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output].Columns[CodeValue]" dataType="wstr" length="60" lineageId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output].Columns[CodeValue]" name="CodeValue">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">UPPER(TRIM(CostCenterCode))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">UPPER(TRIM(CostCenterCode))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output].Columns[CodeDescription]" dataType="wstr" length="200" lineageId="Package\DFT Load Cost Center\Conform Cost Center.Outputs[Derived Column Output].Columns[CodeDescription]" name="CodeDescription">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TRIM(CostCenterName)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TRIM(CostCenterName)</property>
                    </properties>
                  </outputColumn>
