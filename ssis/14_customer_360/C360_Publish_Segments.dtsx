    <DTS:Executable
      DTS:refId="Package\Snapshot Previous Segments"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{683C2F11-02B0-73E0-CB63-65B57647336F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Snapshot Previous Segments"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="TRUNCATE TABLE work.CustomerSegmentPrevious; INSERT INTO work.CustomerSegmentPrevious (CustomerId, SegmentCode, AssignedAtUtc) SELECT CustomerId, SegmentCode, AssignedAtUtc FROM work.CustomerSegment;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
