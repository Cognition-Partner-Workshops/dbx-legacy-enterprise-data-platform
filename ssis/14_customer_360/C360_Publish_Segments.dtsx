    <DTS:Executable
      DTS:refId="Package\Truncate work.CustomerSegment"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6D159B73-680C-6689-F4FD-9F9AAB286BD0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Truncate work.CustomerSegment"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="TRUNCATE TABLE work.CustomerSegment;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Assign Segments"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1E05DE4A-D958-22DD-1E86-85823ED16C7F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Assign Segments"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="INSERT INTO work.CustomerSegment&#10;    (CustomerId, RegionCode, SegmentCode, SegmentModelVersion, IsSuppressed, AssignedAtUtc)&#10;SELECT  p.[WWI Customer ID]&#10;,       p.[Region Code]&#10;,       CASE&#10;            WHEN p.[Region Code] = N'EU' AND ISNULL(p.[Is Contactable], 0) = 0&#10;                THEN N'SUPPRESSED'&#10;            WHEN ch.[Churn Risk Band Code] = N'HIGH' AND m.[Monetary Decile] &gt;= 8&#10;                THEN N'AT_RISK_HIGH_VALUE'&#10;            WHEN ch.[Churn Risk Band Code] = N'HIGH'&#10;                THEN N'AT_RISK'&#10;            WHEN m.[Monetary Decile] &gt;= 9 AND m.[Frequency Decile] &gt;= 8&#10;                THEN N'CHAMPION'&#10;            WHEN m.[Recency Decile] &gt;= 8 AND m.[Frequency Decile] &lt;= 3&#10;                THEN N'NEW_PROMISING'&#10;            WHEN lo.[Tier Code] IN (N'PLATINUM', N'PREMIER', N'DIAMOND')&#10;                THEN N'LOYAL_PREMIUM'&#10;            WHEN m.[Activity Status Code] = N'INACTIVE'&#10;                THEN N'DORMANT'&#10;            ELSE N'CORE'&#10;        END&#10;,       ?&#10;,       CASE WHEN p.[Region Code] = N'EU' AND ISNULL(p.[Is Contactable], 0) = 0&#10;             THEN 1 ELSE 0 END&#10;,       SYSUTCDATETIME()&#10;FROM    Customer360.CustomerProfile AS p&#10;LEFT OUTER JOIN Customer360.CustomerRollingMetric AS m&#10;        ON m.[Customer Key] = p.[Customer Key]&#10;LEFT OUTER JOIN Customer360.CustomerChurnFlag AS ch&#10;        ON ch.[Customer Key] = p.[Customer Key]&#10;LEFT OUTER JOIN Customer360.LoyaltyOverlay AS lo&#10;        ON lo.[WWI Customer ID] = p.[WWI Customer ID];"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::SegmentModelVersion" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Drop Suppressed Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BFA938AC-343A-47A8-9948-6615956DCCC1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Drop Suppressed Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="DELETE FROM work.CustomerSegment WHERE IsSuppressed = 1;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Measure Segment Migration"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{20AE6F70-B5BA-70E9-972D-53A6C2629D0C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Segment Migration"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT (SELECT COUNT(*) FROM work.CustomerSegment) AS Segments,        (SELECT COUNT(*) FROM work.CustomerSegment WHERE IsSuppressed = 1) AS Suppressed,        (SELECT COUNT(*) FROM work.CustomerSegment AS c         INNER JOIN work.CustomerSegmentPrevious AS pr ON pr.CustomerId = c.CustomerId         WHERE pr.SegmentCode &lt;&gt; c.SegmentCode) AS Migrated;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::SegmentCount" />
        <SQLTask:ResultBinding SQLTask:ResultName="1" SQLTask:DtsVariableName="User::SuppressedCount" />
        <SQLTask:ResultBinding SQLTask:ResultName="2" SQLTask:DtsVariableName="User::MigratedCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
