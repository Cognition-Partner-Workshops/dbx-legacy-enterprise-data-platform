                  <outputColumn refId="Package\Publish Segments\work CustomerSegment.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Publish Segments\work CustomerSegment.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\Publish Segments\work CustomerSegment.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
