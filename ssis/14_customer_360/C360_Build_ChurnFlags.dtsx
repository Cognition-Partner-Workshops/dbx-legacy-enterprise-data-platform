                  <outputColumn refId="Package\Score Churn Risk\Band Churn Risk.Outputs[Derived Column Output].Columns[ChurnRiskBandCode]" dataType="wstr" length="8" lineageId="Package\Score Churn Risk\Band Churn Risk.Outputs[Derived Column Output].Columns[ChurnRiskBandCode]" name="ChurnRiskBandCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(RuleOrderGapScore + RuleBasketDeclineScore + RuleReturnsScore + RuleTierLapseScore + RuleCreditHoldScore) &gt;= @[$Package::HighRiskScoreThreshold] ? (DT_WSTR,8)"HIGH" : ((RuleOrderGapScore + RuleBasketDeclineScore + RuleReturnsScore + RuleTierLapseScore + RuleCreditHoldScore) &gt;= 30 ? (DT_WSTR,8)"MEDIUM" : (DT_WSTR,8)"LOW")</property>
