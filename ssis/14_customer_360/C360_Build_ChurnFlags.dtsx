          <component refId="Package\Score Churn Risk\Apply Churn Rules" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Apply Churn Rules" usesDispositions="true">
            <inputs>
              <input refId="Package\Score Churn Risk\Apply Churn Rules.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Score Churn Risk\Apply Churn Rules.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Score Churn Risk\Apply Churn Rules.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Score Churn Risk\Apply Churn Rules.Outputs[Derived Column Output].Columns[RuleOrderGapScore]" dataType="i4" lineageId="Package\Score Churn Risk\Apply Churn Rules.Outputs[Derived Column Output].Columns[RuleOrderGapScore]" name="RuleOrderGapScore">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">AverageOrderGapDays &gt; 0 &amp;&amp; DaysSinceLastOrder &gt; AverageOrderGapDays * @[$Package::OrderGapMultiplier] ? 30 : 0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">AverageOrderGapDays &gt; 0 &amp;&amp; DaysSinceLastOrder &gt; AverageOrderGapDays * @[$Package::OrderGapMultiplier] ? 30 : 0</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Score Churn Risk\Apply Churn Rules.Outputs[Derived Column Output].Columns[RuleBasketDeclineScore]" dataType="i4" lineageId="Package\Score Churn Risk\Apply Churn Rules.Outputs[Derived Column Output].Columns[RuleBasketDeclineScore]" name="RuleBasketDeclineScore">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">PriorAverageBasketAmount &gt; 0 &amp;&amp; AverageBasketAmount &lt; PriorAverageBasketAmount * 0.7 ? 20 : 0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PriorAverageBasketAmount &gt; 0 &amp;&amp; AverageBasketAmount &lt; PriorAverageBasketAmount * 0.7 ? 20 : 0</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Score Churn Risk\Apply Churn Rules.Outputs[Derived Column Output].Columns[RuleReturnsScore]" dataType="i4" lineageId="Package\Score Churn Risk\Apply Churn Rules.Outputs[Derived Column Output].Columns[RuleReturnsScore]" name="RuleReturnsScore">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ReturnRatePercent &gt; 15 ? 15 : 0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ReturnRatePercent &gt; 15 ? 15 : 0</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Score Churn Risk\Apply Churn Rules.Outputs[Derived Column Output].Columns[RuleTierLapseScore]" dataType="i4" lineageId="Package\Score Churn Risk\Apply Churn Rules.Outputs[Derived Column Output].Columns[RuleTierLapseScore]" name="RuleTierLapseScore">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TierCode != PreviousTierCode &amp;&amp; PreviousTierCode != "NONE" ? 15 : 0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TierCode != PreviousTierCode &amp;&amp; PreviousTierCode != "NONE" ? 15 : 0</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Score Churn Risk\Apply Churn Rules.Outputs[Derived Column Output].Columns[RuleCreditHoldScore]" dataType="i4" lineageId="Package\Score Churn Risk\Apply Churn Rules.Outputs[Derived Column Output].Columns[RuleCreditHoldScore]" name="RuleCreditHoldScore">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">IsOnCreditHold ? 25 : 0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">IsOnCreditHold ? 25 : 0</property>
                    </properties>
                  </outputColumn>
