      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Score Churn Risk\work ChurnFeatureSet" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="work ChurnFeatureSet" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1200</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  f.CustomerKey, f.CustomerId, f.RegionCode, f.DaysSinceLastOrder,
        f.AverageOrderGapDays, f.AverageBasketAmount, f.PriorAverageBasketAmount,
        f.ReturnRatePercent, ISNULL(l.TierCode, N'NONE') AS TierCode,
        ISNULL(l.PreviousTierCode, N'NONE') AS PreviousTierCode,
        ISNULL(f.IsOnCreditHold, 0) AS IsOnCreditHold
FROM    work.ChurnFeatureSet AS f
LEFT OUTER JOIN work.LoyaltyOverlay AS l ON l.CustomerId = f.CustomerId;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
