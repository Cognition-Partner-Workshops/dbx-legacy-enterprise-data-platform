                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RuleOrderGapScore + RuleBasketDeclineScore + RuleReturnsScore + RuleTierLapseScore + RuleCreditHoldScore</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RuleOrderGapScore + RuleBasketDeclineScore + RuleReturnsScore + RuleTierLapseScore + RuleCreditHoldScore</property>
