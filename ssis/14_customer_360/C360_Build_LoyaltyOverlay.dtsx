    <DTS:Executable
      DTS:refId="Package\Truncate work_LoyaltyOverlay"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D18443D8-34BD-C1A1-8C5A-540AB194EBBE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Truncate work_LoyaltyOverlay"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="TRUNCATE TABLE work.LoyaltyOverlay;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Expire Aged Points"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BFE23250-3EFA-32F2-7140-D071E9ED0C5B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Expire Aged Points"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="UPDATE work.LoyaltyPointLedger&#10;SET    PointStatusCode = N'EXPIRED', ExpiredAtUtc = SYSUTCDATETIME()&#10;WHERE  PointStatusCode = N'ACTIVE'&#10;AND    ((RegionCode = N'NA'   AND AccruedDate &lt; DATEADD(MONTH, -?, CAST(SYSDATETIME() AS date)))&#10;     OR (RegionCode = N'EU'   AND AccruedDate &lt; DATEADD(MONTH, -?, CAST(SYSDATETIME() AS date)))&#10;     OR (RegionCode = N'APAC' AND AccruedDate &lt; DATEADD(MONTH, -?, CAST(SYSDATETIME() AS date))));"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::PointsExpiryMonthsNa" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::PointsExpiryMonthsEu" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::PointsExpiryMonthsApac" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Accrue Points"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F792271E-C202-02F4-603B-2E08A00DDC42}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Accrue Points"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.LoyaltyPointLedger&#10;    (CustomerId, RegionCode, AccruedDate, QualifyingAmount, PointsAccrued,&#10;     PointStatusCode, SourceReference)&#10;SELECT  m.CustomerId&#10;,       m.RegionCode&#10;,       m.InvoiceDate&#10;,       CASE m.RegionCode&#10;            WHEN N'NA'   THEN m.GrossAmount&#10;            WHEN N'EU'   THEN m.NetAmount&#10;            WHEN N'APAC' THEN m.GrossAmount - ISNULL(m.GstAmount, 0)&#10;            ELSE m.NetAmount END&#10;,       CASE m.RegionCode&#10;            WHEN N'NA'   THEN FLOOR(m.GrossAmount)&#10;            WHEN N'EU'   THEN FLOOR(m.NetAmount * 1.5)&#10;            WHEN N'APAC' THEN FLOOR((m.GrossAmount - ISNULL(m.GstAmount, 0)) * 2)&#10;            ELSE FLOOR(m.NetAmount) END&#10;,       N'ACTIVE'&#10;,       m.InvoiceNumber&#10;FROM    work.LoyaltyQualifyingSale AS m&#10;WHERE   NOT EXISTS (SELECT 1 FROM work.LoyaltyPointLedger AS l&#10;                    WHERE l.SourceReference = m.InvoiceNumber);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Recalculate Tier Ladders"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6C5E025D-8748-21A0-84C1-488093570497}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Recalculate Tier Ladders"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.LoyaltyOverlay&#10;    (CustomerId, RegionCode, ActivePoints, ExpiredPoints, PreviousTierCode, TierCode)&#10;SELECT  l.CustomerId&#10;,       l.RegionCode&#10;,       SUM(CASE WHEN l.PointStatusCode = N'ACTIVE' THEN l.PointsAccrued ELSE 0 END)&#10;,       SUM(CASE WHEN l.PointStatusCode = N'EXPIRED' THEN l.PointsAccrued ELSE 0 END)&#10;,       MAX(ISNULL(cur.TierCode, N'NONE'))&#10;,       CASE l.RegionCode&#10;            WHEN N'NA' THEN&#10;                CASE WHEN SUM(CASE WHEN l.PointStatusCode = N'ACTIVE'&#10;                                   THEN l.PointsAccrued ELSE 0 END) &gt;= 50000 THEN N'PLATINUM'&#10;                     WHEN SUM(CASE WHEN l.PointStatusCode = N'ACTIVE'&#10;                                   THEN l.PointsAccrued ELSE 0 END) &gt;= 20000 THEN N'GOLD'&#10;                     WHEN SUM(CASE WHEN l.PointStatusCode = N'ACTIVE'&#10;                                   THEN l.PointsAccrued ELSE 0 END) &gt;= 5000  THEN N'SILVER'&#10;                     ELSE N'BASE' END&#10;            WHEN N'EU' THEN&#10;                CASE WHEN SUM(CASE WHEN l.PointStatusCode = N'ACTIVE'&#10;                                   THEN l.PointsAccrued ELSE 0 END) &gt;= 75000 THEN N'PREMIER'&#10;                     WHEN SUM(CASE WHEN l.PointStatusCode = N'ACTIVE'&#10;                                   THEN l.PointsAccrued ELSE 0 END) &gt;= 30000 THEN N'PLUS'&#10;                     ELSE N'STANDARD' END&#10;            ELSE&#10;                CASE WHEN SUM(CASE WHEN l.PointStatusCode = N'ACTIVE'&#10;                                   THEN l.PointsAccrued ELSE 0 END) &gt;= 40000 THEN N'DIAMOND'&#10;                     WHEN SUM(CASE WHEN l.PointStatusCode = N'ACTIVE'&#10;                                   THEN l.PointsAccrued ELSE 0 END) &gt;= 15000 THEN N'JADE'&#10;                     ELSE N'MEMBER' END&#10;        END&#10;FROM    work.LoyaltyPointLedger AS l&#10;LEFT OUTER JOIN work.LoyaltyOverlayCurrent AS cur ON cur.CustomerId = l.CustomerId&#10;GROUP BY l.CustomerId, l.RegionCode;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Measure Tier Movement"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8324BAAB-1464-D0A2-397A-DCFBEDB489BA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Tier Movement"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT SUM(CASE WHEN TierCode &lt;&gt; PreviousTierCode THEN 1 ELSE 0 END) AS TierChanges,        ISNULL(SUM(ExpiredPoints), 0) AS ExpiredPoints FROM work.LoyaltyOverlay;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::TierChangeCount" />
        <SQLTask:ResultBinding SQLTask:ResultName="1" SQLTask:DtsVariableName="User::ExpiredPointsAmount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
