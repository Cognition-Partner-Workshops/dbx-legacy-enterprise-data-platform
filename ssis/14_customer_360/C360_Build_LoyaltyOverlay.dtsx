                  <outputColumn refId="Package\Publish Loyalty Overlay\work LoyaltyOverlay.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Publish Loyalty Overlay\work LoyaltyOverlay.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\Publish Loyalty Overlay\work LoyaltyOverlay.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
