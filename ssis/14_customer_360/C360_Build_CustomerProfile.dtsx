          <component refId="Package\Build Customer Profile\Apply Regional Consent Rules" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Apply Regional Consent Rules" usesDispositions="true">
            <inputs>
              <input refId="Package\Build Customer Profile\Apply Regional Consent Rules.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Build Customer Profile\Apply Regional Consent Rules.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Build Customer Profile\Apply Regional Consent Rules.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Build Customer Profile\Apply Regional Consent Rules.Outputs[Derived Column Output].Columns[IsContactable]" dataType="bool" lineageId="Package\Build Customer Profile\Apply Regional Consent Rules.Outputs[Derived Column Output].Columns[IsContactable]" name="IsContactable">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "EU" ? (ISNULL(MarketingConsentFlag) ? (DT_BOOL)0 : MarketingConsentFlag) : (RegionCode == "APAC" ? (ISNULL(ConsentCapturedDate) ? (DT_BOOL)0 : (DATEDIFF("Dy", ConsentCapturedDate, GETDATE()) &lt;= 730 ? (DT_BOOL)1 : (DT_BOOL)0)) : (DT_BOOL)1)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "EU" ? (ISNULL(MarketingConsentFlag) ? (DT_BOOL)0 : MarketingConsentFlag) : (RegionCode == "APAC" ? (ISNULL(ConsentCapturedDate) ? (DT_BOOL)0 : (DATEDIFF("Dy", ConsentCapturedDate, GETDATE()) &lt;= 730 ? (DT_BOOL)1 : (DT_BOOL)0)) : (DT_BOOL)1)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Build Customer Profile\Apply Regional Consent Rules.Outputs[Derived Column Output].Columns[MaskedContactEmail]" dataType="wstr" length="256" lineageId="Package\Build Customer Profile\Apply Regional Consent Rules.Outputs[Derived Column Output].Columns[MaskedContactEmail]" name="MaskedContactEmail">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "EU" &amp;&amp; (ISNULL(MarketingConsentFlag) || MarketingConsentFlag == (DT_BOOL)0) ? (DT_WSTR,256)"WITHHELD" : ContactEmail</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "EU" &amp;&amp; (ISNULL(MarketingConsentFlag) || MarketingConsentFlag == (DT_BOOL)0) ? (DT_WSTR,256)"WITHHELD" : ContactEmail</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
          <component refId="Package\Build Customer Profile\Derive Profile Attributes" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Profile Attributes" usesDispositions="true">
            <inputs>
              <input refId="Package\Build Customer Profile\Derive Profile Attributes.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Build Customer Profile\Derive Profile Attributes.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Build Customer Profile\Derive Profile Attributes.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Build Customer Profile\Derive Profile Attributes.Outputs[Derived Column Output].Columns[MasterCustomerId]" dataType="i4" lineageId="Package\Build Customer Profile\Derive Profile Attributes.Outputs[Derived Column Output].Columns[MasterCustomerId]" name="MasterCustomerId">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(SurvivingCustomerId) ? CustomerId : SurvivingCustomerId</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(SurvivingCustomerId) ? CustomerId : SurvivingCustomerId</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Build Customer Profile\Derive Profile Attributes.Outputs[Derived Column Output].Columns[TenureDays]" dataType="i4" lineageId="Package\Build Customer Profile\Derive Profile Attributes.Outputs[Derived Column Output].Columns[TenureDays]" name="TenureDays">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(FirstOrderDate) ? 0 : DATEDIFF("Dy", FirstOrderDate, GETDATE())</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(FirstOrderDate) ? 0 : DATEDIFF("Dy", FirstOrderDate, GETDATE())</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Build Customer Profile\Derive Profile Attributes.Outputs[Derived Column Output].Columns[AverageOrderValue]" dataType="numeric" precision="18" scale="2" lineageId="Package\Build Customer Profile\Derive Profile Attributes.Outputs[Derived Column Output].Columns[AverageOrderValue]" name="AverageOrderValue">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">LifetimeOrderCount == 0 ? (DT_NUMERIC,18,2)0 : LifetimeNetAmount / LifetimeOrderCount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">LifetimeOrderCount == 0 ? (DT_NUMERIC,18,2)0 : LifetimeNetAmount / LifetimeOrderCount</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
