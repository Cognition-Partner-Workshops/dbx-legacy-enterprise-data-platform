    <DTS:Executable
      DTS:refId="Package\Standardise Addresses"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6BA46CDF-96CD-1681-B869-9062F912E2C2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Standardise Addresses"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="UPDATE work.CustomerAddressStandardised&#10;SET    StandardPostalCode =&#10;       CASE RegionCode&#10;            WHEN N'NA'   THEN LEFT(REPLACE(REPLACE(RawPostalCode, N'-', N''), N' ', N''), 5)&#10;            WHEN N'EU'   THEN CountryCode + N'-' + UPPER(REPLACE(RawPostalCode, N' ', N''))&#10;            WHEN N'APAC' THEN UPPER(REPLACE(RawPostalCode, N' ', N''))&#10;            ELSE UPPER(RawPostalCode)&#10;       END&#10;,      StandardEmail = LOWER(LTRIM(RTRIM(RawEmail)))&#10;,      StandardisedAtUtc = SYSUTCDATETIME();"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Resolve Identity Graph"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{49508D4D-060D-E444-1E55-B8024097E728}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Resolve Identity Graph"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="MERGE work.CustomerIdentityGraph AS target&#10;USING (&#10;    SELECT  a.CustomerId&#10;    ,       MIN(b.CustomerId) AS SurvivingCustomerId&#10;    ,       MAX(CASE&#10;                WHEN a.TaxRegistrationNumber = b.TaxRegistrationNumber THEN 100&#10;                WHEN a.StandardEmail = b.StandardEmail                 THEN 95&#10;                WHEN a.CustomerNameNormalised = b.CustomerNameNormalised&#10;                     AND a.StandardPostalCode = b.StandardPostalCode   THEN 88&#10;                ELSE 0 END) AS MatchScore&#10;    FROM    work.CustomerAddressStandardised AS a&#10;    INNER JOIN work.CustomerAddressStandardised AS b&#10;            ON  b.CustomerId &lt;= a.CustomerId&#10;            AND (a.TaxRegistrationNumber = b.TaxRegistrationNumber&#10;                 OR a.StandardEmail = b.StandardEmail&#10;                 OR (a.CustomerNameNormalised = b.CustomerNameNormalised&#10;                     AND a.StandardPostalCode = b.StandardPostalCode))&#10;    GROUP BY a.CustomerId&#10;) AS source&#10;    ON  target.CustomerId = source.CustomerId&#10;WHEN MATCHED AND source.MatchScore &gt;= ? THEN&#10;    UPDATE SET target.SurvivingCustomerId = source.SurvivingCustomerId,&#10;               target.MatchScore = source.MatchScore,&#10;               target.ResolvedAtUtc = SYSUTCDATETIME()&#10;WHEN NOT MATCHED BY TARGET AND source.MatchScore &gt;= ? THEN&#10;    INSERT (CustomerId, SurvivingCustomerId, MatchScore, ResolvedAtUtc)&#10;    VALUES (source.CustomerId, source.SurvivingCustomerId, source.MatchScore,&#10;            SYSUTCDATETIME());"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::MatchThresholdScore" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::MatchThresholdScore" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Build Customer Profile"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{46A12CF7-B3D2-FF6E-2EE3-F24CF7A16361}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Customer Profile"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Build Customer Profile\Dimension Customer" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="Dimension Customer" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  c.[Customer Key]                                AS CustomerKey
,       c.[WWI Customer ID]                             AS CustomerId
,       c.Customer                                      AS CustomerName
,       c.Category                                      AS CustomerCategory
,       c.[Buying Group]                                AS BuyingGroup
,       c.[Postal Code]                                 AS PostalCode
,       c.[Region Code]                                 AS RegionCode
,       c.[Country Code]                                AS CountryCode
,       c.[Primary Contact Email]                       AS ContactEmail
,       c.[Primary Contact Phone]                       AS ContactPhone
,       c.[Marketing Consent Flag]                      AS MarketingConsentFlag
,       c.[Consent Captured Date]                       AS ConsentCapturedDate
,       s.FirstOrderDate
,       s.LastOrderDate
,       s.LifetimeOrderCount
,       s.LifetimeNetAmount
,       p.LastPaymentDate
,       p.OpenBalanceAmount
,       p.AveragePaymentDays
FROM    Dimension.Customer AS c
LEFT OUTER JOIN work.CustomerSalesSummary AS s
        ON  s.CustomerKey = c.[Customer Key]
LEFT OUTER JOIN work.CustomerPaymentSummary AS p
        ON  p.CustomerKey = c.[Customer Key]
WHERE   c.[Valid To] &gt; SYSDATETIME()
AND     c.[WWI Customer ID] &gt; 0</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Build Customer Profile\Dimension Customer.Connections[OleDbConnection]" connectionManagerID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_DW_Destination_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[CustomerKey]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].ExternalColumns[CustomerKey]" lineageId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[CustomerKey]" name="CustomerKey" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[CustomerId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].ExternalColumns[CustomerId]" lineageId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[CustomerId]" name="CustomerId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[CustomerName]" dataType="wstr" length="100" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].ExternalColumns[CustomerName]" lineageId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[CustomerName]" name="CustomerName" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[CustomerCategory]" dataType="wstr" length="50" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].ExternalColumns[CustomerCategory]" lineageId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[CustomerCategory]" name="CustomerCategory" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[BuyingGroup]" dataType="wstr" length="50" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].ExternalColumns[BuyingGroup]" lineageId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[BuyingGroup]" name="BuyingGroup" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[PostalCode]" dataType="wstr" length="12" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].ExternalColumns[PostalCode]" lineageId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[PostalCode]" name="PostalCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\Build Customer Profile\Dimension Customer.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
