    <DTS:Executable
      DTS:refId="Package\Assign Households"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9A5F33FD-9C3E-0C4A-AF73-2B4677F05849}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Assign Households"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="UPDATE p&#10;SET    p.HouseholdKey = h.HouseholdKey&#10;FROM   work.CustomerProfile AS p&#10;INNER JOIN (SELECT DENSE_RANK() OVER (ORDER BY StandardPostalCode, HouseholdNameKey)&#10;                       AS HouseholdKey,&#10;                   CustomerId&#10;            FROM   work.CustomerAddressStandardised) AS h&#10;        ON h.CustomerId = p.CustomerId;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
