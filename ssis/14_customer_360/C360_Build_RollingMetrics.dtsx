            <inputs>
              <input refId="Package\Derive Rolling Metrics\Derive Ratios.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Derive Rolling Metrics\Derive Ratios.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Derive Rolling Metrics\Derive Ratios.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Derive Rolling Metrics\Derive Ratios.Outputs[Derived Column Output].Columns[AverageBasketAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Derive Rolling Metrics\Derive Ratios.Outputs[Derived Column Output].Columns[AverageBasketAmount]" name="AverageBasketAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">OrderCount == 0 ? (DT_NUMERIC,18,2)0 : NetRevenue / OrderCount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">OrderCount == 0 ? (DT_NUMERIC,18,2)0 : NetRevenue / OrderCount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Derive Rolling Metrics\Derive Ratios.Outputs[Derived Column Output].Columns[ReturnRatePercent]" dataType="numeric" precision="18" scale="2" lineageId="Package\Derive Rolling Metrics\Derive Ratios.Outputs[Derived Column Output].Columns[ReturnRatePercent]" name="ReturnRatePercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">NetRevenue == 0 ? (DT_NUMERIC,18,2)0 : ReturnAmount * 100 / NetRevenue</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">NetRevenue == 0 ? (DT_NUMERIC,18,2)0 : ReturnAmount * 100 / NetRevenue</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Derive Rolling Metrics\Derive Ratios.Outputs[Derived Column Output].Columns[DaysSinceLastOrder]" dataType="i4" lineageId="Package\Derive Rolling Metrics\Derive Ratios.Outputs[Derived Column Output].Columns[DaysSinceLastOrder]" name="DaysSinceLastOrder">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(LastOrderDate) ? 9999 : DATEDIFF("Dy", LastOrderDate, WindowEndDate)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(LastOrderDate) ? 9999 : DATEDIFF("Dy", LastOrderDate, WindowEndDate)</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
          <component refId="Package\Derive Rolling Metrics\Derive Activity Status" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Activity Status" usesDispositions="true">
            <inputs>
              <input refId="Package\Derive Rolling Metrics\Derive Activity Status.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Derive Rolling Metrics\Derive Activity Status.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Derive Rolling Metrics\Derive Activity Status.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Derive Rolling Metrics\Derive Activity Status.Outputs[Derived Column Output].Columns[ActivityStatusCode]" dataType="wstr" length="10" lineageId="Package\Derive Rolling Metrics\Derive Activity Status.Outputs[Derived Column Output].Columns[ActivityStatusCode]" name="ActivityStatusCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(ISNULL(LastOrderDate) ? 9999 : DATEDIFF("Dy", LastOrderDate, WindowEndDate)) &gt; @[$Package::InactiveThresholdDays] ? (DT_WSTR,10)"INACTIVE" : (OrderCount &gt;= 12 ? (DT_WSTR,10)"FREQUENT" : (DT_WSTR,10)"ACTIVE")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(ISNULL(LastOrderDate) ? 9999 : DATEDIFF("Dy", LastOrderDate, WindowEndDate)) &gt; @[$Package::InactiveThresholdDays] ? (DT_WSTR,10)"INACTIVE" : (OrderCount &gt;= 12 ? (DT_WSTR,10)"FREQUENT" : (DT_WSTR,10)"ACTIVE")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Derive Rolling Metrics\Derive Activity Status.Outputs[Derived Column Output].Columns[OrdersPerMonth]" dataType="numeric" precision="18" scale="2" lineageId="Package\Derive Rolling Metrics\Derive Activity Status.Outputs[Derived Column Output].Columns[OrdersPerMonth]" name="OrdersPerMonth">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">OrderCount / (DT_NUMERIC,18,2)@[$Package::WindowMonths]</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">OrderCount / (DT_NUMERIC,18,2)@[$Package::WindowMonths]</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
