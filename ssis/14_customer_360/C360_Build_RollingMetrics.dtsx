    <DTS:Executable
      DTS:refId="Package\Assign RFM Deciles"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{28C8615D-A4DE-B10F-93CD-32E2B8E8DA67}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Assign RFM Deciles"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="UPDATE m&#10;SET    m.[Recency Decile] = d.RecencyDecile&#10;,      m.[Frequency Decile] = d.FrequencyDecile&#10;,      m.[Monetary Decile] = d.MonetaryDecile&#10;FROM   Customer360.CustomerRollingMetric AS m&#10;INNER JOIN (SELECT [Customer Key],&#10;                   NTILE(10) OVER (PARTITION BY [Region Code]&#10;                                   ORDER BY [Days Since Last Order] DESC) AS RecencyDecile,&#10;                   NTILE(10) OVER (PARTITION BY [Region Code]&#10;                                   ORDER BY [Order Count]) AS FrequencyDecile,&#10;                   NTILE(10) OVER (PARTITION BY [Region Code]&#10;                                   ORDER BY [Net Revenue]) AS MonetaryDecile&#10;            FROM   Customer360.CustomerRollingMetric) AS d&#10;        ON d.[Customer Key] = m.[Customer Key];"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Count Inactive Customers"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F60E0DD9-AA2E-0E64-64DC-32384677B233}"
