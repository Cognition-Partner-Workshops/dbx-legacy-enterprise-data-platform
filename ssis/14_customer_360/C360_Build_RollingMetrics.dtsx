  DTS:Description="Recomputes the rolling twelve-month customer metrics: revenue, order frequency, average basket, returns rate, days since last order and the recency/frequency/monetary deciles. The window is anchored on the region's own period end - calendar month for NA and EU, the 4-4-5 period for APAC - so the same customer can appear in two different windows if they trade in more than one region."
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="13.0.4001.0"
  DTS:LocaleID="1033"
  DTS:ObjectName="C360_Build_RollingMetrics"
  DTS:PackageType="5"
  DTS:ProtectionLevel="0"
  DTS:VersionBuild="1"
  DTS:VersionGUID="{83017F2E-C24E-D4CD-77ED-A8479701FF11}">
