    <DTS:Executable
      DTS:refId="Package\Aggregate Rolling Window"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BE9C9C58-45ED-CC80-BB9D-B08202620A4C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Aggregate Rolling Window"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="INSERT INTO work.CustomerRollingMetric&#10;    (CustomerKey, RegionCode, WindowStartDate, WindowEndDate, OrderCount, NetRevenue,&#10;     ReturnAmount, DistinctItemCount, LastOrderDate)&#10;SELECT  s.[Customer Key]&#10;,       c.[Region Code]&#10;,       DATEADD(MONTH, -?, CAST(SYSDATETIME() AS date))&#10;,       CAST(SYSDATETIME() AS date)&#10;,       COUNT(DISTINCT s.[WWI Invoice ID])&#10;,       SUM(s.[Total Excluding Tax])&#10;,       SUM(CASE WHEN s.Quantity &lt; 0 THEN ABS(s.[Total Excluding Tax]) ELSE 0 END)&#10;,       COUNT(DISTINCT s.[Stock Item Key])&#10;,       MAX(s.[Invoice Date Key])&#10;FROM    Fact.Sale AS s&#10;INNER JOIN Dimension.Customer AS c ON c.[Customer Key] = s.[Customer Key]&#10;WHERE   s.[Invoice Date Key] &gt;= DATEADD(MONTH, -?, CAST(SYSDATETIME() AS date))&#10;GROUP BY s.[Customer Key], c.[Region Code];"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::WindowMonths" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::WindowMonths" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Realign APAC Window To 445"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F0176C28-A7B6-C531-E8D2-8FFEF5133B73}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Realign APAC Window To 445"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="UPDATE m SET    m.WindowEndDate = f.PeriodEndDate, m.WindowStartDate = f.PeriodStartDate FROM   work.CustomerRollingMetric AS m INNER JOIN (SELECT TOP (1) PeriodStartDate, PeriodEndDate FROM stg.FiscalCalendar445Period             WHERE PeriodEndDate &lt;= CAST(SYSDATETIME() AS date)             ORDER BY PeriodEndDate DESC) AS f ON 1 = 1 WHERE  m.RegionCode = N'APAC';"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
