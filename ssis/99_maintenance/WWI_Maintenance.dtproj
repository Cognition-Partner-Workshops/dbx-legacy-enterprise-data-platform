      <EntryPoint>false</EntryPoint>
    </Package>
    <Package>
      <Name>MNT_Rebuild_Indexes.dtsx</Name>
      <EntryPoint>false</EntryPoint>
    </Package>
    <Package>
      <Name>MNT_Update_Statistics.dtsx</Name>
      <EntryPoint>false</EntryPoint>
    </Package>
    <Package>
      <Name>MNT_Archive_ProcessedFiles.dtsx</Name>
      <EntryPoint>false</EntryPoint>
    </Package>
    <Package>
      <Name>MNT_Validate_Configuration.dtsx</Name>
      <EntryPoint>false</EntryPoint>
    </Package>
    <Package>
      <Name>MNT_Check_DiskSpace.dtsx</Name>
      <EntryPoint>false</EntryPoint>
    </Package>
  </Packages>
