    <DTS:Executable
      DTS:refId="Package\Truncate work.IndexMaintenancePlan"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AF5ED1EF-7F45-DDFB-39E4-DFE4514F1FEA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Truncate work.IndexMaintenancePlan"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="TRUNCATE TABLE work.IndexMaintenancePlan;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Survey Index Fragmentation"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BEB60596-BD87-87CE-AA5E-6311C784B0E4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Survey Index Fragmentation"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="INSERT INTO work.IndexMaintenancePlan&#10;    (SchemaName, TableName, IndexName, IndexTypeCode, FragmentationPercent,&#10;     PageCount, PlannedAction)&#10;SELECT  SCHEMA_NAME(o.schema_id)&#10;,       o.name&#10;,       i.name&#10;,       CASE WHEN i.type IN (5, 6) THEN N'COLUMNSTORE' ELSE N'ROWSTORE' END&#10;,       s.avg_fragmentation_in_percent&#10;,       s.page_count&#10;,       CASE&#10;            WHEN i.type IN (5, 6) THEN N'COLUMNSTORE_REBUILD'&#10;            WHEN s.avg_fragmentation_in_percent &gt;= ? THEN N'REBUILD'&#10;            WHEN s.avg_fragmentation_in_percent &gt;= ? THEN N'REORGANIZE'&#10;            ELSE N'NONE'&#10;        END&#10;FROM    sys.dm_db_index_physical_stats(DB_ID(), NULL, NULL, NULL, N'LIMITED') AS s&#10;INNER JOIN sys.indexes AS i ON i.object_id = s.object_id AND i.index_id = s.index_id&#10;INNER JOIN sys.objects AS o ON o.object_id = i.object_id&#10;WHERE   o.is_ms_shipped = 0&#10;AND     i.name IS NOT NULL&#10;AND     s.page_count &gt; 1000;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="3600"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::RebuildThresholdPercent" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::ReorganiseThresholdPercent" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Maintain Rowstore Indexes"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3AA0666F-67E1-ADC4-4B06-523B21E27321}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Maintain Rowstore Indexes"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DECLARE @Schema sysname, @Table sysname, @Index sysname, @Action nvarchar(30),&#10;        @Sql nvarchar(max), @Online bit = ?, @Deadline datetime2(0);&#10;SET @Deadline = DATEADD(MINUTE, ?, SYSUTCDATETIME());&#10;DECLARE IndexCursor CURSOR LOCAL FAST_FORWARD FOR&#10;    SELECT SchemaName, TableName, IndexName, PlannedAction&#10;    FROM   work.IndexMaintenancePlan&#10;    WHERE  IndexTypeCode = N'ROWSTORE' AND PlannedAction &lt;&gt; N'NONE'&#10;    ORDER BY PageCount DESC;&#10;OPEN IndexCursor;&#10;FETCH NEXT FROM IndexCursor INTO @Schema, @Table, @Index, @Action;&#10;WHILE @@FETCH_STATUS = 0 AND SYSUTCDATETIME() &lt; @Deadline&#10;BEGIN&#10;    SET @Sql = N'ALTER INDEX ' + QUOTENAME(@Index) + N' ON '&#10;             + QUOTENAME(@Schema) + N'.' + QUOTENAME(@Table)&#10;             + CASE WHEN @Action = N'REBUILD'&#10;                    THEN N' REBUILD WITH (ONLINE = '&#10;                         + CASE WHEN @Online = 1 THEN N'ON' ELSE N'OFF' END&#10;                         + N', SORT_IN_TEMPDB = ON);'&#10;                    ELSE N' REORGANIZE;' END;&#10;    BEGIN TRY&#10;        EXEC sp_executesql @Sql;&#10;        INSERT INTO etl.MaintenanceLog (TaskName, DetailText, RecordedAtUtc)&#10;        VALUES (N'MNT_Rebuild_Indexes', @Sql, SYSUTCDATETIME());&#10;    END TRY&#10;    BEGIN CATCH&#10;        INSERT INTO etl.MaintenanceLog (TaskName, DetailText, RecordedAtUtc)&#10;        VALUES (N'MNT_Rebuild_Indexes',&#10;                CONCAT(N'FAILED: ', @Sql, N' -&gt; ', ERROR_MESSAGE()), SYSUTCDATETIME());&#10;    END CATCH&#10;    FETCH NEXT FROM IndexCursor INTO @Schema, @Table, @Index, @Action;&#10;END&#10;CLOSE IndexCursor; DEALLOCATE IndexCursor;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::OnlineRebuild" SQLTask:ParameterDirection="Input" SQLTask:DataType="BYTE" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::MaxDurationMinutes" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Rebuild Columnstore Indexes"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{62C6FDDB-4985-64C5-9E83-182DDE8C4590}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Rebuild Columnstore Indexes"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="EXEC Integration.RebuildColumnstoreIndexes @MaxDurationMinutes = ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="True"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::MaxDurationMinutes" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Measure Index Actions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F708F61C-D764-DD30-C9E4-FDE10535E4B1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Index Actions"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS PlannedActions,        SUM(CASE WHEN PlannedAction = N'REBUILD' THEN 1 ELSE 0 END) AS Rebuilt,        SUM(CASE WHEN PlannedAction = N'REORGANIZE' THEN 1 ELSE 0 END) AS Reorganised FROM   work.IndexMaintenancePlan WHERE PlannedAction &lt;&gt; N'NONE';"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::IndexActionCount" />
        <SQLTask:ResultBinding SQLTask:ResultName="1" SQLTask:DtsVariableName="User::RebuiltCount" />
        <SQLTask:ResultBinding SQLTask:ResultName="2" SQLTask:DtsVariableName="User::ReorganisedCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
