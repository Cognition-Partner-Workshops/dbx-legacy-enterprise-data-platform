  DTS:Description="Purges the etl control tables beyond retention, archiving the batch and error history into the archive tables first so the auditors keep a trail. Rejected records are only purged once they have been resolved or superseded, and watermark rows are never purged."
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="13.0.4001.0"
  DTS:LocaleID="1033"
  DTS:ObjectName="MNT_Purge_ControlHistory"
  DTS:PackageType="5"
  DTS:ProtectionLevel="0"
  DTS:VersionBuild="1"
  DTS:VersionGUID="{4BD96C51-217D-006D-5A07-054F730A8771}">
