  DTS:DTSID="{415E7D7C-7678-839B-A6C3-ED0A2554A8ED}"
  DTS:Description="Asserts that every configuration key the estate depends on exists and is plausible before the nightly batch starts: connection placeholders are populated per environment, the open finance period matches the calendar, the FX rates for the business date have landed, and the regional reference code sets are all present. Missing keys are raised as configuration defects rather than discovered mid-load."
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="13.0.4001.0"
  DTS:LocaleID="1033"
  DTS:ObjectName="MNT_Validate_Configuration"
  DTS:PackageType="5"
  DTS:ProtectionLevel="0"
  DTS:VersionBuild="1"
  DTS:VersionGUID="{10CC68B7-5FC4-EFA2-9462-81097A8363C4}">
