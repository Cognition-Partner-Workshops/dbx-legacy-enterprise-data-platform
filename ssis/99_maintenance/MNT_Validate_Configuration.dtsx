    <DTS:Executable
      DTS:refId="Package\Truncate work_ConfigurationValidation"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{67474C7E-241E-0B65-44D0-F7A85B039E20}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Truncate work_ConfigurationValidation"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="TRUNCATE TABLE work.ConfigurationValidation;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Check Required Keys"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E3658D53-AEFD-F4E3-89CC-5E8950C80954}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Check Required Keys"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.ConfigurationValidation&#10;    (ConfigurationKey, EnvironmentCode, CheckTypeCode, CheckStatus, DetailText)&#10;SELECT  r.ConfigurationKey&#10;,       ?&#10;,       N'REQUIRED'&#10;,       CASE WHEN c.ConfigurationValue IS NULL THEN N'MISSING'&#10;             WHEN LTRIM(RTRIM(c.ConfigurationValue)) = N'' THEN N'EMPTY'&#10;             ELSE N'OK' END&#10;,       CASE WHEN c.ConfigurationValue IS NULL&#10;             THEN N'Key is not defined for this environment' ELSE NULL END&#10;FROM    etl.RequiredConfigurationKey AS r&#10;LEFT OUTER JOIN etl.Configuration AS c&#10;       ON  c.ConfigurationKey = r.ConfigurationKey&#10;       AND c.EnvironmentCode = ?&#10;WHERE   r.IsMandatory = 1;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::EnvironmentCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::EnvironmentCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Check Connection Placeholders"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C919834A-1F7C-A0BE-4015-6A4956719B91}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Check Connection Placeholders"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.ConfigurationValidation&#10;    (ConfigurationKey, EnvironmentCode, CheckTypeCode, CheckStatus, DetailText)&#10;SELECT  k.PlaceholderName&#10;,       ?&#10;,       N'PLACEHOLDER'&#10;,       CASE WHEN c.ConfigurationValue IS NULL THEN N'MISSING' ELSE N'OK' END&#10;,       N'Connection placeholder resolved from the environment, never stored inline'&#10;FROM    (VALUES (N'ORACLE_HOST'), (N'ORACLE_PORT'), (N'ORACLE_SERVICE'),&#10;                (N'ORACLE_USER'), (N'SQLSERVER_HOST'), (N'SQLSERVER_PORT'),&#10;                (N'SQLSERVER_USER'), (N'SQLSERVER_OLTP_DB'),&#10;                (N'SQLSERVER_STAGING_DB'), (N'SQLSERVER_DW_DB'))&#10;            AS k(PlaceholderName)&#10;LEFT OUTER JOIN etl.Configuration AS c&#10;       ON  c.ConfigurationKey = k.PlaceholderName&#10;       AND c.EnvironmentCode = ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::EnvironmentCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::EnvironmentCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Check Value Plausibility"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0409ED33-02C0-CE25-E73A-02E51B7719BB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Check Value Plausibility"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.ConfigurationValidation&#10;    (ConfigurationKey, EnvironmentCode, CheckTypeCode, CheckStatus, DetailText)&#10;SELECT  N'OPEN_PERIOD_' + p.RegionCode&#10;,       ?&#10;,       N'PLAUSIBILITY'&#10;,       CASE WHEN p.OpenPeriodKey IS NULL THEN N'MISSING'&#10;             WHEN p.RegionCode = N'APAC' AND p.FiscalCalendarCode &lt;&gt; N'445'&#10;                  THEN N'SUSPECT'&#10;             WHEN p.RegionCode = N'EU' AND p.VatRegimeCode IS NULL THEN N'SUSPECT'&#10;             WHEN p.OpenPeriodKey &lt; CONVERT(int, FORMAT(DATEADD(MONTH, -2,&#10;                  SYSUTCDATETIME()), N'yyyyMM')) THEN N'SUSPECT'&#10;             ELSE N'OK' END&#10;,       CONCAT(N'Region ', p.RegionCode, N' open period ',&#10;                CAST(ISNULL(p.OpenPeriodKey, 0) AS nvarchar(10)))&#10;FROM    etl.RegionPeriodStatus AS p&#10;UNION ALL&#10;SELECT  N'FX_RATES_' + r.RegionCode, ?, N'PLAUSIBILITY'&#10;,       CASE WHEN r.RateCount = 0 THEN N'MISSING' ELSE N'OK' END&#10;,       CONCAT(N'FX rates loaded for the business date: ',&#10;                CAST(r.RateCount AS nvarchar(10)))&#10;FROM    (SELECT RegionCode, COUNT(*) AS RateCount&#10;         FROM   etl.FxRateAvailability&#10;         WHERE  RateDate = CAST(SYSUTCDATETIME() AS date)&#10;         GROUP BY RegionCode) AS r;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::EnvironmentCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::EnvironmentCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Measure Configuration Defects"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E824260A-E19C-1D9C-32CB-9A2D558D0DB9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Configuration Defects"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT SUM(CASE WHEN CheckStatus IN (N'MISSING', N'EMPTY') THEN 1 ELSE 0 END) AS Missing,        SUM(CASE WHEN CheckStatus = N'SUSPECT' THEN 1 ELSE 0 END) AS Suspect,        CASE WHEN SUM(CASE WHEN CheckStatus IN (N'MISSING', N'EMPTY')                           THEN 1 ELSE 0 END) &gt; 0 THEN N'DEFECTIVE'             WHEN SUM(CASE WHEN CheckStatus = N'SUSPECT' THEN 1 ELSE 0 END) &gt; 0                  THEN N'SUSPECT' ELSE N'OK' END AS ConfigurationStatus FROM   work.ConfigurationValidation;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::MissingKeyCount" />
        <SQLTask:ResultBinding SQLTask:ResultName="1" SQLTask:DtsVariableName="User::SuspectValueCount" />
        <SQLTask:ResultBinding SQLTask:ResultName="2" SQLTask:DtsVariableName="User::ConfigurationStatus" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Raise Configuration Defect"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FFE9D8C0-184F-3D49-2908-B1F2EF717284}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Raise Configuration Defect"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogError @BatchId = ?, @ErrorSeverity = N'Error', @ErrorCode = 50011, @ErrorDescription = N'Mandatory configuration keys are missing for this environment.', @SourceName = N'MNT_Validate_Configuration';"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="True"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Record Suspect Configuration"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C3C7938E-6EF4-8A15-2689-414D87AEDCFE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Record Suspect Configuration"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO etl.OperatorNotification     (BatchId, NotificationTypeCode, Severity, Subject, Body, RaisedAtUtc, IsAcknowledged) SELECT ?, N'CONFIG_SUSPECT', N'WARNING', N'Configuration values look wrong',        CONCAT(N'Suspect configuration entries: ', CAST(COUNT(*) AS nvarchar(20))),        SYSUTCDATETIME(), 0 FROM   work.ConfigurationValidation WHERE CheckStatus = N'SUSPECT' HAVING COUNT(*) &gt; 0;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Log Row Counts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F41C9678-F52A-5CFF-3FAA-181DE511DC84}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Row Counts"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogRowCount @PackageExecutionId = ?, @ObjectName = N'etl.Configuration', @SourceRowCount = ?, @TargetRowCount = ?, @RejectRowCount = ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="True"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::RowsRead" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="User::RowsInserted" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
