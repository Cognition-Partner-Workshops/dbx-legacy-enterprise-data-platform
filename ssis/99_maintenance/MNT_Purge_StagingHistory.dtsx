    <DTS:Executable
      DTS:refId="Package\Truncate work.StagingPurgePlan"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9DA25DE5-6A18-1991-6DB0-FBAB5D133808}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Truncate work.StagingPurgePlan"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="TRUNCATE TABLE work.StagingPurgePlan;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Build Purge Plan"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{49206DF2-B46F-F79B-CDFD-5633CD3AE6A0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Purge Plan"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.StagingPurgePlan&#10;    (SchemaName, TableName, LoadDateColumn, RetentionDays, CutoffDate, EstimatedRows)&#10;SELECT  t.SchemaName&#10;,       t.TableName&#10;,       ISNULL(t.LoadDateColumn, N'LoadedAtUtc')&#10;,       CASE&#10;            WHEN t.SchemaName = N'raw' AND t.TableName LIKE N'Fin%'   THEN 2555&#10;            WHEN t.TableName LIKE N'%Partner%'                        THEN 365&#10;            WHEN t.SchemaName = N'work'                               THEN 14&#10;            ELSE ?&#10;        END&#10;,       DATEADD(DAY, -1 * CASE&#10;            WHEN t.SchemaName = N'raw' AND t.TableName LIKE N'Fin%'   THEN 2555&#10;            WHEN t.TableName LIKE N'%Partner%'                        THEN 365&#10;            WHEN t.SchemaName = N'work'                               THEN 14&#10;            ELSE ? END, CAST(SYSUTCDATETIME() AS date))&#10;,       t.ApproximateRowCount&#10;FROM    etl.StagingTableRegister AS t&#10;WHERE   t.IsPurgeEligible = 1;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::DefaultRetentionDays" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::DefaultRetentionDays" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Purge Each Staging Table"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Row-by-row over the purge plan: legacy dynamic SQL, one table at a time."
      DTS:DTSID="{9E426D21-893A-B1FD-1487-C876329AD0BF}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Purge Each Staging Table">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Purge Each Staging Table\Build And Run Chunked Deletes"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{081A3A38-0766-EB17-ECF9-04D3C2472C67}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Build And Run Chunked Deletes"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="DECLARE @SchemaName sysname, @TableName sysname, @DateColumn sysname,&#10;        @CutoffDate date, @Sql nvarchar(max), @Chunk int = ?, @Deleted int = 1,&#10;        @DryRun bit = ?;&#10;DECLARE PurgeCursor CURSOR LOCAL FAST_FORWARD FOR&#10;    SELECT SchemaName, TableName, LoadDateColumn, CutoffDate&#10;    FROM   work.StagingPurgePlan ORDER BY EstimatedRows DESC;&#10;OPEN PurgeCursor;&#10;FETCH NEXT FROM PurgeCursor INTO @SchemaName, @TableName, @DateColumn, @CutoffDate;&#10;WHILE @@FETCH_STATUS = 0&#10;BEGIN&#10;    SET @Deleted = 1;&#10;    WHILE @Deleted &gt; 0&#10;    BEGIN&#10;        SET @Sql = N'DELETE TOP (' + CAST(@Chunk AS nvarchar(20)) + N') FROM '&#10;                 + QUOTENAME(@SchemaName) + N'.' + QUOTENAME(@TableName)&#10;                 + N' WHERE ' + QUOTENAME(@DateColumn) + N' &lt; @Cutoff;';&#10;        IF @DryRun = 1 BREAK;&#10;        EXEC sp_executesql @Sql, N'@Cutoff date', @Cutoff = @CutoffDate;&#10;        SET @Deleted = @@ROWCOUNT;&#10;        INSERT INTO etl.PurgeAudit&#10;            (BatchId, SchemaName, TableName, CutoffDate, RowsDeleted, PurgedAtUtc)&#10;        VALUES (NULL, @SchemaName, @TableName, @CutoffDate, @Deleted, SYSUTCDATETIME());&#10;    END&#10;    FETCH NEXT FROM PurgeCursor INTO @SchemaName, @TableName, @DateColumn, @CutoffDate;&#10;END&#10;CLOSE PurgeCursor; DEALLOCATE PurgeCursor;"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::DeleteChunkRows" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
            <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::DryRun" SQLTask:ParameterDirection="Input" SQLTask:DataType="BYTE" SQLTask:ParameterSize="-1" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Purge Each Staging Table\Measure Purged Rows"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{B414DB8E-86C1-FDBC-191F-996AE6346F5F}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Measure Purged Rows"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
            SQLTask:SqlStatementSource="SELECT ISNULL(SUM(RowsDeleted), 0) AS RowsDeleted FROM etl.PurgeAudit WHERE PurgedAtUtc &gt;= DATEADD(HOUR, -6, SYSUTCDATETIME());"
            SQLTask:ResultType="ResultSetType_SingleRow"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::PurgedRowCount" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Purge Each Staging Table.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{E12D867C-E5EA-1A5A-A726-FD888C42682E}"
          DTS:From="Package\Purge Each Staging Table\Build And Run Chunked Deletes"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package\Purge Each Staging Table\Measure Purged Rows" />
      </DTS:PrecedenceConstraints>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Record Space Reclaimed"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7008357C-7910-17F1-90BF-2D35C818FFAE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Record Space Reclaimed"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO etl.MaintenanceLog (TaskName, DetailText, RecordedAtUtc) SELECT N'MNT_Purge_StagingHistory',        CONCAT(N'Rows deleted in this run: ', CAST(? AS nvarchar(20))),        SYSUTCDATETIME();"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PurgedRowCount" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Log Row Counts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
