      DTS:DTSID="{1C35CCBB-5F7F-0524-1AB0-9608EB138C1C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Truncate work_VolumeSpaceCheck"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="TRUNCATE TABLE work.VolumeSpaceCheck;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Survey Volume Space"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{79E0B4A2-6820-ACF4-6151-FFB8EF522E17}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Survey Volume Space"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="INSERT INTO work.VolumeSpaceCheck&#10;    (VolumeMountPoint, TotalBytes, AvailableBytes, FreePercent, DatabaseName,&#10;     FileTypeCode, CheckedAtUtc)&#10;SELECT DISTINCT&#10;        vs.volume_mount_point&#10;,       vs.total_bytes&#10;,       vs.available_bytes&#10;,       CAST(vs.available_bytes * 100.0 / NULLIF(vs.total_bytes, 0) AS decimal(9, 2))&#10;,       DB_NAME(f.database_id)&#10;,       CASE WHEN f.type = 1 THEN N'LOG' ELSE N'DATA' END&#10;,       SYSUTCDATETIME()&#10;FROM    sys.master_files AS f&#10;CROSS APPLY sys.dm_os_volume_stats(f.database_id, f.file_id) AS vs;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="300"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Project Batch Growth"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AA080B05-0E65-A829-2B59-C88BE8A2B331}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Project Batch Growth"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="INSERT INTO work.VolumeGrowthProjection&#10;    (VolumeMountPoint, ProjectedBytes, BasisDescription, CheckedAtUtc)&#10;SELECT  v.VolumeMountPoint&#10;,       CAST(AVG(CAST(g.BytesWritten AS bigint)) * 1.33 AS bigint)&#10;,       N'Average of the last ten nightly loads plus index maintenance headroom'&#10;,       SYSUTCDATETIME()&#10;FROM    work.VolumeSpaceCheck AS v&#10;INNER JOIN etl.LoadVolumeHistory AS g ON g.VolumeMountPoint = v.VolumeMountPoint&#10;WHERE   g.LoadDate &gt;= DATEADD(DAY, -14, CAST(SYSUTCDATETIME() AS date))&#10;GROUP BY v.VolumeMountPoint;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Evaluate Preflight"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{CC9DA25D-EFFC-DBE7-B131-65A7F0E421BF}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Evaluate Preflight"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Evaluate Preflight\work VolumeSpaceCheck" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="work VolumeSpaceCheck" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">300</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  v.VolumeMountPoint
,       CAST(v.FreePercent AS int) AS FreePercent
,       CAST(v.AvailableBytes / 1073741824 AS int) AS AvailableGb
,       v.DatabaseName
,       v.FileTypeCode
,       CAST(ISNULL(p.ProjectedBytes, 0) / 1073741824 AS int) AS ProjectedGb
FROM    work.VolumeSpaceCheck AS v
LEFT OUTER JOIN work.VolumeGrowthProjection AS p
       ON p.VolumeMountPoint = v.VolumeMountPoint;</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Connections[OleDbConnection]" connectionManagerID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_DW_Destination_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].Columns[VolumeMountPoint]" dataType="wstr" length="128" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].ExternalColumns[VolumeMountPoint]" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].Columns[VolumeMountPoint]" name="VolumeMountPoint" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].Columns[FreePercent]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].ExternalColumns[FreePercent]" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].Columns[FreePercent]" name="FreePercent" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].Columns[AvailableGb]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].ExternalColumns[AvailableGb]" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].Columns[AvailableGb]" name="AvailableGb" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].Columns[DatabaseName]" dataType="wstr" length="128" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].ExternalColumns[DatabaseName]" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].Columns[DatabaseName]" name="DatabaseName" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].Columns[FileTypeCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].ExternalColumns[FileTypeCode]" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].Columns[FileTypeCode]" name="FileTypeCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].Columns[ProjectedGb]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].ExternalColumns[ProjectedGb]" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].Columns[ProjectedGb]" name="ProjectedGb" truncationRowDisposition="RedirectRow" />
                </outputColumns>
                <externalMetadataColumns isUsed="True">
                  <externalMetadataColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].ExternalColumns[VolumeMountPoint]" dataType="wstr" length="128" name="VolumeMountPoint" />
                  <externalMetadataColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].ExternalColumns[FreePercent]" dataType="i4" name="FreePercent" />
                  <externalMetadataColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].ExternalColumns[AvailableGb]" dataType="i4" name="AvailableGb" />
                  <externalMetadataColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].ExternalColumns[DatabaseName]" dataType="wstr" length="128" name="DatabaseName" />
                  <externalMetadataColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].ExternalColumns[FileTypeCode]" dataType="wstr" length="10" name="FileTypeCode" />
                  <externalMetadataColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Output].ExternalColumns[ProjectedGb]" dataType="i4" name="ProjectedGb" />
                </externalMetadataColumns>
              </output>
              <output refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output]" isErrorOut="true" name="OLE DB Source Error Output">
                <outputColumns>
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[VolumeMountPoint]" dataType="wstr" length="128" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[VolumeMountPoint]" name="VolumeMountPoint" />
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[FreePercent]" dataType="i4" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[FreePercent]" name="FreePercent" />
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[AvailableGb]" dataType="i4" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[AvailableGb]" name="AvailableGb" />
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[DatabaseName]" dataType="wstr" length="128" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[DatabaseName]" name="DatabaseName" />
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[FileTypeCode]" dataType="wstr" length="10" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[FileTypeCode]" name="FileTypeCode" />
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[ProjectedGb]" dataType="i4" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[ProjectedGb]" name="ProjectedGb" />
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[ErrorCode]" dataType="i4" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[ErrorCode]" name="ErrorCode" specialFlags="1" />
                  <outputColumn refId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[ErrorColumn]" dataType="i4" lineageId="Package\Evaluate Preflight\work VolumeSpaceCheck.Outputs[OLE DB Source Error Output].Columns[ErrorColumn]" name="ErrorColumn" specialFlags="1" />
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
          <component refId="Package\Evaluate Preflight\Evaluate Thresholds" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Evaluate Thresholds" usesDispositions="true">
            <inputs>
              <input refId="Package\Evaluate Preflight\Evaluate Thresholds.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Evaluate Preflight\Evaluate Thresholds.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Evaluate Preflight\Evaluate Thresholds.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Evaluate Preflight\Evaluate Thresholds.Outputs[Derived Column Output].Columns[HasShortfall]" dataType="bool" lineageId="Package\Evaluate Preflight\Evaluate Thresholds.Outputs[Derived Column Output].Columns[HasShortfall]" name="HasShortfall">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">FreePercent &lt; @[$Package::MinimumFreePercent] || AvailableGb &lt; ProjectedGb ? (DT_BOOL)1 : (DT_BOOL)0</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">FreePercent &lt; @[$Package::MinimumFreePercent] || AvailableGb &lt; ProjectedGb ? (DT_BOOL)1 : (DT_BOOL)0</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Evaluate Preflight\Evaluate Thresholds.Outputs[Derived Column Output].Columns[SeverityCode]" dataType="wstr" length="10" lineageId="Package\Evaluate Preflight\Evaluate Thresholds.Outputs[Derived Column Output].Columns[SeverityCode]" name="SeverityCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">FreePercent &lt; (@[$Package::MinimumFreePercent] / 2) ? (DT_WSTR,10)"CRITICAL" : (FreePercent &lt; @[$Package::MinimumFreePercent] ? (DT_WSTR,10)"WARNING" : (DT_WSTR,10)"OK")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">FreePercent &lt; (@[$Package::MinimumFreePercent] / 2) ? (DT_WSTR,10)"CRITICAL" : (FreePercent &lt; @[$Package::MinimumFreePercent] ? (DT_WSTR,10)"WARNING" : (DT_WSTR,10)"OK")</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Evaluate Preflight\Evaluate Thresholds.Outputs[Derived Column Output].Columns[HeadroomGb]" dataType="i4" lineageId="Package\Evaluate Preflight\Evaluate Thresholds.Outputs[Derived Column Output].Columns[HeadroomGb]" name="HeadroomGb">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">AvailableGb - ProjectedGb</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">AvailableGb - ProjectedGb</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
