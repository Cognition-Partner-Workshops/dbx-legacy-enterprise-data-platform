    <DTS:Executable
      DTS:refId="Package\Measure Shortfalls"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D7F554F8-8A69-2659-0049-6D71DDC442E9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Shortfalls"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS LowVolumes,        ISNULL(MIN(FreePercent), 100) AS SmallestFreePercent,        CASE WHEN COUNT(*) = 0 THEN N'OK'             WHEN MIN(FreePercent) &lt; 5 THEN N'CRITICAL' ELSE N'WARNING' END AS Status FROM   work.VolumeShortfall;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::LowVolumeCount" />
        <SQLTask:ResultBinding SQLTask:ResultName="1" SQLTask:DtsVariableName="User::SmallestFreePercent" />
        <SQLTask:ResultBinding SQLTask:ResultName="2" SQLTask:DtsVariableName="User::PreflightStatus" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Raise Batch Hold"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{207F5638-5AEE-B33A-FCF7-063E8748D87E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Raise Batch Hold"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO etl.BatchHold (HoldReasonCode, HoldDetail, RaisedAtUtc, IsCleared) SELECT N'DISK_SPACE',        CONCAT(N'Volumes below the free-space threshold: ', CAST(? AS nvarchar(10)),               N'; smallest free percent: ', CAST(? AS nvarchar(10))),        SYSUTCDATETIME(), 0;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::LowVolumeCount" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="User::SmallestFreePercent" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Check Tempdb Headroom"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{440FC3A2-F600-BC00-9516-15F3AACDA489}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Check Tempdb Headroom"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="INSERT INTO etl.PreflightResult (CheckName, CheckStatus, DetailText, CheckedAtUtc) SELECT N'TEMPDB_HEADROOM',        CASE WHEN SUM(vs.available_bytes) / 1073741824 &lt; ? THEN N'FAILED' ELSE N'OK' END,        CONCAT(N'Tempdb volume free GB: ',               CAST(SUM(vs.available_bytes) / 1073741824 AS nvarchar(20))),        SYSUTCDATETIME() FROM   sys.master_files AS f CROSS APPLY sys.dm_os_volume_stats(f.database_id, f.file_id) AS vs WHERE  f.database_id = DB_ID(N'tempdb');"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::MinimumFreeGbTempdb" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Log Row Counts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F41C9678-F52A-5CFF-3FAA-181DE511DC84}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Row Counts"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogRowCount @PackageExecutionId = ?, @ObjectName = N'work.VolumeSpaceCheck', @SourceRowCount = ?, @TargetRowCount = ?, @RejectRowCount = ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
