  DTS:Description="Statistics refresh after the nightly load. Statistics on the incrementally loaded fact tables are sampled, the slowly changing dimensions are updated with a full scan because the optimiser kept choosing bad plans for the type-2 date predicates, and anything untouched by the batch is skipped so the window is not wasted."
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="13.0.4001.0"
  DTS:LocaleID="1033"
  DTS:ObjectName="MNT_Update_Statistics"
