    <DTS:Executable
      DTS:refId="Package\Truncate work.StatisticsRefreshPlan"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0EF45873-30F5-B421-469C-7B607D4EF157}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Truncate work.StatisticsRefreshPlan"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="TRUNCATE TABLE work.StatisticsRefreshPlan;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Plan Statistics Refresh"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3ACB168E-4F0B-207F-7C18-703548E335DC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Plan Statistics Refresh"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="INSERT INTO work.StatisticsRefreshPlan&#10;    (SchemaName, TableName, StatisticsName, ModifiedRowCount, RefreshMode)&#10;SELECT  SCHEMA_NAME(o.schema_id)&#10;,       o.name&#10;,       st.name&#10;,       sp.modification_counter&#10;,       CASE WHEN o.name LIKE N'Dim%' THEN N'FULLSCAN' ELSE N'SAMPLE' END&#10;FROM    sys.stats AS st&#10;INNER JOIN sys.objects AS o ON o.object_id = st.object_id&#10;CROSS APPLY sys.dm_db_stats_properties(st.object_id, st.stats_id) AS sp&#10;WHERE   o.is_ms_shipped = 0&#10;AND     sp.modification_counter &gt;= ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="1800"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::ModificationThresholdRows" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Refresh Statistics"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{21EBFAAE-BFFE-9B13-A44D-DE371700A6E6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Refresh Statistics"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DECLARE @Schema sysname, @Table sysname, @Stat sysname, @Mode nvarchar(20),&#10;        @Sample int = ?, @Sql nvarchar(max);&#10;DECLARE StatsCursor CURSOR LOCAL FAST_FORWARD FOR&#10;    SELECT SchemaName, TableName, StatisticsName, RefreshMode&#10;    FROM   work.StatisticsRefreshPlan ORDER BY ModifiedRowCount DESC;&#10;OPEN StatsCursor;&#10;FETCH NEXT FROM StatsCursor INTO @Schema, @Table, @Stat, @Mode;&#10;WHILE @@FETCH_STATUS = 0&#10;BEGIN&#10;    SET @Sql = N'UPDATE STATISTICS ' + QUOTENAME(@Schema) + N'.' + QUOTENAME(@Table)&#10;             + N' ' + QUOTENAME(@Stat)&#10;             + CASE WHEN @Mode = N'FULLSCAN' THEN N' WITH FULLSCAN;'&#10;                    ELSE N' WITH SAMPLE ' + CAST(@Sample AS nvarchar(10))&#10;                         + N' PERCENT;' END;&#10;    EXEC sp_executesql @Sql;&#10;    FETCH NEXT FROM StatsCursor INTO @Schema, @Table, @Stat, @Mode;&#10;END&#10;CLOSE StatsCursor; DEALLOCATE StatsCursor;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::SamplePercent" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Measure Statistics Refresh"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BC537A17-D2AC-3025-044D-28F87783C3B5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Statistics Refresh"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="SELECT COUNT(*) AS Refreshed,        SUM(CASE WHEN RefreshMode = N'FULLSCAN' THEN 1 ELSE 0 END) AS FullScans FROM   work.StatisticsRefreshPlan;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::StatisticsUpdatedCount" />
        <SQLTask:ResultBinding SQLTask:ResultName="1" SQLTask:DtsVariableName="User::FullScanCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Log Statistics Outcome"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6204CC10-0555-44D5-EBC9-AC99C0510F7C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Statistics Outcome"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO etl.MaintenanceLog (TaskName, DetailText, RecordedAtUtc) SELECT N'MNT_Update_Statistics',        CONCAT(N'Statistics refreshed: ', CAST(? AS nvarchar(20))), SYSUTCDATETIME();"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
