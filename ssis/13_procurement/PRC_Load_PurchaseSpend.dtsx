    <DTS:Executable
      DTS:refId="Package\Load Purchase Spend"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{A3697E04-2002-DA6F-D808-E51663AB77E9}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Purchase Spend"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Load Purchase Spend\stg PurchaseOrderLine" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="stg PurchaseOrderLine" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  pol.PurchaseOrderLineId
,       pol.PurchaseOrderNumber
,       pol.LineNumber
,       poh.SupplierId
,       poh.OrderDate
,       poh.BuyerPersonId
,       poh.RegionCode
,       poh.CurrencyCode
,       pol.StockItemId
,       pol.OrderedOuters
,       pol.ExpectedUnitPricePerOuter
,       pol.OrderedOuters * pol.ExpectedUnitPricePerOuter       AS OrderedAmount
,       pol.ReceivedOuters
,       pol.IsOrderLineFinalized
,       pol.CategoryCode
,       vc.ContractNumber
,       vc.ContractPricePerOuter
,       vc.ContractStartDate
,       vc.ContractEndDate
        /* The ERP contract key changed format in 2013 but the old numbers were
           never migrated, so both shapes have to be matched. */
,       CASE
            WHEN vc.ContractNumber IS NOT NULL              THEN vc.ContractNumber
            WHEN pol.LegacyContractRef LIKE 'C-%'           THEN pol.LegacyContractRef
            WHEN pol.LegacyContractRef LIKE '[0-9][0-9][0-9][0-9][0-9]'
                THEN 'C-' + pol.LegacyContractRef
            ELSE NULL
        END                                                     AS ResolvedContractNumber
FROM    stg.PurchaseOrderLine AS pol
INNER JOIN stg.PurchaseOrderHeader AS poh
        ON  poh.PurchaseOrderNumber = pol.PurchaseOrderNumber
LEFT OUTER JOIN stg.VendorContract AS vc
        ON  vc.SupplierId = poh.SupplierId
        AND vc.CategoryCode = pol.CategoryCode
        AND poh.OrderDate BETWEEN vc.ContractStartDate AND ISNULL(vc.ContractEndDate, '9999-12-31')
WHERE   pol.LoadBatchId = ?
AND     poh.OrderStatusCode NOT IN ('CANC', 'DRAFT')</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Load Purchase Spend\stg PurchaseOrderLine.Connections[OleDbConnection]" connectionManagerID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Staging_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[PurchaseOrderLineId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].ExternalColumns[PurchaseOrderLineId]" lineageId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[PurchaseOrderLineId]" name="PurchaseOrderLineId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[PurchaseOrderNumber]" dataType="wstr" length="20" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].ExternalColumns[PurchaseOrderNumber]" lineageId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[PurchaseOrderNumber]" name="PurchaseOrderNumber" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[LineNumber]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].ExternalColumns[LineNumber]" lineageId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[LineNumber]" name="LineNumber" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[SupplierId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].ExternalColumns[SupplierId]" lineageId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[SupplierId]" name="SupplierId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[OrderDate]" dataType="dbTimeStamp" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].ExternalColumns[OrderDate]" lineageId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[OrderDate]" name="OrderDate" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[BuyerPersonId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].ExternalColumns[BuyerPersonId]" lineageId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[BuyerPersonId]" name="BuyerPersonId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[CurrencyCode]" dataType="wstr" length="3" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].ExternalColumns[CurrencyCode]" lineageId="Package\Load Purchase Spend\stg PurchaseOrderLine.Outputs[OLE DB Source Output].Columns[CurrencyCode]" name="CurrencyCode" truncationRowDisposition="RedirectRow" />
