            </inputs>
            <outputs>
              <output refId="Package\Load Purchase Spend\Classify Spend.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Load Purchase Spend\Classify Spend.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Load Purchase Spend\Classify Spend.Outputs[Derived Column Output].Columns[PriceVariancePercent]" dataType="numeric" precision="18" scale="2" lineageId="Package\Load Purchase Spend\Classify Spend.Outputs[Derived Column Output].Columns[PriceVariancePercent]" name="PriceVariancePercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(ContractPricePerOuter) || ContractPricePerOuter == 0 ? (DT_NUMERIC,18,2)0 : (ExpectedUnitPricePerOuter - ContractPricePerOuter) * 100 / ContractPricePerOuter</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(ContractPricePerOuter) || ContractPricePerOuter == 0 ? (DT_NUMERIC,18,2)0 : (ExpectedUnitPricePerOuter - ContractPricePerOuter) * 100 / ContractPricePerOuter</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Load Purchase Spend\Classify Spend.Outputs[Derived Column Output].Columns[SpendClassCode]" dataType="wstr" length="12" lineageId="Package\Load Purchase Spend\Classify Spend.Outputs[Derived Column Output].Columns[SpendClassCode]" name="SpendClassCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(ResolvedContractNumber) ? (DT_WSTR,12)"MAVERICK" : (ISNULL(ContractPricePerOuter) ? (DT_WSTR,12)"OFFCONTRACT" : (DT_WSTR,12)"ONCONTRACT")</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(ResolvedContractNumber) ? (DT_WSTR,12)"MAVERICK" : (ISNULL(ContractPricePerOuter) ? (DT_WSTR,12)"OFFCONTRACT" : (DT_WSTR,12)"ONCONTRACT")</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
