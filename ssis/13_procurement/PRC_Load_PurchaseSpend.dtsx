                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(ContractPricePerOuter) ? OrderedAmount : OrderedOuters * ContractPricePerOuter</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ISNULL(ContractPricePerOuter) ? OrderedAmount : OrderedOuters * ContractPricePerOuter</property>
