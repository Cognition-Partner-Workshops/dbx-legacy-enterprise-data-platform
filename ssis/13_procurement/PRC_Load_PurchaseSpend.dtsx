    <DTS:Executable
      DTS:refId="Package\Measure Maverick Spend"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1477E803-E53E-C67D-8622-17A4FB3ED310}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Maverick Spend"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT SUM(CASE WHEN SpendClassCode &lt;&gt; N'ONCONTRACT' THEN 1 ELSE 0 END) AS OffContractLines,        ISNULL(SUM(CASE WHEN SpendClassCode = N'MAVERICK' THEN OrderedAmount ELSE 0 END), 0)            AS MaverickAmount FROM work.PurchaseSpendLine;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::OffContractCount" />
        <SQLTask:ResultBinding SQLTask:ResultName="1" SQLTask:DtsVariableName="User::MaverickSpendAmount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
