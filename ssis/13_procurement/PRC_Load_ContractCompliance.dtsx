    <DTS:Executable
      DTS:refId="Package\Truncate work_ContractCompliance"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{97E41788-5EB3-C976-FF48-339CF9072802}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Truncate work_ContractCompliance"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="TRUNCATE TABLE work.ContractCompliance;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Evaluate Contract Compliance"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{083DDE40-DB9D-6246-F233-A8A8AA27458D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Evaluate Contract Compliance"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.ContractCompliance&#10;    (PurchaseOrderNumber, LineNumber, SupplierId, CategoryCode, OrderDate, OrderedAmount,&#10;     ContractNumber, ContractPricePerOuter, ComplianceStatusCode, LeakageAmount)&#10;SELECT  pol.PurchaseOrderNumber&#10;,       pol.LineNumber&#10;,       poh.SupplierId&#10;,       pol.CategoryCode&#10;,       poh.OrderDate&#10;,       pol.OrderedOuters * pol.ExpectedUnitPricePerOuter&#10;,       vc.ContractNumber&#10;,       vc.ContractPricePerOuter&#10;,       CASE&#10;            WHEN vc.ContractNumber IS NULL&#10;                 AND EXISTS (SELECT 1 FROM stg.VendorContract AS alt&#10;                             WHERE alt.CategoryCode = pol.CategoryCode&#10;                               AND alt.IsPreferred = 1&#10;                               AND poh.OrderDate BETWEEN alt.ContractStartDate&#10;                                   AND ISNULL(alt.ContractEndDate, '9999-12-31'))&#10;                THEN N'NON_PREFERRED'&#10;            WHEN vc.ContractNumber IS NULL THEN N'NO_CONTRACT'&#10;            WHEN poh.OrderDate &gt; ISNULL(vc.ContractEndDate, '9999-12-31')&#10;                THEN N'EXPIRED_CONTRACT'&#10;            WHEN pol.ExpectedUnitPricePerOuter &gt;&#10;                 vc.ContractPricePerOuter * (1 + (? / 100.0))&#10;                THEN N'PRICE_LEAKAGE'&#10;            ELSE N'COMPLIANT'&#10;        END&#10;,       CASE WHEN vc.ContractPricePerOuter IS NULL THEN 0&#10;             ELSE CASE WHEN pol.ExpectedUnitPricePerOuter &gt; vc.ContractPricePerOuter&#10;                       THEN (pol.ExpectedUnitPricePerOuter - vc.ContractPricePerOuter)&#10;                            * pol.OrderedOuters&#10;                       ELSE 0 END&#10;        END&#10;FROM    stg.PurchaseOrderLine AS pol&#10;INNER JOIN stg.PurchaseOrderHeader AS poh&#10;        ON  poh.PurchaseOrderNumber = pol.PurchaseOrderNumber&#10;LEFT OUTER JOIN stg.VendorContract AS vc&#10;        ON  vc.SupplierId = poh.SupplierId&#10;        AND vc.CategoryCode = pol.CategoryCode&#10;WHERE   poh.OrderDate &gt;= DATEADD(DAY, -?, CAST(SYSDATETIME() AS date));"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::PriceLeakageTolerance" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::ComplianceWindowDays" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Measure Leakage"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FB683AD9-397F-3CC9-3053-0E9B284E4ADE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Measure Leakage"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT ISNULL(SUM(LeakageAmount), 0) AS Leakage,        SUM(CASE WHEN ComplianceStatusCode = N'EXPIRED_CONTRACT' THEN 1 ELSE 0 END)            AS ExpiredContracts FROM work.ContractCompliance;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::LeakageAmount" />
        <SQLTask:ResultBinding SQLTask:ResultName="1" SQLTask:DtsVariableName="User::ExpiredContractCount" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Publish Compliance To Scorecard"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5DBC3542-9ADE-5092-69A2-F84FA0D6CD49}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Publish Compliance To Scorecard"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="UPDATE sp&#10;SET    sp.[Off Contract Spend Amount] = c.OffContractAmount&#10;,      sp.[Leakage Amount] = c.LeakageAmount&#10;,      sp.[Compliance Percent] = CASE WHEN c.TotalAmount = 0 THEN 100&#10;            ELSE (c.TotalAmount - c.OffContractAmount) * 100 / c.TotalAmount END&#10;FROM   Aggregate.[Supplier Performance] AS sp&#10;INNER JOIN (SELECT SupplierId,&#10;                   SUM(OrderedAmount) AS TotalAmount,&#10;                   SUM(CASE WHEN ComplianceStatusCode &lt;&gt; N'COMPLIANT'&#10;                            THEN OrderedAmount ELSE 0 END) AS OffContractAmount,&#10;                   SUM(LeakageAmount) AS LeakageAmount&#10;            FROM   work.ContractCompliance&#10;            GROUP BY SupplierId) AS c&#10;        ON c.SupplierId = sp.[WWI Supplier ID];"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Raise Non Compliant Lines"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C51376B5-597F-0E9D-6189-F605B4FFBEF7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Raise Non Compliant Lines"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO etl.RejectedRecord     (BatchId, ObjectName, RejectStage, RejectReasonCode, RejectReason,      BusinessKey, LoggedAtUtc, IsReprocessed) SELECT ?, N'stg.VendorContract', N'Fact', ComplianceStatusCode,        N'Purchase line failed contract compliance',        CONCAT(PurchaseOrderNumber, N'|', CAST(LineNumber AS nvarchar(10))),        SYSUTCDATETIME(), 0 FROM   work.ContractCompliance WHERE ComplianceStatusCode &lt;&gt; N'COMPLIANT';"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Log Row Counts"
