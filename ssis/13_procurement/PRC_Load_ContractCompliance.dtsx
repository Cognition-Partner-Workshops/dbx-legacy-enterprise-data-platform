        SQLTask:SqlStatementSource="EXEC etl.usp_LogRowCount @PackageExecutionId = ?, @ObjectName = N'Aggregate.Supplier Performance', @SourceRowCount = ?, @TargetRowCount = ?, @RejectRowCount = ?;"
        SQLTask:ResultType="ResultSetType_None"
