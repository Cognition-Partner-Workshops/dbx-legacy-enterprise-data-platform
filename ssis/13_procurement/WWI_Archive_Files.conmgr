<?xml version="1.0"?>
<DTS:ConnectionManager xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:ObjectName="WWI_Archive_Files"
  DTS:DTSID="{FC358E93-2E40-3B67-98CB-5CBF80721ACA}"
