                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ISNULL(InvoicedUnitPrice) ? (DT_NUMERIC,18,2)0 : InvoicedUnitPrice - ExpectedUnitPricePerOuter</property>
