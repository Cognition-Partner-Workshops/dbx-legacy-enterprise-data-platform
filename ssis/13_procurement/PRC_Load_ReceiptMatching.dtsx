    <DTS:Executable
      DTS:refId="Package\Match Receipts"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{7B001849-170C-FF11-68C1-660943B465E2}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Match Receipts"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Match Receipts\stg Receipt" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="stg Receipt" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT  r.ReceiptId
,       r.ReceiptNumber
,       r.PurchaseOrderNumber
,       r.LineNumber
,       r.ReceivedAtUtc
,       r.ReceivedOuters
,       r.WarehouseSiteCode
,       pol.OrderedOuters
,       pol.ExpectedUnitPricePerOuter
,       ail.InvoicedOuters
,       ail.InvoicedUnitPrice
,       ail.ApInvoiceNumber
,       poh.SupplierId
,       poh.RegionCode
        /* Three-way match tolerances: quantity tolerance is a percentage,
           price tolerance is both a percentage and an absolute floor so that
           low-value lines do not fail on rounding. */
,       ISNULL(tol.QuantityTolerancePercent, 2)         AS QuantityTolerancePercent
,       ISNULL(tol.PriceTolerancePercent, 3)            AS PriceTolerancePercent
,       ISNULL(tol.PriceToleranceAbsolute, 1.00)        AS PriceToleranceAbsolute
FROM    stg.Receipt AS r
INNER JOIN stg.PurchaseOrderLine AS pol
        ON  pol.PurchaseOrderNumber = r.PurchaseOrderNumber
        AND pol.LineNumber = r.LineNumber
INNER JOIN stg.PurchaseOrderHeader AS poh
        ON  poh.PurchaseOrderNumber = r.PurchaseOrderNumber
LEFT OUTER JOIN stg.ApInvoiceLine AS ail
        ON  ail.PurchaseOrderNumber = r.PurchaseOrderNumber
        AND ail.PurchaseOrderLineNumber = r.LineNumber
LEFT OUTER JOIN stg.MatchTolerance AS tol
        ON  tol.RegionCode = poh.RegionCode
        AND tol.CategoryCode = pol.CategoryCode
WHERE   r.LoadBatchId = ?</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Match Receipts\stg Receipt.Connections[OleDbConnection]" connectionManagerID="{E4540100-D4C7-0578-F0D3-C329706F8FFE}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_Staging_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[ReceiptId]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].ExternalColumns[ReceiptId]" lineageId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[ReceiptId]" name="ReceiptId" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[ReceiptNumber]" dataType="wstr" length="20" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].ExternalColumns[ReceiptNumber]" lineageId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[ReceiptNumber]" name="ReceiptNumber" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[PurchaseOrderNumber]" dataType="wstr" length="20" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].ExternalColumns[PurchaseOrderNumber]" lineageId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[PurchaseOrderNumber]" name="PurchaseOrderNumber" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[LineNumber]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].ExternalColumns[LineNumber]" lineageId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[LineNumber]" name="LineNumber" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[ReceivedAtUtc]" dataType="dbTimeStamp" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].ExternalColumns[ReceivedAtUtc]" lineageId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[ReceivedAtUtc]" name="ReceivedAtUtc" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[ReceivedOuters]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].ExternalColumns[ReceivedOuters]" lineageId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[ReceivedOuters]" name="ReceivedOuters" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[WarehouseSiteCode]" dataType="wstr" length="10" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].ExternalColumns[WarehouseSiteCode]" lineageId="Package\Match Receipts\stg Receipt.Outputs[OLE DB Source Output].Columns[WarehouseSiteCode]" name="WarehouseSiteCode" truncationRowDisposition="RedirectRow" />
