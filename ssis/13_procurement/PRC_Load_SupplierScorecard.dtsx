                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">OrderCount == 0 ? (DT_NUMERIC,18,2)0 : OnTimeCount * 100 / OrderCount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">OrderCount == 0 ? (DT_NUMERIC,18,2)0 : OnTimeCount * 100 / OrderCount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Score Suppliers\Derive Component Scores.Outputs[Derived Column Output].Columns[AccuracyPercent]" dataType="numeric" precision="18" scale="2" lineageId="Package\Score Suppliers\Derive Component Scores.Outputs[Derived Column Output].Columns[AccuracyPercent]" name="AccuracyPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">OrderCount == 0 ? (DT_NUMERIC,18,2)0 : QuantityAccurateCount * 100 / OrderCount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">OrderCount == 0 ? (DT_NUMERIC,18,2)0 : QuantityAccurateCount * 100 / OrderCount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Score Suppliers\Derive Component Scores.Outputs[Derived Column Output].Columns[PricePercent]" dataType="numeric" precision="18" scale="2" lineageId="Package\Score Suppliers\Derive Component Scores.Outputs[Derived Column Output].Columns[PricePercent]" name="PricePercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">OrderCount == 0 ? (DT_NUMERIC,18,2)0 : PriceAdherentCount * 100 / OrderCount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">OrderCount == 0 ? (DT_NUMERIC,18,2)0 : PriceAdherentCount * 100 / OrderCount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Score Suppliers\Derive Component Scores.Outputs[Derived Column Output].Columns[QualityPercent]" dataType="numeric" precision="18" scale="2" lineageId="Package\Score Suppliers\Derive Component Scores.Outputs[Derived Column Output].Columns[QualityPercent]" name="QualityPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">OrderCount == 0 ? (DT_NUMERIC,18,2)0 : (OrderCount - QualityRejectCount) * 100 / OrderCount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">OrderCount == 0 ? (DT_NUMERIC,18,2)0 : (OrderCount - QualityRejectCount) * 100 / OrderCount</property>
                    </properties>
                  </outputColumn>
