    <DTS:Executable
      DTS:refId="Package\Build Scorecard Measures"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B42E5C70-DDD5-0609-7D60-F08B2CDC28F4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Scorecard Measures"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO work.SupplierScorecard&#10;    (SupplierId, RegionCode, OrderCount, OnTimeCount, QuantityAccurateCount,&#10;     PriceAdherentCount, QualityRejectCount, InvoiceExceptionCount, WindowDays)&#10;SELECT  s.SupplierId&#10;,       s.RegionCode&#10;,       COUNT(DISTINCT r.PurchaseOrderNumber)&#10;,       SUM(CASE WHEN r.ReceivedAtUtc &lt;= pol.PromisedDate THEN 1 ELSE 0 END)&#10;,       SUM(CASE WHEN r.ReceivedOuters = pol.OrderedOuters THEN 1 ELSE 0 END)&#10;,       SUM(CASE WHEN ABS(ISNULL(ail.InvoicedUnitPrice, pol.ExpectedUnitPricePerOuter)&#10;                          - pol.ExpectedUnitPricePerOuter) &lt; 0.005 THEN 1 ELSE 0 END)&#10;,       SUM(CASE WHEN r.QualityStatusCode = N'REJECT' THEN 1 ELSE 0 END)&#10;,       SUM(CASE WHEN ail.ApInvoiceNumber IS NULL THEN 1 ELSE 0 END)&#10;,       ?&#10;FROM    stg.Supplier AS s&#10;INNER JOIN stg.PurchaseOrderHeader AS poh ON poh.SupplierId = s.SupplierId&#10;INNER JOIN stg.PurchaseOrderLine AS pol&#10;        ON  pol.PurchaseOrderNumber = poh.PurchaseOrderNumber&#10;LEFT OUTER JOIN stg.Receipt AS r&#10;        ON  r.PurchaseOrderNumber = pol.PurchaseOrderNumber&#10;        AND r.LineNumber = pol.LineNumber&#10;LEFT OUTER JOIN stg.ApInvoiceLine AS ail&#10;        ON  ail.PurchaseOrderNumber = pol.PurchaseOrderNumber&#10;        AND ail.PurchaseOrderLineNumber = pol.LineNumber&#10;WHERE   poh.OrderDate &gt;= DATEADD(DAY, -?, CAST(SYSDATETIME() AS date))&#10;GROUP BY s.SupplierId, s.RegionCode;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::ScoringWindowDays" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::ScoringWindowDays" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
