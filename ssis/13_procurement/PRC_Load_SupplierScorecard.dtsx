            <outputs>
              <output refId="Package\Score Suppliers\Derive Component Scores.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Score Suppliers\Derive Component Scores.Inputs[Derived Column Input]">
                <outputColumns>
