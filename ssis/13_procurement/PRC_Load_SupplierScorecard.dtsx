          <component refId="Package\Score Suppliers\Derive Weighted Score" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Weighted Score" usesDispositions="true">
            <inputs>
              <input refId="Package\Score Suppliers\Derive Weighted Score.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Score Suppliers\Derive Weighted Score.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Score Suppliers\Derive Weighted Score.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Score Suppliers\Derive Weighted Score.Outputs[Derived Column Output].Columns[SupplierScore]" dataType="numeric" precision="18" scale="2" lineageId="Package\Score Suppliers\Derive Weighted Score.Outputs[Derived Column Output].Columns[SupplierScore]" name="SupplierScore">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(OnTimePercent * ISNULL(OnTimeWeight) ? 0.4 : OnTimeWeight) + (AccuracyPercent * (ISNULL(AccuracyWeight) ? 0.2 : AccuracyWeight)) + (PricePercent * (ISNULL(PriceWeight) ? 0.2 : PriceWeight)) + (QualityPercent * (ISNULL(QualityWeight) ? 0.2 : QualityWeight))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(OnTimePercent * ISNULL(OnTimeWeight) ? 0.4 : OnTimeWeight) + (AccuracyPercent * (ISNULL(AccuracyWeight) ? 0.2 : AccuracyWeight)) + (PricePercent * (ISNULL(PriceWeight) ? 0.2 : PriceWeight)) + (QualityPercent * (ISNULL(QualityWeight) ? 0.2 : QualityWeight))</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Score Suppliers\Derive Weighted Score.Outputs[Derived Column Output].Columns[ScoreBandCode]" dataType="wstr" length="8" lineageId="Package\Score Suppliers\Derive Weighted Score.Outputs[Derived Column Output].Columns[ScoreBandCode]" name="ScoreBandCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">OrderCount &lt; @[$Package::MinimumOrdersForScore] ? (DT_WSTR,8)"NODATA" : (OnTimePercent &gt;= 95 ? (DT_WSTR,8)"A" : (OnTimePercent &gt;= 85 ? (DT_WSTR,8)"B" : (OnTimePercent &gt;= 70 ? (DT_WSTR,8)"C" : (DT_WSTR,8)"D")))</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">OrderCount &lt; @[$Package::MinimumOrdersForScore] ? (DT_WSTR,8)"NODATA" : (OnTimePercent &gt;= 95 ? (DT_WSTR,8)"A" : (OnTimePercent &gt;= 85 ? (DT_WSTR,8)"B" : (OnTimePercent &gt;= 70 ? (DT_WSTR,8)"C" : (DT_WSTR,8)"D")))</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
