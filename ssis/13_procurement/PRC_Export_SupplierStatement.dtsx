    <DTS:Executable
      DTS:refId="Package\Build Statement Lines"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{CD5E8783-A761-8A3D-E17B-D47D3A48B9DC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Statement Lines"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="INSERT INTO work.SupplierStatementLine&#10;    (SupplierId, SupplierName, RegionCode, StatementPeriod, TransactionTypeCode,&#10;     TransactionDate, TransactionReference, TransactionAmount, CurrencyCode, VatAmount)&#10;SELECT  s.[WWI Supplier ID]&#10;,       s.[Supplier Name]&#10;,       s.[Region Code]&#10;,       ?&#10;,       t.[Transaction Type Code]&#10;,       t.[Transaction Date]&#10;,       t.[Transaction Reference]&#10;,       t.[Transaction Amount]&#10;,       t.[Currency Code]&#10;,       CASE WHEN s.[Region Code] = N'EU' THEN t.[Tax Amount] ELSE NULL END&#10;FROM    Fact.[Supplier Transaction] AS t&#10;INNER JOIN Dimension.Supplier AS s ON s.[Supplier Key] = t.[Supplier Key]&#10;WHERE   CONVERT(char(7), t.[Transaction Date], 126) = ?&#10;AND     (? = 0 OR ISNULL(s.[Is Self Billing], 0) = 0);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::StatementPeriod" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::StatementPeriod" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::ExcludeSelfBilling" SQLTask:ParameterDirection="Input" SQLTask:DataType="BYTE" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Compute Statement Balances"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5285F37C-F1BB-DA11-A318-BD6EBA117F70}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Compute Statement Balances"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="UPDATE l&#10;SET    l.RunningBalance = b.RunningBalance&#10;FROM   work.SupplierStatementLine AS l&#10;INNER JOIN (SELECT SupplierStatementLineId,&#10;                   SUM(TransactionAmount) OVER (PARTITION BY SupplierId&#10;                                                ORDER BY TransactionDate,&#10;                                                         SupplierStatementLineId&#10;                                                ROWS UNBOUNDED PRECEDING) AS RunningBalance&#10;            FROM   work.SupplierStatementLine) AS b&#10;        ON b.SupplierStatementLineId = l.SupplierStatementLineId;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Build Statement File Name"
