      DTS:Description="Expression Task"
      DTS:DTSID="{1504E7CD-C587-80DE-7988-9AE3C3074DC9}"
      DTS:ExecutableType="Microsoft.ExpressionTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Build Statement File Name"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <ExpressionTask Expression='@[User::StatementFileName] = "supplier_statement_" + @[$Package::StatementPeriod] + ".csv"' />
      </DTS:ObjectData>
    </DTS:Executable>
