    <DTS:Executable
      DTS:refId="Package\Delete Refresh Window"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{43A283D9-ADCF-5ED8-6739-AF978B26D705}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Delete Refresh Window"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE a FROM [Aggregate].[Daily Sales Summary] AS a INNER JOIN Dimension.Date AS d ON d.[Date Key] = a.[Invoice Date Key] WHERE d.[Date] &gt;= CAST(? AS date) AND d.[Date] &lt;= CAST(? AS date);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::RefreshFromDate" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::RefreshToDate" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Rebuild Daily Sales Summary"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{05F3FAB8-1760-E2AA-BFC7-90E7C36A5940}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Rebuild Daily Sales Summary"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Rebuild Daily Sales Summary\Fact Sale Window" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="Fact Sale Window" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT f.[Invoice Date Key] AS InvoiceDateKey, c.[Region Code] AS RegionCode, ISNULL(f.[Sales Channel Code], N'DIRECT') AS SalesChannelCode, COUNT(DISTINCT f.[Customer Key]) AS CustomerCount, COUNT_BIG(*) AS InvoiceLineCount, SUM(f.[Gross Amount]) AS GrossAmount, SUM(f.[Discount Amount]) AS DiscountAmount, SUM(f.[Net Amount]) AS NetAmount, SUM(f.[Tax Amount]) AS TaxAmount, SUM(f.[Margin Amount]) AS MarginAmount FROM [Fact].[Sale] AS f INNER JOIN Dimension.Date AS d ON d.[Date Key] = f.[Invoice Date Key] INNER JOIN Dimension.Customer AS c ON c.[Customer Key] = f.[Customer Key] WHERE d.[Date] &gt;= CAST(? AS date) AND d.[Date] &lt;= CAST(? AS date) AND f.[Is Reversal] = 0 GROUP BY f.[Invoice Date Key], c.[Region Code], ISNULL(f.[Sales Channel Code], N'DIRECT');</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Rebuild Daily Sales Summary\Fact Sale Window.Connections[OleDbConnection]" connectionManagerID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_DW_Destination_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Rebuild Daily Sales Summary\Fact Sale Window.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Daily Sales Summary\Fact Sale Window.Outputs[OLE DB Source Output].Columns[InvoiceDateKey]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Daily Sales Summary\Fact Sale Window.Outputs[OLE DB Source Output].ExternalColumns[InvoiceDateKey]" lineageId="Package\Rebuild Daily Sales Summary\Fact Sale Window.Outputs[OLE DB Source Output].Columns[InvoiceDateKey]" name="InvoiceDateKey" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Daily Sales Summary\Fact Sale Window.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="6" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Daily Sales Summary\Fact Sale Window.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\Rebuild Daily Sales Summary\Fact Sale Window.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Daily Sales Summary\Fact Sale Window.Outputs[OLE DB Source Output].Columns[SalesChannelCode]" dataType="wstr" length="12" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Daily Sales Summary\Fact Sale Window.Outputs[OLE DB Source Output].ExternalColumns[SalesChannelCode]" lineageId="Package\Rebuild Daily Sales Summary\Fact Sale Window.Outputs[OLE DB Source Output].Columns[SalesChannelCode]" name="SalesChannelCode" truncationRowDisposition="RedirectRow" />
