                </externalMetadataColumns>
              </output>
              <output refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Error Output]" isErrorOut="true" name="OLE DB Source Error Output">
                <outputColumns>
