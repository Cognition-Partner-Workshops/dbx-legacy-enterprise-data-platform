    <DTS:Executable
      DTS:refId="Package\Delete Rolling Window Periods"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3C11188D-E359-99B1-77FC-ED8C12A3BB03}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Delete Rolling Window Periods"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE FROM [Aggregate].[Customer Rolling 12 Month] WHERE [Accounting Period Code] &gt;= FORMAT(DATEADD(MONTH, -11, CAST(? + '-01' AS date)), 'yyyy-MM')   AND [Accounting Period Code] &lt;= ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Rebuild Rolling 12 Month"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{89847D82-2FFB-6CB6-3173-F92C07EE2D82}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Rebuild Rolling 12 Month"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Rebuild Rolling 12 Month\Rolling Window Source" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="Rolling Window Source" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">7200</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT f.[Customer Key] AS CustomerKey, p.[Accounting Period Code] AS AccountingPeriodCode, c.[Region Code] AS RegionCode, SUM(f.[Net Amount]) AS RollingNetAmount, SUM(f.[Margin Amount]) AS RollingMarginAmount, COUNT(DISTINCT f.[Invoice Number]) AS RollingOrderCount, ISNULL(SUM(r.[Return Line Count]), 0) AS RollingReturnCount, ISNULL(SUM(r.[Return Net Amount]), 0) AS RollingReturnAmount, ISNULL(MAX(prior.[Rolling Net Amount]), 0) AS PriorRollingNetAmount FROM [Aggregate].[Period Calendar] AS p INNER JOIN Dimension.Date AS d         ON d.[Date] BETWEEN DATEADD(MONTH, -1 * ?, p.[Period End Date]) AND p.[Period End Date] INNER JOIN [Fact].[Sale] AS f ON f.[Invoice Date Key] = d.[Date Key] INNER JOIN Dimension.Customer AS c ON c.[Customer Key] = f.[Customer Key] LEFT JOIN [Aggregate].[Customer Return Position] AS r        ON r.[Customer Key] = f.[Customer Key]       AND r.[Accounting Period Code] = p.[Accounting Period Code] LEFT JOIN [Aggregate].[Customer Rolling 12 Month] AS prior        ON prior.[Customer Key] = f.[Customer Key]       AND prior.[Accounting Period Code] = FORMAT(DATEADD(MONTH, -1, p.[Period End Date]), 'yyyy-MM') WHERE p.[Accounting Period Code] &lt;= ?   AND p.[Accounting Period Code] &gt;= FORMAT(DATEADD(MONTH, -11, CAST(? + '-01' AS date)), 'yyyy-MM') GROUP BY f.[Customer Key], p.[Accounting Period Code], c.[Region Code];</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Connections[OleDbConnection]" connectionManagerID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_DW_Destination_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[CustomerKey]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[CustomerKey]" lineageId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[CustomerKey]" name="CustomerKey" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" dataType="wstr" length="7" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[AccountingPeriodCode]" lineageId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" name="AccountingPeriodCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="6" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[RollingNetAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[RollingNetAmount]" lineageId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[RollingNetAmount]" name="RollingNetAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[RollingMarginAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[RollingMarginAmount]" lineageId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[RollingMarginAmount]" name="RollingMarginAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[RollingOrderCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[RollingOrderCount]" lineageId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[RollingOrderCount]" name="RollingOrderCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[RollingReturnCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[RollingReturnCount]" lineageId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[RollingReturnCount]" name="RollingReturnCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[RollingReturnAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[RollingReturnAmount]" lineageId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[RollingReturnAmount]" name="RollingReturnAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[PriorRollingNetAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[PriorRollingNetAmount]" lineageId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].Columns[PriorRollingNetAmount]" name="PriorRollingNetAmount" truncationRowDisposition="RedirectRow" />
                </outputColumns>
                <externalMetadataColumns isUsed="True">
                  <externalMetadataColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[CustomerKey]" dataType="i4" name="CustomerKey" />
