                  <externalMetadataColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[RollingNetAmount]" dataType="numeric" precision="18" scale="2" name="RollingNetAmount" />
                  <externalMetadataColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[RollingMarginAmount]" dataType="numeric" precision="18" scale="2" name="RollingMarginAmount" />
                  <externalMetadataColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[RollingOrderCount]" dataType="i4" name="RollingOrderCount" />
                  <externalMetadataColumn refId="Package\Rebuild Rolling 12 Month\Rolling Window Source.Outputs[OLE DB Source Output].ExternalColumns[RollingReturnCount]" dataType="i4" name="RollingReturnCount" />
