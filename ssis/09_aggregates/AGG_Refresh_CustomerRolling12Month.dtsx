          <component refId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Rolling Trends" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Outputs[Derived Column Output].Columns[NetReturnRatePercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Outputs[Derived Column Output].Columns[NetReturnRatePercent]" name="NetReturnRatePercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RollingNetAmount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)RollingReturnAmount / (DT_NUMERIC,9,4)RollingNetAmount) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RollingNetAmount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)RollingReturnAmount / (DT_NUMERIC,9,4)RollingNetAmount) * 100</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Outputs[Derived Column Output].Columns[GrowthPercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Outputs[Derived Column Output].Columns[GrowthPercent]" name="GrowthPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">PriorRollingNetAmount == 0 ? (DT_NUMERIC,9,4)0 : (((DT_NUMERIC,9,4)RollingNetAmount - (DT_NUMERIC,9,4)PriorRollingNetAmount) / (DT_NUMERIC,9,4)PriorRollingNetAmount) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PriorRollingNetAmount == 0 ? (DT_NUMERIC,9,4)0 : (((DT_NUMERIC,9,4)RollingNetAmount - (DT_NUMERIC,9,4)PriorRollingNetAmount) / (DT_NUMERIC,9,4)PriorRollingNetAmount) * 100</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Outputs[Derived Column Output].Columns[TrendCode]" dataType="wstr" length="10" lineageId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Outputs[Derived Column Output].Columns[TrendCode]" name="TrendCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">PriorRollingNetAmount == 0 ? "NEW" : RollingNetAmount &gt; PriorRollingNetAmount * 1.1 ? "GROWING" : RollingNetAmount &lt; PriorRollingNetAmount * 0.9 ? "DECLINING" : "STABLE"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PriorRollingNetAmount == 0 ? "NEW" : RollingNetAmount &gt; PriorRollingNetAmount * 1.1 ? "GROWING" : RollingNetAmount &lt; PriorRollingNetAmount * 0.9 ? "DECLINING" : "STABLE"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Outputs[Derived Column Output].Columns[AverageMonthlyNetAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Outputs[Derived Column Output].Columns[AverageMonthlyNetAmount]" name="AverageMonthlyNetAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">((DT_NUMERIC,18,2)RollingNetAmount / (DT_NUMERIC,18,2)12)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">((DT_NUMERIC,18,2)RollingNetAmount / (DT_NUMERIC,18,2)12)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Outputs[Derived Column Output].Columns[RefreshedByLineageKey]" dataType="i8" lineageId="Package\Rebuild Rolling 12 Month\Derive Rolling Trends.Outputs[Derived Column Output].Columns[RefreshedByLineageKey]" name="RefreshedByLineageKey">
                    <properties>
