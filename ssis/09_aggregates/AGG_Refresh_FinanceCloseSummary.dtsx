    <DTS:Executable
      DTS:refId="Package\Delete Period Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{60DDFD9C-8211-98A4-513C-4FAE965C0620}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Delete Period Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE FROM [Aggregate].[Finance Close Summary] WHERE [Accounting Period Code] &gt;= FORMAT(DATEADD(MONTH, -1 * ?, CAST(? + '-01' AS date)), 'yyyy-MM') AND [Accounting Period Code] &lt;= ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::RebuildPriorPeriods" SQLTask:ParameterDirection="Input" SQLTask:DataType="LONG" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Rebuild Finance Close Summary"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{1A57E24B-6739-E82C-3AF1-767F005E71A3}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Rebuild Finance Close Summary"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Rebuild Finance Close Summary\GL Close Source" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="GL Close Source" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT gl.[Accounting Period Code] AS AccountingPeriodCode, gl.[Legal Entity Code] AS LegalEntityCode, a.[Account Type Code] AS AccountTypeCode, SUM(gl.[Debit Amount]) AS DebitAmount, SUM(gl.[Credit Amount]) AS CreditAmount, ISNULL(MAX(sl.[Sub Ledger Amount]), 0) AS SubLedgerAmount, COUNT(DISTINCT gl.[Journal Batch Number]) AS JournalCount, SUM(CASE WHEN gl.[Is Manual Journal] = 1 THEN 1 ELSE 0 END) AS ManualJournalCount FROM [Fact].[GL Posting] AS gl INNER JOIN [Dimension].[GL Account] AS a ON a.[GL Account Key] = gl.[GL Account Key] LEFT JOIN [Aggregate].[Sub Ledger Control Total] AS sl        ON sl.[Accounting Period Code] = gl.[Accounting Period Code]       AND sl.[Account Type Code] = a.[Account Type Code]       AND sl.[Legal Entity Code] = gl.[Legal Entity Code] WHERE gl.[Accounting Period Code] = ? GROUP BY gl.[Accounting Period Code], gl.[Legal Entity Code], a.[Account Type Code];</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Rebuild Finance Close Summary\GL Close Source.Connections[OleDbConnection]" connectionManagerID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_DW_Destination_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" dataType="wstr" length="7" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].ExternalColumns[AccountingPeriodCode]" lineageId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" name="AccountingPeriodCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[LegalEntityCode]" dataType="wstr" length="8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].ExternalColumns[LegalEntityCode]" lineageId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[LegalEntityCode]" name="LegalEntityCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[AccountTypeCode]" dataType="wstr" length="8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].ExternalColumns[AccountTypeCode]" lineageId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[AccountTypeCode]" name="AccountTypeCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[DebitAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].ExternalColumns[DebitAmount]" lineageId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[DebitAmount]" name="DebitAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[CreditAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].ExternalColumns[CreditAmount]" lineageId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[CreditAmount]" name="CreditAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[SubLedgerAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].ExternalColumns[SubLedgerAmount]" lineageId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[SubLedgerAmount]" name="SubLedgerAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[JournalCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].ExternalColumns[JournalCount]" lineageId="Package\Rebuild Finance Close Summary\GL Close Source.Outputs[OLE DB Source Output].Columns[JournalCount]" name="JournalCount" truncationRowDisposition="RedirectRow" />
