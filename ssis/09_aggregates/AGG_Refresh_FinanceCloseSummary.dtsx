          <component refId="Package\Rebuild Finance Close Summary\Derive Close Controls" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Close Controls" usesDispositions="true" version="1">
            <inputs>
              <input refId="Package\Rebuild Finance Close Summary\Derive Close Controls.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Rebuild Finance Close Summary\Derive Close Controls.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output].Columns[NetMovementAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output].Columns[NetMovementAmount]" name="NetMovementAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">DebitAmount - CreditAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">DebitAmount - CreditAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output].Columns[ControlVarianceAmount]" dataType="numeric" precision="18" scale="2" lineageId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output].Columns[ControlVarianceAmount]" name="ControlVarianceAmount">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DebitAmount - CreditAmount) - SubLedgerAmount</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DebitAmount - CreditAmount) - SubLedgerAmount</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output].Columns[IsBalanced]" dataType="bool" lineageId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output].Columns[IsBalanced]" name="IsBalanced">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ABS(DebitAmount - CreditAmount - SubLedgerAmount) &lt;= (DT_NUMERIC,18,2)@[$Package::MaterialityAmount]</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ABS(DebitAmount - CreditAmount - SubLedgerAmount) &lt;= (DT_NUMERIC,18,2)@[$Package::MaterialityAmount]</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output].Columns[ManualJournalPercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output].Columns[ManualJournalPercent]" name="ManualJournalPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">JournalCount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)ManualJournalCount / (DT_NUMERIC,9,4)JournalCount) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">JournalCount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)ManualJournalCount / (DT_NUMERIC,9,4)JournalCount) * 100</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output].Columns[CloseStatusCode]" dataType="wstr" length="10" lineageId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output].Columns[CloseStatusCode]" name="CloseStatusCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ABS(DebitAmount - CreditAmount - SubLedgerAmount) &lt;= (DT_NUMERIC,18,2)@[$Package::MaterialityAmount] ? "TIED" : "VARIANCE"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ABS(DebitAmount - CreditAmount - SubLedgerAmount) &lt;= (DT_NUMERIC,18,2)@[$Package::MaterialityAmount] ? "TIED" : "VARIANCE"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output].Columns[RefreshedByLineageKey]" dataType="i8" lineageId="Package\Rebuild Finance Close Summary\Derive Close Controls.Outputs[Derived Column Output].Columns[RefreshedByLineageKey]" name="RefreshedByLineageKey">
                    <properties>
