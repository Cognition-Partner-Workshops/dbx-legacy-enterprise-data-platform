                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Inventory Health\Derive Health Indicators.Outputs[Derived Column Output].Columns[ProvisionPercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\Rebuild Inventory Health\Derive Health Indicators.Outputs[Derived Column Output].Columns[ProvisionPercent]" name="ProvisionPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">StockValueAmount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)ProvisionAmount / (DT_NUMERIC,9,4)StockValueAmount) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">StockValueAmount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)ProvisionAmount / (DT_NUMERIC,9,4)StockValueAmount) * 100</property>
                    </properties>
                  </outputColumn>
