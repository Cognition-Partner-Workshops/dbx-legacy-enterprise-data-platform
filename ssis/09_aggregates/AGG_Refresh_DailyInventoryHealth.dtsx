                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">((DT_NUMERIC,9,4)StockOutSkuCount) &gt; 0 &amp;&amp; AverageDaysOfCover &lt; 7 ? "RED" : AverageDaysOfCover &lt; 14 ? "AMBER" : AverageDaysOfCover &gt; 120 ? "OVERSTOCK" : "GREEN"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">((DT_NUMERIC,9,4)StockOutSkuCount) &gt; 0 &amp;&amp; AverageDaysOfCover &lt; 7 ? "RED" : AverageDaysOfCover &lt; 14 ? "AMBER" : AverageDaysOfCover &gt; 120 ? "OVERSTOCK" : "GREEN"</property>
                    </properties>
