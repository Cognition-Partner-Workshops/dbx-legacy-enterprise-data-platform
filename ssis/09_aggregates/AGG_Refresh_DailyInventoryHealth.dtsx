                <outputColumns>
                  <outputColumn refId="Package\Rebuild Inventory Health\Derive Health Indicators.Outputs[Derived Column Output].Columns[StockOutPercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\Rebuild Inventory Health\Derive Health Indicators.Outputs[Derived Column Output].Columns[StockOutPercent]" name="StockOutPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">SkuCount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)StockOutSkuCount / (DT_NUMERIC,9,4)SkuCount) * 100</property>
