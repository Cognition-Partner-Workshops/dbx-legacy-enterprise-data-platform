    <DTS:Executable
      DTS:refId="Package\Delete Refresh Window"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{43A283D9-ADCF-5ED8-6739-AF978B26D705}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Delete Refresh Window"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE a FROM [Aggregate].[Daily Inventory Health] AS a INNER JOIN Dimension.Date AS d ON d.[Date Key] = a.[Position Date Key] WHERE d.[Date] &gt;= CAST(? AS date) AND d.[Date] &lt;= CAST(? AS date);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::RefreshFromDate" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::RefreshToDate" SQLTask:ParameterDirection="Input" SQLTask:DataType="NVARCHAR" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Rebuild Inventory Health"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{837D8AF8-EBF4-869B-0231-89A15BDDE07E}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Rebuild Inventory Health"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="Fact Daily Inventory Snapshot Window" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT f.[Position Date Key] AS PositionDateKey, f.[Warehouse Code] AS WarehouseCode, si.[Product Category Code] AS ProductCategoryCode, COUNT_BIG(*) AS SkuCount, SUM(CASE WHEN f.[Quantity On Hand] &lt;= ? THEN 1 ELSE 0 END) AS StockOutSkuCount, SUM(CASE WHEN f.[Cover Band Code] IN (N'TIGHT', N'CRITICAL') THEN 1 ELSE 0 END)     AS BelowReorderSkuCount, SUM(f.[Net Stock Value Amount]) AS StockValueAmount, SUM(f.[Obsolescence Provision Amount]) AS ProvisionAmount, AVG(CAST(f.[Days Of Cover] AS decimal(9,2))) AS AverageDaysOfCover FROM [Fact].[Daily Inventory Snapshot] AS f INNER JOIN Dimension.Date AS d ON d.[Date Key] = f.[Position Date Key] INNER JOIN [Dimension].[Stock Item] AS si ON si.[Stock Item Key] = f.[Stock Item Key] WHERE d.[Date] &gt;= CAST(? AS date) AND d.[Date] &lt;= CAST(? AS date) GROUP BY f.[Position Date Key], f.[Warehouse Code], si.[Product Category Code];</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Connections[OleDbConnection]" connectionManagerID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_DW_Destination_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[PositionDateKey]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].ExternalColumns[PositionDateKey]" lineageId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[PositionDateKey]" name="PositionDateKey" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[WarehouseCode]" dataType="wstr" length="12" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].ExternalColumns[WarehouseCode]" lineageId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[WarehouseCode]" name="WarehouseCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[ProductCategoryCode]" dataType="wstr" length="12" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].ExternalColumns[ProductCategoryCode]" lineageId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[ProductCategoryCode]" name="ProductCategoryCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[SkuCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].ExternalColumns[SkuCount]" lineageId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[SkuCount]" name="SkuCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[StockOutSkuCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].ExternalColumns[StockOutSkuCount]" lineageId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[StockOutSkuCount]" name="StockOutSkuCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[BelowReorderSkuCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].ExternalColumns[BelowReorderSkuCount]" lineageId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[BelowReorderSkuCount]" name="BelowReorderSkuCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[StockValueAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].ExternalColumns[StockValueAmount]" lineageId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[StockValueAmount]" name="StockValueAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[ProvisionAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].ExternalColumns[ProvisionAmount]" lineageId="Package\Rebuild Inventory Health\Fact Daily Inventory Snapshot Window.Outputs[OLE DB Source Output].Columns[ProvisionAmount]" name="ProvisionAmount" truncationRowDisposition="RedirectRow" />
