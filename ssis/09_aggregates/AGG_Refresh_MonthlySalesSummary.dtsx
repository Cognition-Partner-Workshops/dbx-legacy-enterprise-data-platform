                  <outputColumn refId="Package\Rebuild Monthly Sales Summary\Fact Sale Period.Outputs[OLE DB Source Output].Columns[MarginAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Monthly Sales Summary\Fact Sale Period.Outputs[OLE DB Source Output].ExternalColumns[MarginAmount]" lineageId="Package\Rebuild Monthly Sales Summary\Fact Sale Period.Outputs[OLE DB Source Output].Columns[MarginAmount]" name="MarginAmount" truncationRowDisposition="RedirectRow" />
