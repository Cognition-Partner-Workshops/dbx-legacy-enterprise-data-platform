  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Init Publication Window"
      DTS:CreationName="Microsoft.ExpressionTask"
      DTS:Description="Expression Task"
      DTS:DTSID="{17EC4D64-E23F-875D-2E4C-4EC92DBDD36F}"
      DTS:ExecutableType="Microsoft.ExpressionTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Init Publication Window"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <ExpressionTask Expression="@[User::WatermarkTo] = (DT_DBTIMESTAMP)GETDATE()" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Log Package Start"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{96FC3B55-0E93-CA83-AF5B-5378451DDAB5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Log Package Start"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogPackageStart @BatchId = ?, @PackageName = ?, @PackageExecutionId = ? OUTPUT;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="True"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="System::PackageName" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Output" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Read Publication List"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AF66F343-F3BA-79A1-A1FF-046D7F6F219D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Read Publication List"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT etl.ufn_GetConfigurationValue(N'ReportingPublicationList', ?) AS PublicationList;"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::PublicationGroupCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::PublishSql" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Check Aggregate Staleness"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{96CA9D05-B872-76C5-A12C-6C55828B0FB1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Check Aggregate Staleness"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="SELECT ISNULL(MAX(DATEDIFF(HOUR, w.WatermarkValue, GETDATE())), 0) AS StalenessHours FROM etl.Watermark AS w WHERE w.ObjectName LIKE N'Aggregate.%';"
        SQLTask:ResultType="ResultSetType_SingleRow"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::StalenessHours" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Publish Reporting Objects"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Swap each Report object over from its Aggregate source"
      DTS:DTSID="{D88F1048-C62A-4627-E112-1A5204828A51}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Publish Reporting Objects">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Publish Reporting Objects\Build Publication Statements"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{8F393459-3FC2-C2C9-0540-532429E7A55C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Build Publication Statements"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
            SQLTask:SqlStatementSource="DECLARE @sql nvarchar(max) = N''; SELECT @sql = @sql + N'TRUNCATE TABLE ' + QUOTENAME(c.TargetSchemaName) + N'.'      + QUOTENAME(c.TargetObjectName) + N'; INSERT INTO ' + QUOTENAME(c.TargetSchemaName)      + N'.' + QUOTENAME(c.TargetObjectName) + N' SELECT * FROM '      + QUOTENAME(c.SourceSchemaName) + N'.' + QUOTENAME(c.SourceObjectName) + N'; ' FROM [Integration].[ReportingPublication] AS c WHERE c.PublicationGroupCode = ? AND c.IsEnabled = 1 ORDER BY c.PublishSequence; EXEC sp_executesql @sql;"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="7200"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::PublicationGroupCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Publish Reporting Objects\Rebuild Reporting Indexes"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{BC8EA42E-0A65-2C0B-5E4B-29C15F15EFDB}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Rebuild Reporting Indexes"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
            SQLTask:SqlStatementSource="DECLARE @sql nvarchar(max) = N''; SELECT @sql = @sql + N'ALTER INDEX ALL ON ' + QUOTENAME(s.name) + N'.' + QUOTENAME(t.name)      + N' REBUILD; ' FROM sys.tables AS t INNER JOIN sys.schemas AS s ON s.schema_id = t.schema_id WHERE s.name = N'Report'; EXEC sp_executesql @sql;"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="7200"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Publish Reporting Objects\Stamp Publication Metadata"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{3EE44EF2-CB27-7BA8-9CDE-FD3BA2223CA2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Stamp Publication Metadata"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
          <SQLTask:SqlTaskData
            SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
            SQLTask:SqlStatementSource="UPDATE [Integration].[ReportingPublication] SET LastPublishedAt = GETDATE(), LastPublishedByExecutionId = ? WHERE PublicationGroupCode = ? AND IsEnabled = 1;"
            SQLTask:ResultType="ResultSetType_None"
            SQLTask:TimeOut="0"
            SQLTask:SqlStmtSourceType="DirectInput"
            SQLTask:IsStoredProc="False"
            xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
            <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
            <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::PublicationGroupCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
          </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Publish Reporting Objects.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{FFC7BED9-9871-96DD-A0BC-FAF4391B43E6}"
          DTS:From="Package\Publish Reporting Objects\Build Publication Statements"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package\Publish Reporting Objects\Rebuild Reporting Indexes" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Publish Reporting Objects.PrecedenceConstraints[Constraint 1]"
          DTS:CreationName=""
          DTS:DTSID="{9569DF19-4240-09B5-012C-23318075424A}"
          DTS:From="Package\Publish Reporting Objects\Rebuild Reporting Indexes"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint 1"
          DTS:To="Package\Publish Reporting Objects\Stamp Publication Metadata" />
      </DTS:PrecedenceConstraints>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Quarantine Stale Publications"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AA0849AF-4266-69FE-C4DC-F3D98BB30C22}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Quarantine Stale Publications"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="INSERT INTO err.RejectedConstraintViolation     (ObjectName, BusinessKey, RejectReason, RejectedAt, PackageExecutionId) SELECT w.ObjectName, w.ObjectName, N'Aggregate is stale at publication time', GETDATE(), ? FROM etl.Watermark AS w WHERE w.ObjectName LIKE N'Aggregate.%'   AND DATEDIFF(HOUR, w.WatermarkValue, GETDATE()) &gt; ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::MaxStalenessHours" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Publish Reporting Layer"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{496872A1-9A77-FCC8-65FA-09A84495EB55}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Publish Reporting Layer"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
