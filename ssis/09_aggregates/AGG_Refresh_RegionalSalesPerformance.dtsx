  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Init Refresh Period"
      DTS:CreationName="Microsoft.ExpressionTask"
      DTS:Description="Expression Task"
      DTS:DTSID="{CEDE3108-A491-846A-837A-212A109B618C}"
