                  <outputColumn refId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Error Output].Columns[SalespersonCount]" dataType="i4" lineageId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Error Output].Columns[SalespersonCount]" name="SalespersonCount" />
