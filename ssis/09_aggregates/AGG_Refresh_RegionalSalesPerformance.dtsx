      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogPackageStart @BatchId = ?, @PackageName = ?, @PackageExecutionId = ? OUTPUT;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="True"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="System::PackageName" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Output" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Delete Period Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{60DDFD9C-8211-98A4-513C-4FAE965C0620}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Delete Period Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE FROM [Aggregate].[Regional Sales Performance] WHERE [Accounting Period Code] &gt;= FORMAT(DATEADD(MONTH, -1 * ?, CAST(? + '-01' AS date)), 'yyyy-MM') AND [Accounting Period Code] &lt;= ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::RebuildPriorPeriods" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Rebuild Regional Sales Performance"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{89125925-9E0E-7038-89A8-487174EF9E71}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Rebuild Regional Sales Performance"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Rebuild Regional Sales Performance\Regional Sales Source" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="Regional Sales Source" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT d.[Accounting Period Code] AS AccountingPeriodCode, c.[Region Code] AS RegionCode, t.[Sales Territory Key] AS SalesTerritoryKey, COUNT(DISTINCT f.[Salesperson Key]) AS SalespersonCount, SUM(f.[Net Amount]) AS NetAmount, SUM(f.[Tax Amount]) AS TaxAmount, SUM(f.[Margin Amount]) AS MarginAmount, SUM(f.[Net Amount Reporting]) AS NetAmountReporting, ISNULL(MAX(q.[Quota Amount]), 0) AS QuotaAmount FROM [Fact].[Sale] AS f INNER JOIN Dimension.Date AS d ON d.[Date Key] = f.[Invoice Date Key] INNER JOIN Dimension.Customer AS c ON c.[Customer Key] = f.[Customer Key] INNER JOIN [Dimension].[Sales Territory] AS t ON t.[Sales Territory Key] = f.[Sales Territory Key] LEFT JOIN [Aggregate].[Territory Quota] AS q        ON q.[Sales Territory Key] = t.[Sales Territory Key]       AND q.[Accounting Period Code] = d.[Accounting Period Code] WHERE d.[Accounting Period Code] = ? GROUP BY d.[Accounting Period Code], c.[Region Code], t.[Sales Territory Key];</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Connections[OleDbConnection]" connectionManagerID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_DW_Destination_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" dataType="wstr" length="7" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].ExternalColumns[AccountingPeriodCode]" lineageId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" name="AccountingPeriodCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="6" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[SalesTerritoryKey]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].ExternalColumns[SalesTerritoryKey]" lineageId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[SalesTerritoryKey]" name="SalesTerritoryKey" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[SalespersonCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].ExternalColumns[SalespersonCount]" lineageId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[SalespersonCount]" name="SalespersonCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[NetAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].ExternalColumns[NetAmount]" lineageId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[NetAmount]" name="NetAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[TaxAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].ExternalColumns[TaxAmount]" lineageId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[TaxAmount]" name="TaxAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[MarginAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].ExternalColumns[MarginAmount]" lineageId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[MarginAmount]" name="MarginAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[NetAmountReporting]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].ExternalColumns[NetAmountReporting]" lineageId="Package\Rebuild Regional Sales Performance\Regional Sales Source.Outputs[OLE DB Source Output].Columns[NetAmountReporting]" name="NetAmountReporting" truncationRowDisposition="RedirectRow" />
