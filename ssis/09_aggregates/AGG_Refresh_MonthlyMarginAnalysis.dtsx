    <DTS:Executable
      DTS:refId="Package\Delete Period Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{60DDFD9C-8211-98A4-513C-4FAE965C0620}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Delete Period Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE FROM [Aggregate].[Monthly Margin Analysis] WHERE [Accounting Period Code] &gt;= FORMAT(DATEADD(MONTH, -1 * ?, CAST(? + '-01' AS date)), 'yyyy-MM') AND [Accounting Period Code] &lt;= ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::RebuildPriorPeriods" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Rebuild Margin Analysis"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{FAF0DA96-A36A-2E8E-9E0C-6B33A5C62622}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Rebuild Margin Analysis"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Rebuild Margin Analysis\Fact Sale Margin Period" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="Fact Sale Margin Period" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT d.[Accounting Period Code] AS AccountingPeriodCode, si.[Product Category Code] AS ProductCategoryCode, ISNULL(f.[Sales Channel Code], N'DIRECT') AS SalesChannelCode, SUM(f.[Net Amount]) AS NetAmount, SUM(f.[Standard Cost Amount]) AS StandardCostAmount, SUM(f.[Total Cost Amount]) AS ActualCostAmount, SUM(f.[Margin Amount]) AS MarginAmount, SUM(f.[Quantity]) AS QuantitySold FROM [Fact].[Sale] AS f INNER JOIN Dimension.Date AS d ON d.[Date Key] = f.[Invoice Date Key] INNER JOIN [Dimension].[Stock Item] AS si ON si.[Stock Item Key] = f.[Stock Item Key] WHERE d.[Accounting Period Code] &gt;= FORMAT(DATEADD(MONTH, -1 * ?, CAST(? + '-01' AS date)), 'yyyy-MM')   AND d.[Accounting Period Code] &lt;= ? AND f.[Is Reversal] = 0 GROUP BY d.[Accounting Period Code], si.[Product Category Code],          ISNULL(f.[Sales Channel Code], N'DIRECT');</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Connections[OleDbConnection]" connectionManagerID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_DW_Destination_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" dataType="wstr" length="7" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].ExternalColumns[AccountingPeriodCode]" lineageId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" name="AccountingPeriodCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[ProductCategoryCode]" dataType="wstr" length="12" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].ExternalColumns[ProductCategoryCode]" lineageId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[ProductCategoryCode]" name="ProductCategoryCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[SalesChannelCode]" dataType="wstr" length="12" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].ExternalColumns[SalesChannelCode]" lineageId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[SalesChannelCode]" name="SalesChannelCode" truncationRowDisposition="RedirectRow" />
