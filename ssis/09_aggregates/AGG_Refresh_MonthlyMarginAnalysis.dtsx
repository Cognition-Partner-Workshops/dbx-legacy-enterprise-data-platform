                  <outputColumn refId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Error Output].Columns[AccountingPeriodCode]" dataType="wstr" length="7" lineageId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Error Output].Columns[AccountingPeriodCode]" name="AccountingPeriodCode" />
