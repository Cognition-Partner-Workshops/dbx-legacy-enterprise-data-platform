                  <outputColumn refId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[StandardCostAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].ExternalColumns[StandardCostAmount]" lineageId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[StandardCostAmount]" name="StandardCostAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[ActualCostAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].ExternalColumns[ActualCostAmount]" lineageId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[ActualCostAmount]" name="ActualCostAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[MarginAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].ExternalColumns[MarginAmount]" lineageId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[MarginAmount]" name="MarginAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[QuantitySold]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].ExternalColumns[QuantitySold]" lineageId="Package\Rebuild Margin Analysis\Fact Sale Margin Period.Outputs[OLE DB Source Output].Columns[QuantitySold]" name="QuantitySold" truncationRowDisposition="RedirectRow" />
