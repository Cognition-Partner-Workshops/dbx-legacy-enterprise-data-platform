      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogPackageStart @BatchId = ?, @PackageName = ?, @PackageExecutionId = ? OUTPUT;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="True"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="System::PackageName" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Output" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Delete Period Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{60DDFD9C-8211-98A4-513C-4FAE965C0620}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Delete Period Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE FROM [Aggregate].[Promotion Effectiveness] WHERE [Accounting Period Code] &gt;= FORMAT(DATEADD(MONTH, -1 * ?, CAST(? + '-01' AS date)), 'yyyy-MM') AND [Accounting Period Code] &lt;= ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::RebuildPriorPeriods" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Rebuild Promotion Effectiveness"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{5897D4F8-C25C-0AD7-BEA4-2ABB171890F0}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Rebuild Promotion Effectiveness"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Rebuild Promotion Effectiveness\Promotion Source" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="Promotion Source" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT f.[Promotion Key] AS PromotionKey, d.[Accounting Period Code] AS AccountingPeriodCode, c.[Region Code] AS RegionCode, SUM(f.[Quantity]) AS PromotedQuantity, SUM(f.[Net Amount]) AS PromotedNetAmount, SUM(f.[Discount Amount]) AS DiscountAmount, SUM(f.[Margin Amount]) AS PromotedMarginAmount, ISNULL(MAX(b.[Baseline Weekly Quantity]), 0) AS BaselineWeeklyQuantity, COUNT(DISTINCT f.[Invoice Number]) AS RedemptionCount, ISNULL(MAX(e.[Eligible Customer Count]), 0) AS EligibleCustomerCount FROM [Fact].[Sale] AS f INNER JOIN Dimension.Date AS d ON d.[Date] = f.[Invoice Date Key] INNER JOIN Dimension.Customer AS c ON c.[Customer Key] = f.[Customer Key] LEFT JOIN [Aggregate].[Promotion Baseline] AS b ON b.[Promotion Key] = f.[Promotion Key] LEFT JOIN [Aggregate].[Promotion Eligibility] AS e ON e.[Promotion Key] = f.[Promotion Key] WHERE d.[Accounting Period Code] = ? AND f.[Promotion Key] IS NOT NULL AND f.[Promotion Key] &lt;&gt; 0 GROUP BY f.[Promotion Key], d.[Accounting Period Code], c.[Region Code];</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Rebuild Promotion Effectiveness\Promotion Source.Connections[OleDbConnection]" connectionManagerID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_DW_Destination_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[PromotionKey]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].ExternalColumns[PromotionKey]" lineageId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[PromotionKey]" name="PromotionKey" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" dataType="wstr" length="7" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].ExternalColumns[AccountingPeriodCode]" lineageId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" name="AccountingPeriodCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[RegionCode]" dataType="wstr" length="6" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].ExternalColumns[RegionCode]" lineageId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[RegionCode]" name="RegionCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[PromotedQuantity]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].ExternalColumns[PromotedQuantity]" lineageId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[PromotedQuantity]" name="PromotedQuantity" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[PromotedNetAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].ExternalColumns[PromotedNetAmount]" lineageId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[PromotedNetAmount]" name="PromotedNetAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[DiscountAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].ExternalColumns[DiscountAmount]" lineageId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[DiscountAmount]" name="DiscountAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[PromotedMarginAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].ExternalColumns[PromotedMarginAmount]" lineageId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[PromotedMarginAmount]" name="PromotedMarginAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[BaselineWeeklyQuantity]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].ExternalColumns[BaselineWeeklyQuantity]" lineageId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[BaselineWeeklyQuantity]" name="BaselineWeeklyQuantity" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[RedemptionCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].ExternalColumns[RedemptionCount]" lineageId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[RedemptionCount]" name="RedemptionCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[EligibleCustomerCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].ExternalColumns[EligibleCustomerCount]" lineageId="Package\Rebuild Promotion Effectiveness\Promotion Source.Outputs[OLE DB Source Output].Columns[EligibleCustomerCount]" name="EligibleCustomerCount" truncationRowDisposition="RedirectRow" />
                </outputColumns>
