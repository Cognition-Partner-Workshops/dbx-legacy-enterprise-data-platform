          <component refId="Package\Rebuild Promotion Effectiveness\Derive Uplift Measures" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Uplift Measures" usesDispositions="true">
            <inputs>
              <input refId="Package\Rebuild Promotion Effectiveness\Derive Uplift Measures.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Rebuild Promotion Effectiveness\Derive Uplift Measures.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Rebuild Promotion Effectiveness\Derive Uplift Measures.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Derive Uplift Measures.Outputs[Derived Column Output].Columns[BaselineQuantity]" dataType="numeric" precision="18" scale="2" lineageId="Package\Rebuild Promotion Effectiveness\Derive Uplift Measures.Outputs[Derived Column Output].Columns[BaselineQuantity]" name="BaselineQuantity">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">BaselineWeeklyQuantity * (DT_NUMERIC,18,2)4.33</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">BaselineWeeklyQuantity * (DT_NUMERIC,18,2)4.33</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Derive Uplift Measures.Outputs[Derived Column Output].Columns[IncrementalQuantity]" dataType="numeric" precision="18" scale="2" lineageId="Package\Rebuild Promotion Effectiveness\Derive Uplift Measures.Outputs[Derived Column Output].Columns[IncrementalQuantity]" name="IncrementalQuantity">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">(DT_NUMERIC,18,2)PromotedQuantity - (BaselineWeeklyQuantity * (DT_NUMERIC,18,2)4.33)</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">(DT_NUMERIC,18,2)PromotedQuantity - (BaselineWeeklyQuantity * (DT_NUMERIC,18,2)4.33)</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Derive Uplift Measures.Outputs[Derived Column Output].Columns[UpliftPercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\Rebuild Promotion Effectiveness\Derive Uplift Measures.Outputs[Derived Column Output].Columns[UpliftPercent]" name="UpliftPercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">BaselineWeeklyQuantity == 0 ? (DT_NUMERIC,9,4)0 : (((DT_NUMERIC,9,4)PromotedQuantity - ((DT_NUMERIC,9,4)BaselineWeeklyQuantity * 4.33)) / ((DT_NUMERIC,9,4)BaselineWeeklyQuantity * 4.33)) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">BaselineWeeklyQuantity == 0 ? (DT_NUMERIC,9,4)0 : (((DT_NUMERIC,9,4)PromotedQuantity - ((DT_NUMERIC,9,4)BaselineWeeklyQuantity * 4.33)) / ((DT_NUMERIC,9,4)BaselineWeeklyQuantity * 4.33)) * 100</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Promotion Effectiveness\Derive Uplift Measures.Outputs[Derived Column Output].Columns[RedemptionRatePercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\Rebuild Promotion Effectiveness\Derive Uplift Measures.Outputs[Derived Column Output].Columns[RedemptionRatePercent]" name="RedemptionRatePercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">EligibleCustomerCount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)RedemptionCount / (DT_NUMERIC,9,4)EligibleCustomerCount) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">EligibleCustomerCount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)RedemptionCount / (DT_NUMERIC,9,4)EligibleCustomerCount) * 100</property>
                    </properties>
