                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">PromotedNetAmount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)DiscountAmount / (DT_NUMERIC,9,4)PromotedNetAmount) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">PromotedNetAmount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)DiscountAmount / (DT_NUMERIC,9,4)PromotedNetAmount) * 100</property>
