                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">RegionCode == "APAC" ? "GROSS" : "NET"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">RegionCode == "APAC" ? "GROSS" : "NET"</property>
                    </properties>
