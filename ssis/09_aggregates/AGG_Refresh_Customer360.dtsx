                  <outputColumn refId="Package\Rebuild Customer 360\Customer Profile Source.Outputs[OLE DB Source Output].Columns[LastOrderDate]" dataType="dbTimeStamp" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Customer 360\Customer Profile Source.Outputs[OLE DB Source Output].ExternalColumns[LastOrderDate]" lineageId="Package\Rebuild Customer 360\Customer Profile Source.Outputs[OLE DB Source Output].Columns[LastOrderDate]" name="LastOrderDate" truncationRowDisposition="RedirectRow" />
