                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">LifetimeOrderCount == 0 ? (DT_NUMERIC,18,2)0 : ((DT_NUMERIC,18,2)LifetimeNetAmount / (DT_NUMERIC,18,2)LifetimeOrderCount)</property>
