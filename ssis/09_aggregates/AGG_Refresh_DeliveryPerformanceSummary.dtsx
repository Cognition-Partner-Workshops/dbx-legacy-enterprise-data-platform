          <component refId="Package\Rebuild Delivery Performance\Derive Performance Ratios" componentClassID="Microsoft.DerivedColumn" description="Derived Column" name="Derive Performance Ratios" usesDispositions="true">
            <inputs>
              <input refId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Inputs[Derived Column Input]" name="Derived Column Input" />
            </inputs>
            <outputs>
              <output refId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Outputs[Derived Column Output]" exclusionGroup="1" name="Derived Column Output" synchronousInputId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Inputs[Derived Column Input]">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Outputs[Derived Column Output].Columns[OnTimePercent]" dataType="numeric" precision="9" scale="4" lineageId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Outputs[Derived Column Output].Columns[OnTimePercent]" name="OnTimePercent">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ShipmentCount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)OnTimeShipmentCount / (DT_NUMERIC,9,4)ShipmentCount) * 100</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ShipmentCount == 0 ? (DT_NUMERIC,9,4)0 : ((DT_NUMERIC,9,4)OnTimeShipmentCount / (DT_NUMERIC,9,4)ShipmentCount) * 100</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Outputs[Derived Column Output].Columns[FreightPerKg]" dataType="numeric" precision="18" scale="2" lineageId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Outputs[Derived Column Output].Columns[FreightPerKg]" name="FreightPerKg">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">TotalWeightKg == 0 ? (DT_NUMERIC,18,2)0 : FreightChargeAmount / (DT_NUMERIC,18,2)TotalWeightKg</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">TotalWeightKg == 0 ? (DT_NUMERIC,18,2)0 : FreightChargeAmount / (DT_NUMERIC,18,2)TotalWeightKg</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Outputs[Derived Column Output].Columns[IsCrossBorderLane]" dataType="bool" lineageId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Outputs[Derived Column Output].Columns[IsCrossBorderLane]" name="IsCrossBorderLane">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">OriginCountryIsoCode != DestinationCountryIsoCode</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">OriginCountryIsoCode != DestinationCountryIsoCode</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Outputs[Derived Column Output].Columns[ServiceLevelBandCode]" dataType="wstr" length="10" lineageId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Outputs[Derived Column Output].Columns[ServiceLevelBandCode]" name="ServiceLevelBandCode">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">ShipmentCount == 0 ? "NODATA" : (((DT_NUMERIC,9,4)OnTimeShipmentCount / (DT_NUMERIC,9,4)ShipmentCount) * 100) &gt;= 98 ? "PLATINUM" : (((DT_NUMERIC,9,4)OnTimeShipmentCount / (DT_NUMERIC,9,4)ShipmentCount) * 100) &gt;= 95 ? "GOLD" : (((DT_NUMERIC,9,4)OnTimeShipmentCount / (DT_NUMERIC,9,4)ShipmentCount) * 100) &gt;= 90 ? "SILVER" : "REVIEW"</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">ShipmentCount == 0 ? "NODATA" : (((DT_NUMERIC,9,4)OnTimeShipmentCount / (DT_NUMERIC,9,4)ShipmentCount) * 100) &gt;= 98 ? "PLATINUM" : (((DT_NUMERIC,9,4)OnTimeShipmentCount / (DT_NUMERIC,9,4)ShipmentCount) * 100) &gt;= 95 ? "GOLD" : (((DT_NUMERIC,9,4)OnTimeShipmentCount / (DT_NUMERIC,9,4)ShipmentCount) * 100) &gt;= 90 ? "SILVER" : "REVIEW"</property>
                    </properties>
                  </outputColumn>
                  <outputColumn refId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Outputs[Derived Column Output].Columns[RefreshedByLineageKey]" dataType="i8" lineageId="Package\Rebuild Delivery Performance\Derive Performance Ratios.Outputs[Derived Column Output].Columns[RefreshedByLineageKey]" name="RefreshedByLineageKey">
                    <properties>
                      <property dataType="System.String" description="The expression used to compute this column." name="Expression">@[User::PackageExecutionId]</property>
                      <property dataType="System.String" description="The expression as displayed in the designer." name="FriendlyExpression">@[User::PackageExecutionId]</property>
                    </properties>
                  </outputColumn>
                </outputColumns>
                <externalMetadataColumns />
              </output>
            </outputs>
          </component>
