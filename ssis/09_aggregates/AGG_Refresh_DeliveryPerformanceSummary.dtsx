    <DTS:Executable
      DTS:refId="Package\Delete Refresh Window"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{43A283D9-ADCF-5ED8-6739-AF978B26D705}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Delete Refresh Window"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE a FROM [Aggregate].[Delivery Performance Summary] AS a INNER JOIN Dimension.Date AS d ON d.[Date Key] = a.[Delivered Date Key] WHERE d.[Date] &gt;= CAST(? AS date) AND d.[Date] &lt;= CAST(? AS date);"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::RefreshFromDate" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::RefreshToDate" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Rebuild Delivery Performance"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{43ACFFEE-7054-FBFB-A290-B4EB1CF9C76B}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Rebuild Delivery Performance"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Rebuild Delivery Performance\Fact Shipment Window" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="Fact Shipment Window" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">1800</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT f.[Delivered Date Key] AS DeliveredDateKey, f.[Carrier Code] AS CarrierCode, f.[Origin Country ISO Code] AS OriginCountryIsoCode, f.[Destination Country ISO Code] AS DestinationCountryIsoCode, COUNT_BIG(*) AS ShipmentCount, SUM(CASE WHEN f.[Days Late] &lt;= 0 THEN 1 ELSE 0 END) AS OnTimeShipmentCount, AVG(CAST(f.[Dispatch To Delivery Days] AS decimal(9,2))) AS AverageTransitDays, AVG(CAST(f.[Customs Hold Days] AS decimal(9,2))) AS AverageCustomsHoldDays, SUM(f.[Freight Charge Amount]) AS FreightChargeAmount, SUM(f.[Shipment Weight Kg]) AS TotalWeightKg FROM [Fact].[Shipment] AS f INNER JOIN Dimension.Date AS d ON d.[Date Key] = f.[Delivered Date Key] WHERE d.[Date] &gt;= CAST(? AS date) AND d.[Date] &lt;= CAST(? AS date)   AND f.[Milestone Status Code] = N'DELIVERED' GROUP BY f.[Delivered Date Key], f.[Carrier Code], f.[Origin Country ISO Code],          f.[Destination Country ISO Code];</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Rebuild Delivery Performance\Fact Shipment Window.Connections[OleDbConnection]" connectionManagerID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_DW_Destination_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[DeliveredDateKey]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].ExternalColumns[DeliveredDateKey]" lineageId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[DeliveredDateKey]" name="DeliveredDateKey" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[CarrierCode]" dataType="wstr" length="8" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].ExternalColumns[CarrierCode]" lineageId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[CarrierCode]" name="CarrierCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[OriginCountryIsoCode]" dataType="wstr" length="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].ExternalColumns[OriginCountryIsoCode]" lineageId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[OriginCountryIsoCode]" name="OriginCountryIsoCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[DestinationCountryIsoCode]" dataType="wstr" length="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].ExternalColumns[DestinationCountryIsoCode]" lineageId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[DestinationCountryIsoCode]" name="DestinationCountryIsoCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[ShipmentCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].ExternalColumns[ShipmentCount]" lineageId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[ShipmentCount]" name="ShipmentCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[OnTimeShipmentCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].ExternalColumns[OnTimeShipmentCount]" lineageId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[OnTimeShipmentCount]" name="OnTimeShipmentCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[AverageTransitDays]" dataType="numeric" precision="9" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].ExternalColumns[AverageTransitDays]" lineageId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Output].Columns[AverageTransitDays]" name="AverageTransitDays" truncationRowDisposition="RedirectRow" />
