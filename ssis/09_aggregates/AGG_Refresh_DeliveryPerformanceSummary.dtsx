                  <outputColumn refId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Error Output].Columns[CarrierCode]" dataType="wstr" length="8" lineageId="Package\Rebuild Delivery Performance\Fact Shipment Window.Outputs[OLE DB Source Error Output].Columns[CarrierCode]" name="CarrierCode" />
