      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogPackageStart @BatchId = ?, @PackageName = ?, @PackageExecutionId = ? OUTPUT;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="True"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="System::PackageName" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Output" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Delete Period Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{60DDFD9C-8211-98A4-513C-4FAE965C0620}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Delete Period Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE FROM [Aggregate].[Product Performance] WHERE [Accounting Period Code] &gt;= FORMAT(DATEADD(MONTH, -1 * ?, CAST(? + '-01' AS date)), 'yyyy-MM') AND [Accounting Period Code] &lt;= ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::RebuildPriorPeriods" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Rebuild Product Performance"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{F664B726-A350-2F6F-91E7-19416BAAE592}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Rebuild Product Performance"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Rebuild Product Performance\Product Performance Source" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="Product Performance Source" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">7200</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT f.[Stock Item Key] AS StockItemKey, d.[Accounting Period Code] AS AccountingPeriodCode, si.[Product Category Code] AS ProductCategoryCode, SUM(f.[Quantity]) AS QuantitySold, SUM(f.[Net Amount]) AS NetAmount, SUM(f.[Margin Amount]) AS MarginAmount, ISNULL(SUM(r.[Quantity Returned]), 0) AS QuantityReturned, ISNULL(AVG(inv.[Quantity On Hand]), 0) AS AverageStockOnHand, ISNULL(SUM(CASE WHEN inv.[Quantity On Hand] = 0 THEN 1 ELSE 0 END), 0) AS StockOutDayCount FROM [Fact].[Sale] AS f INNER JOIN Dimension.Date AS d ON d.[Date Key] = f.[Invoice Date Key] INNER JOIN [Dimension].[Stock Item] AS si ON si.[Stock Item Key] = f.[Stock Item Key] LEFT JOIN [Fact].[Return] AS r ON r.[Stock Item Key] = f.[Stock Item Key] LEFT JOIN [Fact].[Daily Inventory Snapshot] AS inv        ON inv.[Stock Item Key] = f.[Stock Item Key] AND inv.[Position Date Key] = d.[Date Key] WHERE d.[Accounting Period Code] = ? GROUP BY f.[Stock Item Key], d.[Accounting Period Code], si.[Product Category Code];</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Rebuild Product Performance\Product Performance Source.Connections[OleDbConnection]" connectionManagerID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_DW_Destination_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[StockItemKey]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].ExternalColumns[StockItemKey]" lineageId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[StockItemKey]" name="StockItemKey" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" dataType="wstr" length="7" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].ExternalColumns[AccountingPeriodCode]" lineageId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" name="AccountingPeriodCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[ProductCategoryCode]" dataType="wstr" length="12" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].ExternalColumns[ProductCategoryCode]" lineageId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[ProductCategoryCode]" name="ProductCategoryCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[QuantitySold]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].ExternalColumns[QuantitySold]" lineageId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[QuantitySold]" name="QuantitySold" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[NetAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].ExternalColumns[NetAmount]" lineageId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[NetAmount]" name="NetAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[MarginAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].ExternalColumns[MarginAmount]" lineageId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[MarginAmount]" name="MarginAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[QuantityReturned]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].ExternalColumns[QuantityReturned]" lineageId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[QuantityReturned]" name="QuantityReturned" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[AverageStockOnHand]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].ExternalColumns[AverageStockOnHand]" lineageId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[AverageStockOnHand]" name="AverageStockOnHand" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[StockOutDayCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].ExternalColumns[StockOutDayCount]" lineageId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].Columns[StockOutDayCount]" name="StockOutDayCount" truncationRowDisposition="RedirectRow" />
                </outputColumns>
