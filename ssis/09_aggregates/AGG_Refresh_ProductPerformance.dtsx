                  <externalMetadataColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].ExternalColumns[QuantityReturned]" dataType="i4" name="QuantityReturned" />
                  <externalMetadataColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].ExternalColumns[AverageStockOnHand]" dataType="numeric" precision="18" scale="2" name="AverageStockOnHand" />
                  <externalMetadataColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Output].ExternalColumns[StockOutDayCount]" dataType="i4" name="StockOutDayCount" />
                </externalMetadataColumns>
              </output>
              <output refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Error Output]" isErrorOut="true" name="OLE DB Source Error Output">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Error Output].Columns[StockItemKey]" dataType="i4" lineageId="Package\Rebuild Product Performance\Product Performance Source.Outputs[OLE DB Source Error Output].Columns[StockItemKey]" name="StockItemKey" />
