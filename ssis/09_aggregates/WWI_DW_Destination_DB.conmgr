<?xml version="1.0"?>
<DTS:ConnectionManager xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:ObjectName="WWI_DW_Destination_DB"
  DTS:DTSID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
  DTS:CreationName="OLEDB"
  DTS:Description="WideWorldImportersDW warehouse destination.">
  <DTS:PropertyExpression DTS:Name="ConnectionString">"Data Source=" + @[$Project::SqlServerHost] + "," + (DT_WSTR, 12) @[$Project::SqlServerPort] + ";Initial Catalog=" + @[$Project::SqlServerDwDb] + ";Provider=" + @[$Project::SqlServerProvider] + ";Auto Translate=False;" + (LEN(@[$Project::SqlServerUser]) &gt; 0 ? "User ID=" + @[$Project::SqlServerUser] + ";" : "Integrated Security=SSPI;") + (@[$Project::SqlServerTrustServerCertificate] ? "TrustServerCertificate=True;" : "")</DTS:PropertyExpression>
  <DTS:ObjectData>
    <DTS:ConnectionManager
      DTS:ConnectionString="Data Source=sqlserver.internal.example,1433;Initial Catalog=WideWorldImportersDW;Provider=MSOLEDBSQL19.1;Auto Translate=False;" />
  </DTS:ObjectData>
</DTS:ConnectionManager>
