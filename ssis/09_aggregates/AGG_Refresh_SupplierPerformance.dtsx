                </externalMetadataColumns>
              </output>
              <output refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Error Output]" isErrorOut="true" name="OLE DB Source Error Output">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Error Output].Columns[SupplierKey]" dataType="i4" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Error Output].Columns[SupplierKey]" name="SupplierKey" />
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Error Output].Columns[AccountingPeriodCode]" dataType="wstr" length="7" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Error Output].Columns[AccountingPeriodCode]" name="AccountingPeriodCode" />
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Error Output].Columns[SupplierRegionCode]" dataType="wstr" length="6" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Error Output].Columns[SupplierRegionCode]" name="SupplierRegionCode" />
