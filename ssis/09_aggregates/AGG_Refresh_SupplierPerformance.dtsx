      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{E4540100-D4C7-0578-F0D3-C329706F8FFE}"
        SQLTask:SqlStatementSource="EXEC etl.usp_LogPackageStart @BatchId = ?, @PackageName = ?, @PackageExecutionId = ? OUTPUT;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="True"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::BatchId" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="System::PackageName" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="User::PackageExecutionId" SQLTask:ParameterDirection="Output" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Delete Period Rows"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{60DDFD9C-8211-98A4-513C-4FAE965C0620}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Delete Period Rows"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <SQLTask:SqlTaskData
        SQLTask:Connection="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}"
        SQLTask:SqlStatementSource="DELETE FROM [Aggregate].[Supplier Performance] WHERE [Accounting Period Code] &gt;= FORMAT(DATEADD(MONTH, -1 * ?, CAST(? + '-01' AS date)), 'yyyy-MM') AND [Accounting Period Code] &lt;= ?;"
        SQLTask:ResultType="ResultSetType_None"
        SQLTask:TimeOut="0"
        SQLTask:SqlStmtSourceType="DirectInput"
        SQLTask:IsStoredProc="False"
        xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
        <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::RebuildPriorPeriods" SQLTask:ParameterDirection="Input" SQLTask:DataType="3" SQLTask:ParameterSize="-1" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
        <SQLTask:ParameterBinding SQLTask:ParameterName="2" SQLTask:DtsVariableName="$Package::AccountingPeriodCode" SQLTask:ParameterDirection="Input" SQLTask:DataType="130" SQLTask:ParameterSize="4000" />
      </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Rebuild Supplier Performance"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{F0CD3CC3-9D93-79B1-6349-DFB22C2A3544}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Rebuild Supplier Performance"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
      <pipeline version="1">
        <components>
          <component refId="Package\Rebuild Supplier Performance\Supplier Performance Source" componentClassID="Microsoft.OLEDBSource" contactInfo="OLE DB Source" description="OLE DB Source" name="Supplier Performance Source" usesDispositions="true" version="7">
            <properties>
              <property dataType="System.Int32" description="The number of seconds before a command times out." name="CommandTimeout">3600</property>
              <property dataType="System.String" description="Specifies the name of the database object used to open a rowset." name="OpenRowset"></property>
              <property dataType="System.String" description="The SQL command to be executed." name="SqlCommand">SELECT f.[Supplier Key] AS SupplierKey, d.[Accounting Period Code] AS AccountingPeriodCode, s.[Region Code] AS SupplierRegionCode, COUNT_BIG(*) AS ReceiptCount, SUM(CASE WHEN f.[Order To Receipt Days] &lt;= s.[Agreed Lead Time Days] THEN 1 ELSE 0 END)     AS OnTimeReceiptCount, SUM(CASE WHEN f.[Quantity Variance] &gt;= 0 THEN 1 ELSE 0 END) AS InFullReceiptCount, SUM(f.[Received Cost Amount]) AS ReceivedCostAmount, SUM(f.[Price Variance Amount]) AS PriceVarianceAmount, ISNULL(SUM(q.[Rejection Count]), 0) AS QualityRejectionCount, ISNULL(AVG(CAST(sp.[Days To Settle] AS decimal(9,2))), 0) AS AverageDaysToPay FROM [Fact].[Purchase Receipt] AS f INNER JOIN Dimension.Date AS d ON d.[Date] = f.[Goods Received Date Key] INNER JOIN [Dimension].[Supplier] AS s ON s.[Supplier Key] = f.[Supplier Key] LEFT JOIN [Aggregate].[Supplier Quality Position] AS q        ON q.[Supplier Key] = f.[Supplier Key]       AND q.[Accounting Period Code] = d.[Accounting Period Code] LEFT JOIN [Fact].[Supplier Payment] AS sp ON sp.[Supplier Key] = f.[Supplier Key] WHERE d.[Accounting Period Code] = ? AND s.[Is Current Row] = 1 GROUP BY f.[Supplier Key], d.[Accounting Period Code], s.[Region Code];</property>
              <property dataType="System.Int32" description="Specifies the mode used to access the database." name="AccessMode">2</property>
              <property dataType="System.Int32" description="Specifies the column code page to use when code page information is unavailable." name="DefaultCodePage">1252</property>
            </properties>
            <connections>
              <connection refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Connections[OleDbConnection]" connectionManagerID="{2BB319B7-7A7E-B779-78E6-6455B6FCA6FB}:external" connectionManagerRefId="Project.ConnectionManagers[WWI_DW_Destination_DB]" description="The connection used to access the source." name="OleDbConnection" />
            </connections>
            <outputs>
              <output refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output]" name="OLE DB Source Output">
                <outputColumns>
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[SupplierKey]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[SupplierKey]" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[SupplierKey]" name="SupplierKey" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" dataType="wstr" length="7" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[AccountingPeriodCode]" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[AccountingPeriodCode]" name="AccountingPeriodCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[SupplierRegionCode]" dataType="wstr" length="6" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[SupplierRegionCode]" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[SupplierRegionCode]" name="SupplierRegionCode" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[ReceiptCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[ReceiptCount]" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[ReceiptCount]" name="ReceiptCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[OnTimeReceiptCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[OnTimeReceiptCount]" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[OnTimeReceiptCount]" name="OnTimeReceiptCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[InFullReceiptCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[InFullReceiptCount]" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[InFullReceiptCount]" name="InFullReceiptCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[ReceivedCostAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[ReceivedCostAmount]" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[ReceivedCostAmount]" name="ReceivedCostAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[PriceVarianceAmount]" dataType="numeric" precision="18" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[PriceVarianceAmount]" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[PriceVarianceAmount]" name="PriceVarianceAmount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[QualityRejectionCount]" dataType="i4" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[QualityRejectionCount]" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[QualityRejectionCount]" name="QualityRejectionCount" truncationRowDisposition="RedirectRow" />
                  <outputColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[AverageDaysToPay]" dataType="numeric" precision="9" scale="2" errorOrTruncationOperation="Conversion" errorRowDisposition="RedirectRow" externalMetadataColumnId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[AverageDaysToPay]" lineageId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].Columns[AverageDaysToPay]" name="AverageDaysToPay" truncationRowDisposition="RedirectRow" />
                </outputColumns>
                <externalMetadataColumns isUsed="True">
                  <externalMetadataColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[SupplierKey]" dataType="i4" name="SupplierKey" />
                  <externalMetadataColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[AccountingPeriodCode]" dataType="wstr" length="7" name="AccountingPeriodCode" />
                  <externalMetadataColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[SupplierRegionCode]" dataType="wstr" length="6" name="SupplierRegionCode" />
                  <externalMetadataColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[ReceiptCount]" dataType="i4" name="ReceiptCount" />
                  <externalMetadataColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[OnTimeReceiptCount]" dataType="i4" name="OnTimeReceiptCount" />
                  <externalMetadataColumn refId="Package\Rebuild Supplier Performance\Supplier Performance Source.Outputs[OLE DB Source Output].ExternalColumns[InFullReceiptCount]" dataType="i4" name="InFullReceiptCount" />
