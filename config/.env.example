# ---------------------------------------------------------------------------
# WWI estate - environment variable template.
#
# Copy to a file OUTSIDE this repository (the run book uses ~/.wwi/<env>.env),
# fill in the values for your environment, and source it before running
# anything under deployment/:
#
#     set -a && source ~/.wwi/dev.env && set +a
#     deployment/deploy-all.sh --dry-run
#
# Never commit a filled-in copy. Placeholder values below are placeholders, not
# defaults: a driver that finds a required variable unset stops and names it.
#
# Where a value is secret, the run book's vault entry is named in the comment.
# The deployment drivers read secrets from these variables and pass them to the
# clients through SQLCMDPASSWORD or stdin, never on a command line.
# ---------------------------------------------------------------------------

# --- which environment is this? -------------------------------------------
# DEV | TEST | PROD. Selects config/environments/<code>.env.yaml and the SSIS
# environment the deployment binds to.
WWI_ENVIRONMENT=DEV
# Required only when WWI_ENVIRONMENT=PROD. Must be exactly I-UNDERSTAND.
WWI_CONFIRM_PROD=

# --- Oracle ERP (WWIGERP) --------------------------------------------------
ORACLE_HOST=oracle-erp-dev.internal.example
ORACLE_PORT=1521
# Service name, not SID. DEV is WWIGERPD, TEST WWIGERPT, PROD WWIGERP.
ORACLE_SERVICE=WWIGERPD
# Extract principal. PROD uses WWI_ETL_READER; the lower environments still use
# the older per-environment accounts.
ORACLE_USER=WWI_ETL_DEV
# secret - vault: wwi/<env>/oracle/etl-reader
ORACLE_PASSWORD=
# Schema account passwords substituted into oracle/ddl/03_create_schemas.sql.
# Only needed for the Oracle ddl stage on a fresh instance.
# secret - vault: wwi/<env>/oracle/schema/<schema>
WWI_MDM_SECRET=
WWI_PROC_SECRET=
WWI_FIN_SECRET=
WWI_REF_SECRET=
WWI_AUDIT_SECRET=
WWI_EXTRACT_SECRET=

# --- SQL Server ------------------------------------------------------------
SQLSERVER_HOST=sqldev01.internal.example
SQLSERVER_PORT=1433
# The SQL login used by the deployment driver and by the SSIS connection
# managers where Kerberos delegation does not reach.
SQLSERVER_USER=WWI_ETL
# secret - vault: wwi/<env>/sqlserver/wwi-etl
SQLSERVER_PASSWORD=
SQLSERVER_OLTP_DB=WideWorldImporters
SQLSERVER_STAGING_DB=WideWorldImporters_Staging
SQLSERVER_DW_DB=WideWorldImportersDW

# --- SSIS ------------------------------------------------------------------
# Catalogue instance. Often the same host as the warehouse; in PROD it is not.
SSIS_SERVER=sqldev01.internal.example
# Catalogue folder, per-environment. Each area project keeps its own name
# inside the folder, so there is no single estate project variable.
SSIS_FOLDER=WWI_DEV
# Set to 1 on a host without the Integration Services tooling so that preflight
# reports the missing tools as a skip rather than a failure.
WWI_ALLOW_MISSING_SSIS_TOOLS=0

# --- ETL project parameters ------------------------------------------------
# These map one-to-one onto the SSIS project parameters in
# tools/ssisgen/project.py. The per-environment YAML carries the value the
# catalogue environment is created with; these variables override it at deploy
# time when an operator needs to.
ETL_ENVIRONMENT_CODE=DEV
ETL_INBOUND_FILE_ROOT=C:\WWI\DEV\inbound
ETL_ARCHIVE_FILE_ROOT=C:\WWI\DEV\archive
ETL_REJECT_FILE_ROOT=C:\WWI\DEV\quarantine
# Rows per buffer for the bulk loads. Lower in DEV; 100000 in PROD.
ETL_DEFAULT_BATCH_SIZE=10000
# Source query timeout. The Oracle GL extract regularly needs more than the
# 300s default, which is why this exists at all.
ETL_SOURCE_QUERY_TIMEOUT_SECONDS=600
# Percentage of rejected rows above which a load fails rather than warns.
ETL_MAX_REJECT_PERCENT=25

# --- Landing zone ----------------------------------------------------------
# Root of the file landing zone. preflight checks that inbound, archive,
# quarantine, work and outbound exist beneath it. See
# config/landing-zone.yaml for the layout and retention rules.
WWI_LANDING_ROOT=C:\WWI\DEV

# --- Windows / Active Directory -------------------------------------------
# Used by sqlserver/security to build principal names. Names only.
WWI_DOMAIN_PREFIX=CONTOSO
WWI_ETL_SERVICE_ACCOUNT=svc-wwi-etl
WWI_APP_SERVICE_ACCOUNT=svc-wwi-app
WWI_REPORT_SERVICE_ACCOUNT=svc-wwi-report

# --- SQL Agent -------------------------------------------------------------
# Proxy accounts. The agent scripts reference the proxy and credential by name;
# these variables supply the account the credential is created for.
WWI_SSIS_PROXY_ACCOUNT=svc-wwi-etl
WWI_FILE_PROXY_ACCOUNT=svc-wwi-files
# secret - vault: wwi/<env>/agent/ssis-proxy
WWI_SSIS_PROXY_PASSWORD=
# secret - vault: wwi/<env>/agent/file-proxy
WWI_FILE_PROXY_PASSWORD=
# Where job step output files are written. Retention is in
# infrastructure/storage-layout.yaml.
WWI_AGENT_LOG_ROOT=C:\WWI\DEV\Logs\Agent
# Operator notification addresses. Distribution lists, never individuals - the
# estate learned that when the previous on-call engineer left.
WWI_ETL_OPERATOR_EMAIL=wwi-etl-oncall@example.internal
WWI_DBA_OPERATOR_EMAIL=wwi-dba@example.internal
WWI_FINANCE_OPERATOR_EMAIL=wwi-finance-systems@example.internal

# --- Deployment behaviour --------------------------------------------------
# 1 makes every driver print what it would do without invoking a client. The
# entry points also accept --dry-run / -DryRun.
DRY_RUN=0
